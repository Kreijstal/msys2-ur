# Contributor: Kreijstal <elektrischrainbow@gmail.com>

_realname=zathura
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2026.10.23
pkgrel=1
pkgdesc="Minimalistic document viewer with vi-like key bindings (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://pwmt.org/projects/zathura/'
msys2_repository_url='https://github.com/pwmt/zathura'
msys2_references=(
  'archlinux: zathura'
)
license=('spdx:Zlib')
depends=("${MINGW_PACKAGE_PREFIX}-cairo"
         "${MINGW_PACKAGE_PREFIX}-file"
         "${MINGW_PACKAGE_PREFIX}-girara"
         "${MINGW_PACKAGE_PREFIX}-glib2"
         "${MINGW_PACKAGE_PREFIX}-gtk4"
         "${MINGW_PACKAGE_PREFIX}-json-glib"
         "${MINGW_PACKAGE_PREFIX}-libsynctex"
         "${MINGW_PACKAGE_PREFIX}-sqlite3"
         "${MINGW_PACKAGE_PREFIX}-xxhash")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-gettext-tools"
             "${MINGW_PACKAGE_PREFIX}-librsvg"
             "${MINGW_PACKAGE_PREFIX}-meson"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf")
checkdepends=("${MINGW_PACKAGE_PREFIX}-appstream"
              "${MINGW_PACKAGE_PREFIX}-desktop-file-utils")
optdepends=("${MINGW_PACKAGE_PREFIX}-zathura-pdf-mupdf: PDF, EPUB and XPS support")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/pwmt/zathura/archive/refs/tags/${pkgver}.tar.gz"
        "0001-Run-on-Windows.patch"
        "0002-tests-Run-the-GTK-tests-on-Windows.patch"
        "0003-Keep-MIME-types-without-a-Windows-registry-entry-apa.patch")
sha256sums=('664e3770fd487e3a0a47b05bb53b25cf0deca4ca001c7b82b0fb2fbb754b37d8'
            '11db3bfded7838a960bf21036a54ca393559aa76b3ff1b9fa98ad93e0884c8f0'
            'e445613f3f070e166760151e0803a70f14c4c82231e256364ea2d3774b2e7dec'
            'ece0a0e39de12fa6cdd22c845ec99998c5224cfd534a12897adc9f2a96cf9c78')

prepare() {
  cd "${_realname}-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-Run-on-Windows.patch"
  patch -Np1 -i "${srcdir}/0002-tests-Run-the-GTK-tests-on-Windows.patch"
  patch -Np1 -i "${srcdir}/0003-Keep-MIME-types-without-a-Windows-registry-entry-apa.patch"
}

build() {
  # The manual pages need sphinx and are of little use without man(1); the
  # sandbox is seccomp/landlock and Linux only.
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --wrap-mode=nodownload \
      --buildtype=plain \
      -Dsynctex=enabled \
      -Dseccomp=disabled \
      -Dlandlock=disabled \
      -Dmanpages=disabled \
      -Dshell-completions=disabled \
      -Dconvert-icon=enabled \
      -Dtests-x11=disabled \
      -Dtests-wayland=disabled \
      "build-${MSYSTEM}" \
      "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  # The gui suite opens GTK windows and needs an interactive desktop.
  meson test -C "build-${MSYSTEM}" --print-errorlogs --no-suite gui
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
