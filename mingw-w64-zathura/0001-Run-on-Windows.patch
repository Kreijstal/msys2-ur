+char* zathura_relocate_path(const char* path) {
+#ifdef _WIN32
+  const size_t len = strlen(ZATHURA_PREFIX);
+  if (strncmp(path, ZATHURA_PREFIX, len) == 0 && (path[len] == '\0' || G_IS_DIR_SEPARATOR(path[len]))) {
+    /* The directory above bin\, where zathura.exe lives. */
+    g_autofree char* root = g_win32_get_package_installation_directory_of_module(NULL);
+    if (root != NULL) {
+      return g_build_filename(root, path + len, NULL);
+    }
+  }
+#endif
+  return g_strdup(path);
+}
+
 bool file_valid_extension(zathura_t* zathura, const char* path) {
   if (zathura == NULL || path == NULL || zathura->plugins.manager == NULL) {
     return false;
