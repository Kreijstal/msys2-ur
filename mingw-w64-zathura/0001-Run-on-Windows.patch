@@ -223,12 +226,31 @@ static GStrv build_argv_for_child(int idx, char** argv, int argc, char** orig_ar
   return (GStrv)g_ptr_array_free(arr, FALSE);
 }
 
+#ifdef _WIN32
+typedef struct {
+  GMainLoop* loop;
+  size_t running;
+} child_wait_t;
+
+static void child_exited(GPid pid, gint GIRARA_UNUSED(status), gpointer data) {
+  child_wait_t* wait = data;
+  g_spawn_close_pid(pid);
+  if (--wait->running == 0) {
+    g_main_loop_quit(wait->loop);
+  }
+}
+
+/* There is no setsid() on Windows, and g_spawn_async() runs no child setup
+ * function there: a spawned GUI process is already detached from us. */
+#define start_process_group ((GSpawnChildSetupFunc)NULL)
+#else
 static void start_process_group(void* GIRARA_UNUSED(data)) {
   if (setsid() == -1) {
     girara_error("Could not start new process group: %s", strerror(errno));
     exit(-1);
   }
 }
+#endif
 
 /* main function */
 GIRARA_VISIBLE int main(int argc, char* argv[]) {
@@ -367,10 +389,20 @@ GIRARA_VISIBLE int main(int argc, char* argv[]) {
     }
 
     if (!forkback) {
+#ifdef _WIN32
+      /* No waitpid(); GPid is a process handle that a child watch can wait on. */
+      child_wait_t wait = {g_main_loop_new(NULL, FALSE), girara_list_size(child_pids)};
+      for (size_t idx = 0; idx != girara_list_size(child_pids); ++idx) {
+        g_child_watch_add(girara_list_nth(child_pids, idx), child_exited, &wait);
+      }
+      g_main_loop_run(wait.loop);
+      g_main_loop_unref(wait.loop);
+#else
       for (size_t idx = 0; idx != girara_list_size(child_pids); ++idx) {
         const pid_t pid = (pid_t)(intptr_t)girara_list_nth(child_pids, idx);
         waitpid(pid, NULL, 0);
       }
+#endif
     }
     return 0;
   }
