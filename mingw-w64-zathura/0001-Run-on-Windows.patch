   version: version,
   requires: ['girara', 'cairo'],
+  # A PE plugin cannot leave the plugin API undefined for the executable to
+  # provide at load time; it links against the import library of zathura.exe.
+  libraries: host_machine.system() == 'windows' ? ['-L${libdir}', '-lzathura.exe'] : [],
   variables: [
     'apiversion=@0@'.format(plugin_api_version),
     'abiversion=@0@'.format(plugin_abi_version),
