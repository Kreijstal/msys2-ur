# Maintainer: Alexey Pavlov <alexpux@gmail.com>
# Contributor: Renato Silva <br.renatosilva@gmail.com>

_with_harfbuzz="no"

_realname=freetype
#pkgbase=mingw-w64-${_realname}
pkgname="${_realname}"
pkgver=2.13.2
pkgrel=2
pkgdesc="TrueType font rendering library (mingw-w64)"
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clang32' 'clangarm64')
msys2_references=(
  'archlinux: freetype2'
  "cpe: cpe:/a:freetype:freetype"
)
url="https://www.freetype.org/"
license=('spdx:GPL-2.0-or-later OR FTL')
depends=("gcc-libs"
         "brotli"
         "bzip2"
         "libpng"
         "zlib")
if [ "${_with_harfbuzz}" == "yes" ]; then
  depends+=("harfbuzz")
fi
# The -devel halves are mandatory here, not optional: build() passes
# --auto-features=enabled, which promotes bzip2/brotli/png/zlib from optional to
# required. The runtime packages (brotli, libbz2) ship only DLLs - no import
# library and no .pc - so meson fails at "C shared or static library 'bz2' not
# found" unless these are installed.
makedepends=("meson"
             "ninja"
             "pkgconf"
             "gcc"
             "libbz2-devel"
             "brotli-devel"
             "zlib-devel")
source=(https://download-mirror.savannah.gnu.org/releases/freetype//freetype-${pkgver}.tar.xz #{,.sig}
        freetype-2.10.0-enable-valid.patch
        freetype-2.10.0-enable-spr.patch)
sha256sums=('12991c4e55c506dd7f9b765933e62fd2be2e06d421505d7950a132e4f1bb484d'
            '30e84993f899b66c31451992667f7ac6cc9e0b19dfe2f47ccb546d77bbc77ef5'
            '0571f18d97834df020e4cbdb1338b14f9160669f868237080951e01f5b86727c')
validpgpkeys=('E30674707856409FF1948010BE6C3AAC63AD8E3F') # Werner Lemberg <wl@gnu.org>

# Helper macros to help make tasks easier #
apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${srcdir}/freetype-${pkgver}"

  apply_patch_with_msg \
    freetype-2.10.0-enable-valid.patch \
    freetype-2.10.0-enable-spr.patch
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("--buildtype=release")
  else
    extra_config+=("--buildtype=debug")
  fi

  if [ "${_with_harfbuzz}" != "yes" ]; then
    extra_config+=("-Dharfbuzz=disabled")
  fi

  # Build with meson, NOT freetype's bundled autotools. The autotools path runs
  # libtool, which has no host_os=msys case and therefore emits a static archive
  # only - silently, exiting 0. The freetype currently installed on the guest was
  # built that way: it shipped usr/lib/libfreetype.a with no DLL, and the
  # giveaway was usr/share/aclocal/freetype2.m4, which only the autotools build
  # installs. meson derives DLL naming from the compiler instead of a host_os
  # case, so it produces msys-freetype-6.dll correctly (same as pixman,
  # libxkbfile and libxcvt on this guest).
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="/usr" \
      --libdir="/usr/lib" \
      --wrap-mode=nodownload \
      --auto-features=enabled \
      --default-library=both \
      "${extra_config[@]}" \
      ../${_realname}-${pkgver}

  meson compile
}

package () {
  cd "${srcdir}/build-${MSYSTEM}"

  DESTDIR="${pkgdir}" meson install

  # Licenses
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/docs/GPLv2.TXT"   "${pkgdir}/usr/share/licenses/${_realname}/GPLv2.TXT"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/docs/FTL.TXT"     "${pkgdir}/usr/share/licenses/${_realname}/FTL.TXT"
}
