# Maintainer: Kreijstal <elektrischrainbow@gmail.com>
#
# Free Pascal Compiler 3.2.2 for mingw-w64, bootstrapped WITHOUT an existing FPC.
#
# KGPC (a Pascal compiler written in C: https://github.com/Kreijstal/Pascal-Compiler)
# compiles FPC's own compiler source (pp.pas) into a seed compiler, which then
# self-cycles a native FPC 3.2.2 ppcx64.exe to a fixpoint (ppc2 == ppc3) and
# builds the Win64 RTL.  No host fpc is used anywhere in the chain -- the seed
# is pure C.  The shipped ppcx64.exe is therefore a genuine FPC-built FPC, with
# KGPC acting only as the initial bootstrap seed.  The fixpoint ppcx64 then
# builds the complete FPC distribution exactly like upstream `make all`: RTL,
# all packages (FCL, fcl-*, winunits, ...) and the utils (fpcres, fpcmake,
# fpdoc, h2pas, ...).  ${pkgbase}-src ships the pristine FPC sources (for
# Lazarus CodeTools).
#
# Build inside an MSYS2 MINGW64/UCRT64/CLANG64 shell:
#     makepkg-mingw -sCf

_realname=fpc
pkgbase="mingw-w64-${_realname}-kgpc"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}-kgpc"
         "${MINGW_PACKAGE_PREFIX}-${_realname}-kgpc-src")
pkgver=3.2.2
pkgrel=2
# FPC source git tag (GitLab) and the KGPC release tag used as the bootstrap
# seed.  KGPC 0.0.7 is the first revision that fully self-cycles win64 FPC 3.2.2
# to a fixpoint (the FreeAndNil untyped-var pointer-store fix, PR #762).
_fpctag="release_3_2_2"
_kgpc_tag="0.0.9"
pkgdesc="Free Pascal Compiler 3.2.2, bootstrapped from source via KGPC (no host FPC) (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url="https://github.com/Kreijstal/Pascal-Compiler"
msys2_repository_url="https://gitlab.com/freepascal.org/fpc/source"
msys2_references=(
  'archlinux: fpc'
)
license=('spdx:GPL-2.0-or-later' 'spdx:LGPL-2.1-or-later')  # compiler GPL2, RTL LGPL2 + linking exception
# ppcx64 uses its internal assembler/linker on win64, but FPC can shell out to a
# system linker for some link modes.  GCC environments ship GNU binutils; the
# CLANG64 environment has no binutils package and uses LLVM lld instead.
# {$R foo.rc} resources are compiled with `windres` (binutils; llvm-tools in
# CLANG64).
if [ "${MINGW_PACKAGE_PREFIX}" = "mingw-w64-clang-x86_64" ]; then
  _fpc_depends=("${MINGW_PACKAGE_PREFIX}-lld" "${MINGW_PACKAGE_PREFIX}-llvm-tools")
else
  _fpc_depends=("${MINGW_PACKAGE_PREFIX}-binutils")
fi
# "-cc" is the toolchain-agnostic C compiler virtual: provided by -gcc in the
# GCC environments and by -clang in CLANG64.  It links the KGPC-emitted seed.
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-meson"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-gmp")
options=('!strip' '!debug')   # ppcx64.exe is a self-contained PE; the .ppu/.o units must not be stripped
source=("fpc-${pkgver}.tar.gz::https://gitlab.com/freepascal.org/fpc/source/-/archive/${_fpctag}/source-${_fpctag}.tar.gz"
        "kgpc-${_kgpc_tag}.tar.gz::https://github.com/Kreijstal/Pascal-Compiler/archive/refs/tags/${_kgpc_tag}.tar.gz"
        "0001-comprsrc-strip-trailing-delimiter-from-windres-include.patch")
sha256sums=('c15ae8c7b1fd1e6da4194d669d538b833516af3251afca5de5bec50727c3528f'
            '13cdba1b9cd8cc0d442812feddfdf666f3403725071470ff30ce9fc94462238d'
            'b372e4cd4f334c2f503f84955cffb7b516657a477f7b7c2998272c1d312796c4')

_fpctarget="x86_64-win64"

prepare() {
  # Give the two extracted source trees the stable names build()/package() use.
  cd "${srcdir}"
  [ -d fpc ]  || mv "source-${_fpctag}"          fpc
  [ -d kgpc ] || mv "Pascal-Compiler-${_kgpc_tag}" kgpc

  # {$R *.rc}: llvm-windres (CLANG64) chokes on FPC's "--include <dir>\".
  patch -d fpc -Np1 -i "${srcdir}/0001-comprsrc-strip-trailing-delimiter-from-windres-include.patch"
}

build() {
  # MinGW-w64 toolchain guard: the msys posix cc is a Cygwin fork and produces
  # a ppcx64 that faults at startup (argv/entry-info shim), so require _WIN64.
  # Use "cc" (gcc in the GCC envs, clang in CLANG64) so the guard is env-agnostic.
  if ! "${MINGW_PREFIX}/bin/cc" -dM -E - </dev/null 2>/dev/null | grep -q "define _WIN64"; then
    error "Toolchain at ${MINGW_PREFIX}/bin/cc does not define _WIN64 (not MinGW-w64)."
    return 1
  fi

  # --- 1. native KGPC (C) -------------------------------------------------
  cd "${srcdir}/kgpc"
  [ -x "_build/KGPC/kgpc.exe" ] || meson setup _build --buildtype=release
  # kgpc.exe is the compiler; kgpc_runtime is libkgpc_runtime.a, linked into the
  # KGPC-emitted seed compiler (pp_bootstrap.exe / msg2inc.exe).  Both are needed.
  meson compile -C _build kgpc kgpc_runtime

  local _kgpc="${srcdir}/kgpc/_build/KGPC/kgpc.exe"
  local _rtlib="${srcdir}/kgpc/_build/KGPC/libkgpc_runtime.a"

  # KGPC (native-Windows exe) mishandles absolute / forward-slash -Fu paths when
  # resolving transitively-used units (rtl/charmaps).  RELATIVE paths from a fixed
  # cwd work -- the same approach the upstream test harness uses.  Keep cwd at
  # "${srcdir}" for every KGPC invocation and reference the source tree as "fpc/...".
  cd "${srcdir}"
  local fpc=fpc
  local defs=(--no-stdlib -DCPU64 -DCPUX86_64 -Dx86_64 -DFPC -DWINDOWS -DWIN64 -DMSWINDOWS
    -DFPC_HAS_INDIRECT_ENTRY_INFORMATION -DFPC_HAS_TYPE_EXTENDED -DSUPPORT_EXTENDED
    -DFPC_BOOTSTRAP_INDIRECT_ENTRY -Sg)
  local rtlincs=(-I"$fpc/rtl/objpas" -I"$fpc/rtl/objpas/sysutils" -I"$fpc/rtl/objpas/classes"
    -I"$fpc/rtl/inc" -I"$fpc/rtl/x86_64"
    -I"$fpc/rtl/win" -I"$fpc/rtl/win/wininc" -I"$fpc/rtl/win64" -I"$fpc/rtl/win64/x86_64")
  local rtlunits=(-Fu"$fpc/rtl/win" -Fu"$fpc/rtl/win64" -Fu"$fpc/rtl/objpas" -Fu"$fpc/rtl/inc"
    -Fu"$fpc/rtl/objpas/sysutils" -Fu"$fpc/rtl/objpas/classes" -Fu"$fpc/rtl/charmaps")
  local incs=("${rtlincs[@]}" -I"$fpc/compiler" -I"$fpc/compiler/x86" -I"$fpc/compiler/x86_64")
  local units=("${rtlunits[@]}" -Fu"$fpc/compiler" -Fu"$fpc/compiler/x86" -Fu"$fpc/compiler/x86_64" -Fu"$fpc/compiler/systems")

  # --- 2a. generate compiler message includes (msg2inc, KGPC-built) -------
  # The FPC git source does not ship the generated msgtxt.inc / msgidx.inc.
  if [ ! -f "$fpc/compiler/msgtxt.inc" ] || [ ! -f "$fpc/compiler/msgidx.inc" ]; then
    "$_kgpc" "$fpc/compiler/utils/msg2inc.pp" msg2inc.s --emit-link-args \
      "${defs[@]}" "${rtlincs[@]}" "${rtlunits[@]}" 2>msg2inc.err 1>/dev/null
    local msglink; msglink=$(sed -n 's/^KGPC_LINK_ARGS://p' msg2inc.err)
    cc -O2 -o msg2inc.exe msg2inc.s "$_rtlib" -lgmp ${msglink}
    ( cd "$fpc/compiler" && "${srcdir}/msg2inc.exe" msg/errore.msg msg msg )
  fi

  # --- 2b. KGPC compiles pp.pas -> seed compiler (pp_bootstrap.exe) -------
  "$_kgpc" "$fpc/compiler/pp.pas" pp_bootstrap.s --emit-link-args \
    "${defs[@]}" "${incs[@]}" "${units[@]}" 2>pp_compile.err 1>/dev/null
  local linkargs; linkargs=$(sed -n 's/^KGPC_LINK_ARGS://p' pp_compile.err)
  cc -O2 -o pp_bootstrap.exe pp_bootstrap.s "$_rtlib" -lgmp ${linkargs}
  local ppboot="${srcdir}/pp_bootstrap.exe"
  "$ppboot" -h >/dev/null 2>&1 || { error "seed compiler pp_bootstrap.exe does not run"; return 1; }

  # --- 3. seed compiler builds the RTL, then self-cycles a native FPC -----
  # `make compiler cycle` builds ppc1 (with the seed) -> ppc2 (with ppc1) ->
  # ppc3 (with ppc2) and requires ppc2 == ppc3 (fixpoint) before copying to
  # ppcx64.exe.  It also builds utils_all, which produces the fpc.exe driver.
  cd "${srcdir}/${fpc}"
  make -C rtl clean all FPC="$ppboot" CPU_TARGET=x86_64 OS_TARGET=win64
  make -C compiler cycle FPC="$ppboot" CPU_TARGET=x86_64 OS_TARGET=win64

  # --- 4. full FPC with the fixpoint compiler ------------------------------
  # Same sequence as upstream's top-level `make all` after its compiler_cycle
  # (rtl clean+all, packages, utils with RELEASE=1), but invoked per directory:
  # the top-level Makefile derives absolute POSIX paths (-FU/home/...) from
  # `pwd`, which the native ppcx64 cannot open.  The sub-Makefiles use
  # relative paths.  fpmake builds the packages with up to 2 worker threads.
  local ppc="${srcdir}/${fpc}/compiler/ppcx64.exe"
  local fullopts=(FPC="$ppc" CPU_TARGET=x86_64 OS_TARGET=win64 RELEASE=1 "FPMAKEOPT=-T 2")
  make -C rtl clean all "${fullopts[@]}"
  make -C packages all "${fullopts[@]}"
  make -C utils all "${fullopts[@]}"
}

package_fpc-kgpc() {
  pkgdesc="Free Pascal Compiler 3.2.2 (compiler, RTL, packages, utils), bootstrapped from source via KGPC (no host FPC) (mingw-w64)"
  depends=("${_fpc_depends[@]}")
  optdepends=("${MINGW_PACKAGE_PREFIX}-${_realname}-kgpc-src: FPC sources (for Lazarus CodeTools)"
              "${MINGW_PACKAGE_PREFIX}-cc: C preprocessor that windres runs for {$R *.rc} resources")
  install="${_realname}-kgpc.install"

  local fpc=fpc
  local _dest; _dest="$(cygpath -m "${pkgdir}${MINGW_PREFIX}")"
  # Upstream install targets.  Paths are passed in mixed (C:/...) form because
  # fpmake.exe (packages/utils install) is a native program.  The non-UNIXHier
  # (Windows) layout is used, with the base dir moved under lib/fpc/<ver>:
  #   bin/                               ppcx64, fpc, fpcres, fpcmake, fpdoc, h2pas, ...
  #   lib/fpc/<ver>/units/<target>/<pkg> rtl, fcl-*, winunits-*, ... (.ppu/.o/.a)
  #   lib/fpc/<ver>/{msg,fpmkinst,bin/<target>,doc}
  local instopts=(FPC="${srcdir}/${fpc}/compiler/ppcx64.exe"
    FPCMAKE="${srcdir}/${fpc}/utils/fpcm/bin/${_fpctarget}/fpcmake.exe"
    CPU_TARGET=x86_64 OS_TARGET=win64
    INSTALL_PREFIX="${_dest}"
    INSTALL_BASEDIR="${_dest}/lib/fpc/${pkgver}"
    INSTALL_BINDIR="${_dest}/bin")
  cd "${srcdir}/${fpc}"
  make -C compiler install "${instopts[@]}"
  make -C rtl      install "${instopts[@]}"
  make -C packages install "${instopts[@]}"
  make -C utils    install "${instopts[@]}"

  # fpc.cfg from upstream's fpcmkcfg template (-Fu<base>/units/$fpctarget/*,
  # .../rtl, ...), with absolute install paths.  ppcx64 reads fpc.cfg from its
  # own directory.  The build-time prefix is recorded on the marker line; the
  # .install scriptlet rewrites it to the actual MSYS2 root after installation.
  local _bin="${pkgdir}${MINGW_PREFIX}/bin"
  local _winprefix; _winprefix="$(cygpath -w "${MINGW_PREFIX}")"
  "${_bin}/fpcmkcfg.exe" -d "basepath=${_winprefix}\\lib\\fpc\\${pkgver}" \
    -o "$(cygpath -m "${_bin}/fpc.cfg.tmp")"
  {
    printf '# fpc-kgpc-prefix: %s\n' "${_winprefix}"
    printf '# Generated by fpcmkcfg; the line above lets the package scriptlet relocate it.\n'
    printf '# MSYS2 tools (binutils/lld, fpcres, ...) live in the prefix bin dir.\n'
    printf -- '-FD%s\\bin\n' "${_winprefix}"
    tr -d '\r' < "${_bin}/fpc.cfg.tmp"   # LF only, like the header
  } > "${_bin}/fpc.cfg"
  rm -f "${_bin}/fpc.cfg.tmp"

  install -d "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}-kgpc"
  install -m644 "${srcdir}/${fpc}/rtl/COPYING.FPC" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}-kgpc/COPYING.FPC"
}

package_fpc-kgpc-src() {
  pkgdesc="Free Pascal Compiler 3.2.2 sources, for Lazarus CodeTools (mingw-w64)"
  depends=()
  # Pristine sources straight from the release tarball (not the build tree),
  # minus the testsuite; same location as Arch's fpc-src (/usr/lib/fpc/src).
  local _dst="${pkgdir}${MINGW_PREFIX}/lib/fpc/src"
  install -d "${_dst}"
  bsdtar -xf "${srcdir}/fpc-${pkgver}.tar.gz" -C "${_dst}" \
    --strip-components=1 --exclude "source-${_fpctag}/tests"
  install -d "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}-kgpc-src"
  install -m644 "${_dst}/rtl/COPYING.FPC" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}-kgpc-src/COPYING.FPC"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
