prepare() {
 /usr/bin/python3 "$srcdir/extract.py" "$srcdir/msal-$_commit.tar.gz" "$srcdir/source"
 /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/source" "$srcdir/prepared"
}
build() {
 export DOTNET_ROOT=$(cygpath -am ${MINGW_PREFIX}/lib/dotnet) DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
 export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_HOME=$(cygpath -am "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -am "$srcdir/cache")
 ${MINGW_PREFIX}/lib/dotnet/dotnet.exe build "$(cygpath -am "$srcdir/prepared/src/client/Microsoft.Identity.Client.Extensions.Msal/Microsoft.Identity.Client.Extensions.Msal.csproj")" -c Release --configfile "$(cygpath -am "$srcdir/prepared/NuGet.config")" -p:UseSharedCompilation=false -p:CscToolPath="$(cygpath -am ${MINGW_PREFIX}/lib/dotnet/compiler-packs/roslyn-4.9.2)" -p:CscToolExe=csc49.cmd -v:minimal
 /usr/bin/python3 "$srcdir/verify-build.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/cache"
 /usr/bin/python3 "$srcdir/pack.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/feed"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"; }
_package() {
 local name=$1 suffix=$2
 install -Dm644 "$srcdir/feed/$name.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/$name.$pkgver.nupkg"
 install -Dm644 "$srcdir/source/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/LICENSE"
 install -m644 "$srcdir/source/ThirdPartyNotice.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/README.md"
 install -m644 "$srcdir/prepared/source-inventory.json" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/"
}
package_dotnet-msal() {
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-identitymodel-abstractions>=6.35.0" "${MINGW_PACKAGE_PREFIX}-dotnet-system-text-json8>=8.0.5")
 _package Microsoft.Identity.Client msal
}
package_dotnet-msal-extensions() {
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-msal>=4.61.3" "${MINGW_PACKAGE_PREFIX}-dotnet-protecteddata>=8.0.31")
 _package Microsoft.Identity.Client.Extensions.Msal msal-extensions
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
