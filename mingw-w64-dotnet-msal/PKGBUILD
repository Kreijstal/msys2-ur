pkgdesc='Complete original MSAL .NET6 source branch and encrypted cache extension on source .NET8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/AzureAD/microsoft-authentication-library-for-dotnet'
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-identitymodel-abstractions>=6.35.0" "${MINGW_PACKAGE_PREFIX}-dotnet-system-text-json8>=8.0.5" "${MINGW_PACKAGE_PREFIX}-dotnet-protecteddata>=8.0.31" 'python')
checkdepends=("${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2")
options=('!strip' '!lto')
source=("msal-$_commit.tar.gz::https://codeload.github.com/AzureAD/microsoft-authentication-library-for-dotnet/tar.gz/$_commit"
 extract.py prepare.py verify-build.py pack.py Check.cs check.sh check-payload.py compare.py InspectApi.cs InspectAssemblyMetadata.cs source-inputs.json
