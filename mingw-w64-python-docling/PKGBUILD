# Maintainer (msys2-ur): Kreijstal
#
# docling is a metapackage: the module and CLI live in docling-slim, and this
# wheel only declares docling-slim[standard]. It depends on everything that
# extra pulls in (PDF backend, layout/TableFormer models on PyTorch, RapidOCR
# on ONNX Runtime, Office/e-mail/LaTeX formats, chunking, CLI).

_realname=docling
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.135.0
pkgrel=1
pkgdesc="Convert PDF, DOCX, PPTX, XLSX, HTML, images and more into a unified document representation (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/docling-project/docling'
msys2_repository_url='https://github.com/docling-project/docling'
msys2_references=(
  'purl: pkg:pypi/docling'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-docling-slim"
         # docling-slim[standard]
         "${MINGW_PACKAGE_PREFIX}-python-accelerate"
         "${MINGW_PACKAGE_PREFIX}-python-beautifulsoup4"
         "${MINGW_PACKAGE_PREFIX}-python-defusedxml"
         "${MINGW_PACKAGE_PREFIX}-python-docling-core"
         "${MINGW_PACKAGE_PREFIX}-python-docling-ibm-models"
         "${MINGW_PACKAGE_PREFIX}-python-docling-parse"
         "${MINGW_PACKAGE_PREFIX}-python-docx"
         "${MINGW_PACKAGE_PREFIX}-python-dotenv"
         "${MINGW_PACKAGE_PREFIX}-python-httpx"
         "${MINGW_PACKAGE_PREFIX}-python-huggingface-hub"
         "${MINGW_PACKAGE_PREFIX}-python-lxml"
         "${MINGW_PACKAGE_PREFIX}-python-mail-parser"
         "${MINGW_PACKAGE_PREFIX}-python-marko"
         "${MINGW_PACKAGE_PREFIX}-python-numpy"
         "${MINGW_PACKAGE_PREFIX}-python-openpyxl"
         "${MINGW_PACKAGE_PREFIX}-python-oxmsg"
         "${MINGW_PACKAGE_PREFIX}-python-pillow"
         "${MINGW_PACKAGE_PREFIX}-python-polyfactory"
         "${MINGW_PACKAGE_PREFIX}-python-pptx"
         "${MINGW_PACKAGE_PREFIX}-python-pylatexenc"
         "${MINGW_PACKAGE_PREFIX}-python-pypdfium2"
         "${MINGW_PACKAGE_PREFIX}-python-pytorch"
         "${MINGW_PACKAGE_PREFIX}-python-rapidocr"
         "${MINGW_PACKAGE_PREFIX}-python-rich"
         "${MINGW_PACKAGE_PREFIX}-python-rtree"
         "${MINGW_PACKAGE_PREFIX}-python-scipy"
         "${MINGW_PACKAGE_PREFIX}-python-torchvision"
         "${MINGW_PACKAGE_PREFIX}-python-typer"
         "${MINGW_PACKAGE_PREFIX}-python-websockets"
         # docling-core[chunking]
         "${MINGW_PACKAGE_PREFIX}-python-semchunk"
         "${MINGW_PACKAGE_PREFIX}-python-transformers"
         "${MINGW_PACKAGE_PREFIX}-python-tree-sitter"
         "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-c"
         "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-javascript"
         "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-python"
         "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-typescript")
optdepends=("${MINGW_PACKAGE_PREFIX}-python-peft: VLM pipelines (docling[vlm])"
            "${MINGW_PACKAGE_PREFIX}-tesseract-ocr: Tesseract CLI OCR engine")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-hatchling")
source=("https://pypi.org/packages/source/d/docling/docling-${pkgver}.tar.gz"
        "LICENSE::https://raw.githubusercontent.com/docling-project/docling/v${pkgver}/LICENSE"
        "docling-clipboard.py")
sha256sums=('11c55f1feeb017e4a842f01d6d405453b5c0160b1b0269765a44df06403753c6'
            'edb765d1e3e60d0c7a7d5fba5f2bb2c3c29f7465cecb5c22cf1185c884954e4c'
            '5782613755377e5b5bb9ebe72b20e4cdf5db411e92b68d0c743db6529a3c91c8')

prepare() {
  cd "docling-${pkgver}"
  # the docling/docling-tools console scripts are declared again here only
  # for `uv tool install docling`; docling-slim already installs them
  sed -i '/^\[project.scripts\]/,/^docling-tools = /d' pyproject.toml
}

build() {
  cp -r "docling-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  # every requirement of docling-slim[standard] is installed, and the PDF,
  # OCR and model stacks import
  ${MINGW_PREFIX}/bin/python - <<'PY'
from importlib.metadata import requires, version
from packaging.requirements import Requirement
assert version("docling") == version("docling-slim"), (version("docling"), version("docling-slim"))
missing = []
for r in requires("docling-slim"):
    req = Requirement(r)
    if req.marker and not req.marker.evaluate({"extra": "standard"}):
        continue
    try:
        v = version(req.name)
    except Exception:
        missing.append(req.name); continue
    if not req.specifier.contains(v, prereleases=True):
        missing.append(f"{req.name} {v} !{req.specifier}")
assert not missing, missing
import docling_parse.pdf_parsers, docling_ibm_models, rapidocr, torch
from docling.backend.docling_parse_backend import DoclingParseDocumentBackend
from docling.models.stages.ocr.rapid_ocr_model import RapidOcrModel
from docling.document_converter import DocumentConverter
print("docling", version("docling"), "ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  # Granite-Docling on the Windows clipboard image (see the script's --help)
  install -Dm755 "${srcdir}/docling-clipboard.py" "${pkgdir}${MINGW_PREFIX}/share/python-${_realname}/docling-clipboard.py"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
