# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-objectpool
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=8.0.31
pkgrel=1
pkgdesc='Source-built Microsoft.Extensions.ObjectPool for .NET 8'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/aspnetcore'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2" 'python')
options=('!strip' '!lto')
source=("aspnetcore-v$pkgver.tar.gz::https://codeload.github.com/dotnet/aspnetcore/tar.gz/refs/tags/v$pkgver"
        prepare.py AspNetCore.pubkey.hex Check.cs CheckApi.cs check.sh README.md)
noextract=("aspnetcore-v$pkgver.tar.gz")
sha256sums=('ad8ef8f6331576a03714941a90f33fb418b3d1ab9765e792418da5d9a328a60c'
            'da4db6b3d2d91b5a96e2973c3d579c5b873409630dceee4c9e8eaca404ca8bf8' '9faab536742ab7c206bfd26d3f2dce0227f5db75b960af0d7a0ba43e6dc9c0d4' '0039f73e5d54f17b78e8d798d061cd5baf695b587575c4167e880d6294fdf8f3' 'b0d13b7ad3f1bdb768fc3e48786dc7b557e92180bd36769b44999115ab1115c4' 'a7c4b99a90c3af09b755d0c98873b531f6b38bc32a67957b1393985dbb26d1d0' '5282fa2900bfc5ff579b1d2b9d8117efb804afa9bf45181d8f85b92ef1a3f4a6')
prepare() {
  tar -xzf "$srcdir/aspnetcore-v$pkgver.tar.gz" -C "$srcdir" \
    "aspnetcore-$pkgver/src/ObjectPool/src" \
    "aspnetcore-$pkgver/src/Shared/ThrowHelpers/ArgumentNullThrowHelper.cs" \
    "aspnetcore-$pkgver/src/Shared/CallerArgument/CallerArgumentExpressionAttribute.cs" \
    "aspnetcore-$pkgver/LICENSE.txt" "aspnetcore-$pkgver/THIRD-PARTY-NOTICES.txt"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/aspnetcore-$pkgver" "$srcdir/build"
}
build() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet") DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
  export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$(cygpath -m "$srcdir/build/Library.csproj")" \
    -c Release -o "$(cygpath -m "$srcdir/feed")" --configfile "$(cygpath -m "$srcdir/build/NuGet.config")" \
    -p:UseSharedCompilation=false -v:minimal
}
check() {
  bash "$srcdir/check.sh" "$srcdir/consumer" "$srcdir/feed" "$srcdir/build/PublicAPI.txt"
}
package() {
  install -Dm644 "$srcdir/feed/Microsoft.Extensions.ObjectPool.$pkgver.nupkg" \
    "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.extensions.objectpool.$pkgver.nupkg"
  install -Dm644 "$srcdir/aspnetcore-$pkgver/LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/aspnetcore-$pkgver/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.txt"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -m644 "$srcdir/build/PublicAPI.txt" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/PublicAPI.txt"
}
