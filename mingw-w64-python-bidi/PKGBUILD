_realname=bidi
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.6.11
pkgrel=1
pkgdesc="Python BiDi layout wrapping the Rust crate unicode-bidi (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/MeirKriheli/python-bidi'
msys2_repository_url='https://github.com/MeirKriheli/python-bidi'
msys2_references=(
  'purl: pkg:pypi/python-bidi'
)
license=('spdx:LGPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-python")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-maturin"
             "${MINGW_PACKAGE_PREFIX}-rust")
options=('!strip')
source=("https://pypi.org/packages/source/p/python-bidi/python_bidi-${pkgver}.tar.gz")
sha256sums=('034090c597af250d699299d7e7f1e83eb016f9e47b3b707bd89ab2bdec77bce0')

prepare() {
  cd "python_bidi-${pkgver}"
  # 0.29.0 always uses raw-dylib (python3XY.dll); 0.29.3 links through the
  # import library named in PYO3_CONFIG_FILE, see build()
  cargo update --precise 0.29.3 -p pyo3
}

build() {
  cp -r "python_bidi-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  # maturin cross-style config: MinGW Python's library is libpython3.X.dll
  local _pyver=$(${MINGW_PREFIX}/bin/python -c "import sys; print('%d.%d' % sys.version_info[:2])")
  cat > pyo3-config.txt <<END
implementation=CPython
version=${_pyver}
shared=true
abi3=false
lib_name=libpython${_pyver}
lib_dir=$(cygpath -m "${MINGW_PREFIX}/lib")
ext_suffix=$(${MINGW_PREFIX}/bin/python -c "import sysconfig; print(sysconfig.get_config_var('EXT_SUFFIX'))")
pointer_width=64
build_flags=
suppress_build_script_link_lines=false
END
  export PYO3_CONFIG_FILE="$(cygpath -m "${PWD}/pyo3-config.txt")"
  export _PYTHON_HOST_PLATFORM=$(${MINGW_PREFIX}/bin/python -c "import sysconfig, sys; sys.stdout.write(sysconfig.get_platform())")
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
from bidi import get_display
from bidi.algorithm import get_display as py_get_display
s = "abc אבג"
assert get_display(s) == "abc גבא", repr(get_display(s))
assert py_get_display(s) == get_display(s)
print("bidi ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 COPYING.LESSER "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/COPYING.LESSER"
  install -Dm644 COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/COPYING"
}
