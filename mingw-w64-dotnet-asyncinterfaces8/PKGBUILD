# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-asyncinterfaces8
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=8.0.0
pkgrel=1
_sourcever=8.0.31
pkgdesc='Source-built Microsoft.Bcl.AsyncInterfaces 8 facade for the .NET 8 feed'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" 'python')
options=('!strip' '!lto')
source=("runtime-v$_sourcever.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v$_sourcever"
        prepare.py Open.pubkey.hex check.cs check.sh README.md)
noextract=("runtime-v$_sourcever.tar.gz")
sha256sums=('b32a56a29cc0248bed219e1c7ef026bf8f006d997f5d6346382e63a22ecd9070'
            '38d99a633e3eacc7ca198b4f97d9d502901e17ed6cfd55e5f5c34a7b3a9425cd'
            '68908864c4084a0713b7201ff84082db6c158afcbf9cafef0f4a83204759afa5'
            'eca377db258a82b0057e09f2357fb6f2890cf6de4d89e65060dbef6eaeba32ff'
            '5931423d8dc95c075d51973e6920e7d9af559e8b99e5d9c24317755330a89a15'
            '4b5a8b828308cec5581cec6ae640fecf1265051567730d6ad80da28dc31977e8')
prepare() {
  tar -xzf "$srcdir/runtime-v$_sourcever.tar.gz" -C "$srcdir" \
    "runtime-$_sourcever/src/libraries/Microsoft.Bcl.AsyncInterfaces" "runtime-$_sourcever/LICENSE.TXT"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/runtime-$_sourcever" "$srcdir/build"
}
build() {
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet") DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
  export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$(cygpath -m "$srcdir/build/Library.csproj")" -c Release \
    --configfile "$(cygpath -m "$srcdir/build/NuGet.config")" -o "$(cygpath -m "$srcdir/feed")" -p:UseSharedCompilation=false -v:minimal
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"; }
package() {
  install -Dm644 "$srcdir/feed/Microsoft.Bcl.AsyncInterfaces.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.bcl.asyncinterfaces.$pkgver.nupkg"
  install -Dm644 "$srcdir/runtime-$_sourcever/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
}
