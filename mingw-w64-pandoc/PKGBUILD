source=("pandoc-cli-${pkgver}.tar.gz::https://hackage.haskell.org/package/pandoc-cli-${pkgver}/pandoc-cli-${pkgver}.tar.gz")
sha256sums=('c2bf5aea6f664e528e0f307a85e145980cb7b8b9504545a5e48554f045b8d98e')
noextract=()
for _dep in "${_deps[@]}"; do
  read -r _n _v _r _ssha _csha _f <<< "${_dep}"
  source+=("${_n}-${_v}.tar.gz::https://hackage.haskell.org/package/${_n}-${_v}/${_n}-${_v}.tar.gz"
           "${_n}-${_v}-r${_r}.cabal::https://hackage.haskell.org/package/${_n}-${_v}/revision/${_r}.cabal")
  sha256sums+=("${_ssha}" "${_csha}")
  noextract+=("${_n}-${_v}.tar.gz")
done
unset _dep _n _v _r _ssha _csha _f

prepare() {
  rm -rf "${srcdir}/repo" "${srcdir}/cabal-home"
  mkdir -p "${srcdir}/repo" "${srcdir}/cabal-home"

  local _dep _n _v _r _ssha _csha _rest _flags
  for _dep in "${_deps[@]}"; do
    read -r _n _v _r _rest <<< "${_dep}"
    cp "${srcdir}/${_n}-${_v}.tar.gz" "${srcdir}/repo/"
    cp "${srcdir}/${_n}-${_v}-r${_r}.cabal" "${srcdir}/repo/${_n}-${_v}.cabal"
  done

  # Only the local repository: nothing is fetched from the network.
  printf 'repository local\n  url: file+noindex:///%s\n' \
    "$(cygpath -m "${srcdir}/repo")" > "${srcdir}/cabal-home/config"

  cd "${srcdir}/pandoc-cli-${pkgver}"
  {
    echo 'packages: .'
    echo 'tests: False'
    echo 'benchmarks: False'
    echo 'constraints: pandoc-cli +lua +server +repl -nightly'
    for _n in "${_builtin[@]}"; do
      echo "           , any.${_n} installed"
    done
    for _dep in "${_deps[@]}"; do
      read -r _n _v _r _ssha _csha _flags <<< "${_dep}"
      echo "           , any.${_n} ==${_v}"
      [[ -n ${_flags} ]] && echo "           , any.${_n} ${_flags}"
    done
    # serialise and cborg (for pandoc +http via tls) have not been released
    # with bounds allowing the base and containers of GHC 9.14 yet.
    echo 'allow-newer: serialise:base, serialise:containers, cborg:base,'
    echo '             cborg:containers, cborg:ghc-prim'
  } > cabal.project
}

build() {
  cd "${srcdir}/pandoc-cli-${pkgver}"
  export CABAL_DIR="$(cygpath -m "${srcdir}/cabal-home")"
  cabal build -j"$(nproc)" -w "$(cygpath -m "${MINGW_PREFIX}/bin/ghc.exe")" exe:pandoc
}

check() {
  cd "${srcdir}/pandoc-cli-${pkgver}"
  export CABAL_DIR="$(cygpath -m "${srcdir}/cabal-home")"
  # Every package must come from the pinned tarball and .cabal revision.
  printf '%s\n' "${_deps[@]}" > pinned.txt
  python - pinned.txt dist-newstyle/cache/plan.json <<'PY'
import json, sys
want = {}
for l in open(sys.argv[1]).read().splitlines():
    n, v, r, ssha, csha, *flags = l.split()
    want[n] = (v, ssha, csha)
got = {u["pkg-name"]: (u["pkg-version"], u["pkg-src-sha256"], u["pkg-cabal-sha256"])
       for u in json.load(open(sys.argv[2]))["install-plan"]
       if u.get("pkg-src", {}).get("type") == "repo-tar"}
assert got == want, sorted(set(got.items()) ^ set(want.items()))
PY
  local _pandoc="$(cabal list-bin exe:pandoc)"
  "${_pandoc}" --version
  "${_pandoc}" --version | grep -q '^Features: +server +lua'
  printf '# Hi\n\nSome *text*.\n' | "${_pandoc}" -t html | grep -q '<em>text</em>'
  printf 'function Str(s) return pandoc.Str(s.text:upper()) end\n' > upper.lua
  printf 'some text\n' | "${_pandoc}" -L upper.lua -t plain | grep -q 'SOME TEXT'
}

package() {
  cd "${srcdir}/pandoc-cli-${pkgver}"
  export CABAL_DIR="$(cygpath -m "${srcdir}/cabal-home")"
  install -Dm755 "$(cabal list-bin exe:pandoc)" "${pkgdir}${MINGW_PREFIX}/bin/pandoc.exe"
  install -Dm644 man/pandoc.1 "${pkgdir}${MINGW_PREFIX}/share/man/man1/pandoc.1"
  install -Dm644 COPYING.md "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING.md"
}
