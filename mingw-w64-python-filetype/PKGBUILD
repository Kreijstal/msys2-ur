_realname=filetype
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.2.0
pkgrel=1
pkgdesc="Infer file type and MIME type of any file/buffer, no external dependencies (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/h2non/filetype.py'
msys2_repository_url='https://github.com/h2non/filetype.py'
msys2_references=(
  'purl: pkg:pypi/filetype'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
source=("https://pypi.org/packages/source/f/filetype/filetype-${pkgver}.tar.gz")
sha256sums=('66b56cd6474bf41d8c54660347d37afcc3f7d1970648de365c102ef77548aadb')

build() {
  cp -r "filetype-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import filetype
png = b"\x89PNG\r\n\x1a\n" + b"\0" * 32
pdf = b"%PDF-1.7\n" + b"\0" * 32
assert filetype.guess_mime(png) == "image/png", filetype.guess_mime(png)
assert filetype.guess_extension(pdf) == "pdf"
print("filetype ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
