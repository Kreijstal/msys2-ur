# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-asn1801
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=8.0.1
pkgrel=1
pkgdesc='Exact System.Formats.Asn1 8.0.1 original NET8 source bootstrap'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime8-servicing=8.0.31")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler53-bootstrap>=5.3.0.2.26113.113-3"
             "${MINGW_PACKAGE_PREFIX}-dotnet-targeting8-servicing=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-dotnet-reference10=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-nuget73-tasks-bootstrap=7.3.0.preview1.11413"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
source=('asn1801-snapshot-2aade6be.tar.gz'
        'arcade-asn1801-e6f70c7d.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/e6f70c7dd528f05cd28cec2a179d58c22e91d9ac'
        'intellisense8-20230918.1.nupkg::https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet8-transport/nuget/v3/flat2/microsoft.private.intellisense/8.0.0-preview-20230918.1/microsoft.private.intellisense.8.0.0-preview-20230918.1.nupkg'
        'asn1801-source-1.tar.gz')
noextract=('intellisense8-20230918.1.nupkg' 'asn1801-snapshot-2aade6be.tar.gz' 'arcade-asn1801-e6f70c7d.tar.gz')
sha256sums=('f688556c4895b4e484b0a17d0291947a6d6dfc7dc482dcbda3d4368399ab9f05'
            '1fd0c9fbc0e2d1cc67e2812c434c9ae6a73a05620aa29d4a3c9f186ad2e2dfd6'
            '48b7ad1dedcdcd36143c1b8611f6f8d185024b253781695b0afb06133449139a'
            '7c2957ef057a701654fb7119a0ed8bcf8072fdd12ab640658bf3e67b7355e5e9')
prepare() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/prepare.py")" "$(cygpath -am "$srcdir/asn1801-snapshot-2aade6be.tar.gz")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/intellisense8-20230918.1.nupkg")" > "$srcdir/prepare.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/evaluate.py")" "$(cygpath -am "$srcdir/plan")" > "$srcdir/evaluate.log" 2>&1
}
build() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/build.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/arcade-asn1801-e6f70c7d.tar.gz")" "$(cygpath -am "$srcdir/build")" > "$srcdir/build.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/localize.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/localized")" > "$srcdir/localize.log" 2>&1
}
check() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/check-api.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/api-check")" > "$srcdir/api-check.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/audit.py")" "$(cygpath -am "$srcdir/asn1801-snapshot-2aade6be.tar.gz")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/localized")" "$(cygpath -am "$srcdir/source-audit.json")" > "$srcdir/audit.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/check-resources.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/localized")" "$(cygpath -am "$srcdir/resource-check")" > "$srcdir/resource-check.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/check.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/runtime-check")" > "$srcdir/runtime-check.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/asn1801-workflow/stage.py")" "$(cygpath -am "$srcdir")" "$(cygpath -am "$srcdir/package-prefix")" > "$srcdir/stage.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/package-prefix/share/doc/$_realname/checks/check-installed.py")" "$(cygpath -am "$srcdir/package-prefix")" "$(cygpath -am "$srcdir/staged-check")" > "$srcdir/staged-check.log" 2>&1
}
package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -R "$srcdir/package-prefix/." "$pkgdir$MINGW_PREFIX/"
}
