_realname=oxmsg
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.0.2
pkgrel=1
pkgdesc="Extract attachments and content from Outlook .msg files (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/scanny/python-oxmsg'
msys2_repository_url='https://github.com/scanny/python-oxmsg'
msys2_references=(
  'purl: pkg:pypi/python-oxmsg'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-click"
         "${MINGW_PACKAGE_PREFIX}-python-olefile"
         "${MINGW_PACKAGE_PREFIX}-python-typing_extensions")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
source=("https://pypi.org/packages/source/p/python-oxmsg/python_oxmsg-${pkgver}.tar.gz")
sha256sums=('a6aff4deb1b5975d44d49dab1d9384089ffeec819e19c6940bc7ffbc84775fad')

build() {
  cp -r "python_oxmsg-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import oxmsg
from oxmsg import Message
from oxmsg.cli import oxmsg as cli
from click.testing import CliRunner
r = CliRunner().invoke(cli, ["--help"])
assert r.exit_code == 0 and "dump" in r.output, r.output
print("oxmsg ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.txt "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE.txt"
}
