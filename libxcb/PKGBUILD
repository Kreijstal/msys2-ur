# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=libxcb
pkgver=1.16
pkgrel=2
pkgdesc="X Protocol C-Language Bindings"
arch=('i686' 'x86_64')
url="https://xcb.sourceforge.net/"
license=('MIT')
# msys-xcb-1.dll imports msys-Xau-6.dll and msys-Xdmcp-6.dll, so both are
# hard runtime dependencies, not just build inputs.
depends=('libxau' 'libxdmcp')
# libxcb only runs the xsltproc *binary* -- configure.ac does a bare
# AC_PATH_PROG(XSLTPROC, xsltproc, no) and nothing links against libxslt or
# includes its headers. So the dependency is the runtime package 'libxslt'
# (which ships /usr/bin/xsltproc), NOT the split 'libxslt-devel' headers
# package, which isn't installed and would need network access to fetch.
makedepends=('xorg-util-macros' 'xcb-proto' 'libxau' 'libxdmcp' 'libpthread-stubs'
'libxslt')
source=(https://xcb.freedesktop.org/dist/${pkgname}-${pkgver}.tar.xz
       1.16-no-pthread-stubs.patch)
sha256sums=('SKIP'  # Replace SKIP with the actual checksum
           'SKIP')  # Replace SKIP with the actual checksum

prepare() {
 cd ${srcdir}/

 # Apply the patch
 patch -Np1 -i "${srcdir}/../1.16-no-pthread-stubs.patch"
 cd ${pkgname}-${pkgver}
 autoreconf -vif
}

build() {
 cd ${srcdir}/${pkgname}-${pkgver}

 CYGCONF_ARGS="--enable-composite --enable-damage --enable-dbe --enable-dpms --enable-dri2 --enable-glx --enable-randr --enable-record --enable-render --enable-res --enable-screensaver --enable-shape --enable-shm --enable-sync --enable-xfixes --enable-xinerama --enable-xinput --enable-xkb --enable-xtest --enable-present --enable-shared --enable-static"

 # Use MSYS2's declared host triple ($CHOST). libtool has no msys case
 # (deplibs_check_method=unknown, build_libtool_libs=no for host_os=msys), so
 # letting config.sub canonicalise to *-msys yields a STATIC-ONLY libxcb - and
 # since every X library above it links -no-undefined against -lxcb, libtool
 # then silently degrades libX11, libXext, ... to static as well. That is
 # useless to Wine: winex11.drv dlopens the shared libX11 at runtime.
 # $CHOST gives host_os=cygwin, where libtool has full shared support.
 # --build is passed identically so autoconf does not consider this a cross
 # build, and CC stays the msys gcc - only libtool's naming/behaviour follows
 # the cygwin path. The 1.16-no-pthread-stubs.patch already exempts cygwin*
 # from the pthread-stubs requirement, which this triple selects.
 # The triple is $CHOST, MSYS2's own declaration for this environment: stock
 # /etc/makepkg.conf (straight from the pacman package) sets
 # CHOST=x86_64-pc-cygwin. Never hardcode one here - an earlier revision of this
 # file hardcoded x86_64-pc-msys, which is precisely what produced the
 # static-only build described above.
 local _host="${CHOST:?CHOST unset - /etc/makepkg.conf was not sourced}"

 ./configure --prefix=/usr \
   --build=${_host} \
   --host=${_host} \
   ${CYGCONF_ARGS}


 # Override the autotools-regeneration recipes so a stale Makefile.in mtime
 # cannot trigger a doomed automake re-run on the guest's broken autoconf split.
 make AUTOMAKE=: AUTOCONF=: AUTOHEADER=: ACLOCAL=: MAKEINFO=:
}

check() {
 cd ${srcdir}/${pkgname}-${pkgver}

 # Add any check commands here
}

package() {

 cd ${srcdir}/${pkgname}-${pkgver}
 make DESTDIR=${pkgdir} install AUTOMAKE=: AUTOCONF=: AUTOHEADER=: ACLOCAL=: MAKEINFO=:

 # A libtool static-only degradation is silent: configure and make both still
 # exit 0, so nothing above this line can fail on it. Assert on the artifacts
 # instead, or a static-only regression ships unnoticed and every X library
 # above libxcb quietly goes static along with it.
 [ -f "${pkgdir}/usr/lib/libxcb.dll.a" ] || {
   echo "ERROR: libxcb built static-only (no import library)" >&2; return 1; }
 ls "${pkgdir}"/usr/bin/msys-xcb-*.dll >/dev/null 2>&1 || {
   echo "ERROR: libxcb built static-only (no DLL)" >&2; return 1; }
}
