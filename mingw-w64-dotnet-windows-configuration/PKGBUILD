pkgbase=mingw-w64-dotnet-windows-configuration
pkgname=(
  "${MINGW_PACKAGE_PREFIX}-dotnet-systemevents"
  "${MINGW_PACKAGE_PREFIX}-dotnet-drawing-common"
  "${MINGW_PACKAGE_PREFIX}-dotnet-windows-extensions"
  "${MINGW_PACKAGE_PREFIX}-dotnet-security-permissions"
  "${MINGW_PACKAGE_PREFIX}-dotnet-eventlog"
  "${MINGW_PACKAGE_PREFIX}-dotnet-configuration-manager"
  "${MINGW_PACKAGE_PREFIX}-dotnet-runtime-caching"
  "${MINGW_PACKAGE_PREFIX}-dotnet-performancecounter"
  "${MINGW_PACKAGE_PREFIX}-dotnet-servicecontroller"
  "${MINGW_PACKAGE_PREFIX}-dotnet-directoryservices"
)
pkgver=8.0.31
pkgrel=1
pkgdesc='Source-built Windows .NET configuration, drawing and diagnostics libraries'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-protecteddata>=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-llvm" "${MINGW_PACKAGE_PREFIX}-clang" 'python' 'binutils')
options=('!strip' '!lto')
source=("runtime-v${pkgver}.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v${pkgver}"
        "winforms-v${pkgver}.tar.gz::https://codeload.github.com/dotnet/winforms/tar.gz/refs/tags/v${pkgver}"
        prepare.py libraries.json Microsoft.pubkey.hex Open.pubkey.hex build-library.sh check.cs check.sh check-api.cs check-api.sh perf-provider-probe.c README.md)
noextract=("runtime-v${pkgver}.tar.gz" "winforms-v${pkgver}.tar.gz")
sha256sums=('b32a56a29cc0248bed219e1c7ef026bf8f006d997f5d6346382e63a22ecd9070'
            'bb2e9937d65e29d3812f7172e03cd86ac1ee5b3f9da3584f00ddd5523c42cbb7'
