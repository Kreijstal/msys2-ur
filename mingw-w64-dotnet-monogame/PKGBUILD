_stock_effects=(AlphaTestEffect BasicEffect DualTextureEffect EnvironmentMapEffect SkinnedEffect SpriteEffect)

_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/nuget-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
  export VKD3D_SHADER_DEBUG=none VKD3D_DEBUG=none
  # mgcb/mgfxc take /option:value switches; keep MSYS from rewriting them as paths.
  export MSYS2_ARG_CONV_EXCL='/'
  _dotnet="$MINGW_PREFIX/lib/dotnet/dotnet.exe"
  _feedsrc=$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")
  _props=(-c Release -p:Version=$pkgver -p:PackageVersion=$pkgver -p:DisableNativeBuild=True
          -p:RestoreSources="$_feedsrc" -p:NuGetAudit=false -p:UseSharedCompilation=false
          -p:EnableNETAnalyzers=false -p:WarningsAsErrors= -p:ContinuousIntegrationBuild=true
          -p:IncludeSymbols=false -v:minimal)
}

prepare() {
  cd "$srcdir/$_tree"
  local _sub
  for _sub in ThirdParty/StbImageSharp:StbImageSharp-${_stbimagesharp} \
              ThirdParty/StbImageWriteSharp:StbImageWriteSharp-${_stbimagewritesharp} \
              external/CppNet:CppNet-${_cppnet} \
              external/MonoGame.Templates:MonoGame.Templates-${_templates}; do
    rm -rf "${_sub%%:*}"
    cp -a "$srcdir/${_sub#*:}" "${_sub%%:*}"
  done
  local _p
  for _p in "$srcdir"/00*.patch; do
    msg2 "Applying ${_p##*/}"
    patch --binary -Np1 -i "$_p"
  done
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/$_tree" "$pkgver"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
  cp "$srcdir/NuGet.config" NuGet.config
}

# Non-system DLLs that $1 (in $MINGW_PREFIX/bin) needs, recursively, including $1.
_dll_closure() {
  local _todo=("$@") _seen=() _dll _dep
  while ((${#_todo[@]})); do
    _dll=${_todo[0]}; _todo=("${_todo[@]:1}")
    [[ " ${_seen[*]} " == *" $_dll "* ]] && continue
    _seen+=("$_dll")
    for _dep in $(objdump -p "$(cygpath -m "$MINGW_PREFIX/bin/$_dll")" | sed -n 's/^\s*DLL Name: //p'); do
      [[ -f "$MINGW_PREFIX/bin/$_dep" ]] && _todo+=("$_dep")
    done
  done
  printf '%s\n' "${_seen[@]}"
}

build() {
  _env
  cd "$srcdir/$_tree"

  # Native texture helper of the content pipeline (stb from the MSYS2 stb
  # package); C++ runtime linked in so it only needs system DLLs.
  local _native=Artifacts/native/mgpipeline/windows/x64/Release
  mkdir -p "$_native"
  ${CXX:-c++} ${CXXFLAGS} -std=c++17 -shared -static \
    -DDLL_EXPORT -DNDEBUG -DSTB_IMAGE_IMPLEMENTATION -DSTB_IMAGE_WRITE_IMPLEMENTATION \
    -DSTB_IMAGE_RESIZE_IMPLEMENTATION -DSTBI_WINDOWS_UTF8 -DSTBIW_WINDOWS_UTF8 \
    -Inative/pipeline/include -Inative/monogame/include -I"$MINGW_PREFIX/include/stb" \
    -o "$_native/mgpipeline.dll" native/pipeline/mgcp_texture.cpp

  # DesktopGL games get SDL2 and OpenAL Soft (and what they link) copied
  # from the MSYS2 prefix of the building SDK.
  local _dlls
  _dlls=$(_dll_closure SDL2.dll libopenal-1.dll | paste -sd';')
  msg2 "DesktopGL native libraries: $_dlls"
  sed -i "s|@MSYS2_NATIVE_DLLS@|$_dlls|" MonoGame.Framework/MonoGame.Framework.DesktopGL.targets

  # Stage 1: mgfxc (it only needs the framework's reference assembly, so the
  # framework is first built with empty stock effect resources).
  local _fx _res=MonoGame.Framework/Platform/Graphics/Effect/Resources
  for _fx in "${_stock_effects[@]}"; do : > "$_res/$_fx.ogl.mgfxo"; done
  "$_dotnet" build Tools/MonoGame.Effect.Compiler/MonoGame.Effect.Compiler.csproj "${_props[@]}" \
    --configfile "$(cygpath -m "$srcdir/NuGet.config")" -p:UseAppHost=false

  # Stage 2: the stock effects, from their .fx sources, with this mgfxc
  # (vkd3d d3dcompiler_47 + MojoShader).
  for _fx in "${_stock_effects[@]}"; do
    msg2 "mgfxc $_fx.fx (OpenGL)"
    "$_dotnet" Artifacts/MonoGame.Effect.Compiler/Release/mgfxc.dll \
      "$(cygpath -m "$_res/$_fx.fx")" "$(cygpath -m "$_res/$_fx.ogl.mgfxo")" /Profile:OpenGL
    [[ -s "$_res/$_fx.ogl.mgfxo" ]]
  done

  # Stage 3: packages for the offline feed.
  local _proj
  for _proj in MonoGame.Framework/MonoGame.Framework.DesktopGL.csproj \
               MonoGame.Framework.Content.Pipeline/MonoGame.Framework.Content.Pipeline.csproj \
               Tools/MonoGame.Effect.Compiler/MonoGame.Effect.Compiler.csproj \
               Tools/MonoGame.Content.Builder/MonoGame.Content.Builder.csproj \
               Tools/MonoGame.Content.Builder.Task/MonoGame.Content.Builder.Task.csproj \
               external/MonoGame.Templates/CSharp/MonoGame.Templates.CSharp.csproj; do
    msg2 "Packing $_proj"
    "$_dotnet" pack "$_proj" "${_props[@]}" -o "$(cygpath -m "$srcdir/feed")" \
      --configfile "$(cygpath -m "$srcdir/NuGet.config")"
  done

  # Framework-dependent mgcb and mgfxc for $MINGW_PREFIX/lib/monogame.
  for _proj in mgcb:Tools/MonoGame.Content.Builder/MonoGame.Content.Builder.csproj \
               mgfxc:Tools/MonoGame.Effect.Compiler/MonoGame.Effect.Compiler.csproj; do
    "$_dotnet" publish "${_proj#*:}" "${_props[@]}" -p:UseAppHost=false -p:SatelliteResourceLanguages=en \
      -o "$(cygpath -m "$srcdir/stage/${_proj%%:*}")" --configfile "$(cygpath -m "$srcdir/NuGet.config")"
  done
}

check() {
  _env
  local _feed=$(cygpath -m "$srcdir/feed")
  rm -rf "$srcdir/check"
  mkdir -p "$srcdir/check/content" "$srcdir/check/app"
  cd "$srcdir/check"

  # mgfxc: a custom effect for both shader backends.
  local _fx=$(cygpath -m "$srcdir/$_tree/Tools/MonoGame.Content.Builder.Editor/Templates/Effect.fx")
  "$_dotnet" "$(cygpath -m "$srcdir/stage/mgfxc/mgfxc.dll")" "$_fx" effect.ogl.mgfxo /Profile:OpenGL
  "$_dotnet" "$(cygpath -m "$srcdir/stage/mgfxc/mgfxc.dll")" "$_fx" effect.dx11.mgfxo /Profile:DirectX_11
  head -c4 effect.ogl.mgfxo | grep -q MGFX
  head -c4 effect.dx11.mgfxo | grep -q MGFX

  # mgcb: texture (stb via mgpipeline), sprite font (FreeType), stock-style and
  # custom effects (vkd3d + MojoShader), model (Assimp) and XML content.
  /usr/bin/python3 "$srcdir/check-content.py" "$srcdir/check/content" \
    "$srcdir/$_tree/external/MonoGame.Templates/CSharp/content/MonoGame.ItemTemplate.SpriteFont.CSharp/Roboto-Bold.ttf" \
    "$srcdir/$_tree/MonoGame.Framework/Platform/Graphics/Effect/Resources" "$_fx"
  (cd content && "$_dotnet" "$(cygpath -m "$srcdir/stage/mgcb/mgcb.dll")" /@:Content.mgcb /platform:DesktopGL \
    /outputDir:bin /intermediateDir:obj /rebuild)
  local _x
  for _x in texture font basic custom model; do
    [[ -s "content/bin/$_x.xnb" ]] || { echo "missing $_x.xnb"; return 1; }
  done

  # The packages restore offline from the feed and the framework carries the
  # source-built stock effects; the built content loads through the
  # ContentManager readers that need no graphics device.
  cp "$srcdir/check.cs" app/Program.cs
  cat > app/check.csproj <<PROJECT
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit><MonoGameCopyNativeLibraries>true</MonoGameCopyNativeLibraries></PropertyGroup>
<ItemGroup><PackageReference Include="MonoGame.Framework.DesktopGL" Version="[$pkgver]" /><PackageReference Include="MonoGame.Framework.Content.Pipeline" Version="[$pkgver]" /></ItemGroup></Project>
PROJECT
  "$_dotnet" run --project "$(cygpath -m "$srcdir/check/app/check.csproj")" -c Release \
    -p:RestoreSources="$_feed;$_feedsrc" -p:UseSharedCompilation=false -- "$(cygpath -m "$srcdir/check/content/bin")"

  # Every MSYS2 DLL that the copied native libraries link must be copied too.
  local _out=app/bin/Release/net8.0 _dll _dep
  for _dll in "$_out"/*.dll; do
    for _dep in $(objdump -p "$(cygpath -m "$_dll")" | sed -n 's/^\s*DLL Name: //p'); do
      if [[ -f "$MINGW_PREFIX/bin/$_dep" && ! -f "$_out/$_dep" ]]; then
        echo "${_dll##*/} needs $_dep, which was not copied next to the app"; return 1
      fi
    done
  done
}

package() {
  local _lib="$pkgdir$MINGW_PREFIX/lib"
  local _nupkg _id
  for _nupkg in "$srcdir"/feed/*.nupkg; do
    _id=$(basename "$_nupkg")
    if [[ $_id == MonoGame.Templates.CSharp.* ]]; then
      # Bundled with the SDK's own templates so `dotnet new mgdesktopgl` works
      # without `dotnet new install`.
      install -Dm644 "$_nupkg" "$_lib/dotnet/templates/${_sdkver}/${_id,,}"
    else
      install -Dm644 "$_nupkg" "$_lib/dotnet/library-packs/${_id,,}"
    fi
  done
  mkdir -p "$_lib/monogame"
  cp -r "$srcdir/stage/mgcb" "$srcdir/stage/mgfxc" "$_lib/monogame/"
  install -Dm755 "$srcdir/mgcb.sh" "$pkgdir$MINGW_PREFIX/bin/mgcb"
  sed 's/mgcb/mgfxc/g' "$srcdir/mgcb.sh" > "$srcdir/mgfxc.sh"
  install -Dm755 "$srcdir/mgfxc.sh" "$pkgdir$MINGW_PREFIX/bin/mgfxc"
  install -Dm644 "$srcdir/$_tree/LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/$_tree/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.txt"
  install -Dm644 "$srcdir/$_tree/external/CppNet/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/CppNet.LICENSE"
  install -Dm644 "$srcdir/README.msys2" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.msys2"
  install -Dm644 "$srcdir/$_tree/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
}
