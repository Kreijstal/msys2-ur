diff --git a/MonoGame.Framework/Platform/Utilities/Msys2Native.cs b/MonoGame.Framework/Platform/Utilities/Msys2Native.cs
new file mode 100644
index 0000000..53834ad
--- /dev/null
+++ b/MonoGame.Framework/Platform/Utilities/Msys2Native.cs
@@ -0,0 +1,116 @@
+// MonoGame - Copyright (C) MonoGame Foundation, Inc
+// This file is subject to the terms and conditions defined in
+// file 'LICENSE.txt', which is part of this source code package.
+
+// MSYS2 packaging: native libraries come from the MSYS2 prefix that the
+// .NET runtime itself is installed in ($MINGW_PREFIX/lib/dotnet), instead
+// of MonoGame.Library.* / MonoGame.Tool.* NuGet packages with prebuilt
+// binaries. A copy next to the application always wins.
+
+using System;
+using System.IO;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+
+namespace MonoGame.Msys2
+{
+    internal static class Msys2Native
+    {
+        private static string? _prefix;
+        private static bool _prefixResolved;
+
+        /// <summary>
+        /// The MSYS2 environment prefix (e.g. C:/msys64/clang64), from
+        /// MONOGAME_MSYS2_PREFIX or derived from the running .NET runtime
+        /// ($prefix/lib/dotnet/shared/Microsoft.NETCore.App/x.y.z/).
+        /// Null when the runtime is not an MSYS2 one.
+        /// </summary>
+        public static string? Prefix
+        {
+            get
+            {
+                if (_prefixResolved)
+                    return _prefix;
+                _prefixResolved = true;
+
+                var env = Environment.GetEnvironmentVariable("MONOGAME_MSYS2_PREFIX");
+                if (!string.IsNullOrEmpty(env) && Directory.Exists(Path.Combine(env, "bin")))
+                    return _prefix = Path.GetFullPath(env);
+
+                try
+                {
+                    var runtimeDir = RuntimeEnvironment.GetRuntimeDirectory();
+                    var prefix = Path.GetFullPath(Path.Combine(runtimeDir, "..", "..", "..", "..", ".."));
+                    if (File.Exists(Path.Combine(prefix, "lib", "dotnet", "dotnet.exe")) && Directory.Exists(Path.Combine(prefix, "bin")))
+                        _prefix = prefix;
+                }
+                catch (Exception)
+                {
+                }
+                return _prefix;
+            }
+        }
+
+        /// <summary>Maps MonoGame's DllImport names to MSYS2 DLL names.</summary>
+        public static string? MapName(string libraryName)
+        {
+            switch (libraryName)
+            {
+                case "openal": return "libopenal-1.dll";
+                case "mojoshader": return "libmojoshader.dll";
+                case "freetype": return "libfreetype-6.dll";
+                case "SDL2.dll": return "SDL2.dll";
+                case "mgpipeline": return "mgpipeline.dll";
+                default: return null;
+            }
+        }
+
+        /// <summary>Loads an MSYS2 DLL by full path from $prefix/bin, so its own dependencies resolve there too.</summary>
+        public static IntPtr LoadFromPrefix(string fileName)
+        {
+            var prefix = Prefix;
+            if (prefix == null)
+                return IntPtr.Zero;
+            var path = Path.Combine(prefix, "bin", fileName);
+            if (File.Exists(path) && NativeLibrary.TryLoad(path, out var handle))
+                return handle;
+            return IntPtr.Zero;
+        }
+
+        private static IntPtr Resolve(string libraryName, Assembly assembly, DllImportSearchPath? searchPath)
+        {
+            var fileName = MapName(libraryName);
+            if (fileName == null || !OperatingSystem.IsWindows())
+                return IntPtr.Zero;
+
+            foreach (var local in new[] {
+                Path.Combine(AppContext.BaseDirectory, fileName),
+                Path.Combine(AppContext.BaseDirectory, "runtimes", "win-x64", "native", fileName) })
+            {
+                if (File.Exists(local) && NativeLibrary.TryLoad(local, out var handle))
+                    return handle;
+            }
+
+            if (NativeLibrary.TryLoad(libraryName, assembly, searchPath, out var fallback))
+                return fallback;
+
+            return LoadFromPrefix(fileName);
+        }
+
+#pragma warning disable CA2255 // ModuleInitializer in a library is intentional here.
+        [ModuleInitializer]
+        internal static void Register()
+        {
+            try
+            {
+                NativeLibrary.SetDllImportResolver(typeof(Msys2Native).Assembly, Resolve);
+            }
+            catch (InvalidOperationException)
+            {
+                // A resolver was already registered for this assembly.
+            }
+        }
+#pragma warning restore CA2255
+    }
+}
