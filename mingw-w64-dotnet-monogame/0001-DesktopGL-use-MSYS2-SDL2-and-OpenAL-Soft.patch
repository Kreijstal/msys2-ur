diff --git a/MonoGame.Framework/MonoGame.Framework.DesktopGL.targets b/MonoGame.Framework/MonoGame.Framework.DesktopGL.targets
index 7e350cb..4a572bb 100644
--- a/MonoGame.Framework/MonoGame.Framework.DesktopGL.targets
+++ b/MonoGame.Framework/MonoGame.Framework.DesktopGL.targets
@@ -4,4 +4,24 @@
     <MonoGamePlatform>DesktopGL</MonoGamePlatform>
   </PropertyGroup>
 
+  <!--
+    MSYS2 packaging: SDL2 and OpenAL Soft are the DLLs of the MSYS2 SDL2 and
+    openal packages, taken from the prefix of the .NET SDK doing the build
+    ($MINGW_PREFIX/lib/dotnet -> $MINGW_PREFIX/bin) and copied next to the
+    game. Set MonoGameCopyNativeLibraries=false to ship them yourself, or
+    MonoGameNativeLibraryDir to take them from somewhere else.
+  -->
+  <PropertyGroup>
+    <MonoGameNativeLibraryDir Condition="'$(MonoGameNativeLibraryDir)' == ''">$([MSBuild]::NormalizeDirectory('$(NetCoreRoot)', '..', '..', 'bin'))</MonoGameNativeLibraryDir>
+  </PropertyGroup>
+
+  <ItemGroup Condition="'$(MonoGameCopyNativeLibraries)' != 'false' And '$(OS)' == 'Windows_NT'">
+    <MonoGameNativeLibrary Include="@MSYS2_NATIVE_DLLS@" />
+    <None Include="@(MonoGameNativeLibrary->'$(MonoGameNativeLibraryDir)%(Identity)')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
+  </ItemGroup>
+
+  <Target Name="_MonoGameCheckNativeLibraries" BeforeTargets="Build" Condition="'$(MonoGameCopyNativeLibraries)' != 'false' And '$(OS)' == 'Windows_NT'">
+    <Error Condition="!Exists('$(MonoGameNativeLibraryDir)%(MonoGameNativeLibrary.Identity)')" Text="MonoGame: %(MonoGameNativeLibrary.Identity) not found in $(MonoGameNativeLibraryDir) (install the MSYS2 SDL2 and openal packages, or set MonoGameNativeLibraryDir / MonoGameCopyNativeLibraries=false)." />
+  </Target>
+
 </Project>
