diff --git a/Tools/MonoGame.Effect.Compiler/Effect/ExternalTools.Msys2.cs b/Tools/MonoGame.Effect.Compiler/Effect/ExternalTools.Msys2.cs
new file mode 100644
index 0000000..4e5265f
--- /dev/null
+++ b/Tools/MonoGame.Effect.Compiler/Effect/ExternalTools.Msys2.cs
@@ -0,0 +1,121 @@
+// MonoGame - Copyright (C) MonoGame Foundation, Inc
+// This file is subject to the terms and conditions defined in
+// file 'LICENSE.txt', which is part of this source code package.
+
+// MSYS2 packaging: replaces the MonoGame.Tool.* NuGet packages (which carry
+// prebuilt crunch/basisu/ffmpeg/ffprobe/dxc executables) with the same
+// Run() API launching executables from the MSYS2 prefix of the .NET runtime
+// ($MINGW_PREFIX/bin), then PATH. A tool that is not installed fails with a
+// clear message; crunch, basisu and dxc have no MSYS2 package, so the
+// content features that need them (DXT3/ETC texture compression, mobile
+// texture formats, DirectX 12/Vulkan shader profiles) are unavailable.
+
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Text;
+
+namespace MonoGame.Tool
+{
+    internal static class Msys2Tool
+    {
+        public static string? Find(string exe)
+        {
+            var prefix = MonoGame.Msys2.Msys2Native.Prefix;
+            if (prefix != null)
+            {
+                var candidate = Path.Combine(prefix, "bin", exe + ".exe");
+                if (File.Exists(candidate))
+                    return candidate;
+            }
+
+            var path = Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
+            foreach (var dir in path.Split(Path.PathSeparator, StringSplitOptions.RemoveEmptyEntries))
+            {
+                try
+                {
+                    var candidate = Path.Combine(dir.Trim('"'), exe + ".exe");
+                    if (File.Exists(candidate))
+                        return candidate;
+                }
+                catch (ArgumentException)
+                {
+                }
+            }
+            return null;
+        }
+
+        public static int Run(string exe, string what, string args, out string stdout, out string stderr, string? stdin, string? workingDirectory)
+        {
+            var path = Find(exe);
+            if (path == null)
+            {
+                stdout = string.Empty;
+                stderr = $"{exe}.exe ({what}) was not found in the MSYS2 prefix or on PATH. " +
+                         "This MonoGame build does not ship prebuilt tool binaries; install the tool to use this content feature.";
+                return -1;
+            }
+
+            var info = new ProcessStartInfo(path, args)
+            {
+                UseShellExecute = false,
+                CreateNoWindow = true,
+                RedirectStandardOutput = true,
+                RedirectStandardError = true,
+                RedirectStandardInput = stdin != null,
+                StandardOutputEncoding = Encoding.UTF8,
+                StandardErrorEncoding = Encoding.UTF8,
+            };
+            if (!string.IsNullOrEmpty(workingDirectory))
+                info.WorkingDirectory = workingDirectory;
+
+            var outBuf = new StringBuilder();
+            var errBuf = new StringBuilder();
+            using var process = new Process { StartInfo = info };
+            process.OutputDataReceived += (_, e) => { if (e.Data != null) lock (outBuf) outBuf.AppendLine(e.Data); };
+            process.ErrorDataReceived += (_, e) => { if (e.Data != null) lock (errBuf) errBuf.AppendLine(e.Data); };
+            process.Start();
+            process.BeginOutputReadLine();
+            process.BeginErrorReadLine();
+            if (stdin != null)
+            {
+                process.StandardInput.Write(stdin);
+                process.StandardInput.Close();
+            }
+            process.WaitForExit();
+            stdout = outBuf.ToString();
+            stderr = errBuf.ToString();
