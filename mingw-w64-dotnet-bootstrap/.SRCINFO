pkgname = mingw-w64-clang-x86_64-dotnet-host
	pkgdesc = .NET 8 native host and hostfxr, built from source with MinGW (mingw-w64)
	depends = mingw-w64-clang-x86_64-cc-libs

pkgname = mingw-w64-clang-x86_64-dotnet-runtime
	pkgdesc = CoreCLR 8.0.0 and Microsoft.NETCore.App, built from source (mingw-w64)
	depends = mingw-w64-clang-x86_64-dotnet-host=8.0.131
	depends = mingw-w64-clang-x86_64-cc-libs
	depends = mingw-w64-clang-x86_64-zlib
	depends = mingw-w64-clang-x86_64-brotli

pkgname = mingw-w64-clang-x86_64-dotnet-targeting-pack
	pkgdesc = Source-built .NET 8 reference assemblies (mingw-w64)

pkgname = mingw-w64-clang-x86_64-dotnet-sdk
	pkgdesc = Self-hosted .NET SDK 8.0.131 built from the Mono seed, without Microsoft binaries (mingw-w64)
	depends = mingw-w64-clang-x86_64-dotnet-runtime=8.0.131
	depends = mingw-w64-clang-x86_64-dotnet-targeting-pack=8.0.131
	optdepends = mingw-w64-clang-x86_64-dotnet-sdk-netanalyzers: source-built implicit .NET analyzers and compiler selection

pkgname = mingw-w64-clang-x86_64-dotnet-bootstrap-tools
	pkgdesc = Source-built Roslyn generations, MSBuild/NuGet and net472 bootstrap dependencies (mingw-w64)
	depends = mingw-w64-ucrt-x86_64-mono
	optdepends = mingw-w64-clang-x86_64-dotnet-runtime=8.0.131: run the retained net8 Roslyn tool builds

pkgname = mingw-w64-clang-x86_64-dotnet-runtime-mono
	pkgdesc = Source-built Mono flavor of the .NET 8 shared framework (mingw-w64)
	depends = mingw-w64-clang-x86_64-cc-libs
	depends = mingw-w64-clang-x86_64-zlib
	depends = mingw-w64-clang-x86_64-brotli

pkgname = mingw-w64-clang-x86_64-dotnet-crossgen2
	pkgdesc = Source-built ReadyToRun compiler crossgen2 8.0.0 (mingw-w64)
	depends = mingw-w64-clang-x86_64-dotnet-runtime=8.0.131
	depends = mingw-w64-clang-x86_64-cc-libs

pkgname = mingw-w64-clang-x86_64-dotnet-ilasm
	pkgdesc = Source-built CoreCLR IL assembler (mingw-w64)
	depends = mingw-w64-clang-x86_64-cc-libs

pkgname = mingw-w64-clang-x86_64-dotnet-host-devel
	pkgdesc = Native .NET hosting headers, nethost and hostfxr import/static libraries (mingw-w64)
	depends = mingw-w64-clang-x86_64-dotnet-host=8.0.131

pkgname = mingw-w64-clang-x86_64-dotnet-mono-devel
