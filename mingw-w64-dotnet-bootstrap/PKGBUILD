_tree() { printf '%s/dotnet-mingw-bootstrap-%s' "${srcdir}" "${_bootstrap_commit}"; }
_root() {
  local saved
  if [[ -f ${srcdir}/.m612-root ]] && saved=$(cat "${srcdir}/.m612-root") && [[ -d ${saved} ]]; then
    printf '%s' "${saved}"
  else printf '%s/m612' "${srcdir}"; fi
}
_short_root() {
  [[ -f ${srcdir}/.m612-root && -d $(cat "${srcdir}/.m612-root") ]] && return 0
  local short
  short=$(mktemp -d /tmp/dnb.XXXXXX)
  "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/short-build-root.py" \
    "$(cygpath -m "${srcdir}/m612")" "$(cygpath -m "${short}/m")"
  printf '%s' "${short}/m" > "${srcdir}/.m612-root"
}
_sdk() { printf '%s/dotnet-sdk-%s-stage2' "$(_root)" "${pkgver}"; }
_dotnet_env() {
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
  export DOTNET_MULTILEVEL_LOOKUP=0 DOTNET_CLI_HOME="$(cygpath -m "${srcdir}/check-home")"
  export NUGET_PACKAGES="$(cygpath -m "${srcdir}/check-packages")"
  export HTTP_PROXY=http://127.0.0.1:9 HTTPS_PROXY=http://127.0.0.1:9 NO_PROXY=
}

# ---- UCRT64: the CLANG64 packages with GCC-built native files ----
_rehosting() { [[ ${MINGW_PACKAGE_PREFIX} == *-ucrt-* ]]; }
_rehost_env() {
  printf '%s\n' "M612=$(_root)" MSYSTEM=UCRT64 "JOBS=${DOTNET_BUILD_JOBS:-4}" "REACTOS_SRC=${srcdir}/reactos"
}
_rehost_prepare() {
  tar -xzf "${srcdir}/dotnet-mingw-bootstrap-${_bootstrap_commit}.tar.gz" -C "${srcdir}"
  mkdir -p "$(_root)/src"
  cp "${srcdir}/runtime-8.0.0.tar.gz" "$(_root)/src/"
  install -Dm644 "${srcdir}/reactos-${_reactos_commit}-gcc_plugin_seh.cpp" \
    "${srcdir}/reactos/sdk/tools/gcc_plugin_seh/main.cpp"
  install -Dm644 "${srcdir}/reactos-${_reactos_commit}-pseh2_64.h" \
    "${srcdir}/reactos/sdk/lib/pseh/include/pseh/pseh2_64.h"
  local part
  rm -rf "${srcdir}/rehost"
  for part in "${_rehost_parts[@]}"; do
    mkdir -p "${srcdir}/rehost/${part}"
    tar --zstd -xf "${srcdir}/mingw-w64-clang-x86_64-dotnet-${part}-${_clang_pkgver}-any.pkg.tar.zst" \
      -C "${srcdir}/rehost/${part}" --exclude=.PKGINFO --exclude=.BUILDINFO --exclude=.MTREE
  done
}
_rehost_build() {
  _short_root
  local m bs
  m=$(_root); bs=$(_tree)/bootstrap/m612
  local -a e
  mapfile -t e < <(_rehost_env)
  env "${e[@]}" SDKROOT="${m}/corehost-sdkroot" bash "${bs}/corehost.sh" prep configure build install
  env "${e[@]}" bash "${bs}/coreclr.sh" prep configure build install
  PATH="${MINGW_PREFIX}/bin:/usr/bin" \
    "${MINGW_PREFIX}/bin/ninja" -C "${m}/build/coreclr-8.0.0-ucrt64/cmake" -j"${DOTNET_BUILD_JOBS:-4}" ilasm
  env "${e[@]}" NATIVE_MSYSTEM=UCRT64 CROSSGEN2_NATIVE=1 bash "${bs}/crossgen2.sh" native
  env "${e[@]}" bash "${bs}/mono-runtime.sh" prep nativelibs
  _launcher dotnet ../lib/dotnet/dotnet.exe
  _launcher crossgen2 ../lib/dotnet/dotnet.exe ../lib/dotnet/tools/crossgen2/crossgen2.dll

  # every native file of the CLANG64 packages, built by GCC (debug info stripped)
  local o="${m}/corehost-8.0.0-ucrt64/corehost" c="${m}/coreclr-8.0.0-ucrt64"
  local cb="${m}/build/coreclr-8.0.0-ucrt64/cmake" g="${srcdir}/gcc-natives" n
  rm -rf "${g}"; mkdir -p "${g}"
  for n in apphost.exe comhost.dll nethost.dll nethost.dll.a libnethost.a dotnet.exe \
           hostfxr.dll hostfxr.dll.a libhostfxr.a hostpolicy.dll; do cp "${o}/${n}" "${g}/"; done
  for n in coreclr.dll clrjit.dll mscorrc.dll; do cp "${c}/${n}" "${g}/"; done
  cp "${m}/mono-8.0.0-ucrt64/libs/System.IO.Compression.Native.dll" "${cb}/jit/clrjit_win_x64_x64.dll" \
     "${cb}/tools/aot/jitinterface/jitinterface_x64.dll" "${cb}/ilasm/ilasm.exe" "${g}/"
  strip --strip-debug "${g}"/*.exe "${g}"/*.dll
  local -a r=()
  for n in apphost.exe comhost.dll nethost.dll nethost.dll.a libnethost.a hostfxr.dll hostfxr.dll.a \
           libhostfxr.a hostpolicy.dll coreclr.dll clrjit.dll mscorrc.dll System.IO.Compression.Native.dll \
           clrjit_win_x64_x64.dll jitinterface_x64.dll; do r+=("${n}=${g}/${n}"); done
  r+=("lib/dotnet/dotnet.exe=${g}/dotnet.exe" "bin/dotnet.exe=${srcdir}/dotnet.exe"
      "bin/crossgen2.exe=${srcdir}/crossgen2.exe" "bin/ilasm-dotnet.exe=${g}/ilasm.exe")
  "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/rehost-natives.py" "${srcdir}"/rehost/*/clang64 -- "${r[@]}"
}
_rehost_install() { # _rehost_install <part> <destdir>
  local lic="$2${MINGW_PREFIX}/share/licenses"
  mkdir -p "$2${MINGW_PREFIX}"
  cp -a "${srcdir}/rehost/$1/clang64/." "$2${MINGW_PREFIX}/"
  mv "${lic}/mingw-w64-clang-x86_64-dotnet-$1" "${lic}/${MINGW_PACKAGE_PREFIX}-dotnet-$1"
}
_rehost_check() {
  local -a e
  mapfile -t e < <(_rehost_env)
  # the EHa self-tests of the GCC SEH plugin with the runtime's EH shim
  env "${e[@]}" bash "$(_tree)/bootstrap/m612/coreclr.sh" test
  "${MINGW_PREFIX}/bin/python.exe" "$(_tree)/packaging/check-launcher.py" \
    "$(cygpath -m "$(_tree)/packaging/launcher.c")" "$(cygpath -m "${MINGW_PREFIX}/bin/cc.exe")" "$(cygpath -m "${srcdir}")"

  local image="${srcdir}/package check" part
  rm -rf "${image}"
  for part in "${_rehost_parts[@]}"; do _rehost_install "${part}" "${image}"; done
  (
    _dotnet_env
    local p="${image}${MINGW_PREFIX}" project="${srcdir}/check project" eh="${srcdir}/check ehstress"
    local cli="${p}/bin/dotnet.exe" fx="${p}/lib/dotnet/shared/Microsoft.NETCore.App/8.0.0" out
    "${cli}" --info
    "${cli}" --list-sdks | tr -d '\r' > "${srcdir}/check-sdks.txt"
    grep -q '^8.0.131 ' "${srcdir}/check-sdks.txt"
    rm -rf "${project}" "${eh}" "${srcdir}/check-r2r"
    mkdir -p "${project}"
    printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "${project}/NuGet.config"
    "${cli}" new console --no-restore -o "${project}" --force
    "${cli}" build "${project}" --configfile "${project}/NuGet.config" -p:UseSharedCompilation=false -p:NuGetAudit=false
    out="${project}/bin/Debug/net8.0/$(basename "${project}")"
    "${cli}" "${out}.dll" | tr -d '\r' > "${srcdir}/check-console.txt"
    grep -qx 'Hello, World!' "${srcdir}/check-console.txt"
    (
      MINGW_PREFIX=${p}
      unset DOTNET_ROOT DOTNET_ROOT_X64
      . "${p}/etc/profile.d/dotnet.sh"
      "${out}.exe" | tr -d '\r' > "${srcdir}/check-apphost.txt"
    )
    grep -qx 'Hello, World!' "${srcdir}/check-apphost.txt"
    # hardware faults, filters, finally, threads and the GC on the GCC CoreCLR,
    # as IL and as ReadyToRun code compiled by crossgen2 with the GCC JIT
    cp -r "$(_tree)/bootstrap/m612/tests/ehstress" "${eh}"
    cp "${project}/NuGet.config" "${eh}/"
    "${cli}" build "${eh}" --configfile "${eh}/NuGet.config" -p:UseSharedCompilation=false -p:NuGetAudit=false
    "${cli}" "${eh}/bin/Debug/net8.0/ehstress.dll" | tr -d '\r' | tee "${srcdir}/check-ehstress.txt"
    grep -qx 'EHSTRESS OK' "${srcdir}/check-ehstress.txt"
    mkdir -p "${srcdir}/check-r2r"
    "${p}/bin/crossgen2.exe" "$(cygpath -m "${eh}/bin/Debug/net8.0/ehstress.dll")" \
      -o "$(cygpath -m "${srcdir}/check-r2r/ehstress.dll")" -r "$(cygpath -m "${fx}")/*.dll" \
      --targetos windows --targetarch x64 -O
    cp "${eh}/bin/Debug/net8.0/ehstress.runtimeconfig.json" "${srcdir}/check-r2r/"
    "${cli}" "${srcdir}/check-r2r/ehstress.dll" | tr -d '\r' | tee "${srcdir}/check-ehstress-r2r.txt"
    grep -qx 'EHSTRESS OK' "${srcdir}/check-ehstress-r2r.txt"
    "${p}/bin/ilasm-dotnet.exe" -? > /dev/null
    "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/check-native-devel.py" \
      "$(cygpath -m "${image}")" "$(cygpath -m "${MINGW_PREFIX}/bin/cc.exe")" "${MINGW_PREFIX#/}"
  )
}

prepare() {
  if _rehosting; then _rehost_prepare; return; fi
  [[ ${MSYSTEM} == CLANG64 ]] || { error 'The runtime port currently requires CLANG64'; return 1; }
  tar -xzf "${srcdir}/dotnet-mingw-bootstrap-${_bootstrap_commit}.tar.gz" -C "${srcdir}"
  mkdir -p "$(_root)/src" "$(_root)/s12/src"
  local input name dest
  for input in "${source[@]:1:28}"; do
    name=${input%%::*}; dest="$(_root)/src"
    case ${name} in
      arcade-*|sbrp-*|xliff-tasks-*|xdt-9a1c3e1b*) dest="$(_root)/s12/src" ;;
    esac
    cp "${srcdir}/${name}" "${dest}/${name}"
  done
}

_launcher() {
  local name=$1 target=$2 tool=${3:-}
  printf '#define TARGET_RELATIVE L"%s"\n' "${target}" > "${srcdir}/launcher-${name}.h"
  if [[ -n ${tool} ]]; then
    printf '#define TOOL_RELATIVE L"%s"\n' "${tool}" >> "${srcdir}/launcher-${name}.h"
  fi
  "${MINGW_PREFIX}/bin/cc" -std=c11 -O2 -Wall -Wextra -Werror -municode \
    -include "${srcdir}/launcher-${name}.h" "$(_tree)/packaging/launcher.c" -o "${srcdir}/${name}.exe"
}

build() {
  if _rehosting; then _rehost_build; return; fi
  _short_root
  # Only source archives enter this private build root. Mono 6.12 from UCRT64
  # is the one trusted managed seed; native builds switch to CLANG64 themselves.
  env M612="$(_root)" MSYSTEM=UCRT64 JOBS="${DOTNET_BUILD_JOBS:-4}" \
    bash "$(_tree)/bootstrap/m612/chain.sh" "${DOTNET_BOOTSTRAP_START:-1}" 44
  # The hand-run bootstrap built ilasm outside chain.sh. Close that missing edge
  # before S12 assembles its reference packages.
  PATH="${MINGW_PREFIX}/bin:/usr/bin" \
    "${MINGW_PREFIX}/bin/ninja" -C "$(_root)/build/coreclr-8.0.0/cmake" -j"${DOTNET_BUILD_JOBS:-4}" ilasm
  env M612="$(_root)" MSYSTEM=UCRT64 JOBS="${DOTNET_BUILD_JOBS:-4}" \
    bash "$(_tree)/bootstrap/m612/chain.sh" 45 46
  _launcher dotnet ../lib/dotnet/dotnet.exe
  _launcher dotnet-mono ../lib/dotnet-mono/dotnet.exe
  _launcher crossgen2 ../lib/dotnet/dotnet.exe ../lib/dotnet/tools/crossgen2/crossgen2.dll
  _launcher csc-bootstrap ../../ucrt64/bin/mono.exe ../lib/dotnet-bootstrap/roslyn-5.0.0/csc.exe
  _launcher msbuild-bootstrap ../../ucrt64/bin/mono.exe ../lib/dotnet-bootstrap/msbuild-17.8.49/tools/MSBuild.exe
}

_copy() { # copy a required build output, keeping relative directory content
  [[ -e $1 ]] || { error "Missing source-built output: $1"; return 1; }
  mkdir -p "$(dirname "$2")"
  rm -rf -- "$2"
  cp -a "$1" "$2"
}
_license() {
  local component=$1 text=$2
  install -Dm644 "${text}" "${pkgdir}${MINGW_PREFIX}/share/licenses/${pkgname}/${component}.txt"
}
_component_licenses() {
  local tree name
  for tree in "$(_root)"/src/*/ "$(_root)"/build/*/ "$(_root)"/s12/src/*/; do
    for name in LICENSE LICENSE.txt LICENSE.md License.txt COPYING NOTICE THIRD-PARTY-NOTICES.TXT; do
      [[ -f ${tree}/${name} ]] || continue
      _license "$(basename "${tree}")-${name,,}" "${tree}/${name}"
    done
  done
}
_host() {
  _copy "$(_sdk)/dotnet.exe" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/dotnet.exe"
  _copy "$(_sdk)/host" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/host"
  install -Dm755 "${srcdir}/dotnet.exe" "${pkgdir}${MINGW_PREFIX}/bin/dotnet.exe"
  install -Dm644 "${srcdir}/dotnet.sh" "${pkgdir}${MINGW_PREFIX}/etc/profile.d/dotnet.sh"
}
_runtime() { _copy "$(_sdk)/shared" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/shared"; }
_targeting() {
  _copy "$(_sdk)/packs/Microsoft.NETCore.App.Ref" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/packs/Microsoft.NETCore.App.Ref"
  "${MINGW_PREFIX}/bin/python.exe" "$(cygpath -m "${srcdir}/normalize-targeting-metadata.py")" \
    "$(cygpath -m "${pkgdir}${MINGW_PREFIX}/lib/dotnet/packs/Microsoft.NETCore.App.Ref")" \
    "$(cygpath -m "$(_sdk)/shared/Microsoft.NETCore.App/8.0.0")"
}
_sdkfiles() {
  local part
  for part in sdk templates library-packs; do
    _copy "$(_sdk)/${part}" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/${part}"
  done
  for part in Microsoft.NETCore.App.Host.win-x64 Microsoft.NETCore.App.Runtime.win-x64; do
    _copy "$(_sdk)/packs/${part}" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/packs/${part}"
  done
  rm -f "${pkgdir}${MINGW_PREFIX}/lib/dotnet/sdk/${pkgver}/.m612-stage"
  "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/install-net-analyzer-imports.py" \
    "$(cygpath -m "${pkgdir}${MINGW_PREFIX}/lib/dotnet/sdk/${pkgver}")"
  # Include the upstream SDK notices that the bootstrap layout did not copy.
  _license sdk "$(_root)/build/sdk-${pkgver}/LICENSE.TXT"
  _component_licenses
  _license launcher "$(_tree)/packaging/LICENSE.launcher"
}
_bootstrap_tools() {
  local part
  for part in "$(_root)"/roslyn-*/ "$(_root)/msbuild-17.8.49" "$(_root)/pkgs"; do
    _copy "${part%/}" "${pkgdir}${MINGW_PREFIX}/lib/dotnet-bootstrap/$(basename "${part%/}")"
  done
  "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/relocate-bootstrap-tools.py" "$(cygpath -m "${pkgdir}${MINGW_PREFIX}/lib/dotnet-bootstrap")"
  install -Dm755 "${srcdir}/csc-bootstrap.exe" "${pkgdir}${MINGW_PREFIX}/bin/csc-bootstrap.exe"
  install -Dm755 "${srcdir}/msbuild-bootstrap.exe" "${pkgdir}${MINGW_PREFIX}/bin/msbuild-bootstrap.exe"
}
_mono_runtime() {
  local base="$(_root)/dotnet-sdk-${pkgver}-net8" part
  for part in dotnet.exe host shared; do
    _copy "${base}/${part}" "${pkgdir}${MINGW_PREFIX}/lib/dotnet-mono/${part}"
  done
  install -Dm755 "${srcdir}/dotnet-mono.exe" "${pkgdir}${MINGW_PREFIX}/bin/dotnet-mono.exe"
}
_crossgen() {
  _copy "$(_root)/crossgen2-8.0.0" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/tools/crossgen2"
  install -Dm755 "${srcdir}/crossgen2.exe" "${pkgdir}${MINGW_PREFIX}/bin/crossgen2.exe"
}
_ilasm() {
  install -Dm755 "$(_root)/build/coreclr-8.0.0/cmake/ilasm/ilasm.exe" "${pkgdir}${MINGW_PREFIX}/bin/ilasm-dotnet.exe"
}

_host_devel() {
  local native="$(_root)/corehost-8.0.0/corehost" file
  for file in nethost.h hostfxr.h coreclr_delegates.h; do
    install -Dm644 "${native}/${file}" "${pkgdir}${MINGW_PREFIX}/include/dotnet/${file}"
  done
  for file in nethost.dll nethost.dll.a libnethost.a hostfxr.dll hostfxr.dll.a libhostfxr.a; do
    install -Dm644 "${native}/${file}" "${pkgdir}${MINGW_PREFIX}/lib/dotnet/hosting/${file}"
  done
}
_mono_devel() {
  local native="$(_root)/mono-8.0.0" file
  _copy "${native}/include" "${pkgdir}${MINGW_PREFIX}/lib/dotnet-mono/embedding/include"
  _copy "${native}/lib" "${pkgdir}${MINGW_PREFIX}/lib/dotnet-mono/embedding/lib"
  install -Dm755 "${native}/bin/mono-sgen.exe" "${pkgdir}${MINGW_PREFIX}/lib/dotnet-mono/embedding/bin/mono-sgen.exe"
  for file in "${native}/libs"/*.a; do
    install -Dm644 "${file}" "${pkgdir}${MINGW_PREFIX}/lib/dotnet-mono/embedding/lib/$(basename "${file}")"
  done
}

check() {
  if _rehosting; then _rehost_check; return; fi
  "${MINGW_PREFIX}/bin/python.exe" "$(_tree)/packaging/check-launcher.py" \
    "$(cygpath -m "$(_tree)/packaging/launcher.c")" "$(cygpath -m "${MINGW_PREFIX}/bin/cc.exe")" "$(cygpath -m "${srcdir}")"

  # Test the same install functions used by package(), in a moved tree whose
  # path contains spaces. The native bin launcher must find the adjacent root.
  local image="${srcdir}/package check" part
  (
    pkgdir=${image}
    for part in _host _runtime _targeting _sdkfiles _crossgen _ilasm _bootstrap_tools _mono_runtime _host_devel _mono_devel; do "${part}"; done
    _dotnet_env
    local cli="${image}${MINGW_PREFIX}/bin/dotnet.exe" project="${srcdir}/check project"
    "${cli}" --info
    "${cli}" --list-sdks | tr -d '\r' > "${srcdir}/check-sdks.txt"
    grep -q '^8.0.131 ' "${srcdir}/check-sdks.txt"
    mkdir -p "${project}"
    printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "${project}/NuGet.config"
    "${cli}" new console --no-restore -o "${project}" --force
    "${cli}" build "${project}" --configfile "${project}/NuGet.config" -p:UseSharedCompilation=false -p:NuGetAudit=false
    "${cli}" "${project}/bin/Debug/net8.0/$(basename "${project}").dll" | tr -d '\r' > "${srcdir}/check-console.txt"
    grep -qx 'Hello, World!' "${srcdir}/check-console.txt"
    (
      MINGW_PREFIX="${image}${MINGW_PREFIX}"
      unset DOTNET_ROOT DOTNET_ROOT_X64
      . "${MINGW_PREFIX}/etc/profile.d/dotnet.sh"
      "${project}/bin/Debug/net8.0/$(basename "${project}").exe" | tr -d '\r' > "${srcdir}/check-apphost.txt"
    )
    grep -qx 'Hello, World!' "${srcdir}/check-apphost.txt"
    "${image}${MINGW_PREFIX}/bin/dotnet-mono.exe" "${project}/bin/Debug/net8.0/$(basename "${project}").dll" | tr -d '\r' > "${srcdir}/check-mono-console.txt"
    grep -qx 'Hello, World!' "${srcdir}/check-mono-console.txt"
    "${image}${MINGW_PREFIX}/bin/crossgen2.exe" --help > /dev/null
    "${image}${MINGW_PREFIX}/bin/ilasm-dotnet.exe" -? > /dev/null
    "${image}${MINGW_PREFIX}/lib/dotnet-mono/embedding/bin/mono-sgen.exe" --version
    "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/check-native-devel.py" \
      "$(cygpath -m "${image}")" "$(cygpath -m "${MINGW_PREFIX}/bin/cc.exe")"
    "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/check-bootstrap-tools.py" \
      "$(cygpath -m "${image}")" "$(cygpath -m "$(_tree)/bootstrap/m612/tests/oldstyle")"
  )
}

package_mingw-w64-clang-x86_64-dotnet-host() {
  pkgdesc='.NET 8 native host and hostfxr, built from source with MinGW (mingw-w64)'
  depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
