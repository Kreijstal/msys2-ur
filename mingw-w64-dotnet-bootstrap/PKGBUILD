if [[ ${MINGW_PACKAGE_PREFIX} == *-ucrt-* ]]; then
  # UCRT64 rehosts the CLANG64 build of this recipe: its managed IL does not
  # depend on the C runtime or the compiler and is taken from the CLANG64
  # packages; every native file is rebuilt from the same patched runtime
  # 8.0.0 tree with GCC/libstdc++ (SEH from ReactOS's PSEH and gcc_plugin_seh).
  # The Mono flavor and the Mono-hosted bootstrap tools stay CLANG64-only.
  _rehost_parts=(host runtime targeting-pack sdk crossgen2 ilasm host-devel)
  pkgname=("${_rehost_parts[@]/#/${MINGW_PACKAGE_PREFIX}-dotnet-}")
  _reactos_commit=e417d7d45544bb292f1df4181d0ce5f0014ae1b4
  _clang_release=https://github.com/Kreijstal/msys2-ur/releases/download/x11-shared-20260731
  _clang_pkgver=${pkgver}-${pkgrel}
  makedepends=('mingw-w64-ucrt-x86_64-mono>=6.12.0.199'
               "${MINGW_PACKAGE_PREFIX}-cc"
               "${MINGW_PACKAGE_PREFIX}-gcc-plugin"
               "${MINGW_PACKAGE_PREFIX}-cmake"
               "${MINGW_PACKAGE_PREFIX}-ninja"
               "${MINGW_PACKAGE_PREFIX}-python"
               "${MINGW_PACKAGE_PREFIX}-uasm"
               "${MINGW_PACKAGE_PREFIX}-zlib"
               "${MINGW_PACKAGE_PREFIX}-brotli"
               'git' 'patch' 'zstd')
  source=("dotnet-mingw-bootstrap-${_bootstrap_commit}.tar.gz::https://codeload.github.com/Kreijstal/dotnet-mingw-bootstrap/tar.gz/${_bootstrap_commit}"
