# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=commons-cli
pkgbase=mingw-w64-java-commons-cli
pkgname="${MINGW_PACKAGE_PREFIX}-java-commons-cli"
pkgver=1.11.0
pkgrel=1
pkgdesc="Apache Commons CLI command line parser, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://commons.apache.org/proper/commons-cli/'
msys2_repository_url='https://github.com/apache/commons-cli'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("${_realname}-${pkgver}-src.tar.gz::https://archive.apache.org/dist/commons/cli/source/commons-cli-${pkgver}-src.tar.gz")
sha256sums=('b2bb70c9e1103590e4371319bd404e96f74f5b14bd8c4b023498326608d2e96e')

_src=commons-cli-${pkgver}-src

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  jb_module commons-cli:commons-cli:${pkgver} src/main/java -u pom.xml \
    -m 'Automatic-Module-Name: org.apache.commons.cli'
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  # upstream tests need JUnit 5 (Jupiter) and mocking libraries, which are not packaged
  jb_loadcheck commons-cli:commons-cli
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install commons-cli:commons-cli
  install -Dm644 "${_src}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-commons-cli/LICENSE.txt"
  install -Dm644 "${_src}/NOTICE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-commons-cli/NOTICE.txt"
}
