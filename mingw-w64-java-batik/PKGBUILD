check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.apache.xmlgraphics:batik-shared-resources org.apache.xmlgraphics:batik-constants
  jb_loadcheck --with org.apache.xmlgraphics:batik-shared-resources org.apache.xmlgraphics:batik-i18n
  jb_loadcheck --with org.apache.xmlgraphics:batik-shared-resources org.apache.xmlgraphics:batik-ext
  jb_loadcheck --with org.apache.xmlgraphics:batik-constants --with org.apache.xmlgraphics:batik-i18n --with org.apache.xmlgraphics:batik-shared-resources org.apache.xmlgraphics:batik-util
  jb_loadcheck --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util org.apache.xmlgraphics:batik-xml
  jb_loadcheck --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util --with org.apache.xmlgraphics:xmlgraphics-commons org.apache.xmlgraphics:batik-awt-util
  jb_loadcheck --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util --with org.apache.xmlgraphics:xmlgraphics-commons --with xml-apis:xml-apis-ext org.apache.xmlgraphics:batik-css
  jb_loadcheck --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util org.apache.xmlgraphics:batik-svggen
  jb_loadcheck --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util --with org.apache.xmlgraphics:batik-xml --with xml-apis:xml-apis-ext org.apache.xmlgraphics:batik-parser
  jb_loadcheck --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util org.apache.xmlgraphics:batik-gvt
  jb_loadcheck --with org.apache.xmlgraphics:batik-css --with org.apache.xmlgraphics:batik-ext --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util --with org.apache.xmlgraphics:batik-xml --with xml-apis:xml-apis --with xml-apis:xml-apis-ext org.apache.xmlgraphics:batik-dom
  jb_loadcheck --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-css --with org.apache.xmlgraphics:batik-dom --with org.apache.xmlgraphics:batik-ext --with org.apache.xmlgraphics:batik-parser --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util --with xml-apis:xml-apis-ext org.apache.xmlgraphics:batik-svg-dom
  jb_loadcheck --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-css --with org.apache.xmlgraphics:batik-dom --with org.apache.xmlgraphics:batik-ext --with org.apache.xmlgraphics:batik-parser --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-svg-dom --with org.apache.xmlgraphics:batik-util --with xml-apis:xml-apis-ext org.apache.xmlgraphics:batik-anim
  jb_loadcheck --with org.apache.xmlgraphics:batik-anim --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-util --with org.mozilla:rhino org.apache.xmlgraphics:batik-script
  jb_loadcheck --with org.apache.xmlgraphics:batik-anim --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-css --with org.apache.xmlgraphics:batik-dom --with org.apache.xmlgraphics:batik-gvt --with org.apache.xmlgraphics:batik-parser --with org.apache.xmlgraphics:batik-script --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-svg-dom --with org.apache.xmlgraphics:batik-util --with org.apache.xmlgraphics:batik-xml --with org.apache.xmlgraphics:xmlgraphics-commons --with xml-apis:xml-apis-ext --with org.mozilla:rhino org.apache.xmlgraphics:batik-bridge
  jb_loadcheck --with org.apache.xmlgraphics:batik-anim --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-bridge --with org.apache.xmlgraphics:batik-dom --with org.apache.xmlgraphics:batik-gvt --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-svggen --with org.apache.xmlgraphics:batik-util --with org.apache.xmlgraphics:batik-xml --with xml-apis:xml-apis-ext org.apache.xmlgraphics:batik-transcoder
  jb_loadcheck --with org.apache.xmlgraphics:batik-awt-util --with org.apache.xmlgraphics:batik-bridge --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-transcoder --with org.apache.xmlgraphics:batik-util org.apache.xmlgraphics:batik-codec
  jb_loadcheck --with org.apache.xmlgraphics:batik-parser --with org.apache.xmlgraphics:batik-shared-resources --with org.apache.xmlgraphics:batik-transcoder --with org.apache.xmlgraphics:batik-util --with org.apache.xmlgraphics:batik-codec org.apache.xmlgraphics:batik-svgrasterizer
  mkdir -p smoke
  cat > smoke/BatikRender.java <<'JAVA'
import java.io.*;
import org.apache.batik.transcoder.*;
import org.apache.batik.transcoder.image.PNGTranscoder;
import org.apache.batik.bridge.RhinoInterpreter;
public class BatikRender {
  public static void main(String[] args) throws Exception {
    String svg = "<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'><rect width='4' height='4' fill='#00ff00'/></svg>";
    ByteArrayOutputStream png = new ByteArrayOutputStream();
    new PNGTranscoder().transcode(new TranscoderInput(new StringReader(svg)), new TranscoderOutput(png));
    var image = javax.imageio.ImageIO.read(new ByteArrayInputStream(png.toByteArray()));
    if (image.getWidth()!=4 || image.getHeight()!=4 || (image.getRGB(1,1)&0xffffff)!=0x00ff00) throw new AssertionError("SVG rendering");
    RhinoInterpreter interpreter = new RhinoInterpreter(new java.net.URL("file:/bootstrap.svg"), new org.apache.batik.script.ImportInfo());
    try {
      if (((Number)interpreter.evaluate("6 * 7")).intValue()!=42) throw new AssertionError("SVG JavaScript");
    } finally { interpreter.dispose(); }
    System.out.println("Batik SVG-to-PNG pixels and JavaScript interpreter passed");
  }
}
JAVA
  local cp=$(jb_cp org.apache.xmlgraphics:batik-transcoder org.apache.xmlgraphics:batik-codec org.mozilla:rhino)
  javac --release 21 -d "$(jb_w smoke)" -cp "$cp" "$(jb_w smoke/BatikRender.java)"
  java -Djava.awt.headless=true -cp "$(jb_w smoke);$cp" BatikRender

}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

