prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
  # Jacl is excluded by upstream's build. Jython is an optional backend;
  # retain the JavaScript engine used by SVG while omitting these adapters.
  rm -rf upstream/batik-script/org/apache/batik/script/{jacl,jpython}
  sed -i '/^org\.apache\.batik\.script\.\(jacl\|jpython\)\./d' resources/batik-bridge/META-INF/services/org.apache.batik.script.InterpreterFactory
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.apache.xmlgraphics:batik-shared-resources:1.18 - \
    -r resources/batik-shared-resources -u batik-shared-resources-1.18.pom
  jb_module org.apache.xmlgraphics:batik-constants:1.18 upstream/batik-constants \
    -r resources/batik-constants -u batik-constants-1.18.pom -- \
    org.apache.xmlgraphics:batik-shared-resources
  jb_module org.apache.xmlgraphics:batik-i18n:1.18 upstream/batik-i18n \
    -r resources/batik-i18n -u batik-i18n-1.18.pom -- \
    org.apache.xmlgraphics:batik-shared-resources
  jb_module org.apache.xmlgraphics:batik-ext:1.18 upstream/batik-ext \
    -r resources/batik-ext -u batik-ext-1.18.pom -- \
    org.apache.xmlgraphics:batik-shared-resources
  jb_module org.apache.xmlgraphics:batik-util:1.18 upstream/batik-util \
    -r resources/batik-util -u batik-util-1.18.pom -- \
    org.apache.xmlgraphics:batik-constants org.apache.xmlgraphics:batik-i18n org.apache.xmlgraphics:batik-shared-resources
  jb_module org.apache.xmlgraphics:batik-xml:1.18 upstream/batik-xml \
    -r resources/batik-xml -u batik-xml-1.18.pom -- \
    org.apache.xmlgraphics:batik-shared-resources org.apache.xmlgraphics:batik-util
  jb_module org.apache.xmlgraphics:batik-awt-util:1.18 upstream/batik-awt-util \
    -r resources/batik-awt-util -u batik-awt-util-1.18.pom -- \
    org.apache.xmlgraphics:batik-shared-resources org.apache.xmlgraphics:batik-util org.apache.xmlgraphics:xmlgraphics-commons
  jb_module org.apache.xmlgraphics:batik-css:1.18 upstream/batik-css \
    -r resources/batik-css -u batik-css-1.18.pom -- \
    org.apache.xmlgraphics:batik-shared-resources org.apache.xmlgraphics:batik-util org.apache.xmlgraphics:xmlgraphics-commons xml-apis:xml-apis-ext
  jb_module org.apache.xmlgraphics:batik-svggen:1.18 upstream/batik-svggen \
