# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-runtime430
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.3.0
pkgrel=1
pkgdesc='Original System.Runtime4.3.0 references and complete NET462 forwarding facade'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/source-build-reference-packages'
license=('spdx:MIT' 'custom:Microsoft.NET.Library')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-legacy-ns13-contracts-bootstrap>=20261031-4"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn44=4.4.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-cecil011-bootstrap=0.11.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netframework46-contracts-bootstrap=20261031"
             "${MINGW_PACKAGE_PREFIX}-llvm-tools"
             "${MINGW_PACKAGE_PREFIX}-dotnet-legacy-extension430-bootstrap=20261031"
             "${MINGW_PACKAGE_PREFIX}-dotnet-encoding430=4.3.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-reflection430=4.3.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-io-primitives430=4.3.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-tasks430=4.3.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netcore-platforms110=1.1.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netcore-targets110=1.1.0"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
source=('sbrp-5aeee273.tar.gz::https://codeload.github.com/dotnet/source-build-reference-packages/tar.gz/5aeee2738338530a92d7f6caa2c7d5f569fed3c4'
        'roslyn-4.4.0-1ce8866c.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/1ce8866c9de4c2d67351ef6863699dee03b0804a'
        'corefx11-4d1af962.tar.gz::https://codeload.github.com/dotnet/corefx/tar.gz/4d1af962ca0fede10beb01d197367c2f90e92c97'
        'runtime430-source-1.tar.gz')
noextract=('sbrp-5aeee273.tar.gz' 'roslyn-4.4.0-1ce8866c.tar.gz' 'corefx11-4d1af962.tar.gz')
sha256sums=('2b3136fab488246d0289e622797094e7c2eb29b35f67a9a5cd1312ef3ddfca79'
            '9edb8c430576c5f5b27032afe8f79c74508b0150e03406a7a4ca6f218e03fd11'
            '1782b55a84ae89baa4fcb5c8400c3d7042c5c617a4e35ce1b0ad16952d6981b2'
            '22a147bf687779a106f9f848daca0c47ce4bff7f7fa8487956139d9ffc60955e')
_env() {
  export DOTNET_CLI_HOME=$(cygpath -am "$srcdir/cli-home")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
build() {
  _env
  local workflow="$srcdir/runtime430-workflow"
  /usr/bin/python3 "$workflow/compiler44.py" "$srcdir/roslyn-4.4.0-1ce8866c.tar.gz" "$srcdir/compiler44" > "$srcdir/compiler44.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$workflow/build.py")" "$(cygpath -am "$srcdir/sbrp-5aeee273.tar.gz")" "$(cygpath -am "$srcdir/corefx11-4d1af962.tar.gz")" "$(cygpath -am "$srcdir/prepared")" "$(cygpath -am "$MINGW_PREFIX")" "$(cygpath -am "$srcdir/compiler44/bin/Release/net8.0")" > "$srcdir/build.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$workflow/pack.py")" "$(cygpath -am "$srcdir/prepared")" "$(cygpath -am "$srcdir/archives")" "$(cygpath -am "$MINGW_PREFIX")" > "$srcdir/pack.log" 2>&1
}
check() {
  _env
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/runtime430-workflow/check.py")" "$(cygpath -am "$srcdir/archives/feed")" "$(cygpath -am "$srcdir/check")" "$(cygpath -am "$MINGW_PREFIX")" "$(cygpath -am "$srcdir/compiler44/bin/Release/net8.0")" > "$srcdir/check.log" 2>&1
}
package() {
  local workflow="$srcdir/runtime430-workflow"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  local licenses="$pkgdir$MINGW_PREFIX/share/licenses/$_realname"
  local name file
  mkdir -p "$doc" "$licenses"
  for name in System.Runtime;do
    install -Dm644 "$srcdir/archives/feed/$name.4.3.0.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${name,,}.4.3.0.nupkg"
    for file in dotnet_library_license.txt ThirdPartyNotices.txt;do
      install -m644 "$workflow/inputs/$name/data/$file" "$licenses/$name-$file"
    done
  done
  for file in check.py build-inspector.py build-forwarder-inspector.py README.md;do install -m644 "$workflow/$file" "$doc/";done
  cp -r "$workflow/inputs" "$workflow/metadata-inputs" "$doc/"
  install -m644 "$srcdir/prepared/references/SBRP-LICENSE.txt" "$licenses/SBRP-LICENSE.txt"
  install -m644 "$srcdir/prepared/references/results.json" "$doc/source-reference-build.json"
  install -m644 "$srcdir/prepared/facade/results.json" "$doc/source-facade-build.json"
  install -m644 "$srcdir/prepared/facade/Forwards.cs" "$doc/NET462-Forwards.cs"
  install -m644 "$srcdir/prepared/facade/source/LICENSE" "$licenses/CoreFX-LICENSE"
  install -m644 "$srcdir/prepared/facade/source/THIRD-PARTY-NOTICES" "$licenses/CoreFX-THIRD-PARTY-NOTICES"
  install -m644 "$srcdir/prepared/results.json" "$doc/source-build.json"
  install -m644 "$srcdir/prepared/framework-seeds/results.json" "$doc/source-framework-seeds-build.json"
  cp -r "$workflow/generated" "$doc/"
  install -m644 "$workflow/inputs/ReferenceAssemblies-LICENSE.txt" "$licenses/ReferenceAssemblies-LICENSE.txt"
  install -m644 "$workflow/inputs/SDK-LICENSE.txt" "$licenses/GenAPI-SDK-LICENSE.txt"
  install -m644 "$srcdir/archives/results.json" "$doc/source-package-build.json"
  install -m644 "$srcdir/check/results.json" "$doc/producer-check-results.json"
  install -m644 "$srcdir/compiler44/source-inputs.json" "$doc/compiler44-source-inputs.json"
}
