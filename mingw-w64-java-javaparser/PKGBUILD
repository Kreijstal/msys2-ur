# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-javaparser
pkgname=("${MINGW_PACKAGE_PREFIX}-java-javaparser-core"
         "${MINGW_PACKAGE_PREFIX}-java-javaparser-symbol-solver-core")
pkgver=3.26.2
pkgrel=1
pkgdesc="javaparser Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/dbeaver/dbeaver-deps-ce'
license=('spdx:LGPL-2.1-or-later')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-jsr305"
             "${MINGW_PACKAGE_PREFIX}-java-checker-qual"
             "${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-guava"
             "${MINGW_PACKAGE_PREFIX}-java-javassist")
source=('https://repo.maven.apache.org/maven2/com/github/javaparser/javaparser-core/3.26.2/javaparser-core-3.26.2-sources.jar'
         'https://repo.maven.apache.org/maven2/com/github/javaparser/javaparser-core/3.26.2/javaparser-core-3.26.2.pom'
         'https://repo.maven.apache.org/maven2/com/github/javaparser/javaparser-symbol-solver-core/3.26.2/javaparser-symbol-solver-core-3.26.2-sources.jar'
         'https://repo.maven.apache.org/maven2/com/github/javaparser/javaparser-symbol-solver-core/3.26.2/javaparser-symbol-solver-core-3.26.2.pom')
noextract=('javaparser-core-3.26.2-sources.jar'
         'javaparser-core-3.26.2.pom'
         'javaparser-symbol-solver-core-3.26.2-sources.jar'
         'javaparser-symbol-solver-core-3.26.2.pom')
sha256sums=('e450a5f8c86af0b0a5db5096ffbd1a794a86ff2e6a8a55266e28b3ad4df70c40'
         'f312ba81707d56db4486c1f9ad1a6e03c36a99acf1e089a186ea7478a71344b8'
         '56b31772e89243ad9c96068117d807f0c7e7f1255ac5d8ee151ba68b536bad52'
         'd9c39bdaef48640e3d00a7d28a81fab44b4919e8b898c50e3d0e23db87385773')
_artifacts=('com.github.javaparser:javaparser-core:3.26.2'
         'com.github.javaparser:javaparser-symbol-solver-core:3.26.2')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=8
  jb_module com.github.javaparser:javaparser-core:3.26.2 upstream/javaparser-core \
    -r resources/javaparser-core -u javaparser-core-3.26.2.pom
  jb_module com.github.javaparser:javaparser-symbol-solver-core:3.26.2 upstream/javaparser-symbol-solver-core \
    -r resources/javaparser-symbol-solver-core -u javaparser-symbol-solver-core-3.26.2.pom -- \
    com.github.javaparser:javaparser-core org.javassist:javassist com.google.guava:guava com.google.code.findbugs:jsr305/provided org.checkerframework:checker-qual/provided
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck com.github.javaparser:javaparser-core
  jb_loadcheck --with com.github.javaparser:javaparser-core --with org.javassist:javassist --with com.google.guava:guava --with com.google.code.findbugs:jsr305 --with org.checkerframework:checker-qual com.github.javaparser:javaparser-symbol-solver-core
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-javaparser-core() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.github.javaparser:javaparser-core
  _license javaparser-core 3.26.2
}

package_java-javaparser-symbol-solver-core() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-javaparser-core"
           "${MINGW_PACKAGE_PREFIX}-java-javassist"
           "${MINGW_PACKAGE_PREFIX}-java-guava")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.github.javaparser:javaparser-symbol-solver-core
  _license javaparser-symbol-solver-core 3.26.2
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
