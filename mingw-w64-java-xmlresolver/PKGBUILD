# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-xmlresolver
pkgname=("${MINGW_PACKAGE_PREFIX}-java-xmlresolver")
pkgver=5.2.2
pkgrel=1
pkgdesc="xmlresolver Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/xmlresolver/xmlresolver'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-httpclient5"
             "${MINGW_PACKAGE_PREFIX}-java-httpcore5")
source=('0001-jdk-parser-profile.patch'
         'https://repo.maven.apache.org/maven2/org/xmlresolver/xmlresolver/5.2.2/xmlresolver-5.2.2-sources.jar'
         'https://repo.maven.apache.org/maven2/org/xmlresolver/xmlresolver/5.2.2/xmlresolver-5.2.2.pom')
noextract=('xmlresolver-5.2.2-sources.jar'
         'xmlresolver-5.2.2.pom')
sha256sums=('7c85efa4a7824992a6ab41ccd811b331801d1db54943bec2327211cdcb79c15e'
         'f76cc2e9fd290ebfe5b5ffdc3d2b31ebae472fe8af766355a65baf6254a9d7e2'
         'e15a2922543b3a55c31774f10e83db74e93b2fa90b3d6315dd3a1c42a91f0074')
_artifacts=('org.xmlresolver:xmlresolver:5.2.2')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
  # Use the JDK SAX/JAXP parser. Optional Jing validation and the external
  # Xerces XNI adapter are outside this DBeaver/Saxon runtime profile.
  rm -f upstream/xmlresolver/org/xmlresolver/XercesResolver.java \
        upstream/xmlresolver/org/xmlresolver/loaders/ValidatingXmlLoader.java
  patch -p1 -i "${srcdir}/0001-jdk-parser-profile.patch"
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.xmlresolver:xmlresolver:5.2.2 upstream/xmlresolver \
    -r resources/xmlresolver -u xmlresolver-5.2.2.pom -- \
    org.apache.httpcomponents.client5:httpclient5/runtime org.apache.httpcomponents.core5:httpcore5/runtime
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.apache.httpcomponents.client5:httpclient5 --with org.apache.httpcomponents.core5:httpcore5 org.xmlresolver:xmlresolver
  mkdir -p smoke
  cat > smoke/CatalogResolve.java <<'JAVA'
import org.xmlresolver.*;
import java.nio.file.*;
import java.util.*;
import javax.xml.transform.*;
import javax.xml.transform.stream.*;
public class CatalogResolve {
  public static void main(String[] args) throws Exception {
    Path dir = Files.createTempDirectory("xmlresolver-");
    try {
      Path data=dir.resolve("answer.xml"), catalog=dir.resolve("catalog.xml");
      Files.writeString(data,"<answer>42</answer>");
      Files.writeString(catalog,"<catalog xmlns='urn:oasis:names:tc:entity:xmlns:xml:catalog'><uri name='urn:bootstrap:answer' uri='answer.xml'/></catalog>");
      XMLResolverConfiguration config=new XMLResolverConfiguration();
      config.setFeature(ResolverFeature.CATALOG_FILES, List.of(catalog.toUri().toString()));
      Source resolved=new Resolver(config).resolve("urn:bootstrap:answer", null);
      if(resolved==null) throw new AssertionError("catalog resolution");
      java.io.StringWriter text=new java.io.StringWriter();
      TransformerFactory.newInstance().newTransformer().transform(resolved,new StreamResult(text));
      if(!text.toString().contains(">42<")) throw new AssertionError(text);
      System.out.println("XML catalog URI resolution and JDK XML parsing passed");
    } finally {
      try(var files=Files.walk(dir)) {for(Path file:files.sorted(Comparator.reverseOrder()).toList()) Files.delete(file);}
    }
  }
}
JAVA
  local cp=$(jb_cp org.xmlresolver:xmlresolver)
  javac --release 21 -cp "$cp" -d "$(jb_w smoke)" "$(jb_w smoke/CatalogResolve.java)"
  java -cp "$(jb_w smoke);$cp" CatalogResolve

}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-xmlresolver() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-httpclient5"
           "${MINGW_PACKAGE_PREFIX}-java-httpcore5")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.xmlresolver:xmlresolver
  _license xmlresolver 5.2.2
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
