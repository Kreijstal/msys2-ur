# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=msdfgen
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.13
pkgrel=1
# Skia gives msdfgen its shape preprocessing (resolving self-intersections
# and overlapping contours). MSYS2's skia 143.r77119-5 was built with
# -mavx512f for the whole library and dies with SIGILL on CPUs without
# AVX-512; msys2-ur's skia 5.1 drops those flags, hence the version bound.
# Build with _use_skia=0 for a Skia-free msdfgen.
: "${_use_skia:=1}"
pkgdesc='Multi-channel signed distance field generator for fonts and vector shapes (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://github.com/Chlumsky/msdfgen'
msys2_repository_url='https://github.com/Chlumsky/msdfgen'
msys2_changelog_url='https://github.com/Chlumsky/msdfgen/releases'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-freetype"
         "${MINGW_PACKAGE_PREFIX}-libpng"
         $( ((_use_skia)) && echo "${MINGW_PACKAGE_PREFIX}-skia>=143.r77119.da51f0d6-5.1")
         "${MINGW_PACKAGE_PREFIX}-tinyxml2")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/Chlumsky/msdfgen/archive/refs/tags/v${pkgver}.tar.gz"
        "0001-import-svg-give-the-exported-flag-constants-explicit.patch"
        "0002-Find-Skia-through-pkg-config-when-it-has-no-CMake-pa.patch")
sha256sums=('93cd1ad8918c1a78c5c96e82d4f4c77f0eb86c2e7e8579a0967e54196c4b7167'
            '168bc71542cdda572e10aab085a39d9c5cdd8424111781475b13f0d79f642567'
            '8906b3b3cf3c18f044905fd6d0a3315902555310fac38e90c7fbcf7f3e7fce6d')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-import-svg-give-the-exported-flag-constants-explicit.patch"
  patch -Np1 -i "${srcdir}/0002-Find-Skia-through-pkg-config-when-it-has-no-CMake-pa.patch"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # Skia provides shape preprocessing (resolving self-intersections and
  # overlapping contours); see _use_skia above.
  # Only part of the core API is marked MSDFGEN_PUBLIC; MSVC builds rely on
  # CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS, which does not apply to MinGW, and the
  # explicit dllexports switch off lld's auto-export. msdfgen-ext and users
  # need classes such as Shape and EdgeSegment, so export everything.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -S "${srcdir}/${_realname}-${pkgver}" \
      -B "${srcdir}/build-${MSYSTEM}" \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DBUILD_SHARED_LIBS=ON \
      -DMSDFGEN_USE_VCPKG=OFF \
      -DMSDFGEN_USE_SKIA=$( ((_use_skia)) && echo ON || echo OFF) \
      -DMSDFGEN_USE_OPENMP=OFF \
      -DMSDFGEN_DYNAMIC_RUNTIME=ON \
      -DMSDFGEN_BUILD_STANDALONE=ON \
      -DMSDFGEN_INSTALL=ON \
      -DCMAKE_SHARED_LINKER_FLAGS="-Wl,--export-all-symbols" \
      "${_extra_config[@]}"
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/build-${MSYSTEM}"
}

check() {
  local _b="${srcdir}/build-${MSYSTEM}"
  local _exe
  _exe=$(find "${_b}" -name 'msdfgen.exe' -print -quit)
  export PATH="${_b}:$(dirname "${_exe}"):${PATH}"
  cd "${srcdir}"
  # a shape from the built-in description syntax, and an SVG path
  "${_exe}" msdf -defineshape '{ 1471,0; 1149,0; 1021,333; 435,333; 314,0; 0,0; 571,1466; 884,1466; # }{ 926,580; 724,1124; 526,580; # }' \
    -size 32 32 -autoframe -o shape.png -testrender shape-render.png 256 256
  cat > shape.svg <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"><path d="M1 1 L9 1 L5 9 Z"/></svg>
SVG
  "${_exe}" sdf -svg shape.svg -size 16 16 -autoframe -o svg.png
  # Skia preprocessing: two overlapping squares are merged into one contour.
  # Without Skia, -preprocess aborts with "not available in this version".
  if ((_use_skia)); then
  "${_exe}" msdf -defineshape '{ 0,0; 0,2; 2,2; 2,0; # }{ 1,1; 1,3; 3,3; 3,1; # }' \
    -preprocess -size 32 32 -autoframe -o overlap.png -exportshape overlap.txt
  [[ $(grep -o '{' overlap.txt | wc -l) -eq 1 ]] || { echo "Skia preprocessing did not merge the contours"; cat overlap.txt; return 1; }
  fi
  # FreeType font loading, if a system font is present
  local _font _outs=(shape.png shape-render.png svg.png)
  _font="$(cygpath -u "${WINDIR:-C:/Windows}")/Fonts/arial.ttf"
  if [[ -f "${_font}" ]]; then
    "${_exe}" mtsdf -font "$(cygpath -m "${_font}")" 65 -size 32 32 -autoframe -o glyph.png
    _outs+=(glyph.png)
  fi
  local _f
  for _f in "${_outs[@]}"; do
    [[ -s "${_f}" ]] || { echo "missing ${_f}"; return 1; }
  done
}

package() {
  DESTDIR="${pkgdir}" "${MINGW_PREFIX}/bin/cmake.exe" --install "${srcdir}/build-${MSYSTEM}"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.txt"
}
