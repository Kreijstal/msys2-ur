# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-runtime10-generators
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.5
pkgrel=1
pkgdesc='Original source .NET10 complete six-assembly shipping generator bundle'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-roslyn414-visualbasic=4.14.0"
         "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn44=4.4.0")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-reference10=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
source=('runtime-v10.0.5.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.5'
        'generators10-source-1.tar.gz'
        'arcade-runtime10-4bf37ce6.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/4bf37ce670528cf2aef4d9b1cd892554b1b02d9d')
noextract=('runtime-v10.0.5.tar.gz' 'arcade-runtime10-4bf37ce6.tar.gz')
sha256sums=('1692acae5e3adfd625452fbc9db4fd4e982c10e38189358ae245c74dd5514d7a'
            '06f8837ea02b4db0a7c95261dbe6cb37f95edd2fa1f34ffa42de522463ff89d2'
            '82f5f6dd63c0dcf3c0fc49b282207db5d889d9cc0939589d43b16c7fcfdf7d66')
prepare() {
  /usr/bin/python3 "$srcdir/generators10-workflow/prepare.py" "$srcdir" "$srcdir/prepared" >"$srcdir/prepare.log" 2>&1
}
build() {
  bash "$srcdir/generators10-workflow/build-all.sh" "$srcdir" "$srcdir/prepared" >"$srcdir/build.log" 2>&1
}
check() {
  bash "$srcdir/generators10-workflow/check-all.sh" "$srcdir" "$srcdir/prepared" >"$srcdir/check.log" 2>&1
}
package() {
  local target="$pkgdir$MINGW_PREFIX/lib/dotnet/generator-packs/runtime-10.0.5"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$target" "$doc"
  cp -R "$srcdir/stage/"* "$target/"
  install -m644 "$srcdir/generators10-workflow/README.md" "$doc/"
  install -m644 "$srcdir/prepared/"{source-inputs,tool-inputs,localization,source-package-audit}.json "$doc/"
  install -m644 "$srcdir/json-runtime/source-inputs.json" "$doc/json-source-inputs.json"
  install -m644 "$srcdir/json-runtime/source-build-audit.json" "$doc/json-source-audit.json"
  install -m644 "$srcdir/version-build-inputs.json" "$doc/"
  install -m644 "$srcdir/consumer/results.json" "$doc/build-consumer-results.json"
  install -Dm644 "$srcdir/r/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE.TXT"
  install -Dm644 "$srcdir/r/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.TXT"
  install -Dm644 "$srcdir/Arcade-LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Arcade-LICENSE.TXT"
}
