  jb_loadcheck --with org.eclipse.jetty:jetty-session --with org.eclipse.jetty:jetty-xml --with org.eclipse.jetty.ee:jetty-ee-webapp --with org.eclipse.jetty.ee11:jetty-ee11-servlet --with org.slf4j:slf4j-api org.eclipse.jetty.ee11:jetty-ee11-webapp
  jb_loadcheck --with org.eclipse.jetty.ee11:jetty-ee11-servlet --with org.eclipse.jetty.websocket:jetty-websocket-core-server --with org.slf4j:slf4j-api org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-servlet
  jb_loadcheck --with org.eclipse.jetty:jetty-client --with org.eclipse.jetty:jetty-xml --with org.eclipse.jetty.websocket:jetty-websocket-core-common org.eclipse.jetty.websocket:jetty-websocket-core-client
  jb_loadcheck --with org.eclipse.jetty:jetty-http --with org.eclipse.jetty:jetty-io --with org.eclipse.jetty:jetty-util --with org.slf4j:slf4j-api --with jakarta.servlet:jakarta.servlet-api --with org.eclipse.jetty.ee11:jetty-ee11-webapp org.eclipse.jetty.ee11:jetty-ee11-servlets
  jb_loadcheck --with jakarta.enterprise:jakarta.enterprise.cdi-api --with jakarta.enterprise:jakarta.enterprise.lang-model --with jakarta.interceptor:jakarta.interceptor-api --with jakarta.transaction:jakarta.transaction-api --with org.eclipse.jetty:jetty-jndi --with org.eclipse.jetty:jetty-plus --with org.eclipse.jetty.ee11:jetty-ee11-webapp --with org.slf4j:slf4j-api org.eclipse.jetty.ee11:jetty-ee11-plus
  jb_loadcheck --with jakarta.websocket:jakarta.websocket-api --with jakarta.websocket:jakarta.websocket-client-api --with org.eclipse.jetty.websocket:jetty-websocket-core-client --with org.slf4j:slf4j-api org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-jakarta-common
  jb_loadcheck --with jakarta.annotation:jakarta.annotation-api --with jakarta.servlet:jakarta.servlet-api --with org.eclipse.jetty:jetty-annotations --with org.eclipse.jetty.ee11:jetty-ee11-plus --with org.eclipse.jetty.ee11:jetty-ee11-webapp --with org.ow2.asm:asm --with org.ow2.asm:asm-commons --with org.slf4j:slf4j-api org.eclipse.jetty.ee11:jetty-ee11-annotations
  jb_loadcheck --with jakarta.websocket:jakarta.websocket-api --with jakarta.websocket:jakarta.websocket-client-api --with org.eclipse.jetty:jetty-client --with org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-jakarta-common --with org.eclipse.jetty.websocket:jetty-websocket-core-client org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-jakarta-client
  jb_loadcheck --with jakarta.servlet:jakarta.servlet-api --with org.eclipse.jetty:jetty-jmx --with org.eclipse.jetty.ee11:jetty-ee11-annotations --with org.eclipse.jetty.ee11:jetty-ee11-servlet --with org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-servlet --with org.eclipse.jetty.websocket:jetty-websocket-jetty-api --with org.eclipse.jetty.websocket:jetty-websocket-jetty-common --with org.eclipse.jetty.websocket:jetty-websocket-jetty-server --with org.slf4j:slf4j-api org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-jetty-server
  jb_loadcheck --with jakarta.websocket:jakarta.websocket-api --with org.eclipse.jetty.ee11:jetty-ee11-annotations --with org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-jakarta-client --with org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-servlet --with org.slf4j:slf4j-api org.eclipse.jetty.ee11.websocket:jetty-ee11-websocket-jakarta-server
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

