# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-httpclient5
pkgname=("${MINGW_PACKAGE_PREFIX}-java-httpclient5")
pkgver=5.1.3
pkgrel=1
pkgdesc="httpclient5 Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/dbeaver/dbeaver-deps-ce'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-commons-codec"
             "${MINGW_PACKAGE_PREFIX}-java-httpcore5"
             "${MINGW_PACKAGE_PREFIX}-java-httpcore5-h2"
             "${MINGW_PACKAGE_PREFIX}-java-slf4j-api")
source=('0001-use-jsse-on-java-21.patch'
         'https://repo.maven.apache.org/maven2/org/apache/httpcomponents/client5/httpclient5/5.1.3/httpclient5-5.1.3-sources.jar'
         'https://repo.maven.apache.org/maven2/org/apache/httpcomponents/client5/httpclient5/5.1.3/httpclient5-5.1.3.pom')
noextract=('httpclient5-5.1.3-sources.jar'
         'httpclient5-5.1.3.pom')
sha256sums=('a94950f515276f1c2fa5fcf9fc0b14697c1fcbb10e0dcf039e71c23cb48b00fc'
         '86135405842cde6b46337796a8aa4170a3253690d3f95cbdc5a957bc66917eba'
         '1988ab3d1bdae0f51f22c83dc97b88fa07561adb6244679d8b8f7146cdd13aaf')
_artifacts=('org.apache.httpcomponents.client5:httpclient5:5.1.3')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
  # OpenJDK JSSE is the TLS backend; the optional Conscrypt native adapter
  # is excluded consistently with the companion HTTP Core build.
  rm -f upstream/httpclient5/org/apache/hc/client5/http/ssl/ConscryptClientTlsStrategy.java
  patch -p1 -i "${srcdir}/0001-use-jsse-on-java-21.patch"
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.apache.httpcomponents.client5:httpclient5:5.1.3 upstream/httpclient5 \
    -r resources/httpclient5 -u httpclient5-5.1.3.pom -- \
    org.apache.httpcomponents.core5:httpcore5 org.apache.httpcomponents.core5:httpcore5-h2 org.slf4j:slf4j-api commons-codec:commons-codec
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.apache.httpcomponents.core5:httpcore5 --with org.apache.httpcomponents.core5:httpcore5-h2 --with org.slf4j:slf4j-api --with commons-codec:commons-codec org.apache.httpcomponents.client5:httpclient5
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-httpclient5() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-httpcore5"
           "${MINGW_PACKAGE_PREFIX}-java-httpcore5-h2"
           "${MINGW_PACKAGE_PREFIX}-java-slf4j-api"
           "${MINGW_PACKAGE_PREFIX}-java-commons-codec")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.httpcomponents.client5:httpclient5
  _license httpclient5 5.1.3
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
