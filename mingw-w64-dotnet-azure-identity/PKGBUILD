_realname=dotnet-azure-identity
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.11.4
pkgrel=1
_commit=2856f9a00d6cb96f71b724d29b1ce8ce271c4137
pkgdesc='Complete original Azure.Identity source library for the Azure/PowerShell graph'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/Azure/azure-sdk-for-net'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-azure-core>=1.38.0" "${MINGW_PACKAGE_PREFIX}-dotnet-msal>=4.61.3" "${MINGW_PACKAGE_PREFIX}-dotnet-msal-extensions>=4.61.3" "${MINGW_PACKAGE_PREFIX}-dotnet-system-text-json8>=8.0.5" "${MINGW_PACKAGE_PREFIX}-dotnet-protecteddata>=8.0.31")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" 'python')
checkdepends=("${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2")
options=('!strip' '!lto')
source=("azure-sdk-$_commit.tar.gz::https://codeload.github.com/Azure/azure-sdk-for-net/tar.gz/$_commit"
 extract.py
 prepare.py
 verify-build.py
 pack.py
 Check.cs
 OwnedEndpoint.cs
 check.sh
 check-payload.py
 compare.py
 InspectApi.cs
 InspectAssemblyMetadata.cs
