# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-pdfbox
pkgname=("${MINGW_PACKAGE_PREFIX}-java-pdfbox-io"
         "${MINGW_PACKAGE_PREFIX}-java-fontbox"
         "${MINGW_PACKAGE_PREFIX}-java-pdfbox")
pkgver=3.0.3
pkgrel=1
pkgdesc="pdfbox Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/dbeaver/dbeaver-deps-ce'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-bcpkix-jdk18on"
             "${MINGW_PACKAGE_PREFIX}-java-bcprov"
             "${MINGW_PACKAGE_PREFIX}-java-commons-logging")
source=('https://repo.maven.apache.org/maven2/org/apache/pdfbox/pdfbox-io/3.0.3/pdfbox-io-3.0.3-sources.jar'
         'https://repo.maven.apache.org/maven2/org/apache/pdfbox/pdfbox-io/3.0.3/pdfbox-io-3.0.3.pom'
         'https://repo.maven.apache.org/maven2/org/apache/pdfbox/fontbox/3.0.3/fontbox-3.0.3-sources.jar'
         'https://repo.maven.apache.org/maven2/org/apache/pdfbox/fontbox/3.0.3/fontbox-3.0.3.pom'
         'https://repo.maven.apache.org/maven2/org/apache/pdfbox/pdfbox/3.0.3/pdfbox-3.0.3-sources.jar'
         'https://repo.maven.apache.org/maven2/org/apache/pdfbox/pdfbox/3.0.3/pdfbox-3.0.3.pom')
noextract=('pdfbox-io-3.0.3-sources.jar'
         'pdfbox-io-3.0.3.pom'
         'fontbox-3.0.3-sources.jar'
         'fontbox-3.0.3.pom'
         'pdfbox-3.0.3-sources.jar'
         'pdfbox-3.0.3.pom')
sha256sums=('064de22969dc6002458401e3513743f0c7db2ecc1ee8a455f8d6573ea0f98bd5'
         '11701bb8c5a735a4b3140f73ae833a281cea09e3bc3f9f3791b9a97a745e90d4'
         '93e34b6e84ab26ea944943f0bd18f7de977dcb5605af4671082f913aeb36b5bf'
         'b2293e503aa77043061150f884683d7f614ccf5163be2d0f052ca29f3c7677e2'
         'eb81f296d88843ac94f0ae170a5ab281fc4d07ed71b4784b1ffeef339f23ff22'
         'be0895f6b2c20f311d6235c96a6fd2aac102b31904d3f4c39ea5259775b07008')
_artifacts=('org.apache.pdfbox:pdfbox-io:3.0.3'
         'org.apache.pdfbox:fontbox:3.0.3'
         'org.apache.pdfbox:pdfbox:3.0.3')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.apache.pdfbox:pdfbox-io:3.0.3 upstream/pdfbox-io \
    -r resources/pdfbox-io -u pdfbox-io-3.0.3.pom -- \
    commons-logging:commons-logging
  jb_module org.apache.pdfbox:fontbox:3.0.3 upstream/fontbox \
    -r resources/fontbox -u fontbox-3.0.3.pom -- \
    org.apache.pdfbox:pdfbox-io commons-logging:commons-logging
  jb_module org.apache.pdfbox:pdfbox:3.0.3 upstream/pdfbox \
    -r resources/pdfbox -u pdfbox-3.0.3.pom -- \
    org.apache.pdfbox:pdfbox-io org.apache.pdfbox:fontbox commons-logging:commons-logging org.bouncycastle:bcprov-jdk18on? org.bouncycastle:bcpkix-jdk18on?
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with commons-logging:commons-logging org.apache.pdfbox:pdfbox-io
  jb_loadcheck --with org.apache.pdfbox:pdfbox-io --with commons-logging:commons-logging org.apache.pdfbox:fontbox
  jb_loadcheck --with org.apache.pdfbox:pdfbox-io --with org.apache.pdfbox:fontbox --with commons-logging:commons-logging --with org.bouncycastle:bcprov-jdk18on --with org.bouncycastle:bcpkix-jdk18on org.apache.pdfbox:pdfbox
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-pdfbox-io() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-commons-logging")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.pdfbox:pdfbox-io
  _license pdfbox-io 3.0.3
}

package_java-fontbox() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-pdfbox-io"
           "${MINGW_PACKAGE_PREFIX}-java-commons-logging")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.pdfbox:fontbox
  _license fontbox 3.0.3
}

package_java-pdfbox() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-pdfbox-io"
           "${MINGW_PACKAGE_PREFIX}-java-fontbox"
           "${MINGW_PACKAGE_PREFIX}-java-commons-logging")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.pdfbox:pdfbox
  _license pdfbox 3.0.3
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
