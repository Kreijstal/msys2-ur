# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-maintenance-netstandard10
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
# This is the source bundle's packaging snapshot, not an upstream library version.
pkgver=20261029
pkgrel=1
pkgdesc='Source Memory4.6.3 Unsafe6.1.2 Tasks.Extensions4.6.3 with original inbox profiles'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/maintenance-packages'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-netstandard-reference>=2.0.3-3"
         "${MINGW_PACKAGE_PREFIX}-dotnet-maintenance-netstandard>=20261028-2")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing=8.0.131"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-ilasm10=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp=4.9.2"
             "${MINGW_PACKAGE_PREFIX}-llvm" 'python')
options=('!strip' '!lto' '!buildflags')
source=('maintenance-6b84308c.tar.gz::https://codeload.github.com/dotnet/maintenance-packages/tar.gz/6b84308c9ad012f53240d72c1d716d7e42546483'
        'maintenance-f62ca000.tar.gz::https://codeload.github.com/dotnet/maintenance-packages/tar.gz/f62ca0009b038cab4725a720f386623a969d73ad'
        'maintenance-netstandard-source-1.tar.gz')
noextract=('maintenance-6b84308c.tar.gz' 'maintenance-f62ca000.tar.gz')
sha256sums=('5f8a5d6a7fe51c06216d21eb06fd2c4ad4bae2b4a3b13319a74d790919b7492c'
            '76d2a3bcca49a0463e8bdf4dd79c0772bc899d7427b3d4ade0120036e48df5eb'
            'b9401875a74f8ab7d394d500d4e7c7a16b490679bba8fd845ded1f1c1c8c2fce')
prepare() {
  /usr/bin/python3 "$srcdir/maintenance-netstandard/prepare.py" "$srcdir" "$srcdir/prepared" > "$srcdir/prepare.log" 2>&1
}
build() {
  /usr/bin/python3 "$srcdir/maintenance-netstandard/build.py" "$srcdir" "$srcdir/prepared" > "$srcdir/build.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/maintenance-netstandard/check.py" "$srcdir" "$srcdir/prepared" "$srcdir/consumer" > "$srcdir/check.log" 2>&1
  /usr/bin/python3 "$srcdir/maintenance-netstandard/check-inbox.py" "$srcdir/prepared" "$srcdir/inbox-consumer" > "$srcdir/inbox-check.log" 2>&1
  /usr/bin/python3 "$srcdir/maintenance-netstandard/audit-production.py" "$srcdir" "$srcdir/prepared" > "$srcdir/production-audit.log" 2>&1
  /usr/bin/python3 "$srcdir/maintenance-netstandard/audit-assets.py" "$srcdir" "$srcdir/prepared" > "$srcdir/asset-audit.log" 2>&1
}
package() {
  local feed="$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$feed" "$doc"
  local archive
  # Buffer/Vector packages are rebuilt privately to validate the exact closure;
  # their unchanged versions remain owned by the original maintenance package.
  for archive in "$srcdir/prepared/feed/System.Memory.4.6.3.nupkg" \
                 "$srcdir/prepared/feed/System.Runtime.CompilerServices.Unsafe.6.1.2.nupkg" \
                 "$srcdir/prepared/feed/System.Threading.Tasks.Extensions.4.6.3.nupkg";do
    install -m644 "$archive" "$feed/$(basename "$archive" | tr '[:upper:]' '[:lower:]')"
  done
  install -m644 "$srcdir/maintenance-netstandard/README.md" "$doc/"
  install -m644 "$srcdir/prepared/"{source-inputs,tool-inputs,resources,asset-audit,production-audit}.json "$doc/"
  install -m644 "$srcdir/consumer/results.json" "$doc/build-check-results.json"
  install -m644 "$srcdir/inbox-consumer/results.json" "$doc/build-inbox-results.json"
  install -Dm644 "$srcdir/prepared/maintenance-packages-6b84308c9ad012f53240d72c1d716d7e42546483/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/maintenance-6b84308c-LICENSE"
  install -Dm644 "$srcdir/prepared/maintenance-packages-f62ca0009b038cab4725a720f386623a969d73ad/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/maintenance-f62ca000-LICENSE"
}
