From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Sat, 7 Nov 2026 20:01:06 +0100
Subject: [PATCH 15/18] MinGW: replace MSVC-only constructs

- std::exception(const char*) is an MSVC extension, use runtime_error
- std::wstring vs wxString in ?: needs an explicit wxString
- <Shlobj_core.h> does not exist in mingw-w64, <shlobj.h> does
- MinGW lacks strptime like MSVC, use the existing fallback
- avrdude: mingw-w64 has gettimeofday in <sys/time.h>
- Button: WM_GETDLGCODE needs <windows.h>
- libstdc++ std::thread handles are winpthreads pthread_t
- __try/__except is MSVC-only
---
 bundled_deps/avrdude/avrdude/avr.c          |  2 +-
 bundled_deps/avrdude/avrdude/stk500v2.c     |  2 +-
 src/libslic3r/Thread.cpp                    |  5 +++++
 src/libslic3r/Time.cpp                      |  6 +++---
 src/slic3r/GUI/BackgroundSlicingProcess.cpp |  9 +++++++++
 src/slic3r/GUI/ConfigWizard.cpp             |  2 +-
 src/slic3r/GUI/UserAccountCommunication.cpp | 10 +++++-----
 src/slic3r/GUI/Widgets/Button.cpp           |  3 +++
 src/slic3r/Utils/AppUpdater.cpp             |  2 +-
 src/slic3r/Utils/OctoPrint.cpp              |  2 +-
 src/slic3r/Utils/PrusaConnect.cpp           |  2 +-
 11 files changed, 31 insertions(+), 14 deletions(-)

diff --git a/bundled_deps/avrdude/avrdude/avr.c b/bundled_deps/avrdude/avrdude/avr.c
index defae75..72d55cc 100644
--- a/bundled_deps/avrdude/avrdude/avr.c
+++ b/bundled_deps/avrdude/avrdude/avr.c
@@ -27,7 +27,7 @@
 #include <string.h>
 #include <time.h>
 
-#if !defined(WIN32NATIVE)
+#if !defined(WIN32NATIVE) || defined(__MINGW32__)
 #  include <sys/time.h>
 #endif
 
diff --git a/bundled_deps/avrdude/avrdude/stk500v2.c b/bundled_deps/avrdude/avrdude/stk500v2.c
index 33bdf8e..75a4ede 100644
--- a/bundled_deps/avrdude/avrdude/stk500v2.c
+++ b/bundled_deps/avrdude/avrdude/stk500v2.c
@@ -46,7 +46,7 @@
 #include <unistd.h>
 #include <time.h>
 
-#if !defined(WIN32NATIVE)
+#if !defined(WIN32NATIVE) || defined(__MINGW32__)
 #  include <sys/time.h>
 #endif
 
diff --git a/src/libslic3r/Thread.cpp b/src/libslic3r/Thread.cpp
index 04a3492..ecbe147 100644
--- a/src/libslic3r/Thread.cpp
+++ b/src/libslic3r/Thread.cpp
@@ -112,7 +112,12 @@ static bool WindowsSetThreadName(HANDLE hThread, const char *thread_name)
 
 bool set_thread_name(std::thread &thread, const char *thread_name)
 {
+#if defined(__MINGW32__) && !defined(_LIBCPP_VERSION)
+    // libstdc++ std::thread is a winpthreads pthread_t
+   	return WindowsSetThreadName(pthread_gethandle(thread.native_handle()), thread_name);
+#else
    	return WindowsSetThreadName(static_cast<HANDLE>(thread.native_handle()), thread_name);
+#endif
 }
 
 bool set_thread_name(boost::thread &thread, const char *thread_name)
diff --git a/src/libslic3r/Time.cpp b/src/libslic3r/Time.cpp
index e987d8e..b4a3ed1 100644
--- a/src/libslic3r/Time.cpp
+++ b/src/libslic3r/Time.cpp
@@ -10,7 +10,7 @@
 #include <ctime>
 #include <locale>
 
-#ifdef _MSC_VER
+#ifdef _WIN32
 #include <map>
 #endif
 
@@ -42,8 +42,8 @@ namespace __get_put_time_emulation {
 // compile or do not pass the tests on the build server. If we switch to newer
 // compilers, this namespace can be deleted with all its content.
 
-#ifdef _MSC_VER
-// VS2019 implementation fails with ISO8601Z_TIME_FMT.
+#ifdef _WIN32
+// MinGW has no strptime either. VS2019 implementation fails with ISO8601Z_TIME_FMT.
 // VS2019 does not have std::strptime either. See bug:
 // https://developercommunity.visualstudio.com/content/problem/140618/c-stdget-time-not-parsing-correctly.html
 
diff --git a/src/slic3r/GUI/BackgroundSlicingProcess.cpp b/src/slic3r/GUI/BackgroundSlicingProcess.cpp
index e8c2bc7..4cdbb98 100644
--- a/src/slic3r/GUI/BackgroundSlicingProcess.cpp
+++ b/src/slic3r/GUI/BackgroundSlicingProcess.cpp
@@ -331,11 +331,16 @@ static void rethrow_seh_exception(unsigned long win32_seh_catched)
 unsigned long BackgroundSlicingProcess::call_process_seh(std::exception_ptr &ex) throw()
 {
 	unsigned long win32_seh_catched = 0;
+#ifdef _MSC_VER
 	__try {
 		this->call_process(ex);
 	} __except (is_win32_seh_harware_exception(GetExceptionCode())) {
 		win32_seh_catched = GetExceptionCode();
 	}
+#else
+	// no __try/__except in GCC: hardware exceptions crash as on Linux
+	this->call_process(ex);
+#endif
 	return win32_seh_catched;
 }
 void BackgroundSlicingProcess::call_process_seh_throw(std::exception_ptr &ex) throw()
@@ -374,11 +379,15 @@ void BackgroundSlicingProcess::call_process(std::exception_ptr &ex) throw()
 unsigned long BackgroundSlicingProcess::thread_proc_safe_seh() throw()
 {
 	unsigned long win32_seh_catched = 0;
+#ifdef _MSC_VER
 	__try {
 		this->thread_proc_safe();
 	} __except (is_win32_seh_harware_exception(GetExceptionCode())) {
 		win32_seh_catched = GetExceptionCode();
 	}
+#else
+	this->thread_proc_safe();
+#endif
 	return win32_seh_catched;
 }
 void BackgroundSlicingProcess::thread_proc_safe_seh_throw() throw()
