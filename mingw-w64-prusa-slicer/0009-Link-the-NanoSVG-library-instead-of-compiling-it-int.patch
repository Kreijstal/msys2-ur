From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Sat, 7 Nov 2026 18:50:14 +0100
Subject: [PATCH 09/18] Link the NanoSVG library instead of compiling it into
 libslic3r

From Arch Linux's fixes_nanosvg.patch.
---
 src/libslic3r/CMakeLists.txt     | 2 ++
 src/libslic3r/Format/SL1_SVG.cpp | 1 -
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/libslic3r/CMakeLists.txt b/src/libslic3r/CMakeLists.txt
index 777744b..6620dab 100644
--- a/src/libslic3r/CMakeLists.txt
+++ b/src/libslic3r/CMakeLists.txt
@@ -622,6 +622,7 @@ target_include_directories(libslic3r PUBLIC ${EXPAT_INCLUDE_DIRS})
 
 find_package(JPEG REQUIRED)
 find_package(nlohmann_json REQUIRED)
+find_package(NanoSVG REQUIRED)
 
 target_link_libraries(libslic3r PRIVATE
     sla_time_estimate
@@ -643,6 +644,7 @@ target_link_libraries(libslic3r PRIVATE
     fastfloat
     int128
     nlohmann_json::nlohmann_json
+    NanoSVG::nanosvg
 )
 target_link_libraries(libslic3r PUBLIC
     Eigen3::Eigen
diff --git a/src/libslic3r/Format/SL1_SVG.cpp b/src/libslic3r/Format/SL1_SVG.cpp
index e5af3ec..be198fa 100644
--- a/src/libslic3r/Format/SL1_SVG.cpp
+++ b/src/libslic3r/Format/SL1_SVG.cpp
@@ -17,7 +17,6 @@
 #include "libslic3r/Zipper.hpp"
 #include "libslic3r/libslic3r.h"
 
-#define NANOSVG_IMPLEMENTATION
 #include <cstdint>
 #include <algorithm>
 #include <string_view>
