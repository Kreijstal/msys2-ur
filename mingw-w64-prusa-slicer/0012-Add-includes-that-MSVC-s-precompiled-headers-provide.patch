 src/slic3r/Utils/Process.cpp              | 1 +
 src/slic3r/Utils/WifiScanner.hpp          | 1 +
 src/slic3r/Utils/WinRegistry.cpp          | 5 +++++
 11 files changed, 20 insertions(+)

