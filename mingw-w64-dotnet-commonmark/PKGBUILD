prepare() {
 /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/CommonMark.NET-$_commit" "$srcdir/prepared"
 mkdir "$srcdir/test-data"
 cp "$srcdir/CommonMark.NET-$_commit/CommonMark.Tests/Specification/Specs.cs" "$srcdir/test-data/Specs.cs"
 cp "$srcdir/CommonMark.NET-$_commit/CommonMark.Tests/Helpers.cs" "$srcdir/test-data/Helpers.cs"
}
build() { bash "$srcdir/build.sh" "$srcdir/prepared"; }
check() {
 bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/test-data" "$srcdir/feed"
 bash "$srcdir/check-api.sh" "$srcdir/check" "$srcdir/check-api"
}
package() {
 install -Dm644 "$srcdir/feed/CommonMark.NET.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/commonmark.net.$pkgver.nupkg"
 install -Dm644 "$srcdir/CommonMark.NET-$_commit/LICENSE.md" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
 install -m644 "$srcdir/LICENSE.CommonMarkSpec" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/"
 for file in README.md ExpectedApi.json published-metadata-provenance.json;do
  install -Dm644 "$srcdir/$file" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/$file"
 done
 for file in source-items.json removed-binaries.json;do
  install -m644 "$srcdir/prepared/$file" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/$file"
 done
 for file in Specs.cs Helpers.cs;do
  install -Dm644 "$srcdir/test-data/$file" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/checks/$file"
 done
}
