# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-commonmark
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.15.1
pkgrel=1
_commit=6f0ed9805065ee368c01fe931ca7d589e9341f11
pkgdesc='CommonMark.NET Markdown parser and formatter built from source for .NET 8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/Knagis/CommonMark.NET'
license=('spdx:BSD-3-Clause' 'spdx:CC-BY-SA-4.0')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("commonmark-$pkgver.tar.gz::https://codeload.github.com/Knagis/CommonMark.NET/tar.gz/$_commit"
        prepare.py build.sh Check.cs TestHost.cs check.sh InspectApi.cs ExpectedApi.json published-metadata-provenance.json check-api.sh README.md LICENSE.CommonMarkSpec)
sha256sums=('7fd82969785165a4ecaceaaad0d4121ee1506306977c95882c2c55dddcfec417'
            '8d485f256e0d4073fd12aa129028d31a1fe5902608f2c4d989be4e0f4809817f'
            '16d030bdb394a8336f2b90cbc5942008bccafbcd45d1d3e01be7265a7f985a3c'
            '00b60e5c5309b6e9cc88c0c5c065aaf896b1823a0da413dce69bba4035428884'
            'd0af8a4c10016e3f623be7e16093c3586a9357b5f767fae729bfe5a433c136af'
            '2173e36f34f4706cc3b56550100402ebfe0bef4901a75a7cdaa6fba8a0c17786'
            '4d658e87c67c627487624486ecd6fe7d2f61b08d90b11a3cf402c5adc9b29d8e'
            '486de7b8f3f75436c29718c7fa1cfe959751cbcb7115e210a51c83fd9fa4325b'
            '2161098063130bab7d0afacc9df3ea95087338b2855e6e8c687ce0095bb37480'
            '570bb074ff04aa91e47b2108478f5090e2f2b8f6629410e6389da4bb904bce7f'
