# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=libxaw
urlpkgname=libXaw
pkgver=1.0.16
pkgrel=1
pkgdesc="Athena Widget library"
arch=('i686' 'x86_64')
url="https://www.x.org/"
license=('MIT')
depends=('libx11' 'libxmu' 'libxext' 'libxpm' 'libxt')
makedepends=('xtrans' 'autoconf' 'automake' 'libtool' 'gcc' 'ccache')

XORG_SRC_COMPRESSION=${XORG_SRC_COMPRESSION:-xz}
source=(https://www.x.org/archive/individual/lib/${urlpkgname}-${pkgver}.tar.${XORG_SRC_COMPRESSION})
sha256sums=('SKIP')  # Replace SKIP with the actual checksum

prepare() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Regenerate configure so the build below uses the guest's MSYS2-patched
  # libtool.m4, whose cygwin branch renames lib -> msys- rather than cyg.
  autoreconf -vif
}

build() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # libtool has no 'msys' case: its Windows branch matches only
  # cygwin*|mingw*|windows*|pw32*|cegcc*, so an *-msys host (which is what CHOST
  # is here) falls through to the default branch, which sets
  # build_libtool_libs=no and an empty library_names_spec. The result is a STATIC
  # ARCHIVE ONLY, produced silently with configure still exiting 0;
  # --enable-shared does not override it, the host triple is what decides.
  # $CHOST selects the branch with full shared-library support, and
  # --build is passed identically so autoconf does not treat this as a cross
  # build - CC stays the msys gcc, only libtool's behaviour changes.
  # The triple is $CHOST, MSYS2's own declaration for this environment: stock
  # /etc/makepkg.conf (straight from the pacman package) sets
  # CHOST=x86_64-pc-cygwin. Never hardcode one here - an earlier revision of this
  # file hardcoded x86_64-pc-msys, which is precisely what produced the
  # static-only build described above.
  local _host="${CHOST:?CHOST unset - /etc/makepkg.conf was not sourced}"

  ./configure --prefix=/usr \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --datadir=/usr/share \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info \
    --build=${_host} \
    --host=${_host} \
    --enable-shared \
    --enable-static

  make
}

check() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  make check
}

package() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Install the package to the system
  make DESTDIR=${pkgdir} install

  # A libtool static-only degradation is silent: configure and make both still
  # exit 0, so nothing above this line can fail on it. Assert on the artifacts
  # instead. This matters beyond this package -- libtool also degrades a
  # dependent library to static when one of its dependencies has no import
  # library, so one static result quietly propagates down the whole chain.
  ls "${pkgdir}"/usr/bin/msys-*.dll >/dev/null 2>&1 || {
    echo "ERROR: ${pkgname} built static-only (no DLL installed)" >&2; return 1; }
  local _a _base
  for _a in "${pkgdir}"/usr/lib/lib*.a; do
    [ -e "${_a}" ] || continue
    case "${_a}" in *.dll.a) continue;; esac
    _base=$(basename "${_a}" .a)
    [ -f "${pkgdir}/usr/lib/${_base}.dll.a" ] || {
      echo "ERROR: ${_base} built static-only (no import library)" >&2; return 1; }
  done
}
