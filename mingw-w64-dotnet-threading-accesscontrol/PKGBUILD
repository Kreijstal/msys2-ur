# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-threading-accesscontrol
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=8.0.0
pkgrel=2
_sourcever=8.0.31
pkgdesc='Source-built System.Threading.AccessControl 8 for plain .NET 8 consumers'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("runtime-v${_sourcever}.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v${_sourcever}"
        prepare.py libraries.json Microsoft.pubkey.hex check.cs CheckAssets.cs check.sh check-api.cs check-api.sh README.md)
noextract=("runtime-v${_sourcever}.tar.gz")
sha256sums=('b32a56a29cc0248bed219e1c7ef026bf8f006d997f5d6346382e63a22ecd9070'
            'bcc059f4ac0d09a362d08f929c861fc79fa2fc1f4b768647701d44eb881d03f0'
            'd0df5e705bf127ee2fb9e69f681ab05cfe4f70f46151caebbfcd5a6b93c202c5'
            'f590f89e2667ca399aa6e436a8c8d3855bbcec19228980320920bad70e5bfd3f'
            '4945572b8ebade73e12473a0b36ba76f54ad499b3275051d678572d1306a65eb'
            '16e3f95dae8a33ff981216fab2b0be9e1055a831d8e8097733a6af701e7b74ea'
            '96ea1c4aa46586a7e4fb0e49f09503a7e27d43d15a4642efdac8f9d6a94c019d'
            'f2f865f6b1a6e567c7f2b87fba1fa2d4b52e4e3d9d54877e09f40c9857b26b52'
            '18fa3eb6195d768a93788cd3a1a02fa95a488474c0ba5dd3a021a9c26373433f'
