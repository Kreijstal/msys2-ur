build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local row name gav bsn
  for row in "${_bundles[@]}"; do
    IFS='|' read -r name gav bsn <<< "$row"
    jb_wrap "$gav" "${srcdir}/$name.bnd"
  done
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_osgi_resolvecheck
}

_package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_plugins_install "$1"
}

package_dbeaver-orbit-guava-failureaccess() {
  depends=("${MINGW_PACKAGE_PREFIX}-java-guava-failureaccess")
  _package com.google.guava.failureaccess
}

