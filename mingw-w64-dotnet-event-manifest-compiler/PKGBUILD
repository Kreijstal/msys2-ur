# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-event-manifest-compiler
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.0.0.git20201006.f919e38
pkgrel=1
pkgdesc='Source-built EventTraceKit manifest resource compiler with a .NET 8 command-line driver'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/gix/event-trace-kit'
license=('spdx:MIT')
_commit=f919e38bbf553f89058f98b5d1eeb3c4536a673b
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" 'bash')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" 'python')
options=('!strip' '!lto')
source=("event-trace-kit-${_commit}.tar.gz::https://codeload.github.com/gix/event-trace-kit/tar.gz/${_commit}"
        prepare.py Program.cs build.sh event-manifest-compiler.sh README.md)
sha256sums=('02c4f0cf88ccd5049b549ac7b4419cc5fda6e0ea724104b415f0004a71de3fa3'
            'c8afb495c86808adfa2e3d948db17c02095a7ad634459b89b952fef287211a78' '259573eeda33c8b237d4485c895503ad13d71b8ede4a28d07aa78a9ffcd7154f' '89d41bbb62678bf5d6ab32786e83c31a67d474398a5e72188f352f5313a1aa01' '6d02a02b716f2c9bb001e67589f19a65b5ec7d742a32523e154f3edaa2736bdc' 'f396b66a3db4478ed8ae3f8ea035450692ee3fb177f95a6474a423b525fa4178')
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/event-trace-kit-${_commit}" "$srcdir/compiler"
}
build() {
  bash "$srcdir/build.sh" "$srcdir/compiler"
}
check() {
  # CLI usage is checked here; the consuming native package validates generated
  # message/template resources through Windows' independent TDH implementation.
  local status=0
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" "$(cygpath -m "$srcdir/compiler/bin/Release/net8.0/event-manifest-compiler.dll")" > "$srcdir/usage.log" 2>&1 || status=$?
  [[ $status == 2 ]]
  grep -q 'usage: event-manifest-compiler' "$srcdir/usage.log"
}
package() {
  install -d "$pkgdir$MINGW_PREFIX/lib/event-manifest-compiler"
  install -m644 "$srcdir/compiler/bin/Release/net8.0/"{event-manifest-compiler.dll,event-manifest-compiler.deps.json,event-manifest-compiler.runtimeconfig.json} \
    "$pkgdir$MINGW_PREFIX/lib/event-manifest-compiler/"
  install -Dm755 "$srcdir/event-manifest-compiler.sh" "$pkgdir$MINGW_PREFIX/bin/event-manifest-compiler"
  install -Dm644 "$srcdir/event-trace-kit-${_commit}/LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
}
