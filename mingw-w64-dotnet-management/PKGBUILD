_env() {
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  inputs=("runtime-$_sourcever/LICENSE.TXT" "runtime-$_sourcever/THIRD-PARTY-NOTICES.TXT"
          "runtime-$_sourcever/src/libraries/Common/src" "runtime-$_sourcever/src/libraries/System.Private.CoreLib/src")
  while read -r id; do inputs+=("runtime-$_sourcever/src/libraries/$id"); done < <(/usr/bin/python3 -c 'import json,sys; [print(x["id"]) for x in json.load(open(sys.argv[1]))]' "$srcdir/libraries.json")
  tar -xzf "$srcdir/runtime-v$_sourcever.tar.gz" -C "$srcdir" "${inputs[@]}"
  (cd "$srcdir/runtime-$_sourcever" && patch -p1 < "$srcdir/0001-use-source-built-wmi-backend.patch" &&
    patch -p1 < "$srcdir/0002-secure-service-calls-in-calling-apartment.patch")
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/runtime-$_sourcever" "$srcdir/prepared"
}
build() {
  _env
  bash "$srcdir/build-native.sh" "$srcdir/native"
  mkdir -p "$srcdir/feed"
  while read -r id; do
    "$MINGW_PREFIX/lib/dotnet/dotnet.exe" build "$(cygpath -m "$srcdir/prepared/$id/contract/Contract.csproj")" -c Release \
      --configfile "$(cygpath -m "$srcdir/prepared/NuGet.config")" -p:UseSharedCompilation=false -v:minimal
    "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$(cygpath -m "$srcdir/prepared/$id/Library.csproj")" -c Release \
      -o "$(cygpath -m "$srcdir/feed")" --configfile "$(cygpath -m "$srcdir/prepared/NuGet.config")" \
      -p:GeneratePackageOnBuild=false -p:ImportDirectoryBuildProps=false -p:ImportDirectoryBuildTargets=false -p:UseSharedCompilation=false -v:minimal
  done < <(/usr/bin/python3 -c 'import json,sys; [print(x["id"]) for x in json.load(open(sys.argv[1]))]' "$srcdir/libraries.json")
}
check() {
  _env
  bash "$srcdir/check-installed.sh" "$srcdir/check" "$srcdir/prepared/localization.json" "$srcdir/feed"
  bash "$srcdir/check-api.sh" "$srcdir/prepared" "$srcdir/check" "$srcdir/check-api"
}
package() {
  install -Dm644 "$srcdir/feed/System.Management.8.0.0.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/system.management.8.0.0.nupkg"
  install -Dm644 "$srcdir/runtime-$_sourcever/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/runtime-$_sourcever/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES"
  install -Dm644 "$srcdir/prepared/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
  install -Dm644 "$srcdir/prepared/localization.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/localization.json"
  install -Dm644 "$srcdir/LICENSE.port" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE.port"
  install -Dm644 "$srcdir/native-exports.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/native-exports.json"
  install -Dm644 "$srcdir/0001-use-source-built-wmi-backend.patch" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/source-port.patch"
  install -Dm644 "$srcdir/0002-secure-service-calls-in-calling-apartment.patch" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/apartment-security.patch"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
}
