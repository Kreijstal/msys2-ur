_realname=dotnet-management
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=8.0.0
pkgrel=2
_sourcever=8.0.31
pkgdesc='Source-built System.Management with a native Windows COM backend'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codedom=8.0.31")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2"
             "${MINGW_PACKAGE_PREFIX}-dotnet-codedom=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-llvm" "${MINGW_PACKAGE_PREFIX}-lld" 'python' 'patch')
options=('!strip' '!lto')
source=("runtime-v${_sourcever}.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v${_sourcever}"
        prepare.py libraries.json Microsoft.pubkey.hex 0001-use-source-built-wmi-backend.patch
        wmi-native.cpp service-security.inc 0002-secure-service-calls-in-calling-apartment.patch build-native.sh check-native.py native-exports.json LICENSE.port
        Probe.cs PortChecks.cs ApartmentChecks.cs NativeDependencies.cs CheckAssets.cs check-installed.sh
        check-api.cs check-api.sh README.md)
noextract=("runtime-v${_sourcever}.tar.gz")
