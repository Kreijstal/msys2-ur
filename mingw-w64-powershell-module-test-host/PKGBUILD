prepare() {
  mkdir "$srcdir/prepared"
  mv "$srcdir/PowerShell-$pkgver" "$srcdir/prepared/"
  cp -L "$srcdir/powershell-$pkgver.tar.gz" "$srcdir/prepared/powershell-$pkgver.tar.gz"
  /usr/bin/python3 "$srcdir/prepare-core.py" "$srcdir/prepared/PowerShell-$pkgver"
  /usr/bin/python3 "$srcdir/prepare-gherkin.py" "$srcdir/gherkin-dotnet-55ab34d45dcd8249349704335c2aa2f90839fae3" "$srcdir/gherkin"
}
build() {
  bash "$srcdir/build-core-tools.sh" "$srcdir/prepared"
  bash "$srcdir/build-host.sh" "$srcdir/prepared" "$srcdir/host"
  export DOTNET_ROOT=$(cygpath -am /clang64/lib/dotnet) DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
  export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_HOME=$(cygpath -am "$srcdir/host/cli-home") NUGET_PACKAGES=$(cygpath -am "$srcdir/prepared/empty-packages")
  /usr/bin/python3 "$srcdir/build-entry.py" "$srcdir/prepared" "$srcdir/host/bin/Release/net8.0" "$srcdir/entry"
  /clang64/lib/dotnet/dotnet.exe build "$(cygpath -am "$srcdir/gherkin/Gherkin.csproj")" -c Release \
    --configfile "$(cygpath -am "$srcdir/prepared/NuGet.config")" -p:UseSharedCompilation=false -v:minimal
  /usr/bin/python3 "$srcdir/stage-pester.py" "$srcdir/Pester-add7dc5f435287aa14db39c31f90159572e6a6df" \
    "$srcdir/host/bin/Release/net8.0/Modules/Pester" "$srcdir/gherkin/bin/Release/net8.0/Gherkin.dll"
  /usr/bin/python3 "$srcdir/audit-source.py" "$srcdir/prepared"
  /usr/bin/python3 "$srcdir/audit-payload.py" "$srcdir/prepared" "$srcdir/host/bin/Release/net8.0" "$srcdir/gherkin/bin/Release/net8.0/Gherkin.dll"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/host/bin/Release/net8.0"; }
package() {
  local target="$pkgdir$MINGW_PREFIX/lib/dotnet/tools/$_realname"
  mkdir -p "$target"
  cp -R "$srcdir/host/bin/Release/net8.0/." "$target/"
  find "$target" -name '*.pdb' -delete
  install -m644 "$srcdir/powershell-module-test-host.cmd" "$target/"
  install -Dm755 "$srcdir/powershell-module-test-host" "$pkgdir$MINGW_PREFIX/bin/powershell-module-test-host"
  install -Dm644 "$srcdir/prepared/PowerShell-$pkgver/LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/PowerShell-LICENSE.txt"
  install -m644 "$srcdir/prepared/PowerShell-$pkgver/ThirdPartyNotices.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/"
  install -m644 "$srcdir/Pester-add7dc5f435287aa14db39c31f90159572e6a6df/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Pester-LICENSE"
  install -m644 "$srcdir/gherkin-dotnet-55ab34d45dcd8249349704335c2aa2f90839fae3/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Gherkin-LICENSE"
  install -m644 "$MINGW_PREFIX/share/licenses/${MINGW_PACKAGE_PREFIX}-dotnet-runtime/runtime.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Dotnet-AppHost-LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  for file in source-coverage.json source-build-inputs.json module-host-payload.json;do
    install -m644 "$srcdir/prepared/$file" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
  done
  install -m644 "$srcdir/gherkin/source-inventory.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/gherkin-source-inventory.json"
}
