#!/usr/bin/env bash
set -euo pipefail
prefix=$(cd "$(dirname "$0")/.." && pwd)
export DOTNET_ROOT=$(cygpath -am "$prefix/lib/dotnet") DOTNET_CLI_TELEMETRY_OPTOUT=1 POWERSHELL_TELEMETRY_OPTOUT=1
export DOTNET_ROOT_X64=$DOTNET_ROOT
exec "$prefix/lib/dotnet/dotnet.exe" "$(cygpath -am "$prefix/lib/dotnet/tools/powershell-module-test-host/SourcePowerShell.ModuleHost.dll")" "$@"
