# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-cdi-api
pkgname=("${MINGW_PACKAGE_PREFIX}-java-cdi-api")
pkgver=1.0.SP4
pkgrel=1
pkgdesc="cdi-api Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='http://www.seamframework.org/Weld'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-javax-el-api"
             "${MINGW_PACKAGE_PREFIX}-java-javax-inject"
             "${MINGW_PACKAGE_PREFIX}-java-jboss-interceptors-api-1-1-spec"
             "${MINGW_PACKAGE_PREFIX}-java-jsr250-api")
source=('https://repo.maven.apache.org/maven2/javax/enterprise/cdi-api/1.0-SP4/cdi-api-1.0-SP4-sources.jar'
         'https://repo.maven.apache.org/maven2/javax/enterprise/cdi-api/1.0-SP4/cdi-api-1.0-SP4.pom')
noextract=('cdi-api-1.0-SP4-sources.jar'
         'cdi-api-1.0-SP4.pom')
sha256sums=('4ef6485e9d039fd1d70806a56ff698bf4e8e5090c4d1de24d70b399667b7173a'
         'b32a77fb000b96e1e9090e7ad4c8b0fa0cfb06f4907875e5d354186071a4ed42')
_artifacts=('javax.enterprise:cdi-api:1.0-SP4')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module javax.enterprise:cdi-api:1.0-SP4 upstream/cdi-api \
    -r resources/cdi-api -u cdi-api-1.0-SP4.pom -- \
    org.jboss.spec.javax.interceptor:jboss-interceptors-api_1.1_spec javax.annotation:jsr250-api javax.inject:javax.inject javax.el:javax.el-api/provided
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.jboss.spec.javax.interceptor:jboss-interceptors-api_1.1_spec --with javax.annotation:jsr250-api --with javax.inject:javax.inject --with javax.el:javax.el-api javax.enterprise:cdi-api
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-cdi-api() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-jboss-interceptors-api-1-1-spec"
           "${MINGW_PACKAGE_PREFIX}-java-jsr250-api"
           "${MINGW_PACKAGE_PREFIX}-java-javax-inject")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install javax.enterprise:cdi-api
  _license cdi-api 1.0-SP4
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
