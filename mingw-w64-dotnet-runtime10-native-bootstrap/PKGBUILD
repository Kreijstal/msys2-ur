# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-runtime10-native-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.5
pkgrel=1
pkgdesc='Original source runtime10 native compression and globalization bootstrap libraries'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT' 'spdx:BSD-3-Clause' 'spdx:Zlib')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja" "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-python" 'python' 'patch')
options=('!strip' '!lto' '!buildflags' '!debug')
source=('runtime-v10.0.5.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.5'
        'runtime10-native-bootstrap-source-1.tar.gz'
        'arcade-runtime10-4bf37ce6.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/4bf37ce670528cf2aef4d9b1cd892554b1b02d9d')
noextract=('runtime-v10.0.5.tar.gz' 'arcade-runtime10-4bf37ce6.tar.gz')
sha256sums=('1692acae5e3adfd625452fbc9db4fd4e982c10e38189358ae245c74dd5514d7a'
            '217b988346d44a38cea7184b72ea0ae9e1a0e8561325197bcb0f12391d5f8541'
            '82f5f6dd63c0dcf3c0fc49b282207db5d889d9cc0939589d43b16c7fcfdf7d66')
prepare() { /usr/bin/python3 "$srcdir/native10-workflow/prepare.py" "$srcdir" >"$srcdir/prepare.log" 2>&1; }
build() { bash "$srcdir/native10-workflow/build-native.sh" "$srcdir" "$srcdir/native-output" >"$srcdir/build.log" 2>&1; }
check() {
  /clang64/bin/python.exe "$(cygpath -am "$srcdir/native10-workflow/audit-native.py")" "$(cygpath -am "$srcdir")" "$(cygpath -am "$srcdir/native-output")" >"$srcdir/audit.log" 2>&1
  /usr/bin/python3 "$srcdir/native10-workflow/check.py" "$srcdir" "$srcdir/native-output" "$srcdir/check" >"$srcdir/check.log" 2>&1
}
package() {
  local target="$pkgdir$MINGW_PREFIX/lib/dotnet-bootstrap10/native-libraries/10.0.5"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$target" "$doc"
  install -m755 "$srcdir/native-output/build/libs/System.IO.Compression.Native/System.IO.Compression.Native.dll" "$srcdir/native-output/build/libs/System.Globalization.Native/System.Globalization.Native.dll" "$target/"
  install -m644 "$srcdir/native10-workflow/README.md" "$doc/"
  install -m644 "$srcdir/native-output/"{source-inputs,source-audit}.json "$doc/"
  install -m644 "$srcdir/check/results.json" "$doc/build-check-results.json"
  install -m644 "$srcdir/"{coreclr-port-inputs,version-build-inputs,native-version-inputs}.json "$doc/"
  install -m644 "$srcdir/native-output/native-libs-mingw.patch" "$doc/"
  install -Dm644 "$srcdir/r/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE.TXT"
  install -m644 "$srcdir/r/THIRD-PARTY-NOTICES.TXT" "$srcdir/Arcade-LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/"
  install -m644 "$srcdir/r/src/native/external/brotli/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Brotli-LICENSE"
  install -m644 "$srcdir/r/src/native/external/zlib-ng/LICENSE.md" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/zlib-ng-LICENSE.md"
}
