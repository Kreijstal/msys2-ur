_realname=doclang
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.7.3
pkgrel=1
pkgdesc="Reference toolkit (XSD/Schematron validation, packaging) for the DocLang document markup (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/doclang-project/doclang'
msys2_repository_url='https://github.com/doclang-project/doclang'
msys2_references=(
  'purl: pkg:pypi/doclang'
)
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-lxml"
         "${MINGW_PACKAGE_PREFIX}-python-typer")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
source=("https://pypi.org/packages/source/d/doclang/doclang-${pkgver}.tar.gz")
sha256sums=('ca50615357e46ebf9597bb9065b9112367103ec24bd539f8ae12649224cf50b0')

build() {
  cp -r "doclang-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import pathlib, tempfile
from doclang import ValidationError, validate
from typer.testing import CliRunner
from doclang.cli import app
bad = pathlib.Path(tempfile.mkdtemp()) / "bad.dclg"
bad.write_text("<foo/>")
try:
    validate(bad, xsd_only=True)
    raise SystemExit("invalid document accepted")
except ValidationError as e:
    assert e.xsd_errors, e
r = CliRunner().invoke(app, ["--help"])
assert r.exit_code == 0 and "validate" in r.output, r.output
print("doclang ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
