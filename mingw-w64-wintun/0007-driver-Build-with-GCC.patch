+            &Ctx->Device.Receive.Thread, THREAD_ALL_ACCESS, &ObjectAttributes, NULL, NULL, (KSTART_ROUTINE *)TunProcessReceiveData, Ctx)))
         goto cleanupFlagsConnected;
 
