+static SECURITY_DESCRIPTOR *TunDispatchSecurityDescriptor = (SECURITY_DESCRIPTOR *)(DECLSPEC_ALIGN(8) UCHAR[]){
     0x01, 0x00, 0x14, 0x90, 0x64, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x14, 0x00, 0x00, 0x00, 0x30, 0x00, 0x00,
     0x00, 0x02, 0x00, 0x1c, 0x00, 0x01, 0x00, 0x00, 0x00, 0x11, 0x00, 0x14, 0x00, 0x07, 0x00, 0x00, 0x00, 0x01, 0x01,
     0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00, 0x30, 0x00, 0x00, 0x02, 0x00, 0x34, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00,
@@ -300,8 +303,10 @@ TunSendNetBufferLists(
 
     Ctx->Device.Send.RingTail = TUN_RING_WRAP(RingTail + RequiredRingSpace, RingCapacity);
     TunNblInitialize(NetBufferLists, Ctx->Device.Send.RingTail);
-    *(Ctx->Device.Send.ActiveNbls.Head ? &NET_BUFFER_LIST_NEXT_NBL_EX(Ctx->Device.Send.ActiveNbls.Tail)
-                                       : &Ctx->Device.Send.ActiveNbls.Head) = NetBufferLists;
+    if (Ctx->Device.Send.ActiveNbls.Head)
+        NET_BUFFER_LIST_NEXT_NBL_EX(Ctx->Device.Send.ActiveNbls.Tail) = NetBufferLists;
+    else
+        Ctx->Device.Send.ActiveNbls.Head = NetBufferLists;
     Ctx->Device.Send.ActiveNbls.Tail = NetBufferLists;
 
     KeReleaseInStackQueuedSpinLock(&LockHandle);
@@ -588,6 +593,31 @@ cleanup:
 
 #define IS_POW2(x) ((x) && !((x) & ((x)-1)))
 
+_IRQL_requires_max_(APC_LEVEL)
+_Must_inspect_result_
+static NTSTATUS
+TunProbeAndLockPages(_Inout_ MDL *Mdl)
+{
+#ifdef _MSC_VER
+    try
+    {
+        MmProbeAndLockPages(Mdl, UserMode, IoWriteAccess);
+    }
+    except(EXCEPTION_EXECUTE_HANDLER) { return STATUS_INVALID_USER_BUFFER; }
+    return STATUS_SUCCESS;
+#else
+    /* GCC has no try/except, but the ReactOS PSEH macros */
+    NTSTATUS Status = STATUS_SUCCESS;
+    _SEH2_TRY
+    {
+        MmProbeAndLockPages(Mdl, UserMode, IoWriteAccess);
+    }
+    _SEH2_EXCEPT(EXCEPTION_EXECUTE_HANDLER) { Status = STATUS_INVALID_USER_BUFFER; }
+    _SEH2_END;
+    return Status;
+#endif
+}
+
