# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-dapplo-http
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.0.12
pkgrel=1
pkgdesc='Source-built Dapplo HTTP and JSON libraries for the .NET 8 offline feed'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dapplo/Dapplo.HttpExtensions'
license=('spdx:MIT')
_commit=68d999dd1ad92bb5c70565a00adf47c8adc73aab
_tree=Dapplo.HttpExtensions-${_commit}
_project=src/Dapplo.HttpExtensions.JsonNet/Dapplo.HttpExtensions.JsonNet.csproj
_id=Dapplo.HttpExtensions.JsonNet
_framework=net8.0
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-dapplo-log>=3.0.22" "${MINGW_PACKAGE_PREFIX}-dotnet-newtonsoft-json>=13.0.4" "${MINGW_PACKAGE_PREFIX}-dotnet-syndication>=10.0.3")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" 'python')
options=('!strip' '!lto')
source=("dapplo-http-68d999dd1ad92bb5c70565a00adf47c8adc73aab.tar.gz::https://codeload.github.com/dapplo/Dapplo.HttpExtensions/tar.gz/68d999dd1ad92bb5c70565a00adf47c8adc73aab" prepare.py check.cs)
sha256sums=('2b9c58454e1bb02c3422f5c38c0528c52254608a5dad5265666c9a36735b0507' 'baa440e870fcf5aca261052fd49842b3ced4181f37e01617927e5efd1c10670b' '0ca7b198f475f3482df4e77cb1a085e67da50bed07ee022ed73a1bfd73e022b8')

_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" dapplo-http "$srcdir/$_tree"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  cd "$srcdir/$_tree"
  for project in Dapplo.HttpExtensions Dapplo.HttpExtensions.JsonNet; do
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "src/$project/$project.csproj" -c Release -o "$(cygpath -m "$srcdir/feed")" \
    --configfile "$(cygpath -m "$srcdir/NuGet.config")" -p:PackageVersion="$pkgver" \
    -p:Version="$pkgver" -p:PackageLicenseExpression=MIT -p:GeneratePackageOnBuild=false \
    -p:SolutionDir="$(cygpath -m "$srcdir/$_tree/src")/" -p:IncludeSymbols=false -p:RestoreSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" -p:TargetFrameworks=net8.0 -p:EnableNETAnalyzers=false -p:NuGetAudit=false -p:UseSharedCompilation=false -v:minimal
  done
}
check() {
  _env
  mkdir -p "$srcdir/check"
  cp "$srcdir/check.cs" "$srcdir/check/Program.cs"
  cat > "$srcdir/check/check.csproj" <<PROJECT
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>$_framework</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="$_id" Version="[$pkgver]" /></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" run --project "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    -p:RestoreSources="$(cygpath -m "$srcdir/feed")" -p:RestoreAdditionalProjectSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" -p:UseSharedCompilation=false
}
package() {
  for id in Dapplo.HttpExtensions Dapplo.HttpExtensions.JsonNet; do
    install -Dm644 "$srcdir/feed/$id.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${id,,}.$pkgver.nupkg"
  done
  install -Dm644 "$srcdir/$_tree/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/$_tree/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
}
