_realname=dotnet-identitymodel-abstractions
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=6.35.0
pkgrel=1
_commit=c94c7fc235501d478221e979062bd8837a55575b
pkgdesc='Complete original source IdentityModel logging and telemetry abstractions'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/AzureAD/azure-activedirectory-identitymodel-extensions-for-dotnet'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" 'python')
checkdepends=("${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp=4.9.2")
options=('!strip' '!lto')
source=("identitymodel-$_commit.tar.gz::https://codeload.github.com/AzureAD/azure-activedirectory-identitymodel-extensions-for-dotnet/tar.gz/$_commit"
 extract.py
 prepare.py
 verify-build.py
 pack.py
 Check.cs
 check.sh
 check-payload.py
 compare.py
 InspectApi.cs
 InspectAssemblyMetadata.cs
 published-api.json
 published-metadata.json
 README.md
)
noextract=("identitymodel-$_commit.tar.gz")
