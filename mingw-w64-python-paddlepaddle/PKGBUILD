prepare() {
  cd Paddle
  git submodule init
  local _sm
  for _sm in "${_submodules[@]}"; do
    git config "submodule.third_party/${_sm}.url" "${srcdir}/${_sm}"
    git -c protocol.file.allow=always submodule update "third_party/${_sm}"
  done

  local _patch
  for _patch in "${srcdir}"/0*.patch; do
    msg2 "Applying ${_patch##*/}"
    git apply -v "${_patch}"
  done
}

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  # The version string is compiled in (-DPADDLE_VERSION) and becomes the
  # wheel version; do not let cmake derive it from the git checkout.
  export PADDLE_VERSION=${pkgver}
  # pybind11-stubgen is not packaged; the .pyi stubs are optional.
  export SKIP_STUB_GEN=1

  local _prefix=$(cygpath -m "${MINGW_PREFIX}")
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake -GNinja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DPADDLE_SKIP_SUBMODULE_UPDATE=ON \
    -DPY_VERSION=$(${MINGW_PREFIX}/bin/python -c "import sys; print('%d.%d' % sys.version_info[:2])") \
    -DPYTHON_EXECUTABLE="${_prefix}/bin/python.exe" \
    -DPYTHON_INCLUDE_DIR="$(${MINGW_PREFIX}/bin/python -c "import sysconfig; print(sysconfig.get_path('include'))")" \
    -DPYTHON_LIBRARY="$(${MINGW_PREFIX}/bin/python -c "import sysconfig, os; print(os.path.join(sysconfig.get_config_var('LIBDIR'), sysconfig.get_config_var('LDLIBRARY')))")" \
    -DWITH_GPU=OFF -DWITH_ROCM=OFF -DWITH_XPU=OFF -DWITH_NCCL=OFF -DWITH_RCCL=OFF \
    -DWITH_MKL=OFF -DWITH_ONEDNN=OFF \
    -DWITH_SYSTEM_BLAS=ON \
    -DOPENBLAS_INC_DIR="${_prefix}/include/openblas" \
    -DOPENBLAS_LAPACKE_INC_DIR="${_prefix}/include/openblas" \
    -DOPENBLAS_CONFIG_INC_DIR="${_prefix}/include/openblas" \
    -DOPENBLAS_LIB="${_prefix}/lib/libopenblas.dll.a" \
    -DWITH_DISTRIBUTE=OFF -DWITH_TESTING=OFF -DWITH_CPP_TEST=OFF \
    -DWITH_CUSTOM_DEVICE=OFF -DWITH_CINN=OFF -DWITH_XBYAK=OFF -DWITH_SLEEF=OFF \
    -DWITH_PROFILER=OFF -DON_INFER=OFF -DWITH_SHARED_IR=OFF \
    -DWITH_AVX=ON -DWITH_PYTHON=ON -DWITH_CRYPTO=ON -DWITH_POCKETFFT=ON \
    ../Paddle

  cmake --build . -j $(nproc)
}

check() {
  cd "build-${MSYSTEM}/python"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import paddle
paddle.utils.run_check()
paddle.seed(0)
x = paddle.randn([256, 3])
y = x @ paddle.to_tensor([[2.0], [-3.0], [0.5]]) + 1.0
model = paddle.nn.Linear(3, 1)
opt = paddle.optimizer.SGD(learning_rate=0.1, parameters=model.parameters())
losses = []
for _ in range(50):
    loss = paddle.nn.functional.mse_loss(model(x), y)
    loss.backward()
    opt.step()
    opt.clear_grad()
    losses.append(float(loss))
assert losses[-1] < 1e-2 * losses[0], losses
PY
}

package() {
  cd "build-${MSYSTEM}/python"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 "${srcdir}/Paddle/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
