   if (dir != nullptr) {
     while ((ent = readdir(dir)) != nullptr) {
+#if defined(__MINGW32__)
+      // MinGW's dirent has no d_type; classify the entry with stat().
+      struct stat ent_st;
+      std::string ent_path = join(directory, ent->d_name);
