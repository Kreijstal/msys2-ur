diff --git a/paddle/phi/core/kernel_registry.h b/paddle/phi/core/kernel_registry.h
index f56189cd..3a029b8b 100644
--- a/paddle/phi/core/kernel_registry.h
+++ b/paddle/phi/core/kernel_registry.h
@@ -213,6 +213,17 @@ struct KernelRegistrar {
   template decltype(__VA_ARGS__) __VA_ARGS__;
 #endif
 
+// Windows: kernels that other DLLs call directly are exported with
+// `PD_WIN_KERNEL_INSTANTIATION PADDLE_API void Kernel<T, Ctx>(...)`.  MSVC's
+// PD_REGISTER_* macros do not instantiate, so there it is a definition.  GCC
+// (MinGW) instantiates in PD_REGISTER_* like on Linux, so make it a dllexport
+// explicit instantiation declaration that the registration then defines.
+#if defined(_WIN32) && !defined(_MSC_VER)
+#define PD_WIN_KERNEL_INSTANTIATION extern template
+#else
+#define PD_WIN_KERNEL_INSTANTIATION template
+#endif
+
 // The macro for instantiating function kernel
 #define FUNCTION_KERNEL_INSTANTIATION(meta_kernel_fn, cpp_dtype, context) \
   PD_DECLTYPE_FUNCTION_TEMPLATE_INSTANTIATION(                            \
@@ -390,7 +401,7 @@ struct KernelRegistrar {
                                     variadic_kernel_unfold_marco,          \
                                     __VA_ARGS__))
 
-#ifndef _WIN32
+#ifndef _MSC_VER
 #define _PD_REGISTER_2TA_KERNEL(reg_type,                                   \
                                 kernel_name,                                \
                                 backend,                                    \
@@ -1404,7 +1415,7 @@ struct KernelRegistrar {
   __PD_REGISTER_KERNEL_FOR_ALL_DTYPE(                                        \
       reg_type, kernel_name, backend, layout, kernel_fn)
 
-#ifndef _WIN32
+#ifndef _MSC_VER
 #define __PD_REGISTER_KERNEL_FOR_ALL_DTYPE(                                    \
     reg_type, kernel_name, backend, layout, kernel_fn)                         \
   PD_DECLTYPE_FUNCTION_TEMPLATE_INSTANTIATION(kernel_fn)                       \
@@ -1548,7 +1559,7 @@ struct KernelRegistrar {
                 __PD_KERNEL_args_def_FN_##kernel_name##_##layout( \
                     const ::phi::KernelKey& kernel_key UNUSED,    \
                     ::phi::Kernel* kernel UNUSED))
-#ifndef _WIN32
+#ifndef _MSC_VER
 #define ___PD_REGISTER_KERNEL_FOR_ALL_BACKEND_DTYPE(                           \
     reg_type, kernel_name, backend, layout, kernel_fn, args_def_fn)            \
   PD_DECLTYPE_FUNCTION_TEMPLATE_INSTANTIATION(kernel_fn)                       \
diff --git a/paddle/phi/core/utils/type_info.cc b/paddle/phi/core/utils/type_info.cc
index 95a991e2..c747ca34 100644
--- a/paddle/phi/core/utils/type_info.cc
+++ b/paddle/phi/core/utils/type_info.cc
@@ -49,6 +49,20 @@ template <typename BaseT, typename DerivedT>
 const TypeInfo<BaseT> TypeInfoTraits<BaseT, DerivedT>::kType =
     RegisterStaticType<BaseT>(DerivedT::name());
 
+#if defined(_WIN32) && !defined(_MSC_VER)
+// Definitions for the explicit instantiation declarations in
+// type_registry.h: one type registry per base class for all DLLs.
+#define PD_MINGW_TYPE_REGISTRY(BaseT)                  \
+  template class TypeRegistry<BaseT>;                  \
+  template class TypeInfo<BaseT>;                      \
+  template TypeInfo<BaseT> RegisterStaticType<BaseT>( \
+      const std::string& type);
+PD_MINGW_TYPE_REGISTRY(phi::TensorBase)
+PD_MINGW_TYPE_REGISTRY(phi::DeviceContext)
+PD_MINGW_TYPE_REGISTRY(phi::StorageProperties)
+#undef PD_MINGW_TYPE_REGISTRY
+#endif
+
 template class PADDLE_API TypeInfoTraits<phi::TensorBase, DenseTensor>;
 template class PADDLE_API TypeInfoTraits<phi::TensorBase, SelectedRows>;
 template class PADDLE_API TypeInfoTraits<phi::TensorBase, SparseCooTensor>;
diff --git a/paddle/phi/core/utils/type_registry.h b/paddle/phi/core/utils/type_registry.h
index ed1c9216..f44de9a3 100644
--- a/paddle/phi/core/utils/type_registry.h
+++ b/paddle/phi/core/utils/type_registry.h
@@ -84,4 +84,24 @@ template <typename BaseT>
 const TypeInfo<BaseT> TypeInfo<BaseT>::kUnknownType =
     RegisterStaticType<BaseT>("Unknown");
 
+#if defined(_WIN32) && !defined(_MSC_VER)
+// MinGW: without these explicit instantiation declarations every DLL
+// (phi.dll, libpaddle.pyd) instantiates its own TypeRegistry singleton from
+// this header, so type ids registered in different DLLs collide and
+// TypeInfoTraits::classof() gives wrong answers.  The single definitions
+// live in phi (paddle/phi/core/utils/type_info.cc).
+class TensorBase;
+class DeviceContext;
+struct StorageProperties;
+#define PD_MINGW_EXTERN_TYPE_REGISTRY(BaseT)                   \
+  extern template class TypeRegistry<BaseT>;                  \
+  extern template class TypeInfo<BaseT>;                      \
+  extern template TypeInfo<BaseT> RegisterStaticType<BaseT>( \
+      const std::string& type);
+PD_MINGW_EXTERN_TYPE_REGISTRY(TensorBase)
+PD_MINGW_EXTERN_TYPE_REGISTRY(DeviceContext)
+PD_MINGW_EXTERN_TYPE_REGISTRY(StorageProperties)
+#undef PD_MINGW_EXTERN_TYPE_REGISTRY
+#endif
+
 }  // namespace phi
