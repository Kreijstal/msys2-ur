diff --git a/CMakeLists.txt b/CMakeLists.txt
index 86f0c31f..ad9fa1ac 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -158,7 +158,25 @@ if(APPLE AND WITH_ARM)
   set(CMAKE_CXX_FLAGS "${CMAKE_C_FLAGS} -target arm64-apple-darwin")
 endif()
 
-if(WIN32)
+if(WIN32 AND NOT MSVC)
+  # MinGW-w64 (GCC/Clang): GNU-style flags, shared CRT.
+  add_definitions(-DNOMINMAX -DWIN32_LEAN_AND_MEAN)
+  # Keep the MSVC DLL names (common.dll, phi.dll, pir.dll, libpaddle.pyd)
+  # that the Windows code paths in Paddle expect; import libs stay lib*.dll.a.
+  set(CMAKE_SHARED_LIBRARY_PREFIX "")
+  set(CMAKE_SHARED_MODULE_PREFIX "")
+  # lld resolves __imp_ references to symbols defined in the same image (the
+  # MSVC LNK4217 behaviour Paddle relies on: COMMON_IMPORT_FLAG etc. are
+  # dllimport even inside the defining DLL) and links the huge DLLs faster.
+  foreach(flag_var CMAKE_SHARED_LINKER_FLAGS CMAKE_EXE_LINKER_FLAGS
+                   CMAKE_MODULE_LINKER_FLAGS)
+    set(${flag_var} "${${flag_var}} -fuse-ld=lld")
+  endforeach()
+  set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wa,-mbig-obj")
+  set(CMAKE_CXX_FLAGS
+      "${CMAKE_CXX_FLAGS} -Wa,-mbig-obj -Wno-error=deprecated-declarations -Wno-deprecated-declarations"
+  )
+elseif(WIN32)
   option(MSVC_STATIC_CRT "use static C Runtime library by default" ON)
   message("Build static library of PHI")
   # (Note xuxinyi04): If CMAKE_SUPPRESS_REGENERATION is OFF, which is default, then CMake adds a
