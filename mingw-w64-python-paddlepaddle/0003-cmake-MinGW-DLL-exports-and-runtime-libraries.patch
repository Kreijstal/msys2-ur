From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Wed, 7 Oct 2026 01:33:54 +0200
Subject: [PATCH 3/7] cmake: MinGW DLL exports and runtime libraries

GCC does not reproduce MSVC's dllexport semantics for Paddle's PADDLE_API
annotations (attributes on already-instantiated class templates are
ignored, vtables are only emitted with the key function), and CMake's
WINDOWS_EXPORT_ALL_SYMBOLS is MSVC-only.  Export all global symbols of
common.dll/phi.dll's own objects through a generated .def file
(tools/mingw_gen_def.py), but not the static archives linked into them
(protobuf, glog, ...), which consumers link themselves as with MSVC.
Also link dbghelp/ws2_32 (MSVC gets them via #pragma comment), use the
linker's import library for libpaddle instead of dumpbin/lib, and do not
copy a bundled openblas.dll next to the build-time code generators.
---
 cmake/generic.cmake                |  24 ++++-
 paddle/common/CMakeLists.txt       |  12 ++-
 paddle/fluid/pybind/CMakeLists.txt |   4 +-
 paddle/phi/CMakeLists.txt          |  17 +++-
 python/CMakeLists.txt              |   9 ++
 tools/mingw_gen_def.py             | 149 +++++++++++++++++++++++++++++
 6 files changed, 207 insertions(+), 8 deletions(-)
 create mode 100644 tools/mingw_gen_def.py

diff --git a/cmake/generic.cmake b/cmake/generic.cmake
index dd360fd6..be465ead 100644
--- a/cmake/generic.cmake
+++ b/cmake/generic.cmake
@@ -165,10 +165,28 @@ function(find_fluid_thirdparties TARGET_NAME)
   endif()
 endfunction()
 
+# MinGW: export every global symbol defined by the target's own objects
+# through a generated .def file (see tools/mingw_gen_def.py).
+function(mingw_export_objects TARGET_NAME)
+  set(_objs ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}_objects.txt)
+  set(_def ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.def)
+  file(
+    GENERATE
+    OUTPUT ${_objs}
+    CONTENT "$<JOIN:$<TARGET_OBJECTS:${TARGET_NAME}>,\n>\n")
+  add_custom_command(
+    TARGET ${TARGET_NAME}
+    PRE_LINK
+    COMMAND ${PYTHON_EXECUTABLE} ${PADDLE_SOURCE_DIR}/tools/mingw_gen_def.py
+            ${_objs} ${_def} $<TARGET_FILE_NAME:${TARGET_NAME}>
+    VERBATIM)
+  target_link_options(${TARGET_NAME} PRIVATE ${_def})
+endfunction()
+
 function(create_static_lib TARGET_NAME)
   set(libs ${ARGN})
   list(REMOVE_DUPLICATES libs)
-  if(WIN32)
+  if(MSVC)
     set(dummy_index 1)
     set(dummy_offset 1)
     # the dummy target would be consisted of limit size libraries
@@ -272,7 +290,7 @@ function(merge_static_libs TARGET_NAME)
   endif()
 
   # LINUX: use "ar" to extract objects and re-add to a common lib
-  if(LINUX)
+  if(LINUX OR MINGW)
     set(mri_file
         ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.mri
         CACHE INTERNAL "phi_static.mri file")
@@ -297,7 +315,7 @@ function(merge_static_libs TARGET_NAME)
   endif()
 
   # Windows do not support gcc/nvcc combined compiling. Use msvc 'lib.exe' to merge libs.
-  if(WIN32)
+  if(MSVC)
     foreach(lib ${libs})
       set(libfiles ${libfiles} $<TARGET_FILE:${lib}>)
     endforeach()
