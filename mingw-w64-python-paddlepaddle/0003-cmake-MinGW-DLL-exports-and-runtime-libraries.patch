diff --git a/tools/mingw_gen_def.py b/tools/mingw_gen_def.py
new file mode 100644
index 00000000..ad6a3c01
--- /dev/null
+++ b/tools/mingw_gen_def.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 PaddlePaddle Authors. All Rights Reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Write a module-definition (.def) file exporting the global symbols defined
+by a DLL's own object files (MinGW).
+
+GCC does not reproduce MSVC's export semantics for Paddle's PADDLE_API
+annotations (dllexport on already-instantiated class templates is ignored,
+vtables live with the key function), so the MinGW build exports every global
+symbol of the DLL's own objects, like the ELF build does.  Unlike
+--export-all-symbols this leaves out the static archives linked into the DLL
+(protobuf, glog, ...): consumers link their own copies of those (as with
+MSVC), and exporting them as well makes GNU ld/lld report duplicate
+definitions.
+
+usage: mingw_gen_def.py <object-list-file> <output.def> <dll-name>
+"""
+
+import struct
+import sys
+
+IMAGE_SCN_CNT_CODE = 0x20
+IMAGE_SCN_LNK_COMDAT = 0x1000
+BIGOBJ_CLSID = bytes.fromhex('c7a1bad1eebaa94baf20faf66aa4dcb8')
+
+# Leading namespaces of third-party code that is header-only or linked
+# statically into every consumer; never export those instantiations.
+FOREIGN_NAMESPACES = {
+    'std',
+    '__gnu_cxx',
+    '__cxxabiv1',
+    'Eigen',
+    'google',
+    'absl',
+    'YAML',
+    'nlohmann',
+    'pybind11',
+    'CryptoPP',
+    'fmt',
+    'pocketfft',
+    'dlpack',
+    'mpark',
+}
+STD_ABBREV = ('St', 'Sa', 'Sb', 'Ss', 'Si', 'So', 'Sd')
+
+
+def leading_namespace(name):
+    if not name.startswith('_Z'):
+        return None
+    s = name[2:]
+    for p in ('TV', 'TI', 'TS', 'TT', 'TH', 'TW', 'GV', 'GR'):
+        if s.startswith(p):
+            s = s[2:]
+            break
+    if s.startswith('L'):
+        s = s[1:]
+    if s.startswith('N'):
+        s = s[1:]
+        while s and s[0] in 'rVKRO':
+            s = s[1:]
+    if s.startswith(STD_ABBREV):
+        return 'std'
+    i = 0
+    while i < len(s) and s[i].isdigit():
+        i += 1
+    if i == 0:
+        return None
+    n = int(s[:i])
+    return s[i : i + n]
+
+
+def read_symbols(path):
+    with open(path, 'rb') as f:
+        data = f.read()
+    sig1, sig2 = struct.unpack_from('<HH', data, 0)
+    if sig1 == 0 and sig2 == 0xFFFF and data[12:28] == BIGOBJ_CLSID:
+        (nsect, symptr, nsyms) = struct.unpack_from('<III', data, 44)
+        sect_off = 56
+        symsize, secfmt = 20, '<8sIiHBB'
+    else:
+        (_machine, nsect, _ts, symptr, nsyms, optsize, _ch) = (
+            struct.unpack_from('<HHIIIHH', data, 0)
+        )
+        sect_off = 20 + optsize
+        symsize, secfmt = 18, '<8sIhHBB'
+    code_sections = set()
+    comdat_sections = set()
+    for i in range(nsect):
+        (ch,) = struct.unpack_from('<I', data, sect_off + 40 * i + 36)
+        if ch & IMAGE_SCN_CNT_CODE:
+            code_sections.add(i + 1)
+        if ch & IMAGE_SCN_LNK_COMDAT:
+            comdat_sections.add(i + 1)
+    strtab = symptr + nsyms * symsize
+    i = 0
+    while i < nsyms:
+        off = symptr + i * symsize
+        raw, _value, secnum, _typ, sclass, naux = struct.unpack_from(
+            secfmt, data, off
+        )
+        i += 1 + naux
+        if sclass != 2 or secnum <= 0:  # IMAGE_SYM_CLASS_EXTERNAL, defined
+            continue
+        if raw[:4] == b'\0\0\0\0':
+            (soff,) = struct.unpack_from('<I', raw, 4)
+            end = data.index(b'\0', strtab + soff)
+            name = data[strtab + soff : end].decode('latin-1')
+        else:
+            name = raw.rstrip(b'\0').decode('latin-1')
+        yield name, secnum in code_sections, secnum in comdat_sections
+
+
+def main():
+    objlist, out, dllname = sys.argv[1:4]
+    with open(objlist) as f:
+        objs = [l.strip() for l in f if l.strip()]
+    exports = {}
+    for obj in objs:
+        for name, is_code, is_comdat in read_symbols(obj):
+            if name.startswith(('.', '__imp_', '_GLOBAL__', '__real@', '_ZGV')):
+                continue
+            if name in ('DllMain', 'DllEntryPoint', 'DllMainCRTStartup'):
+                continue
+            # Header-instantiated third-party code (COMDAT) stays private;
+            # out-of-line definitions such as std::hash<DDim> are exported.
+            if is_comdat and leading_namespace(name) in FOREIGN_NAMESPACES:
+                continue
+            exports[name] = exports.get(name, False) or is_code
+    if len(exports) > 65535:
+        sys.exit(f'{dllname}: {len(exports)} exports exceed the PE limit')
+    with open(out, 'w') as f:
+        f.write(f'LIBRARY {dllname}\nEXPORTS\n')
+        for name in sorted(exports):
+            f.write(f'  {name}\n' if exports[name] else f'  {name} DATA\n')
+
+
+if __name__ == '__main__':
+    main()
