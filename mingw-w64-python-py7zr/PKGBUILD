_realname=py7zr
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.1.3
pkgrel=1
pkgdesc="Pure python 7-zip library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://pypi.org/project/py7zr/'
msys2_references=(
  'purl: pkg:pypi/py7zr'
)
license=('spdx:LGPL-2.1-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-texttable"
         "${MINGW_PACKAGE_PREFIX}-python-pycryptodomex"
         "${MINGW_PACKAGE_PREFIX}-python-brotli"
         "${MINGW_PACKAGE_PREFIX}-python-psutil"
         "${MINGW_PACKAGE_PREFIX}-python-pyppmd"
         "${MINGW_PACKAGE_PREFIX}-python-pybcj"
         "${MINGW_PACKAGE_PREFIX}-python-multivolumefile"
         "${MINGW_PACKAGE_PREFIX}-python-inflate64")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools-scm")
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('8d51894abb38355bf14881088bb97f01fe4cb5b14ebe22f66d6297668c7e1a74')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages && ${MINGW_PREFIX}/bin/python - <<'EOF'
import io, py7zr, py7zr.io
for filters in (None, [{"id": py7zr.FILTER_PPMD}], [{"id": py7zr.FILTER_X86}, {"id": py7zr.FILTER_LZMA2}]):
    buf = io.BytesIO()
    with py7zr.SevenZipFile(buf, "w", filters=filters) as z:
        z.writestr(b"hello 7z" * 100, "a.txt")
    buf.seek(0)
    factory = py7zr.io.BytesIOFactory(1 << 20)
    with py7zr.SevenZipFile(buf) as z:
        z.extractall(factory=factory)
    factory.products["a.txt"].seek(0)
    assert factory.products["a.txt"].read() == b"hello 7z" * 100
EOF
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
