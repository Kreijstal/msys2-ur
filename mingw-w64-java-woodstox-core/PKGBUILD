# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-woodstox-core
pkgname=("${MINGW_PACKAGE_PREFIX}-java-woodstox-core")
pkgver=6.5.1
pkgrel=1
pkgdesc="woodstox-core Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/FasterXML/woodstox'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-bnd-annotation"
             "${MINGW_PACKAGE_PREFIX}-java-msv-core"
             "${MINGW_PACKAGE_PREFIX}-java-osgi-core"
             "${MINGW_PACKAGE_PREFIX}-java-stax2-api")
source=('https://repo.maven.apache.org/maven2/com/fasterxml/woodstox/woodstox-core/6.5.1/woodstox-core-6.5.1-sources.jar'
         'https://repo.maven.apache.org/maven2/com/fasterxml/woodstox/woodstox-core/6.5.1/woodstox-core-6.5.1.pom')
noextract=('woodstox-core-6.5.1-sources.jar'
         'woodstox-core-6.5.1.pom')
sha256sums=('b38b99fbd3fdc8acd843a9ffc2fcc6be54158dcd233c6d5a8397181f16caaac4'
         '4839654e16b1714e74f51abcb378d8356814ab8f4d5273d1dd2f1ce8a390addc')
_artifacts=('com.fasterxml.woodstox:woodstox-core:6.5.1')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module com.fasterxml.woodstox:woodstox-core:6.5.1 upstream/woodstox-core \
    -r resources/woodstox-core -u woodstox-core-6.5.1.pom -- \
    org.codehaus.woodstox:stax2-api org.osgi:osgi.core/provided? biz.aQute.bnd:biz.aQute.bnd.annotation/provided? net.java.dev.msv:msv-core?
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.codehaus.woodstox:stax2-api --with org.osgi:osgi.core --with biz.aQute.bnd:biz.aQute.bnd.annotation --with net.java.dev.msv:msv-core com.fasterxml.woodstox:woodstox-core
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-woodstox-core() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-stax2-api")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.fasterxml.woodstox:woodstox-core
  _license woodstox-core 6.5.1
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
