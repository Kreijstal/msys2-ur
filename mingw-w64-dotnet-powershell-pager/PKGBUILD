# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-powershell-pager
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.0.0
pkgrel=1
pkgdesc='Complete source Microsoft.PowerShell.Pager NuGet package for .NET8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/PowerShell/Pager'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131-2" 'python')
checkdepends=("${MINGW_PACKAGE_PREFIX}-powershell-module-test-host>=7.4.20-2")
options=('!strip' '!lto')
source=("pager-$pkgver.tar.gz::https://codeload.github.com/PowerShell/Pager/tar.gz/refs/tags/v$pkgver"
        prepare.py
        build.sh
        check.sh
        prepare-tests.py
        Check.cs
        verify-restored.py
        inspect.sh
        InspectApi.cs
        InspectIdentity.cs
        published-provenance.json
        README.md
)
