prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/Pager-$pkgver" "$srcdir/prepared"; }
build() { bash "$srcdir/build.sh" "$srcdir/prepared"; }
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/Pager-$pkgver" "$srcdir/prepared/feed"; }
package() {
  install -Dm644 "$srcdir/prepared/feed/Microsoft.PowerShell.Pager.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/Microsoft.PowerShell.Pager.$pkgver.nupkg"
  install -Dm644 "$srcdir/prepared/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -m644 "$srcdir/prepared/source-inventory.json" "$srcdir/published-provenance.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
}
