# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-bcnencoder
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.1.0
pkgrel=1
pkgdesc='Source-built BCnEncoder.Net block-compression texture encoder/decoder for the .NET 8 offline feed'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/Nominom/BCnEncoder.NET'
license=('spdx:MIT OR Unlicense')
_commit=8027552bca81cd61699bb445cf2845a440731ed7
_tree=BCnEncoder.NET-${_commit}
_project=BCnEnc.Net/BCnEncoder.csproj
_id=BCnEncoder.Net
_framework=net8.0
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-toolkit-highperformance>=7.0.2")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" 'python')
options=('!strip' '!lto')
source=("bcnencoder-8027552bca81cd61699bb445cf2845a440731ed7.tar.gz::https://codeload.github.com/Nominom/BCnEncoder.NET/tar.gz/8027552bca81cd61699bb445cf2845a440731ed7" prepare.py check.cs)
sha256sums=('f46c7937b4bd7f4c28dce1c896c4c2cc3a4204448a29557e82927bb1acfa2aa1'
            '0f42fff8db138c15ef0519a56effcb779c1f3182ae962948a79ab34d7f219157'
            '05d66823200f8419c523a933932ec12d49865796833cd482785bb948533fe4e1')

_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" bcnencoder "$srcdir/$_tree"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  cd "$srcdir/$_tree"
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$_project" -c Release -o "$(cygpath -m "$srcdir/feed")" \
    --configfile "$(cygpath -m "$srcdir/NuGet.config")" -p:PackageId="$_id" -p:PackageVersion="$pkgver" \
    -p:Version="$pkgver" -p:GeneratePackageOnBuild=false \
    -p:AssemblyVersion=2.1.0.0 -p:FileVersion=2.1.0.0 -p:InformationalVersion="$pkgver+$_commit" \
    -p:RepositoryCommit="$_commit" -p:IncludeSymbols=false -p:RestoreSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" \
    -p:EnablePackageValidation=false -p:WarningsAsErrors= -p:EnableNETAnalyzers=false -p:NuGetAudit=false -p:UseSharedCompilation=false -v:minimal
}
check() {
  _env
  mkdir -p "$srcdir/check"
  cp "$srcdir/check.cs" "$srcdir/check/Program.cs"
  cat > "$srcdir/check/check.csproj" <<PROJECT
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>$_framework</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="$_id" Version="[$pkgver]" /></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" run --project "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    -p:RestoreSources="$(cygpath -m "$srcdir/feed")%3B$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" -p:UseSharedCompilation=false
}
package() {
  install -Dm644 "$srcdir/feed/$_id.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${_id,,}.$pkgver.nupkg"
  install -Dm644 "$srcdir/$_tree/LICENSE-MIT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE-MIT"
  install -Dm644 "$srcdir/$_tree/UNLICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/UNLICENSE"
  install -Dm644 "$srcdir/$_tree/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
}
