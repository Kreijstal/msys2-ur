prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/roslyn-analyzers-$_commit" "$srcdir/prepared"; }
build() { bash "$srcdir/build.sh" "$srcdir/roslyn-analyzers-$_commit" "$srcdir/prepared"; }
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed" "$srcdir/prepared/package/payload/source-build"; }
package_dotnet-netanalyzers() {
 install -Dm644 "$srcdir/feed/Microsoft.CodeAnalysis.NetAnalyzers.$_nugetver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.codeanalysis.netanalyzers.$_nugetver.nupkg"
 install -Dm644 "$srcdir/roslyn-analyzers-$_commit/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-netanalyzers/License.txt"
 install -m644 "$srcdir/roslyn-analyzers-$_commit/assets/ThirdPartyNotices.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-netanalyzers/ThirdPartyNotices.txt"
 for file in README.md ExpectedAssemblies.json ExpectedLegacyEmpty.json ExpectedGeneratedAssets.json UpstreamFixtures.json published-metadata-provenance.json;do
  install -Dm644 "$srcdir/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-netanalyzers/$file"
 done
 for file in source-items.json localization.json removed-binaries.json fixtures.json;do
  install -m644 "$srcdir/prepared/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-netanalyzers/$file"
 done
}
package_dotnet-sdk-netanalyzers() {
 pkgdesc='Source-built implicit .NET analyzers and compiler selection for source SDK8.0.131'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131-2" "${MINGW_PACKAGE_PREFIX}-dotnet-netanalyzers=$pkgver")
 local target="$pkgdir$MINGW_PREFIX/lib/dotnet/sdk/8.0.131/Sdks/Microsoft.NET.Sdk/analyzers" name language
 for name in Microsoft.CodeAnalysis.NetAnalyzers Microsoft.CodeAnalysis.CSharp.NetAnalyzers Microsoft.CodeAnalysis.VisualBasic.NetAnalyzers;do
  install -Dm644 "$srcdir/prepared/$name/bin/Release/net8.0/$name.dll" "$target/$name.dll"
 done
 for language in cs de es fr it ja ko pl pt-BR ru tr zh-Hans zh-Hant;do
  install -Dm644 "$srcdir/prepared/Microsoft.CodeAnalysis.NetAnalyzers/bin/Release/net8.0/$language/Microsoft.CodeAnalysis.NetAnalyzers.resources.dll" "$target/$language/Microsoft.CodeAnalysis.NetAnalyzers.resources.dll"
 done
 install -Dm644 "$srcdir/prepared/generated/buildTransitive/Microsoft.CodeAnalysis.NetAnalyzers.props" "$target/build/SourceBuild.NetAnalyzers.Default.props"
 install -Dm644 "$srcdir/prepared/generated/buildTransitive/Microsoft.CodeAnalysis.NetAnalyzers.targets" "$target/build/SourceBuild.NetAnalyzers.targets"
 install -m644 "$srcdir/SourceBuild.NetAnalyzers.props" "$target/build/SourceBuild.NetAnalyzers.props"
 mkdir -p "$target/build/config"
 cp "$srcdir/prepared/generated/globalconfig/"*.globalconfig "$target/build/config/"
 install -Dm644 "$srcdir/roslyn-analyzers-$_commit/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-sdk-netanalyzers/License.txt"
 install -m644 "$srcdir/roslyn-analyzers-$_commit/assets/ThirdPartyNotices.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-sdk-netanalyzers/ThirdPartyNotices.txt"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-sdk-netanalyzers/README.md"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
