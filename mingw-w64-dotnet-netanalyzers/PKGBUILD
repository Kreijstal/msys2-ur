pkgdesc='Full source-built SDK-selected .NET analyzers and CSharp/VisualBasic code fixes'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/roslyn-analyzers'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-visualbasic-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-visualbasic-compiler>=4.9.2")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'mingw-w64-ucrt-x86_64-mono>=6.12.0.199' 'python')
options=('!strip' '!lto')
