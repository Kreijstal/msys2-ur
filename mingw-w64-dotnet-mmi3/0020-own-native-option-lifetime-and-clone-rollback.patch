--- a/Native/MI_OptionResource.cs
+++ b/Native/MI_OptionResource.cs
@@ -0,0 +1,48 @@
+// Native option contents belong to successful factory/clone results. Borrowed
+// wrappers own only their HGlobal pointer cell. This managed state is outside
+// every native MI structure layout.
+using System;
+
+namespace Microsoft.Management.Infrastructure.Native
+{
+    internal abstract class MI_OptionResource<T> : MI_NativeObjectWithFT<T> where T : new()
+    {
+        private readonly object cleanupGate = new object();
+        private bool ownsNative;
+        private bool deleted;
+
+        protected MI_OptionResource(bool isDirect) : base(isDirect) { }
+        protected MI_OptionResource(IntPtr existingPtr) : base(existingPtr) { }
+
+        internal void OwnNativeLifetime() { ownsNative = true; }
+        protected abstract void DeleteNative();
+
+        internal void Delete()
+        {
+            lock (cleanupGate)
+            {
+                if (deleted) return;
+                deleted = true;
+                ownsNative = false;
+                try { DeleteNative(); }
+                finally { GC.KeepAlive(this); }
+            }
+        }
+
+        ~MI_OptionResource()
+        {
+            try { Dispose(); } catch { /* Cleanup failures cannot escape a finalizer. */ }
+        }
+
+        public override void Dispose()
+        {
+            // A failed base constructor can leave only a wrapper allocation.
+            if (cleanupGate == null) { base.Dispose(); return; }
+            lock (cleanupGate)
+            {
+                try { if (ownsNative) Delete(); }
+                finally { base.Dispose(); GC.SuppressFinalize(this); }
+            }
+        }
+    }
+}
