+            // No managed fields may be added to this sequential native layout.
+            // The delegate closure owns buffers for this one synchronous call.
+            internal void SetIncludedFileContent(Func<string, byte[]> callback)
+            {
+                var buffers = new HashSet<IntPtr>();
+                getIncludedFileContent = (IntPtr context, string name, out IntPtr buffer, out uint length) =>
+                {
+                    buffer = IntPtr.Zero;
+                    length = 0;
+                    IntPtr allocated = IntPtr.Zero;
+                    try
+                    {
+                        byte[] content = callback(name);
+                        if (content == null) return MI_Result.MI_RESULT_NOT_FOUND;
+                        allocated = Marshal.AllocHGlobal(Math.Max(1, content.Length));
+                        Marshal.Copy(content, 0, allocated, content.Length);
+                        lock (buffers) buffers.Add(allocated);
+                        buffer = allocated;
+                        length = checked((uint)content.Length);
+                        return MI_Result.MI_RESULT_OK;
+                    }
+                    catch
+                    {
+                        if (allocated != IntPtr.Zero) Marshal.FreeHGlobal(allocated);
+                        return MI_Result.MI_RESULT_FAILED;
+                    }
+                };
+                freeIncludedFileContent = (context, buffer) =>
+                {
+                    lock (buffers)
+                    {
+                        if (buffer != IntPtr.Zero)
+                        {
+                            if (buffers.Remove(buffer)) Marshal.FreeHGlobal(buffer);
+                        }
+                        else
+                        {
+                            foreach (IntPtr pending in buffers) Marshal.FreeHGlobal(pending);
+                            buffers.Clear();
+                        }
+                    }
+                };
+            }
+
+            public void Dispose()
+            {
+                // Native parsers may abandon pending includes after an error.
+                freeIncludedFileContent?.Invoke(IntPtr.Zero, IntPtr.Zero);
+            }
         }
