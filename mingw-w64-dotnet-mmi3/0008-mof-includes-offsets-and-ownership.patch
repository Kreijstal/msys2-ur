+        // The native extended array owns its children. Clone each result before
+        // deleting that array, and keep callback delegates/options/schema alive
+        // for the entire synchronous parser call (including re-entrant callbacks).
+        private T[] DeserializeHandleArray<T>(byte[] data, ref uint offset,
+            IEnumerable<CimClass> cimClasses, OnClassNeeded classCallback,
+            GetIncludedFileContent includeCallback, bool classes, string computerName,
+            string namespaceName, Func<IntPtr, T> wrap, Func<T, T> clone, Action<T> delete)
+            where T : MI_NativeObject
+        {
+            if (data == null) throw new ArgumentNullException("serializedData");
+            if (offset >= data.Length) throw new ArgumentOutOfRangeException(nameof(offset));
+            AssertNotDisposed();
+            var schemas = cimClasses?.Select(value => value.ClassHandle).ToArray();
+            var callbacks = new MI_DeserializerCallbacks();
+            if (classCallback != null) callbacks.classObjectNeeded = CreateClassObjectNeededCallbackDelegate(classCallback);
+            if (includeCallback != null) callbacks.includedFileContent = name => includeCallback(name);
+            using var options = GetOperationOptions();
+            MI_ExtendedArray array = null;
+            MI_Instance error = null;
+            T[] result = null;
+            int cloned = 0;
+            bool transferred = false;
+            try
+            {
+                uint used;
+                MI_Result status;
+                unsafe
+                {
+                    fixed (byte* pointer = data)
+                    {
+                        IntPtr input = new IntPtr(pointer + offset);
+                        uint length = (uint)data.Length - offset;
+                        status = classes
+                            ? _myHandle.DeserializeClassArray(MI_SerializerFlags.None,
+                                options.OperationOptionsHandle, callbacks, input, length, schemas,
+                                computerName, namespaceName, out used, out array, out error)
+                            : _myHandle.DeserializeInstanceArray(MI_SerializerFlags.None,
+                                options.OperationOptionsHandle, callbacks, input, length, schemas,
+                                out used, out array, out error);
+                    }
+                }
+                CimException.ThrowIfMiResultFailure(status, error != null && !error.IsNull ? error : null);
+                if (used == 0 || used > data.Length - offset)
+                    throw new InvalidOperationException("The native MOF deserializer returned an invalid input length.");
+                T[] borrowed = array != null && !array.IsNull
+                    ? array.ReadAsManagedPointerArray(wrap) : Array.Empty<T>();
+                result = new T[borrowed.Length];
+                try
+                {
+                    for (; cloned < borrowed.Length; cloned++) result[cloned] = clone(borrowed[cloned]);
+                }
+                finally { foreach (T value in borrowed) value?.Dispose(); }
+                offset = checked(offset + used);
+                transferred = true;
+                return result;
