_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/$_tree" "$srcdir/mmi" --patched --public-sign
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$(cygpath -m "$srcdir/mmi/Mmi.csproj")" -c Release \
    -o "$(cygpath -m "$srcdir/feed")" --configfile "$(cygpath -m "$srcdir/NuGet.config")" \
    -p:PackageId="$_id" -p:PackageVersion="$_nugetver" -p:Version="$_nugetver" \
    -p:RepositoryUrl="$url" -p:RepositoryCommit="$_commit" -p:PackageLicenseExpression=MIT \
    -p:PackageDescription="$pkgdesc" -p:GeneratePackageOnBuild=false -p:UseSharedCompilation=false -v:minimal
}
check() {
  _env
  bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"
  bash "$srcdir/check-api.sh" "$srcdir/check" "$srcdir/check-api"
  bash "$srcdir/check-mof.sh" "$srcdir/check-mof" "$srcdir/feed"
  bash "$srcdir/check-mof-semantics.sh" "$srcdir/check-mof-semantics" "$srcdir/feed"
  bash "$srcdir/check-embedded-values.sh" "$srcdir/check-embedded-values" "$srcdir/feed"
  bash "$srcdir/check-delivery-options.sh" "$srcdir/check-delivery-options" "$srcdir/feed"
  bash "$srcdir/check-metadata-ownership.sh" "$srcdir/check-metadata-ownership" "$srcdir/feed"
  bash "$srcdir/check-class-clone-rollback.sh" "$srcdir/check-class-clone-rollback" "$srcdir/feed"
  bash "$srcdir/check-instance-clone-rollback.sh" "$srcdir/check-instance-clone-rollback" "$srcdir/feed"
  bash "$srcdir/check-class-lifetime.sh" "$srcdir/check-class-lifetime" "$srcdir/feed"
  bash "$srcdir/check-transient-metadata.sh" "$srcdir/check-transient-metadata" "$srcdir/feed"
  bash "$srcdir/check-qualifier-lookup.sh" "$srcdir/check-qualifier-lookup" "$srcdir/feed"
  bash "$srcdir/check-instance-call-lifetime.sh" "$srcdir/check-instance-call-lifetime" "$srcdir/feed"
  bash "$srcdir/check-session-options.sh" "$srcdir/check-session-options" "$srcdir/feed"
  bash "$srcdir/check-option-finalization.sh" "$srcdir/check-option-finalization" "$srcdir/feed"
  bash "$srcdir/check-execution-context.sh" "$srcdir/check-execution-context" "$srcdir/feed"
  bash "$srcdir/check-error-ownership.sh" "$srcdir/check-error-ownership" "$srcdir/feed"
  bash "$srcdir/check-sync-results.sh" "$srcdir/check-sync-results" "$srcdir/feed"
}

package() {
  install -Dm644 "$srcdir/feed/$_id.$_nugetver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${_id,,}.$_nugetver.nupkg"
  install -Dm644 "$srcdir/$_tree/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/ExpectedApi.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/ExpectedApi.json"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
}
