# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=libfontenc
pkgver=1.1.9
pkgrel=1
pkgdesc="X11 font encoding library"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('spdx:MIT')
depends=('zlib')
makedepends=('gcc'
             'pkgconf'
             'xorg-util-macros'
             # configure.ac calls XORG_FONTROOTDIR, which lives in font-util's
             # fontutil.m4. Without it the autoreconf below fails in aclocal
             # ("must install X.Org font-util 1.1 or later"), configure is never
             # regenerated, and the build silently falls back to the tarball's
             # stock libtool - which names the DLL cygfontenc-1.dll instead of
             # msys-fontenc-1.dll. That is not a naming nit: libXfont2 records
             # the name in its import table.
             'font-util'
             'xorgproto'
             'autoconf'
             'automake'
             'libtool')
source=("https://xorg.freedesktop.org/releases/individual/lib/${pkgname}-${pkgver}.tar.xz")
sha256sums=('9d8392705cb10803d5fe1d27d236cbab3f664e26841ce01916bbbe430cf273e2')

prepare() {
  cd "${pkgname}-${pkgver}"

  # Regenerate configure so the build below uses the guest's MSYS2-patched
  # libtool.m4, whose cygwin branch renames lib -> msys- rather than cyg.
  autoreconf -vif
}

build() {
  cd "${pkgname}-${pkgver}"

  # MSYS2's own /etc/makepkg.conf declares CHOST=x86_64-pc-cygwin for the MSYS
  # environment: MSYS2 is a Cygwin fork, and its patched libtool.m4 renames
  # lib -> msys- inside libtool's cygwin branch, so this is the supported path.
  # Do NOT substitute config.guess's "x86_64-pc-msys" - stock libtool has no msys
  # case (its Windows branch matches only cygwin*|mingw*|windows*|pw32*|cegcc*),
  # so an *-msys host falls through to the default branch, which sets
  # build_libtool_libs=no and an empty library_names_spec. That yields a STATIC
  # ARCHIVE ONLY, produced silently with configure still exiting 0;
  # --enable-shared does not override it, the triple decides. --build is passed
  # identically so autoconf does not read this as a cross build: CC stays the
  # msys gcc, only libtool's behaviour changes.
  local _host="${CHOST:?CHOST unset - /etc/makepkg.conf was not sourced}"

  ./configure \
    --prefix=/usr \
    --build=${_host} \
    --host=${_host} \
    --disable-static

  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"

  # A libtool static-only degradation is silent: configure and make both still
  # exit 0, so nothing above this line can fail on it. Assert on the artifacts
  # instead. This matters beyond this package -- libtool also degrades a
  # dependent library to static when one of its dependencies has no import
  # library, so one static result quietly propagates down the whole chain.
  ls "${pkgdir}"/usr/bin/msys-*.dll >/dev/null 2>&1 || {
    echo "ERROR: ${pkgname} built static-only (no DLL installed)" >&2; return 1; }
  local _a _base
  for _a in "${pkgdir}"/usr/lib/lib*.a; do
    [ -e "${_a}" ] || continue
    case "${_a}" in *.dll.a) continue;; esac
    _base=$(basename "${_a}" .a)
    [ -f "${pkgdir}/usr/lib/${_base}.dll.a" ] || {
      echo "ERROR: ${_base} built static-only (no import library)" >&2; return 1; }
  done
}
