_srcdir="Ardour-${pkgver}.0"

apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Np1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${_srcdir}"
  apply_patch_with_msg \
    0001-Link-fftw3f_threads-for-MinGW-builds.patch \
    0002-Strip-absolute-source-root-path-from-build-info.patch \
    0003-Keep-using-the-bundled-qm-dsp-with-use-external-libs.patch \
    0004-mingw-point-GTK_PATH-at-Ardour-s-module-directory.patch \
    0005-pbd-test-port-Windows-timer-test-to-get_microseconds.patch \
    0006-pbd-test-copy-the-saved-locale-name-in-LocaleGuard.patch \
    0007-dummy-backend-link-system-libltc-with-use-external-l.patch \
    0008-temporal-test-use-GLib-s-PRNG-in-TimelineTest.patch \
    0009-pbd-initialize-RWLock-s-shared_mutex-eagerly-on-MinG.patch \
    0010-pbd-test-skip-the-reader-preference-RWLock-test-on-W.patch \
    0011-ardour-test-fix-the-MinGW-CPPUNIT_ASSERT_DOUBLES_EQU.patch \
    0012-pbd-test-accept-two-digit-float-exponents-on-Windows.patch \
    0013-Don-t-crash-when-GLib-knows-no-system-config-dir-on-.patch \
    0014-Find-the-bundled-VAMP-plugins-from-headless-tools-on.patch \
    0015-Use-mingw-x86-intrinsics-flags-when-building-with-cl.patch \
