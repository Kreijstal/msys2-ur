    0021-temporal-test-don-t-abort-an-update-that-was-never-s.patch
}

build() {
  local _backends="portaudio,dummy"
  if [[ ${MINGW_PACKAGE_PREFIX} != *-clang-* ]]; then
    _backends+=",jack"
  fi

  local _waf_configure_options=(
    --prefix="${MINGW_PREFIX}"
    --configdir="${MINGW_PREFIX}/share"
    --check-c-compiler="${CC}"
    --check-cxx-compiler="${CXX}"
    --dist-target=mingw
    --cxx17
    --freedesktop
    --no-phone-home
    --optimize
    --ptformat
    --test
    --use-external-libs
    --with-backends="${_backends}"
    --out="${srcdir}/build-${MSYSTEM}"
  )

  # waf treats CC/CXX from the environment as absolute paths.
  unset CC CXX
  export WAF_NO_PREFORK=1
  export LINKFLAGS="${LDFLAGS}"

  cd "${_srcdir}"
  /usr/bin/python waf configure "${_waf_configure_options[@]}"
  /usr/bin/python waf build
}

_ardour_test_env() {
  local _b="${srcdir}/build-${MSYSTEM}"
  local _s="${srcdir}/${_srcdir}"
  local _libs="${_b}/libs"

  # Uninstalled build: point Ardour at the build tree (cf. ardev_common.sh)
  # and make every freshly built DLL loadable.
  PATH="$(find "${_libs}" -name '*.dll' -printf '%h\n' | sort -u | tr '\n' ':')${PATH}"
  export PATH
  export ARDOUR_DLL_PATH="$(cygpath -m "${_libs}")"
  export ARDOUR_BACKEND_PATH="$(cygpath -m "${_libs}/backends/dummy")"
  export ARDOUR_PANNER_PATH="$(cygpath -m "${_libs}/panners")"
  export ARDOUR_SURFACES_PATH="$(cygpath -m "${_libs}/surfaces/generic_midi")"
  export ARDOUR_DATA_PATH="$(cygpath -wp "${_s}/share:${_b}:${_s}/gtk2_ardour:${_b}/gtk2_ardour")"
  export ARDOUR_CONFIG_PATH="${ARDOUR_DATA_PATH}"
  # also marks this as a source-tree run, so the dummy backend is listed
  export ARDOUR_THEMES_PATH="$(cygpath -m "${_s}/gtk2_ardour/themes")"
  export ARDOUR_TEST_PATH="$(cygpath -m "${_s}/libs/ardour/test/data")"
  export PBD_TEST_PATH="$(cygpath -m "${_s}/libs/pbd/test")"
  export EVORAL_TEST_PATH="$(cygpath -m "${_s}/libs/evoral/test/testdata")"
  export MIDIPP_TEST_PATH="$(cygpath -m "${_s}/share/patchfiles")"
  # keep the user's real Ardour configuration out of the tests
  export LOCALAPPDATA="$(cygpath -m "${srcdir}/test-home")"
  export APPDATA="${LOCALAPPDATA}"
  export XDG_CONFIG_HOME="${LOCALAPPDATA}"
  export XDG_DATA_HOME="${LOCALAPPDATA}"
  export XDG_CACHE_HOME="${LOCALAPPDATA}"
  export TMP="$(cygpath -m "${srcdir}/test-home")"
  export TEMP="${TMP}"
  mkdir -p "${srcdir}/test-home"
}

check() {
  _ardour_test_env
  local _b="${srcdir}/build-${MSYSTEM}"

  # CppUnit suites of the core libraries.
  local _t
  for _t in pbd temporal evoral midi++2 audiographer ardour; do
    msg2 "Running libs/${_t} unit tests"
    (cd "${_b}/libs/${_t}" && ./run-tests.exe)
  done

  # Headless end-to-end run of the Lua session tool with the dummy backend.
  msg2 "Running headless session create/export test"
  local _t_dir="${srcdir}/test-session"
  rm -rf "${_t_dir:?}"
  "${_b}/luasession/ardour${pkgver%%.*}-lua.exe" \
    "$(cygpath -m "${srcdir}/headless-session-test.lua")" \
    "$(cygpath -m "${_t_dir}/smoke")" "$(cygpath -m "${_t_dir}/export")" \
    | tee "${srcdir}/headless-session-test.log"
  grep -q '^HEADLESS-SESSION-TEST-OK$' "${srcdir}/headless-session-test.log"
  test -f "${_t_dir}/smoke/smoke.ardour"
  # 2 s of -30 dBFS uniform noise, mono track panned centre:
  # expect about -37.8 dBFS RMS and a peak of about 0.022
  /usr/bin/python "${srcdir}/check-export.py" "${_t_dir}/export/smoke.wav" 2 -40 0.025
}

package() {
  cd "${_srcdir}"
  /usr/bin/python waf i18n --destdir="${pkgdir}"
  /usr/bin/python waf install --destdir="${pkgdir}"

  local _major=${pkgver%%.*}
  local _p="${pkgdir}${MINGW_PREFIX}"
  local _dlldir="${_p}/lib/${_realname}${_major}"

  # Windows Ardour derives its data (share/ardour9) and module
  # (lib/ardour9) directories from the location of the running .exe,
  # which therefore has to live in bin/ next to Ardour's own DLLs,
  # like in the upstream installer (tools/x-win/package.sh).
  rm -f "${_p}/bin/${_realname}${_major}"
  # suil's GTK2-in-Win32 UI wrapper is loaded from SUIL_MODULE_DIR=<dll-dir>/suil
  install -d "${_dlldir}/suil"
  mv "${_dlldir}/suil_win_in_gtk2.dll" "${_dlldir}/suil/"
  mv "${_dlldir}"/*.dll "${_p}/bin/"
  mv "${_dlldir}/ardour-${pkgver}.0.exe" "${_p}/bin/${_realname}${_major}.exe"
  mv "${_dlldir}/hardour-${pkgver}.0.exe" "${_p}/bin/h${_realname}${_major}.exe"
  mv "${_dlldir}"/ardour-vst*-scanner.exe "${_p}/bin/"
  # Ardour refers to its VAMP plugins as libardourvampplugins:<id> etc.
  mv "${_dlldir}"/vamp/ardourvampplugins*.dll "${_dlldir}/vamp/libardourvampplugins.dll"
  mv "${_dlldir}"/vamp/ardourvamppyin*.dll "${_dlldir}/vamp/libardourvamppyin.dll"
  find "${_p}" \( -name '*.dll.a' -o -name '*.a' \) -delete

  install -vDm644 "${_realname}.1" -t "${_p}/share/man/man1/"
  if [[ -d "${_p}/share/appdata" ]]; then
    mv "${_p}/share/appdata" "${_p}/share/metainfo"
  fi

  # Upstream ships the MIDI loops as a separate, unversioned zip.
  unzip -q "${srcdir}/${_realname}-midi-${pkgver}.zip" \
    -d "${_p}/share/${_realname}${_major}/media/"

  install -vDm644 COPYING "${_p}/share/licenses/${_realname}/COPYING"
}
