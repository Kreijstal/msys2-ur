pkgname="${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-visualbasic-workspaces"
pkgver=4.9.2
pkgrel=1
_commit=9934fb9e3527e1c0c51314e57d4aab30f97e8f9e
pkgdesc='Complete source-built Roslyn Visual Basic Workspaces services and resources for .NET 8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/roslyn'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-common=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-visualbasic=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-workspaces-common=$pkgver")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("roslyn-$pkgver.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/$_commit"
        prepare.py build.sh Check.cs check.sh check-api.sh InspectApi.cs InspectMetadata.cs InspectServices.cs ExpectedApi.json ExpectedMetadata.json ExpectedServices.json published-metadata-provenance.json README.md)
sha256sums=('e01ea67aaec6408de51a0a4c18a7e15b2a527ca7a853c9a0a7742cb5680aeb30'
            '606840e554f004ee9d0a6bbc6f9c6dfefc96af159482b9b59018da14bfa94fdf'
