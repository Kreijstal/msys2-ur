prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/roslyn-$_commit" "$srcdir/prepared"; }
build() { bash "$srcdir/build.sh" "$srcdir/prepared"; }
check() {
 bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/prepared/localization.json" "$srcdir/prepared/source-items.json" "$srcdir/feed"
 bash "$srcdir/check-api.sh" "$srcdir/check" "$srcdir/check-api"
}
package() {
 install -Dm644 "$srcdir/feed/Microsoft.CodeAnalysis.VisualBasic.Workspaces.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.codeanalysis.visualbasic.workspaces.$pkgver.nupkg"
 for name in License.txt THIRD-PARTY-NOTICES.txt;do
  install -Dm644 "$srcdir/roslyn-$_commit/$name" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-codeanalysis-visualbasic-workspaces/$name"
 done
 for name in README.md ExpectedApi.json ExpectedMetadata.json ExpectedServices.json published-metadata-provenance.json;do
  install -Dm644 "$srcdir/$name" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-codeanalysis-visualbasic-workspaces/$name"
 done
 for name in localization.json source-items.json removed-binaries.json;do
  install -m644 "$srcdir/prepared/$name" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-codeanalysis-visualbasic-workspaces/$name"
 done
}
