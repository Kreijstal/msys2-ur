# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-corelib10-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.5
pkgrel=1
pkgdesc='Original source linked CoreLib10 and corerun bootstrap with installed native CLR'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-coreclr10-bootstrap=10.0.5")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-runtime10-generators=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-illink10-bootstrap=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja" "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-uasm" "${MINGW_PACKAGE_PREFIX}-python" 'python' 'patch')
options=('!strip' '!lto' '!buildflags' '!debug')
source=('runtime-v10.0.5.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.5'
        'corelib10-bootstrap-source-1.tar.gz'
        'arcade-runtime10-4bf37ce6.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/4bf37ce670528cf2aef4d9b1cd892554b1b02d9d')
noextract=('runtime-v10.0.5.tar.gz' 'arcade-runtime10-4bf37ce6.tar.gz')
sha256sums=('1692acae5e3adfd625452fbc9db4fd4e982c10e38189358ae245c74dd5514d7a'
            '3dc6f25b8b8e3662b9bec8783e0f9651066a3c06a72da9bafa75d0d01162ec04'
            '82f5f6dd63c0dcf3c0fc49b282207db5d889d9cc0939589d43b16c7fcfdf7d66')
prepare() {
  /usr/bin/python3 "$srcdir/corelib10-workflow/prepare.py" "$srcdir" >"$srcdir/prepare.log" 2>&1
}
build() {
  bash "$srcdir/corelib10-workflow/build.sh" "$srcdir" >"$srcdir/build.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/corelib10-workflow/check.py" "$srcdir" "$srcdir/managed-check" >"$srcdir/check.log" 2>&1
  /usr/bin/python3 "$srcdir/corelib10-workflow/audit.py" "$srcdir" >"$srcdir/audit.log" 2>&1
}
package() {
  local target="$pkgdir$MINGW_PREFIX/lib/dotnet-bootstrap10/corelib/10.0.5"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$target" "$doc"
  install -m644 "$srcdir/corelib10-1/rewrite/linked/System.Private.CoreLib.dll" "$srcdir/corelib10-1/rewrite/linked/System.Private.CoreLib.pdb" "$target/"
  install -m755 "$srcdir/coreclr-build/hosts/corerun/corerun.exe" "$target/"
  install -m644 "$srcdir/corelib10-workflow/README.md" "$doc/"
  install -m644 "$srcdir/corelib10-1/corelib/"{source-inputs,compile-inputs,source-audit,metadata-raw,metadata-linked}.json "$doc/"
  install -m644 "$srcdir/corelib10-1/rewrite/"{rewrite-inputs,rewrite-results,api-audit}.json "$doc/"
  install -m644 "$srcdir/managed-check/results.json" "$doc/build-managed-results.json"
  install -Dm644 "$srcdir/r/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE.TXT"
  install -Dm644 "$srcdir/r/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.TXT"
  install -Dm644 "$srcdir/Arcade-LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Arcade-LICENSE.TXT"
}
