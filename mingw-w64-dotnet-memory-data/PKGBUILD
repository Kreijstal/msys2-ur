_realname=dotnet-memory-data
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.0.2
pkgrel=1
_commit=7e3cf643977591e9041f4c628fd4d28237398e0b
pkgdesc='Complete original BinaryData source library for the Azure/PowerShell graph'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/Azure/azure-sdk-for-net'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-system-text-json8>=8.0.5")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" 'python')
checkdepends=("${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2")
options=('!strip' '!lto')
source=("azure-sdk-$_commit.tar.gz::https://codeload.github.com/Azure/azure-sdk-for-net/tar.gz/$_commit"
 extract.py
 prepare.py
 verify-build.py
 pack.py
 Check.cs
 check.sh
