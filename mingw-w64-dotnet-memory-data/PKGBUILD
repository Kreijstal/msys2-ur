 compare.py
 InspectApi.cs
 InspectAssemblyMetadata.cs
 git-tree-provenance.json
 published-identity.json
 published-api.json
 published-metadata.json
 README.md
)
noextract=("azure-sdk-$_commit.tar.gz")
