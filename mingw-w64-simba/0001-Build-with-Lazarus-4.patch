From 426c28bfd6069ac61be2b1e67adb5e3839818be2 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Tue, 27 Oct 2026 10:29:24 +0100
Subject: [PATCH 1/4] Build with Lazarus 4

Simba 1400 targets Lazarus 2.2.  Two LCL changes break it with 4.x:

* LazUtils' GraphType now declares its own TPointArray (array of TPoint).
  simba.bitmap_misc and simba.ocrutil use GraphType in the implementation
  section, so it shadows Simba's TPointArray from simba.mufasatypes and
  the method/forward declarations no longer match their bodies.  Alias
  the type back right after the implementation uses clauses.
* TCustomImageList.AddMultipleResolutions gained a TRasterImage overload
  next to the TCustomBitmap one, so an array of TBitmap is ambiguous.
  Cast the elements to TCustomBitmap.
---
 Source/forms/simba.main.pas  | 2 +-
 Source/simba.bitmap_misc.pas | 5 +++++
 Source/simba.ocrutil.pas     | 5 +++++
 3 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/Source/forms/simba.main.pas b/Source/forms/simba.main.pas
index b4c8ea9..095c739 100644
--- a/Source/forms/simba.main.pas
+++ b/Source/forms/simba.main.pas
@@ -703,7 +703,7 @@ procedure TSimbaForm.DoPackageMenuBuildingFinished(Sender: TObject);
     with PackageImageList.ResolutionByIndex[1] do
       Draw(bmp32.Canvas, bmp32.Width - Width, bmp32.Height - Height, Min(Count - 1, Num));
 
-    Result := Images.AddMultipleResolutions([bmp16, bmp24, bmp32]);
+    Result := Images.AddMultipleResolutions([TCustomBitmap(bmp16), TCustomBitmap(bmp24), TCustomBitmap(bmp32)]);
 
     bmp16.Free();
     bmp24.Free();
diff --git a/Source/simba.bitmap_misc.pas b/Source/simba.bitmap_misc.pas
index 30dd272..c20d539 100644
--- a/Source/simba.bitmap_misc.pas
+++ b/Source/simba.bitmap_misc.pas
@@ -51,6 +51,11 @@ implementation
 uses
   BMPcomn, GraphType;
 
+// Lazarus 4 GraphType declares its own TPointArray (array of TPoint);
+// keep resolving to Simba's, which the interface section uses.
+type
+  TPointArray = simba.mufasatypes.TPointArray;
+
 type
   PARGB = ^TARGB;
   TARGB = packed record
diff --git a/Source/simba.ocrutil.pas b/Source/simba.ocrutil.pas
index 80d91cf..408616b 100644
--- a/Source/simba.ocrutil.pas
+++ b/Source/simba.ocrutil.pas
@@ -75,6 +75,11 @@ uses
   graphtype, intfgraphics,graphics;
   {End To-Remove unit}
 
+// Lazarus 4 GraphType declares its own TPointArray (array of TPoint);
+// keep resolving to Simba's, which the interface section uses.
+type
+  TPointArray = simba.mufasatypes.TPointArray;
+
 {initalizes the remaining fields from a TocrGlyphMask and finds the global bounds}
 
 {
