# Maintainer: kreijstal <kreijstal@hotmail.com>
pkgname=libpng
pkgver=1.6.43
pkgrel=1
pkgdesc='A collection of routines used to create PNG format graphics files'
url='http://www.libpng.org/pub/png/libpng.html'
license=('custom')
depends=('zlib' 'zlib-devel' 'sh' 'make' 'gcc')
source=("https://downloads.sourceforge.net/sourceforge/$pkgname/$pkgname-$pkgver.tar.xz"
        "msys_locale.patch")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  patch -Np1 -i "$srcdir/msys_locale.patch"
  autoreconf -vif
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  # Force the Cygwin host triple. libtool has no host_os=msys case: an *-msys
  # host falls through to the default branch, sets build_libtool_libs=no and
  # emits a STATIC ARCHIVE ONLY - silently, with configure still exiting 0. The
  # host triple is decisive; --enable-shared cannot override it.
  #
  # (The previous `# --enable-shared` here was inert regardless: it followed a
  # line-continuation backslash, so it collapsed onto the configure line and
  # commented itself out.)
  #
  # freetype links libpng, and libtool degrades a -no-undefined library to
  # static whenever a dependency lacks a .dll.a - so a static libpng would drag
  # freetype down with it.
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --build=x86_64-pc-cygwin \
    --host=x86_64-pc-cygwin \
    --enable-shared \
    --enable-static


  make
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  make check
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  install -D -m0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  cd contrib/pngminus
  make PNGLIB_SHARED="-L$pkgdir/usr/lib -lpng" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" png2pnm pnm2png
  install -m0755 png2pnm pnm2png "$pkgdir/usr/bin/"
}
