# Maintainer: Kreijstal <rainb@tfwno.gf>

# Eclipse LSP4J 1.0.0: the JSON-RPC implementation and the Language Server
# Protocol bindings, built with javac instead of Gradle.
#
# org.eclipse.lsp4j's protocol classes are written in Xtend (Protocol.xtend
# and a few adapters) and generated at build time by the Xtend compiler with
# LSP4J's active annotations; Xtend cannot be bootstrapped here, so the Java
# that the Xtend compiler generated for the release is taken from the
# release's -sources jar (only the files that are not in the git tree; the
# hand-written sources come from the tag).  Everything else, including
# org.eclipse.lsp4j.jsonrpc, is built from the git tag.

_realname=eclipse-lsp4j
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-eclipse-lsp4j-jsonrpc"
         "${MINGW_PACKAGE_PREFIX}-eclipse-lsp4j")
pkgver=1.0.0
pkgrel=1
_qualifier=v20260209-1721
pkgdesc="Eclipse LSP4J, Java bindings for the Language Server Protocol (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/eclipse-lsp4j/lsp4j'
license=('spdx:EPL-2.0 OR BSD-3-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-gson"
             "${MINGW_PACKAGE_PREFIX}-eclipse-orbit-gson")
source=("lsp4j-${pkgver}.tar.gz::https://github.com/eclipse-lsp4j/lsp4j/archive/refs/tags/v${pkgver}.tar.gz"
        "https://repo1.maven.org/maven2/org/eclipse/lsp4j/org.eclipse.lsp4j/${pkgver}/org.eclipse.lsp4j-${pkgver}-sources.jar")
sha256sums=('3e6e495edff5cdaf61078bc6bb6f9c6b860280573bd96b67c0a0c863d26c9e80'
            'e5a5ed6ddc23508af07700b79217212376ddcd45f7e8dffbd29c8aecf8de8944')
noextract=("org.eclipse.lsp4j-${pkgver}-sources.jar")

_src=lsp4j-${pkgver}

prepare() {
  find "${_src}" -type f \( -name '*.jar' -o -name '*.class' \) -delete
  # the Java generated from the Xtend sources (not in the git tree)
  rm -rf xtend-gen && mkdir -p xtend-gen-all xtend-gen
  (cd xtend-gen-all && jar --extract --file "$(cygpath -m "${srcdir}/org.eclipse.lsp4j-${pkgver}-sources.jar")")
  local f
  (cd xtend-gen-all && find org -name '*.java') | while read -r f; do
    [[ -f ${_src}/org.eclipse.lsp4j/src/main/java/$f ]] && continue
    mkdir -p "xtend-gen/$(dirname "$f")"
    cp "xtend-gen-all/$f" "xtend-gen/$f"
  done
  rm -rf xtend-gen-all
}

_bnd() {
  cat <<EOF
Bundle-SymbolicName: $1
Bundle-Name: $1
Bundle-Version: ${pkgver}.${_qualifier}
Bundle-Vendor: Eclipse LSP4J
Bundle-RequiredExecutionEnvironment: JavaSE-11
-exportcontents: org.eclipse.lsp4j.*
-exportversion: ${pkgver}
Import-Package: com.google.gson.*;version="[2.9.1,3.0)",*
EOF
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  local JB_RELEASE=11
  _bnd org.eclipse.lsp4j.jsonrpc > "${srcdir}/jsonrpc.bnd"
  jb_module org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc:${pkgver} org.eclipse.lsp4j.jsonrpc/src/main/java \
    -r org.eclipse.lsp4j.jsonrpc/src/main/resources -b "${srcdir}/jsonrpc.bnd" \
    -- com.google.code.gson:gson
  _bnd org.eclipse.lsp4j > "${srcdir}/lsp4j.bnd"
  jb_module org.eclipse.lsp4j:org.eclipse.lsp4j:${pkgver} org.eclipse.lsp4j/src/main/java -s "${srcdir}/xtend-gen" \
    -r org.eclipse.lsp4j/src/main/resources -b "${srcdir}/lsp4j.bnd" \
    -- org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc org.eclipse.lsp4j:org.eclipse.lsp4j
  # upstream JSON-RPC tests (JUnit 4; the tests use Java 17)
  local JB_RELEASE=17
  cd "${_src}/org.eclipse.lsp4j.jsonrpc"
  jb_test lsp4j.jsonrpc src/test/java -r src/test/resources -- org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc
}

package_eclipse-lsp4j-jsonrpc() {
  pkgdesc="Eclipse LSP4J JSON-RPC, bundle org.eclipse.lsp4j.jsonrpc (mingw-w64)"
  depends=("${MINGW_PACKAGE_PREFIX}-java-gson" "${MINGW_PACKAGE_PREFIX}-eclipse-orbit-gson")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar lsp4j-jsonrpc --plugin org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc
  install -Dm644 "${srcdir}/${_src}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/eclipse-lsp4j-jsonrpc/LICENSE"
}

package_eclipse-lsp4j() {
  pkgdesc="Eclipse LSP4J Language Server Protocol bindings, bundle org.eclipse.lsp4j (mingw-w64)"
  depends=("${MINGW_PACKAGE_PREFIX}-eclipse-lsp4j-jsonrpc")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar lsp4j --plugin org.eclipse.lsp4j:org.eclipse.lsp4j
  install -Dm644 "${srcdir}/${_src}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/eclipse-lsp4j/LICENSE"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
