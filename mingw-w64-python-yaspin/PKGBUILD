# Contributor: Kreijstal <elektrischrainbow@gmail.com>

_realname=yaspin
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=3.5.1
pkgrel=1
pkgdesc="Yet Another Terminal Spinner (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://github.com/pavdmyt/yaspin'
msys2_repository_url='https://github.com/pavdmyt/yaspin'
msys2_references=(
  'purl: pkg:pypi/yaspin'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-termcolor")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-poetry-core")
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('5cb55fb774eae3543fdd30b5958c46e348dfd316a8b289c9f8db2c6f8a511846')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  # Test the built wheel, not the source tree.
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  local _site=( "${PWD}"/chk${MINGW_PREFIX}/lib/python3*/site-packages )
  export PYTHONPATH="$(cygpath -w "${_site[0]}")"
  ${MINGW_PREFIX}/bin/python - <<'PY'
import io, time
from yaspin import yaspin
from yaspin.spinners import Spinners
with yaspin(Spinners.line, text="working") as sp:
    time.sleep(0.2)
    sp.ok("done")
print("yaspin ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
