# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=plexus-cipher
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=2.0
pkgrel=1
pkgdesc="Plexus cipher used for Maven password encryption, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/codehaus-plexus/plexus-cipher'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-java-javax-inject")
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-sisu-inject")
checkdepends=("${MINGW_PACKAGE_PREFIX}-java-junit4")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/codehaus-plexus/plexus-cipher/archive/refs/tags/${_realname}-${pkgver}.tar.gz")
sha256sums=('99b45a9f1b434529cc397116cf6f52ab7a29659f1dc05a0937c73e25596a67fd')

_src=${_realname}-${_realname}-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  # Sisu index of the @Named cipher (sisu-maven-plugin upstream)
  jb_module org.codehaus.plexus:plexus-cipher:${pkgver} src/main/java -u pom.xml -P sisu \
    -c org.eclipse.sisu:org.eclipse.sisu.inject -- javax.inject:javax.inject
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  jb_loadcheck org.codehaus.plexus:plexus-cipher
  unzip -p "$(jb_jarpath org.codehaus.plexus:plexus-cipher)" META-INF/sisu/javax.inject.Named \
    | grep -q DefaultPlexusCipher
  jb_test plexus-cipher src/test/java -- org.codehaus.plexus:plexus-cipher
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.codehaus.plexus:plexus-cipher
}
