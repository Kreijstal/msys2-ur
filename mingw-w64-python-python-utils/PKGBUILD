_realname=python-utils
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=4.2.0
pkgrel=1
pkgdesc="Convenient utilities not included with the standard Python install (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://pypi.org/project/python-utils/'
msys2_references=(
  'purl: pkg:pypi/python-utils'
)
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-typing_extensions")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-uv-build")
source=("https://files.pythonhosted.org/packages/source/p/${_realname}/python_utils-${pkgver}.tar.gz")
sha256sums=('f3d53b05640136e5eb2e685840e084071347f127f9bf30ddd05c81a6d00f01ad')

build() {
  cp -r python_utils-${pkgver} python-build-${MSYSTEM} && cd python-build-${MSYSTEM}
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd python-build-${MSYSTEM}
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
from python_utils import converters, formatters
assert converters.to_int("abc123def", regexp=True) == 123
assert formatters.camel_to_underscore("SpamEggsAndBacon") == "spam_eggs_and_bacon"
print("python-utils ok")
PY
}

package() {
  cd python-build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
