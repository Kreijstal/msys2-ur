# Maintainer: Kreijstal <rainb@tfwno.gf>

# Hamcrest 1.3, the matcher library JUnit 4 depends on, built from source
# without Ant or Maven.  The sugar classes CoreMatchers and Matchers are
# generated by hamcrest-generator as upstream does, but without QDox (it
# only added javadoc and parameter names to the generated source).

_realname=hamcrest
pkgbase=mingw-w64-java-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-java-hamcrest-core"
         "${MINGW_PACKAGE_PREFIX}-java-hamcrest-library")
pkgver=1.3
pkgrel=1
pkgdesc="Hamcrest matchers for Java (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://hamcrest.org/JavaHamcrest/'
msys2_repository_url='https://github.com/hamcrest/JavaHamcrest'
license=('spdx:BSD-3-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/hamcrest/JavaHamcrest/archive/refs/tags/hamcrest-java-${pkgver}.tar.gz"
        '0001-generator-build-without-QDox.patch'
        '0002-core-explicit-type-arguments-for-Java-8-inference.patch')
sha256sums=('6ac31de50c6f3b047a7bd7f62ab7ca3e88b2a8449d22b0978c9f575740d0e085'
            'b3ac9824d629574913b6b91d57efd132ece07b3fbcbe4f569dfd9fdc55acb5aa'
            'a28628e69c1ae90fc221f0e2d43ee9a885a3b44f742e2b1e5aede4f444f3b85e')

_src=JavaHamcrest-hamcrest-java-${pkgver}

prepare() {
  cd "${_src}"
  # bundled third-party jars (easymock, jmock, junit, qdox, testng, ...)
  find . -name '*.jar' -print -delete
  local p
  for p in "${srcdir}"/0*.patch; do
    patch -p1 -i "${p}"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  local b="${srcdir}/build"
  rm -rf "${b}"
  mkdir -p "${b}"/{core,generator,library,gen-core,gen-library}

  jb_javac -d "$(jb_w "${b}/core")" -- hamcrest-core/src/main/java
  jb_javac -d "$(jb_w "${b}/generator")" -cp "$(jb_w "${b}/core")" \
    -- hamcrest-generator/src/main/java

  # org.hamcrest.CoreMatchers
  java -cp "$(jb_w "${b}/core");$(jb_w "${b}/generator")" \
    org.hamcrest.generator.config.XmlConfigurator \
    core-matchers.xml hamcrest-core/src/main/java org.hamcrest.CoreMatchers \
    "$(jb_w "${b}/gen-core")" > /dev/null
  jb_javac -d "$(jb_w "${b}/core")" -cp "$(jb_w "${b}/core")" -- "${b}/gen-core"

  jb_javac -d "$(jb_w "${b}/library")" -cp "$(jb_w "${b}/core")" \
    -- hamcrest-library/src/main/java
  # org.hamcrest.Matchers
  java -cp "$(jb_w "${b}/core");$(jb_w "${b}/generator");$(jb_w "${b}/library")" \
    org.hamcrest.generator.config.XmlConfigurator \
    matchers.xml hamcrest-core/src/main/java,hamcrest-library/src/main/java \
    org.hamcrest.Matchers "$(jb_w "${b}/gen-library")" > /dev/null
  jb_javac -d "$(jb_w "${b}/library")" -cp "$(jb_w "${b}/core");$(jb_w "${b}/library")" \
    -- "${b}/gen-library"

  local m
  for m in core library; do
    cp LICENSE.txt "${b}/${m}/"   # in upstream's jars too
    JB_GAV=org.hamcrest:hamcrest-${m}:${pkgver} JB_UPSTREAM_POM=pom/hamcrest-${m}.pom \
      jb_jar "${b}/hamcrest-${m}.jar" "${b}/${m}"
  done
  jb_pom "${b}/hamcrest-core.pom" org.hamcrest hamcrest-core ${pkgver} -n "Hamcrest Core"
  jb_stage org.hamcrest:hamcrest-core:${pkgver} "${b}/hamcrest-core.pom" "${b}/hamcrest-core.jar"
  jb_pom "${b}/hamcrest-library.pom" org.hamcrest hamcrest-library ${pkgver} \
    -n "Hamcrest library" -- org.hamcrest:hamcrest-core
  jb_stage org.hamcrest:hamcrest-library:${pkgver} "${b}/hamcrest-library.pom" \
    "${b}/hamcrest-library.jar"
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream's unit tests need JUnit, which is built on top of this package
  jb_loadcheck org.hamcrest:hamcrest-core org.hamcrest:hamcrest-library
  # the generated sugar is complete
  unzip -l "${srcdir}/build/hamcrest-core.jar" | grep -q 'org/hamcrest/CoreMatchers.class'
  unzip -l "${srcdir}/build/hamcrest-library.jar" | grep -q 'org/hamcrest/Matchers.class'
}

package_java-hamcrest-core() {
  pkgdesc="Hamcrest core matchers for Java (mingw-w64)"
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.hamcrest:hamcrest-core
  install -Dm644 "${_src}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-hamcrest-core/LICENSE.txt"
}

package_java-hamcrest-library() {
  pkgdesc="Hamcrest library of matchers for Java (mingw-w64)"
  depends=("${MINGW_PACKAGE_PREFIX}-java-hamcrest-core")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.hamcrest:hamcrest-library
  install -Dm644 "${_src}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-hamcrest-library/LICENSE.txt"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
