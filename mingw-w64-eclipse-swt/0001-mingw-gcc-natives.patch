diff -ruN "a/bundles/org.eclipse.swt/Eclipse SWT PI/win32/library/gdip_mingw.h" "b/bundles/org.eclipse.swt/Eclipse SWT PI/win32/library/gdip_mingw.h"
--- "a/bundles/org.eclipse.swt/Eclipse SWT PI/win32/library/gdip_mingw.h"
+++ "b/bundles/org.eclipse.swt/Eclipse SWT PI/win32/library/gdip_mingw.h"
@@ -0,0 +1,60 @@
+/*
+ * GDI+ C++ API methods that the MinGW-w64 gdiplus headers do not implement
+ * (TextureBrush::GetImage, Pen::GetBrush, PathGradientBrush::SetGraphicsPath),
+ * written against the flat API like Microsoft's headers.  The wrapper classes
+ * keep their GDI+ handles in private members; they are reached through
+ * explicit template instantiation, which C++ exempts from access checking.
+ *
+ * SPDX-License-Identifier: EPL-2.0
+ */
+#ifndef SWT_GDIP_MINGW_H
+#define SWT_GDIP_MINGW_H
+
+namespace swt_mingw {
+template <typename Tag, typename Tag::type M> struct Rob {
+	friend typename Tag::type get(Tag) { return M; }
+};
+struct BrushNative { typedef Gdiplus::GpBrush *Gdiplus::Brush::*type; friend type get(BrushNative); };
+template struct Rob<BrushNative, &Gdiplus::Brush::nativeBrush>;
+struct PenNative { typedef Gdiplus::GpPen *Gdiplus::Pen::*type; friend type get(PenNative); };
+template struct Rob<PenNative, &Gdiplus::Pen::nativePen>;
+struct PathNative { typedef Gdiplus::GpPath *Gdiplus::GraphicsPath::*type; friend type get(PathNative); };
+template struct Rob<PathNative, &Gdiplus::GraphicsPath::nativePath>;
+struct ImageNative { typedef Gdiplus::GpImage *Gdiplus::Image::*type; friend type get(ImageNative); };
+template struct Rob<ImageNative, &Gdiplus::Image::nativeImage>;
+}
+
+/* PathGradientBrush::SetGraphicsPath */
+static inline Gdiplus::Status SWT_GDIP_PathGradientBrush_SetGraphicsPath(Gdiplus::PathGradientBrush *brush, Gdiplus::GraphicsPath *path)
+{
+	using namespace swt_mingw;
+	if (path == NULL) return Gdiplus::InvalidParameter;
+	return Gdiplus::DllExports::GdipSetPathGradientPath((Gdiplus::GpPathGradient *)(brush->*get(BrushNative())),
+		path->*get(PathNative()));
+}
+
+/* Pen::GetBrush: a new Brush object that owns the pen's brush fill */
+static inline Gdiplus::Brush *SWT_GDIP_Pen_GetBrush(Gdiplus::Pen *pen)
+{
+	using namespace swt_mingw;
+	Gdiplus::GpBrush *native = NULL;
+	if (Gdiplus::DllExports::GdipGetPenBrushFill(pen->*get(PenNative()), &native) != Gdiplus::Ok || native == NULL) return NULL;
+	Gdiplus::SolidBrush *brush = new Gdiplus::SolidBrush(Gdiplus::Color());
+	Gdiplus::DllExports::GdipDeleteBrush(brush->*get(BrushNative()));
+	brush->*get(BrushNative()) = native;
+	return brush;
+}
+
+/* TextureBrush::GetImage: a new Image object that owns the texture's image */
+static inline Gdiplus::Image *SWT_GDIP_TextureBrush_GetImage(Gdiplus::TextureBrush *brush)
+{
+	using namespace swt_mingw;
+	Gdiplus::GpImage *native = NULL;
+	if (Gdiplus::DllExports::GdipGetTextureImage((Gdiplus::GpTexture *)(brush->*get(BrushNative())), &native) != Gdiplus::Ok || native == NULL) return NULL;
+	Gdiplus::Bitmap *image = new Gdiplus::Bitmap(1, 1, PixelFormat32bppARGB);
+	Gdiplus::DllExports::GdipDisposeImage(image->*get(ImageNative()));
+	image->*get(ImageNative()) = native;
+	return image;
+}
+
+#endif
