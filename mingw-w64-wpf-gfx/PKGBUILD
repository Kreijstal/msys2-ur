_patches=("0001-wpfgfx-make-friend-functions-and-dependent-base-name.patch"
          "0002-wpfgfx-use-standard-template-specialization-and-inst.patch"
          "0003-wpfgfx-replace-__if_exists-uses-clang-cannot-express.patch"
          "0004-wpfgfx-avoid-other-MSVC-only-constructs.patch"
          "0005-wpfgfx-fix-declarations-that-only-link-with-MSVC.patch"
          "0006-wpfgfx-build-against-mingw-w64-headers.patch")

prepare() {
  rm -rf "${srcdir}/wpf-${pkgver}"
  tar -xzf "${srcdir}/wpf-${pkgver}.tar.gz" -C "${srcdir}" \
    "wpf-${pkgver}/LICENSE.TXT" \
    "wpf-${pkgver}/src/Microsoft.DotNet.Wpf/src/WpfGfx" \
    "wpf-${pkgver}/src/Microsoft.DotNet.Wpf/src/Shared"

  cd "${srcdir}/wpf-${pkgver}"
  local _p
  for _p in "${_patches[@]}"; do
    patch -Np1 -i "${srcdir}/${_p}"
  done

  local _g="${srcdir}/wpf-${pkgver}/src/Microsoft.DotNet.Wpf/src/WpfGfx"
  # The D3DX/ShaderGen-generated text shader tokens are replaced by fxasm.py
  # output; keep upstream's copy aside only to compare against in check().
  mv "${_g}/core/hw/Shaders.rc" "${_g}/core/hw/Shaders.rc.upstream"
  cp "${srcdir}/CMakeLists.txt" "${_g}/"
  mkdir -p "${_g}/mingw/codeanalysis"
  cp "${srcdir}"/{NativeVersion.rc,wpf_mingw_compat.h,wpfgfx_mingw_compat.h,winnt.h,wpp_stub.h,dllcrt_alias.cpp,wpfgfx_mingw_shims.cpp,fxasm.py,gendef.py} "${_g}/mingw/"
  cp "${srcdir}/sourceannotations.h" "${_g}/mingw/codeanalysis/"
}

build() {
  cd "${srcdir}/wpf-${pkgver}/src/Microsoft.DotNet.Wpf/src/WpfGfx"

  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # clang in both environments: WpfGfx needs -fms-compatibility
  CC=clang CXX=clang++ \
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -B "build-${MSYSTEM}" \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DWPF_VERSION="${pkgver}" \
      "${_extra_config[@]}"
  "${MINGW_PREFIX}/bin/cmake.exe" --build "build-${MSYSTEM}"
}

check() {
  local _g="${srcdir}/wpf-${pkgver}/src/Microsoft.DotNet.Wpf/src/WpfGfx"
  local _b="${_g}/build-${MSYSTEM}"
  cd "${srcdir}"
  # fxasm.py must reproduce the text shader tokens upstream ships
  "${MINGW_PREFIX}/bin/python" fxasm.py --check "${_g}/core/hw/Shaders.rc.upstream" \
    Text11A="${_g}/core/hw/shaders/hlslTextShaders11A.fx" \
    Text11L="${_g}/core/hw/shaders/hlslTextShaders11L.fx" \
    Text20A="${_g}/core/hw/shaders/hlslTextShaders20A.fx" \
    Text20L="${_g}/core/hw/shaders/hlslTextShaders20L.fx"
  # every name in wpfgfx.def must be exported and resolvable
  ${CC:-cc} -O2 exporttest.c -o exporttest.exe
  ./exporttest.exe "${_b}/wpfgfx_cor3.dll" "${_b}/gen/wpfgfx.def"
  # version handshake + embedded shader resources
  ${CC:-cc} -O2 gfxtest.c -o gfxtest.exe
  ./gfxtest.exe "${_b}/wpfgfx_cor3.dll"
}

package() {
  cd "${srcdir}/wpf-${pkgver}/src/Microsoft.DotNet.Wpf/src/WpfGfx"
  install -Dm755 "build-${MSYSTEM}/wpfgfx_cor3.dll" "${pkgdir}${MINGW_PREFIX}/bin/wpfgfx_cor3.dll"
  install -Dm644 "${srcdir}/wpf-${pkgver}/LICENSE.TXT" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.TXT"
}
