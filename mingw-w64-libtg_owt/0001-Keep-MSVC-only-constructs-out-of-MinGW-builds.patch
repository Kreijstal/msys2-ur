From 949a0df565cc7eb4a1eeb70ffe4d1029bf408780 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Sun, 25 Oct 2026 21:48:41 +0100
Subject: [PATCH 1/3] Keep MSVC-only constructs out of MinGW builds

Three spots in rtc_base assume that a Windows build is an MSVC build:

* platform_thread_types.cc names the thread a second time by raising the
  0x406D1388 debugger exception inside __try/__except. GCC has no SEH
  keywords. The legacy exception only matters to debuggers that predate
  SetThreadDescription(), which the code above already calls, so leave
  it to MSVC.

* windows_version.cc rejects compilers older than VS 2017 15.3 by testing
  _MSC_FULL_VER, which is undefined (0) for GCC, so every MinGW build hits
  the #error.

* rtc_export_template.h sanity-checks that __declspec(dllexport) maps to
  the "MSVC hack" export style. In mingw-w64 __declspec is a macro that
  expands to __attribute__ before the token pasting runs, so the style is
  DEFAULT and the static_assert fails to parse. The hack itself is never
  selected there, only the self-test breaks.
---
 src/rtc_base/platform_thread_types.cc     | 2 ++
 src/rtc_base/system/rtc_export_template.h | 2 ++
 src/rtc_base/win/windows_version.cc       | 2 +-
 3 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/rtc_base/platform_thread_types.cc b/src/rtc_base/platform_thread_types.cc
index 74e732f0..30451b95 100644
--- a/src/rtc_base/platform_thread_types.cc
+++ b/src/rtc_base/platform_thread_types.cc
@@ -99,6 +99,7 @@ void SetCurrentThreadName(const char* name) {
     set_thread_description_func(::GetCurrentThread(), wide_thread_name);
   }
 
+#if defined(_MSC_VER)
   // For details see:
   // https://docs.microsoft.com/en-us/visualstudio/debugger/how-to-set-a-thread-name-in-native-code
 #pragma pack(push, 8)
@@ -118,6 +119,7 @@ void SetCurrentThreadName(const char* name) {
   } __except (EXCEPTION_EXECUTE_HANDLER) {  // NOLINT
   }
 #pragma warning(pop)
+#endif  // defined(_MSC_VER)
 #elif defined(WEBRTC_LINUX) || defined(WEBRTC_ANDROID)
   prctl(PR_SET_NAME, reinterpret_cast<unsigned long>(name));  // NOLINT
 #elif defined(WEBRTC_FREEBSD)
diff --git a/src/rtc_base/system/rtc_export_template.h b/src/rtc_base/system/rtc_export_template.h
index 4ac70438..4856f805 100644
--- a/src/rtc_base/system/rtc_export_template.h
+++ b/src/rtc_base/system/rtc_export_template.h
@@ -185,7 +185,9 @@
 
 RTC_EXPORT_TEMPLATE_TEST(DEFAULT, );  // NOLINT
 RTC_EXPORT_TEMPLATE_TEST(DEFAULT, __attribute__((visibility("default"))));
+#if defined(_MSC_VER)
 RTC_EXPORT_TEMPLATE_TEST(MSVC_HACK, __declspec(dllexport));
+#endif
 RTC_EXPORT_TEMPLATE_TEST(DEFAULT, __declspec(dllimport));
 
 #undef RTC_EXPORT_TEMPLATE_TEST
diff --git a/src/rtc_base/win/windows_version.cc b/src/rtc_base/win/windows_version.cc
index 93af1377..3a91d03b 100644
--- a/src/rtc_base/win/windows_version.cc
+++ b/src/rtc_base/win/windows_version.cc
@@ -17,7 +17,7 @@
 #include "rtc_base/checks.h"
 #include "rtc_base/string_utils.h"
 
-#if !defined(__clang__) && _MSC_FULL_VER < 191125507
+#if defined(_MSC_VER) && !defined(__clang__) && _MSC_FULL_VER < 191125507
 #error VS 2017 Update 3.2 or higher is required
 #endif
 
