_realname=libtg_owt
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
# The revision Telegram Desktop builds against is pinned in tdesktop's
# Telegram/build/prepare/prepare.py (stage 'tg_owt') and in its snapcraft.yaml.
# This one is what tdesktop v7.3.3 expects.
_commit=07fb35bc33b3e79125a1beab7690e830f183f5d8
# The bundled libyuv submodule at the revision tg_owt pins.
_libyuv_commit=04821d1e7d60845525e8db55c7bcd41ef5be9406
pkgver=r502.07fb35b
pkgrel=1
pkgdesc="WebRTC fork used by Telegram Desktop (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/desktop-app/tg_owt'
msys2_repository_url='https://github.com/desktop-app/tg_owt'
msys2_references=(
  'archlinux: libtg_owt'
)
license=('spdx:BSD-3-Clause')
# Static library only (see build()), so everything it links against is
# needed by whoever links it in turn.
depends=("${MINGW_PACKAGE_PREFIX}-abseil-cpp"
         "${MINGW_PACKAGE_PREFIX}-crc32c"
         "${MINGW_PACKAGE_PREFIX}-ffmpeg"
         "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
         "${MINGW_PACKAGE_PREFIX}-libsrtp"
         "${MINGW_PACKAGE_PREFIX}-libvpx"
         "${MINGW_PACKAGE_PREFIX}-openh264"
         "${MINGW_PACKAGE_PREFIX}-openssl"
         "${MINGW_PACKAGE_PREFIX}-opus")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             'git')
options=('staticlibs')
source=("git+https://github.com/desktop-app/tg_owt.git#commit=${_commit}"
        "git+https://gitlab.com/chromiumsrc/libyuv.git#commit=${_libyuv_commit}"
        "0001-Keep-MSVC-only-constructs-out-of-MinGW-builds.patch"
        "0002-Include-cstdint-where-fixed-width-integers-are-used.patch"
        "0003-Build-the-WGC-capture-session-with-mingw-w64-headers.patch"
        "smoke-test.cc")
sha256sums=('3bda4b8d3c3c6797d2adc1acb55c6a04842706eee112ff27950ce0438f239611'
            '33810d30dcd83520e16e0be2ddc1eec0dc2c3154f32c8d103c2988a43f7ada78'
