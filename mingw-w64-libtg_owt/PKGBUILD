            '03a7c608129914e2436a13724b541766fd3ef132d560d3b1df764ea6ed0a296a'
            '8be480ea478131db94cbbbcbf9f23fd0c343f234ba343393384ae98c2fa80916')

prepare() {
  cd "${srcdir}/tg_owt"

  # abseil-cpp, libsrtp and crc32c come from MSYS2 (tg_owt's packaged build
  # picks them up when found), so only the libyuv submodule is needed.
  git submodule init src/third_party/libyuv
  git config submodule.src/third_party/libyuv.url "${srcdir}/libyuv"
  git -c protocol.file.allow=always submodule update src/third_party/libyuv

  # SEH, an _MSC_FULL_VER check and an export-macro self-test assume MSVC.
  patch -Np1 -i "${srcdir}/0001-Keep-MSVC-only-constructs-out-of-MinGW-builds.patch"
  # GCC 16's libstdc++ no longer pulls in <cstdint> transitively.
  patch -Np1 -i "${srcdir}/0002-Include-cstdint-where-fixed-width-integers-are-used.patch"
  # Keep Windows.Graphics.Capture: replace the one WRL::Callback (mingw-w64
  # has no <wrl/event.h>) and the namespaced IID constants it lacks.
  patch -Np1 -i "${srcdir}/0003-Build-the-WGC-capture-session-with-mingw-w64-headers.patch"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # Upstream only supports a static build; the shared one is explicitly
  # "community maintained, may and will break".
  # https://github.com/desktop-app/tg_owt/issues/75#issuecomment-992061171
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${_extra_config[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -S tg_owt \
      -B "build-${MSYSTEM}"

  "${MINGW_PREFIX}/bin/cmake.exe" --build "build-${MSYSTEM}"
}

check() {
  # No upstream test suite is built by the CMake port, so link a small
  # program against the library through its installed CMake package and run
  # it: this proves the static archive and its exported link interface are
  # complete, and exercises the desktop capture code the patches touch.
  local _stage="${srcdir}/check-root"
  rm -rf "${_stage:?}" "${srcdir}/smoke-build"
  DESTDIR="${_stage}" "${MINGW_PREFIX}/bin/cmake.exe" --install "build-${MSYSTEM}" >/dev/null

  mkdir -p "${srcdir}/smoke"
  cp "${srcdir}/smoke-test.cc" "${srcdir}/smoke/"
  cat > "${srcdir}/smoke/CMakeLists.txt" <<'END'
cmake_minimum_required(VERSION 3.16)
project(tg_owt_smoke CXX)
find_package(tg_owt REQUIRED)
add_executable(tg_owt_smoke smoke-test.cc)
target_link_libraries(tg_owt_smoke PRIVATE tg_owt::tg_owt)
END

  "${MINGW_PREFIX}/bin/cmake.exe" -GNinja \
    -DCMAKE_PREFIX_PATH="$(cygpath -m "${_stage}${MINGW_PREFIX}")" \
    -S "${srcdir}/smoke" -B "${srcdir}/smoke-build"
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/smoke-build"
  "${srcdir}/smoke-build/tg_owt_smoke.exe"
}

package() {
  DESTDIR="${pkgdir}" "${MINGW_PREFIX}/bin/cmake.exe" --install "build-${MSYSTEM}"

  install -Dm644 "${srcdir}/tg_owt/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
