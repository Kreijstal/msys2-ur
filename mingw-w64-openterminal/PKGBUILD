# Maintainer: OpenTerminal MSYS2 packagers

_realname=openterminal
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.1.0.r244.g327bc8e
pkgrel=1
_commit=327bc8ed19159f86c4d2b81ee899621dc64b9843
_bundle_commit=0af5c9ab18011f6211a400273fd09d411d4ae07d
_bundle="${_realname}-${_bundle_commit}-ucrt64.tar.zst"
_release="openterminal-windows-20260828"
# OpenTerminal's own XAML runtime (phase3/xamlcore), cross-compiled from the
# exact source commit below with mingw-w64 GCC:
#     python3 -B phase3/scripts/build_xamlcore.py --dll-only --no-xvfb
_xaml_commit=327bc8ed19159f86c4d2b81ee899621dc64b9843
_xamlcore="openxaml-${_xaml_commit}.dll"
_profile_icon="powershell-profile-${_xaml_commit}.png"
pkgdesc="Experimental open-toolchain Windows Terminal research deployment (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url="https://github.com/Kreijstal/openterminal"
msys2_repository_url="${url}"
license=('custom' 'Apache-2.0' 'BSD-2-Clause' 'BSD-3-Clause' 'CC-BY-ND-4.0' 'ICU' 'MIT' 'OFL-1.1' 'Unlicense')
options=('!strip' '!debug')
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs")
source=(
  "${_realname}-${_commit}.tar.gz::${url}/archive/${_commit}/${_realname}-${_commit}.tar.gz"
  "${_bundle}::https://github.com/Kreijstal/msys2-ur/releases/download/${_release}/${_bundle}"
  "${_xamlcore}::https://github.com/Kreijstal/msys2-ur/releases/download/${_release}/${_xamlcore}"
  "${_profile_icon}::https://github.com/Kreijstal/msys2-ur/releases/download/${_release}/${_profile_icon}"
  'openterminal'
  'openterminal.cmd'
  'README.package.md'
  '0001-declare-smoke-resource-scope.patch'
)
sha256sums=(
  '3d3b5a010654ef131c7d4755d4e0f6d29f4c8c5f8dd691dec8c00381929755e6'
  'd9cc322b2f7c5cd9f341a9d24ce037f53e1fe8f88daff8bb6a87ba423bf4f829'
  '5df1b3ecbb0e82d5e2252ead4369f0ef1e5a3e76361b26b0d0e492c978e51e6d'
  '225f69c01321d74637be8d3a041469ff141a7b50e37d529d6b185543030d86ee'
  '119cc6954d75aebe775e8d616aeb263324d0c9d0ff034abfa1fda685ef046b55'
  'dac3d423d35ce1ce891042490fba73245f69cae870bc26ab3d7adaf68382b510'
  'f6c21ce1e8de5acb6a7578ac26004808eef2317a1124c36fa7a32eca19ee4a24'
  '7ed406b31ee0824162a0d3bcc55146050a5bd93c28092d18eed4f45a70ed18f2'
)

prepare() {
  patch -d "${srcdir}/${_realname}-${_commit}" -p1 \
    < "${srcdir}/0001-declare-smoke-resource-scope.patch"
}

package() {
  local bundle="${srcdir}/openterminal-bundle"
  local appdir="${pkgdir}${MINGW_PREFIX}/lib/${_realname}"

  if [[ ! -f "${bundle}/BUNDLE-MANIFEST.sha256" ]]; then
    error "OpenTerminal bundle has no integrity manifest"
    return 1
  fi
  if ! (cd "${bundle}" && sha256sum --check --quiet BUNDLE-MANIFEST.sha256); then
    error "OpenTerminal bundle failed its integrity manifest"
    return 1
  fi

  install -d "${appdir}"
  local path
  for path in "${bundle}"/*; do
    case "${path##*/}" in
      libgcc_s_seh-1.dll|libstdc++-6.dll|libwinpthread-1.dll) continue ;;
    esac
    cp -a "${path}" "${appdir}/"
  done

  # WindowsTerminal.exe activates nine Microsoft.UI.Xaml (WinUI 2) classes,
  # starting with Microsoft.UI.Xaml.XamlTypeInfo.XamlControlsXamlMetaDataProvider.
  # WinUI 2 is not an OS component, so an unpackaged process gets
  # REGDB_E_CLASSNOTREG from RoGetActivationFactory and dies before its first
  # window with 'winrt::hresult_class_not_registered'. C++/WinRT's fallback then
  # trims the class name and LoadLibrary()s the namespace-named DLL, which is why
  # this is installed under the lookup name rather than its own: the name is the
  # activation key, not a claim of provenance. Registering openxaml.dll under its
  # real name through a registration-free WinRT <activatableClass> manifest does
  # not work here because external manifests do not populate the WinRT activation
  # context. Windows.UI.Xaml.* keeps resolving to the system implementation,
  # since the fallback only runs for classes the OS could not resolve.
  install -Dm755 "${srcdir}/${_xamlcore}" \
    "${appdir}/Microsoft.UI.Xaml.dll"
  install -Dm644 "${srcdir}/${_profile_icon}" \
    "${appdir}/ProfileIcons/{61c54bbd-c2c6-5271-96e7-009a87ff44bf}.png"

  install -Dm755 "${srcdir}/openterminal" \
    "${pkgdir}${MINGW_PREFIX}/bin/openterminal"
  install -Dm644 "${srcdir}/openterminal.cmd" \
    "${pkgdir}${MINGW_PREFIX}/bin/openterminal.cmd"
  install -Dm644 "${srcdir}/README.package.md" \
    "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README.package.md"
  install -Dm644 "${srcdir}/${_realname}-${_commit}/README.md" \
    "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README.md"

  if [[ ! -d "${bundle}/licenses" ]]; then
    error "OpenTerminal bundle has no license directory"
    return 1
  fi
  install -d "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -m644 "${bundle}/licenses"/* \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
