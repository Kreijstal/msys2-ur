prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/windowsdesktop-$pkgver.tar.gz"     "$srcdir/arcade-$_arcade.tar.gz" "$srcdir/prepared"
}
build() { /usr/bin/python3 "$srcdir/build.py" "$srcdir/prepared"; }
check() {
  /usr/bin/python3 "$srcdir/audit.py" "$srcdir/prepared"
  bash "$srcdir/check.sh" "$srcdir/prepared" "$srcdir/consumer"
}
package() {
  install -Dm644 "$srcdir/prepared/feed/microsoft.windows.compatibility.$pkgver.nupkg"     "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.windows.compatibility.$pkgver.nupkg"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$doc"
  for name in source-inputs build-audit package-audit dependency-groups; do
    install -m644 "$srcdir/prepared/$name.json" "$doc/"
  done
  for name in README.md Check.cs check.sh verify-consumer.py check-installed.sh; do
    install -m644 "$srcdir/$name" "$doc/"
  done
  install -Dm644 "$srcdir/prepared/source/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -m644 "$srcdir/prepared/Arcade-LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/"
}
