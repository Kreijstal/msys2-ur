@@ -363,3 +363,28 @@ external_deps_repository(
         "@rocm_wheels//:rocm_plugin_py_import",
     ],
 )
+
+##############################################################
+# MSYS2 MinGW-w64: the MSYS2 prefix (Python headers, C++ runtime DLLs)
+##############################################################
+new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
+
+new_local_repository(
+    name = "mingw_prefix",
+    build_file = "//build/mingw:mingw_prefix.BUILD",
+    path = "@MINGW_PREFIX@",
+)
+
+single_version_override(
+    module_name = "curl",
+    patch_strip = 1,
+    patches = ["//third_party/mingw:curl.patch"],
+    version = "8.12.0.bcr.1",
+)
+
+single_version_override(
+    module_name = "boringssl",
+    patch_strip = 1,
+    patches = ["//third_party/mingw:boringssl.patch"],
+    version = "0.20250818.0",
+)
