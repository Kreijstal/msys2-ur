             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-wheel"
             "unzip")
checkdepends=("${MINGW_PACKAGE_PREFIX}-python-opt_einsum")
options=('!strip' '!lto')
# Bazel downloads the remaining pinned dependencies (LLVM, abseil, protobuf,
# grpc, ... and the hermetic build-tool Python) itself during build().
source=("jax-${pkgver}.tar.gz::https://github.com/jax-ml/jax/archive/refs/tags/jax-v${pkgver}.tar.gz"
        "xla-${_xla_commit}.tar.gz::https://github.com/openxla/xla/archive/${_xla_commit}.tar.gz"
        "rules_ml_toolchain-${_rmt_commit}.tar.gz::https://github.com/google-ml-infra/rules_ml_toolchain/archive/${_rmt_commit}.tar.gz"
        "bazel-${_bazelver}.exe::https://github.com/bazelbuild/bazel/releases/download/${_bazelver}/bazel-${_bazelver}-windows-x86_64.exe"
