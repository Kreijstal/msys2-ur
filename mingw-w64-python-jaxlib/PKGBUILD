_jaxdir=jax-jax-v${pkgver}
_xladir=xla-${_xla_commit}
_rmtdir=rules_ml_toolchain-${_rmt_commit}

_apply_patches() {
  local _p
  for _p in "$@"; do
    [[ -f "${_p}" ]] || continue
    msg2 "Applying ${_p##*/}"
    patch -Np1 -i "${_p}"
  done
}

prepare() {
  # Contains symlinks that precede their targets, which bsdtar cannot create.
  rm -rf "${_rmtdir}"
  tar -xzf "rules_ml_toolchain-${_rmt_commit}.tar.gz"

  # Bazel with its runtime DLLs.
  mkdir -p bazel
  cp "bazel-${_bazelver}.exe" bazel/bazel.exe
  unzip -qjo "msvc_runtime-14.44.35112-cp311-cp311-win_amd64.whl" \
    'msvc_runtime-14.44.35112.data/data/Scripts/msvcp140.dll' \
    'msvc_runtime-14.44.35112.data/data/Scripts/vcruntime140.dll' \
    'msvc_runtime-14.44.35112.data/data/Scripts/vcruntime140_1.dll' -d bazel

  cd "${srcdir}/${_xladir}"
  _apply_patches "${srcdir}"/1*-xla-*.patch

  cd "${srcdir}/${_rmtdir}"
  _apply_patches "${srcdir}"/2*-rules_ml_toolchain-*.patch

  cd "${srcdir}/${_jaxdir}"
  _apply_patches "${srcdir}"/0*-jax-*.patch

  local _prefix=$(cygpath -m "${MINGW_PREFIX}")
  local _pyver=$(${MINGW_PREFIX}/bin/python -c "import sys; print('%d.%d' % sys.version_info[:2])")
  mkdir -p build/mingw
  sed -e "s|@MINGW_PREFIX@|${_prefix}|g" -e "s|@PYVER@|${_pyver}|g" \
    "${srcdir}/BUILD.bazel.in" > build/mingw/BUILD.bazel
  sed -e "s|@MINGW_PREFIX@|${_prefix}|g" -e "s|@PYVER@|${_pyver}|g" \
    "${srcdir}/mingw_prefix.BUILD" > build/mingw/mingw_prefix.BUILD
  cp "${srcdir}/cc_toolchain_config.bzl" build/mingw/
  sed -i "s|@MINGW_PREFIX@|${_prefix}|g" MODULE.bazel
}

# Bazel options; written in build() so that makepkg -e uses the same ones.
_write_bazelrc() {
  local _pyver=$(${MINGW_PREFIX}/bin/python -c "import sys; print('%d.%d' % sys.version_info[:2])")
  local _prefix=$(cygpath -m "${MINGW_PREFIX}")
  local _actpath="$(cygpath -m "${srcdir}/bazel");${_prefix}/bin;$(cygpath -m /usr/bin);C:/Windows/System32;C:/Windows"
  # Picked up by the try-import at the end of .bazelrc.
  cat > .bazelrc.user <<EOF
common:mingw --config=clang_local
common:mingw --config=clang
common:mingw --incompatible_enable_cc_toolchain_resolution
common:mingw --extra_toolchains=//build/mingw:cc_toolchain
common:mingw --extra_toolchains=//build/mingw:py_cc_toolchain
common:mingw --repo_env=HERMETIC_PYTHON_VERSION=${_pyver}
common:mingw --repo_env=ML_WHEEL_TYPE=release
# Fixed action PATH (part of every action key, so the result does not depend on
# the calling shell); bazel/ has the MSVC runtime that Bazel's own launcher
# tools need.
common:mingw --action_env=PATH=${_actpath} --host_action_env=PATH=${_actpath}
common:mingw --copt=-mavx --host_copt=-mavx
# Build tools are run by Starlark actions without PATH: have Bazel copy the
# MinGW C++ runtime DLLs next to every executable (see mingw_prefix.BUILD).
common:mingw --@rules_cc//:link_extra_libs=@mingw_prefix//:runtime_dlls
common:mingw --@bazel_tools//tools/cpp:link_extra_libs=@mingw_prefix//:runtime_dlls
common:mingw --copt=-Wno-sign-compare --host_copt=-Wno-sign-compare
common:mingw --override_module=xla=$(cygpath -m "${srcdir}/${_xladir}")
common:mingw --override_module=rules_ml_toolchain=$(cygpath -m "${srcdir}/${_rmtdir}")
EOF
}

_bazel() {
  export BAZEL_SH=$(cygpath -m /usr/bin/bash.exe)
  # Bazel's arguments (//labels, E:/paths) must reach it unconverted.
  export MSYS2_ARG_CONV_EXCL="*"
  unset JAVA_HOME
  # JAXLIB_BAZEL_ROOT: optional shared Bazel output/repository cache.
  "${srcdir}/bazel/bazel.exe" \
    --output_user_root="${JAXLIB_BAZEL_ROOT:-$(cygpath -m "${srcdir}/bazel-root")}" \
    "$@"
}

build() {
  cd "${srcdir}/${_jaxdir}"
  _write_bazelrc
  _bazel build //jaxlib/tools:jaxlib_wheel \
    --noenable_platform_specific_config --config=mingw \
    --jobs=$(nproc) --local_resources=memory=HOST_RAM*.6 \
    --verbose_failures --keep_going

  # The wheel builder runs on the hermetic (MSVC) build-tool Python, which
  # names it win_amd64; the extensions are built for MSYS2's Python.
  local _pytag=$(${MINGW_PREFIX}/bin/python -c "import sys; print('cp%d%d' % sys.version_info[:2])")
  rm -rf "${srcdir}/dist" && mkdir -p "${srcdir}/dist"
  cp bazel-bin/jaxlib/tools/dist/jaxlib-${pkgver}-*.whl "${srcdir}/dist/"
  chmod u+w "${srcdir}"/dist/*.whl
  unset MSYS2_ARG_CONV_EXCL
  ${MINGW_PREFIX}/bin/python -m wheel tags --remove \
    --python-tag ${_pytag} --abi-tag ${_pytag} \
    --platform-tag $(${MINGW_PREFIX}/bin/python -c "import sysconfig; print(sysconfig.get_platform().replace('-', '_').replace('.', '_'))") \
    "${srcdir}"/dist/jaxlib-${pkgver}-*.whl
}

check() {
  cd "${srcdir}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  # Test with the jax Python package of the same source tree.
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  PYTHONPATH="${srcdir}/${_jaxdir}" ${MINGW_PREFIX}/bin/python - <<'PY'
import jax, jax.numpy as jnp
print(jax.__version__, jax.devices())
x = jnp.arange(6.0).reshape(2, 3)
assert float((x @ x.T).sum()) == 83.0
f = jax.jit(lambda a: jnp.sin(a) ** 2 + jnp.cos(a) ** 2)
assert jnp.allclose(f(x), 1.0)
g = jax.grad(lambda w: jnp.sum((w * 3.0 - 1.0) ** 2))(jnp.ones(3))
assert jnp.allclose(g, 12.0), g
assert jax.vmap(jnp.dot)(x, x).shape == (2,)
print("jaxlib ok")
PY
}

package() {
  cd "${srcdir}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 "${srcdir}/${_jaxdir}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
