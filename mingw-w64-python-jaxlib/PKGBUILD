# Maintainer (msys2-ur): Kreijstal
#
# jaxlib (CPU only), the C++ part of JAX: XLA, LLVM/MLIR, StableHLO built
# from the pinned sources with Bazel and MSYS2's clang/lld (GNU driver,
# x86_64-w64-windows-gnu). Upstream only supports clang-cl on Windows; see
# PORTING-NOTES.md for the toolchain and the patch series.

_realname=jaxlib
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.11.2
# Pinned by jax ${pkgver}'s MODULE.bazel.
_xla_commit=91888df6ce85102c30220e41d952065925e10886
_rmt_commit=c0eb2743b7b12b2bbcf0e1888e26d36ba6b093de
