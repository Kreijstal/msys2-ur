# MSYS2 MinGW-w64 toolchains for building jaxlib (generated by PKGBUILD
# prepare(): @MINGW_PREFIX@ is the Windows path of the MSYS2 prefix).
load("@rules_python//python/cc:py_cc_toolchain.bzl", "py_cc_toolchain")
load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

cc_toolchain_config(
    name = "ucrt64_clang_config",
    compile_flags = [
        "-fno-omit-frame-pointer",
        "-Wno-unknown-warning-option",
        "-Wno-unused-command-line-argument",
        "-D_USE_MATH_DEFINES",
        "-DWIN32_LEAN_AND_MEAN",
        "-DNOGDI",
        "-D_WIN32_WINNT=0x0A00",
    ],
    cxx_builtin_include_directories = [
        "@MINGW_PREFIX@/include",
        "@MINGW_PREFIX@/lib/clang",
        "@MINGW_PREFIX@/x86_64-w64-mingw32/include",
    ],
    # C code (e.g. cpuinfo) uses the min/max macros of MinGW's stdlib.h.
    cxx_flags = [
        "-std=gnu++17",
        "-DNOMINMAX",
    ],
    link_flags = [
        "-fuse-ld=lld",
        "-lstdc++",
        "-Wl,--no-insert-timestamp",
        # Windows system libraries that MSVC builds get from
        # "#pragma comment(lib, ...)" or "-DEFAULTLIB:x.lib" linkopts; clang
        # ignores both for MinGW targets. lld (order-independent) only adds a
        # DLL import when a symbol is actually used.
        "-lws2_32",
        "-lshlwapi",
        "-ldbghelp",
        "-lbcrypt",
        "-lcrypt32",
        "-lnormaliz",
        "-lole32",
        "-luuid",
        "-lpsapi",
        "-liphlpapi",
        "-lntdll",
        "-lversion",
    ],
    tool_bin_path = "@MINGW_PREFIX@/bin",
    tool_paths = {
        "ar": "@MINGW_PREFIX@/bin/llvm-ar.exe",
        "cpp": "@MINGW_PREFIX@/bin/clang-cpp.exe",
        "dwp": "@MINGW_PREFIX@/bin/llvm-dwp.exe",
        "gcc": "@MINGW_PREFIX@/bin/clang.exe",
        "gcov": "@MINGW_PREFIX@/bin/llvm-cov.exe",
        "ld": "@MINGW_PREFIX@/bin/ld.lld.exe",
        "nm": "@MINGW_PREFIX@/bin/llvm-nm.exe",
        "objcopy": "@MINGW_PREFIX@/bin/llvm-objcopy.exe",
        "objdump": "@MINGW_PREFIX@/bin/llvm-objdump.exe",
        "strip": "@MINGW_PREFIX@/bin/llvm-strip.exe",
    },
)

cc_toolchain(
    name = "ucrt64_clang",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
    toolchain_config = ":ucrt64_clang_config",
)

toolchain(
    name = "cc_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    toolchain = ":ucrt64_clang",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Python headers and import library of the MSYS2 Python the extensions are
# built for (the hermetic, MSVC-built Python is only used to run build tools).
py_cc_toolchain(
    name = "mingw_py_cc",
    headers = "@mingw_prefix//:python_headers",
    python_version = "@PYVER@",
)

toolchain(
    name = "py_cc_toolchain",
    target_compatible_with = ["@platforms//os:windows"],
    toolchain = ":mingw_py_cc",
    toolchain_type = "@rules_python//python/cc:toolchain_type",
)
