 def find_libpng():
     # Returns (found, include dir, library dir, library name)
+    if IS_MINGW:
+        # libpng-config is a shell script, which Windows Python cannot run
+        prefix = Path(sys.prefix)
+        if not (prefix / "include/libpng16/png.h").exists():
+            warnings.warn("libpng not found")
+            return False, None, None, None
+        return True, str(prefix / "include/libpng16"), str(prefix / "lib"), "png"
