_realname=torchvision
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
# 0.29.x pairs with pytorch 2.14; its ops use torch's stable C ABI, which
# upstream promises from 2.14 on, but stay below the next untested release
pkgver=0.29.1
pkgrel=1
pkgdesc="Datasets, transforms and models for computer vision with PyTorch (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/pytorch/vision'
msys2_repository_url='https://github.com/pytorch/vision'
msys2_references=(
  'purl: pkg:pypi/torchvision'
)
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-numpy"
         "${MINGW_PACKAGE_PREFIX}-python-pillow"
         "${MINGW_PACKAGE_PREFIX}-python-pytorch>=2.14.0"
         "${MINGW_PACKAGE_PREFIX}-python-pytorch<2.15"
         "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
         "${MINGW_PACKAGE_PREFIX}-libpng"
         "${MINGW_PACKAGE_PREFIX}-libwebp")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
options=('!strip')
source=("${_realname}-${pkgver}.tar.gz::https://github.com/pytorch/vision/archive/refs/tags/v${pkgver}.tar.gz"
        '0001-mingw-build.patch'
        '0002-mingw-jpeg-skip-shlwapi.patch')
# the sphinx gallery's symlinked example images cannot be extracted on Windows
noextract=("${_realname}-${pkgver}.tar.gz")
sha256sums=('0a14655bd32095148d93fa595f93aba45dda0d13b25cc7fe86a041340e4a4862'
            '93dcaee72864acca637888b641600ffbd56c242d405c3567bcc76293a69747e4'
            'c745043575f753a0c5263d1f6e99dcc66a88c55ef32e56a4a0bbeff20e1a6f3a')

prepare() {
  bsdtar -xf "${_realname}-${pkgver}.tar.gz" --exclude "vision-${pkgver}/gallery"
  cd "vision-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-mingw-build.patch"
  patch -Np1 -i "${srcdir}/0002-mingw-jpeg-skip-shlwapi.patch"
}

build() {
  cp -r "vision-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  export BUILD_VERSION="${pkgver}"
  export TORCHVISION_USE_NVJPEG=0
  export TORCHVISION_USE_VIDEO_CODEC=0
  export TORCHVISION_USE_FFMPEG=0
  # headers found here are taken to be on the default search paths
  export TORCHVISION_INCLUDE="$(cygpath -m "${MINGW_PREFIX}/include")"
  local _jobs=${MAKEFLAGS#-j}
  [[ ${_jobs} =~ ^[0-9]+$ ]] || _jobs=$(nproc)
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation \
    -C--build-option=build_ext -C--build-option=-j${_jobs}
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import torch, torchvision
from torchvision.ops import nms
from torchvision.io import decode_jpeg, decode_png, encode_jpeg, encode_png
assert torchvision.extension._has_ops()
boxes = torch.tensor([[0, 0, 10, 10], [1, 1, 11, 11], [50, 50, 60, 60]], dtype=torch.float)
assert nms(boxes, torch.tensor([.9, .8, .7]), .5).tolist() == [0, 2]
img = (torch.rand(3, 32, 32) * 255).to(torch.uint8)
assert decode_png(encode_png(img)).equal(img)
assert decode_jpeg(encode_jpeg(img)).shape == img.shape
assert torchvision.models.resnet18()(torch.randn(1, 3, 64, 64)).shape == (1, 1000)
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
