_realname=dotnet-clientmodel
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.0.0
pkgrel=1
_commit=8ffa7d7f26bb2c5e3dadf74b2aa9c9ba9c9d9208
pkgdesc='Complete original ClientModel source library for the Azure/PowerShell graph'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/Azure/azure-sdk-for-net'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-system-text-json8>=8.0.5" "${MINGW_PACKAGE_PREFIX}-dotnet-memory-data>=1.0.2")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" 'python')
checkdepends=("${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2")
options=('!strip' '!lto')
source=("azure-sdk-$_commit.tar.gz::https://codeload.github.com/Azure/azure-sdk-for-net/tar.gz/$_commit"
 extract.py
 prepare.py
 verify-build.py
 pack.py
 Check.cs
 check.sh
 check-payload.py
 compare.py
 InspectApi.cs
 InspectAssemblyMetadata.cs
 source-inputs.json
 published-api.json
 published-metadata.json
 README.md
)
noextract=("azure-sdk-$_commit.tar.gz")
