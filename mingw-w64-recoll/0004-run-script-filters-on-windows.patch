diff --git a/src/utils/pathut.cpp b/src/utils/pathut.cpp
index 5f2cb03..7a2706a 100644
--- a/src/utils/pathut.cpp
+++ b/src/utils/pathut.cpp
@@ -1473,6 +1473,13 @@ bool path_readable(const std::string& path)
 }
 bool path_access(const std::string& path, int mode)
 {
+#ifdef _WIN32
+    // mingw-w64 defines X_OK as 1, which the UCRT _waccess() rejects with
+    // EINVAL. Execute permission has no meaning there: check readability.
+    if (mode & 1) {
+        mode = (mode & ~1) | R_OK;
+    }
+#endif
     SYSPATH(path, syspath);
     return ACCESS(syspath, mode) == 0;
 }
