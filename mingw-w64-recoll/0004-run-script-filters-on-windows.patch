diff --git a/src/common/rclconfig.cpp b/src/common/rclconfig.cpp
index cd7acc3..d64fbdb 100644
--- a/src/common/rclconfig.cpp
+++ b/src/common/rclconfig.cpp
@@ -2177,6 +2177,34 @@ bool RclConfig::processFilterCmd(std::vector<std::string>& cmd) const
     } else if ("pl" == ext) {
         it = cmd.insert(it, findFilter("perl"));
         it++;
+    } else if (ext.empty()) {
+        // Scripts without an extension (rclps, rclimg, rcluncomp...): Windows can't execute
+        // them directly, run the interpreter named on the "#!" line (sh, perl...).
+        std::string script = findFilter(*it);
+        std::fstream input;
+        std::string line;
+        if (path_streamopen(script, std::ios::in | std::ios::binary, input) &&
+            std::getline(input, line) && line.compare(0, 2, "#!") == 0) {
+            trimstring(line, " \t\r");
+            std::vector<std::string> words;
+            stringToStrings(line.substr(2), words);
+            if (!words.empty() && path_getsimple(words[0]) == "env") {
+                words.erase(words.begin());
+            }
+            if (!words.empty()) {
+                std::string interp = path_getsimple(words[0]);
+                std::string interppath = findFilter(interp);
+                if (!path_isabsolute(interppath)) {
+                    std::string msys = path_cat(path_thisexecdir(), "../../usr/bin");
+                    msys = path_canon(path_cat(msys, interp + ".exe"));
+                    if (path_exists(msys))
+                        interppath = msys;
+                }
+                *it = script;
+                it = cmd.insert(it, interppath);
+                it++;
+            }
+        }
     }
 #endif
     
