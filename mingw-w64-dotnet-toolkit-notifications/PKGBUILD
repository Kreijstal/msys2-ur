# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-toolkit-notifications
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=7.1.3
pkgrel=2
pkgdesc='Source-built Windows Community Toolkit desktop notifications for .NET 8'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/CommunityToolkit/WindowsCommunityToolkit'
license=('spdx:MIT')
_commit=0ce64d053be11e928408393175851516bd253ccf
_tree=WindowsCommunityToolkit-${_commit}
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-windowsdesktop-bootstrap" "${MINGW_PACKAGE_PREFIX}-dotnet-winrt-bootstrap>=0.1.1")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" 'python')
options=('!strip' '!lto')
source=("toolkit-$_commit.tar.gz::https://codeload.github.com/CommunityToolkit/WindowsCommunityToolkit/tar.gz/$_commit" prepare.py check.cs README.md)
sha256sums=('85fef15812a6b47256c6ea0bfad4f5b8bf85828e568ea3f870fe3833fc22793e' 'be87a6f43173fc1ed80ca0f976692028a9afb2be08d98230e749ae1d59d3d2a0' '0e4b88b40bfde7edd53e9e5ee5204ea47ff5a6146e6abb658a91ec522e38368d' 'cf4b268dd934091c2e912b315a449a270bd9b4b713621e65d5b3120fe76a0459')
_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet") DOTNET_ROOT_X64=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/$_tree"
  printf '<configuration><packageSources><clear/></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  cd "$srcdir/$_tree"
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack Microsoft.Toolkit.Uwp.Notifications/Microsoft.Toolkit.Uwp.Notifications.csproj \
    -c Release -o "$(cygpath -m "$srcdir/feed")" --configfile "$(cygpath -m "$srcdir/NuGet.config")" \
    -p:RestoreSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" -p:UseSharedCompilation=false -v:minimal
}
check() {
  _env
  mkdir -p "$srcdir/check"
  cp "$srcdir/check.cs" "$srcdir/check/Program.cs"
  cat > "$srcdir/check/check.csproj" <<'PROJECT'
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="[7.1.3]"/></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" run --project "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    -p:RestoreSources="$(cygpath -m "$srcdir/feed")" -p:RestoreAdditionalProjectSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" -p:UseSharedCompilation=false
}
package() {
  install -Dm644 "$srcdir/feed/Microsoft.Toolkit.Uwp.Notifications.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.toolkit.uwp.notifications.$pkgver.nupkg"
  install -Dm644 "$srcdir/$_tree/License.md" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/License.md"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -Dm644 "$srcdir/$_tree/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
}
