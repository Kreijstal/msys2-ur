# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-commons-logging
pkgname=("${MINGW_PACKAGE_PREFIX}-java-commons-logging")
pkgver=1.3.5
pkgrel=1
pkgdesc="commons-logging Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://commons.apache.org/proper/commons-logging/'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-javax-servlet-api"
             "${MINGW_PACKAGE_PREFIX}-java-log4j-api"
             "${MINGW_PACKAGE_PREFIX}-java-slf4j-api")
source=('https://repo.maven.apache.org/maven2/commons-logging/commons-logging/1.3.5/commons-logging-1.3.5-sources.jar'
         'https://repo.maven.apache.org/maven2/commons-logging/commons-logging/1.3.5/commons-logging-1.3.5.pom')
noextract=('commons-logging-1.3.5-sources.jar'
         'commons-logging-1.3.5.pom')
sha256sums=('496332597187dd32e41cfd1d87e5991a3d77b51bae2cc0bbe9e51496ae54ce5c'
         'ccf4a30346f5027b9496abd56290ac26d159abf2be64df1265611dc9400b9d68')
_artifacts=('commons-logging:commons-logging:1.3.5')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  rm -f upstream/commons-logging/org/apache/commons/logging/impl/{AvalonLogger,LogKitLogger,Log4JLogger}.java
  jb_module commons-logging:commons-logging:1.3.5 upstream/commons-logging \
    -r resources/commons-logging -u commons-logging-1.3.5.pom -- \
    org.apache.logging.log4j:log4j-api? org.slf4j:slf4j-api? javax.servlet:javax.servlet-api/provided?
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.apache.logging.log4j:log4j-api --with org.slf4j:slf4j-api --with javax.servlet:javax.servlet-api commons-logging:commons-logging
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-commons-logging() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install commons-logging:commons-logging
  _license commons-logging 1.3.5
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
