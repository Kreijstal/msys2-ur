# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=plexus-interpolation
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=1.29
pkgrel=1
pkgdesc="Plexus string interpolation API, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://codehaus-plexus.github.io/plexus-interpolation/'
msys2_repository_url='https://github.com/codehaus-plexus/plexus-interpolation'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/codehaus-plexus/plexus-interpolation/archive/refs/tags/${_realname}-${pkgver}.tar.gz")
sha256sums=('cfdd8c1c9dedc377bcc9a1bccafa4c712b5081f11ac702dbc956d5818cfecb5b')

_src=${_realname}-${_realname}-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  # src/main/java9 holds only module-info.java (not compiled)
  jb_module org.codehaus.plexus:plexus-interpolation:${pkgver} src/main/java \
    -v 9:src/main/java9 -u pom.xml
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests need JUnit 5 (Jupiter), which is not packaged
  jb_loadcheck org.codehaus.plexus:plexus-interpolation
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.codehaus.plexus:plexus-interpolation
}
