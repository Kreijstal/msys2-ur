# Maintainer: Kreijstal <rainb@tfwno.gf>

# OSGi specification API and companion code of the Eclipse OSGi Working Group
# (github.com/osgi/osgi), built with javac instead of the bnd workspace.
# The bundles of the Eclipse RCP feature (org.osgi.service.*, org.osgi.util.*)
# come from the 8.1.0.cmpn tag; three APIs that were dropped from the R8
# compendium (provisioning, measurement, position) from r7-cmpn-ri-ct-final.
# Bundle versions carry the qualifiers of the upstream releases, the OSGi
# manifests are written by jb.Bnd (bnd's analysis) from the instructions of
# cnf/includes/companion.bnd and the projects' bnd.bnd files.  osgi.core and
# osgi.annotation are compile-time APIs (the framework, org.eclipse.osgi,
# provides the core packages at run time); osgi.core is the Core Release 8
# API from the r8-core-final tag, the versions Equinox implements.

_realname=osgi
pkgbase=mingw-w64-java-${_realname}
# in build order
_bundles=(util.function util.promise util.xml util.measurement util.position
          service.cm service.component.annotations service.component service.device service.event
          service.metatype service.prefs service.provisioning service.serviceloader service.upnp
          service.useradmin service.wireadmin)
_namespaces=(extender implementation service)
pkgname=("${MINGW_PACKAGE_PREFIX}-java-osgi-annotation"
         "${MINGW_PACKAGE_PREFIX}-java-osgi-core")
for _n in "${_namespaces[@]}"; do pkgname+=("${MINGW_PACKAGE_PREFIX}-java-osgi-namespace-${_n}"); done
for _b in "${_bundles[@]}"; do pkgname+=("${MINGW_PACKAGE_PREFIX}-java-osgi-${_b//./-}"); done
pkgver=8.1.0
pkgrel=1
pkgdesc="OSGi specification APIs and companion code (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://www.osgi.org/'
msys2_repository_url='https://github.com/osgi/osgi'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("osgi-${pkgver}.cmpn.tar.gz::https://github.com/osgi/osgi/archive/refs/tags/${pkgver}.cmpn.tar.gz"
        "osgi-r8-core-final.tar.gz::https://github.com/osgi/osgi/archive/refs/tags/r8-core-final.tar.gz"
        "osgi-r7-cmpn-ri-ct-final.tar.gz::https://github.com/osgi/osgi/archive/refs/tags/r7-cmpn-ri-ct-final.tar.gz")
sha256sums=('935bbe30bd3e39da6802118e2b526347e0610b64bcc8d758cc6e2d37cc621de9'
            '852a0c4baec0f76725188ee0ad27858f1dc3738f9c02fabfcaa4ca054a359c67'
            'b78b9d783d03cf47d52f061086b250430ad5c34a7458327a51279862192cd820')
noextract=("osgi-r8-core-final.tar.gz" "osgi-r7-cmpn-ri-ct-final.tar.gz")

_src=osgi-${pkgver}.cmpn
_core=osgi-r8-core-final
_r7=osgi-r7-cmpn-ri-ct-final
# the OSGi Core Release 8 API, as Equinox 3.24 implements it (the 8.1.0.cmpn
# tag already carries newer core package versions)
_coreprojects=(dto framework resource service.condition service.condpermadmin service.log
               service.packageadmin service.permissionadmin service.resolver service.startlevel
               service.url util.tracker)

# project  maven-version  bundle-version  source-tree
_spec() {
  case $1 in
    service.cm)                    echo "1.6.1 1.6.1.202109301733 r8" ;;
    service.component)             echo "1.5.1 1.5.1.202212101352 r8" ;;
    service.component.annotations) echo "1.5.1 1.5.1.202212101352 r8" ;;
    service.device)                echo "1.1.1 1.1.1.202109301733 r8" ;;
    service.event)                 echo "1.4.1 1.4.1.202109301733 r8" ;;
    service.metatype)              echo "1.4.1 1.4.1.202109301733 r8" ;;
    service.prefs)                 echo "1.1.2 1.1.2.202109301733 r8" ;;
    service.provisioning)          echo "1.2.0 1.2.0.201505202024 r7" ;;
    service.serviceloader)         echo "1.0.0 1.0.0.201505202024 r8" ;;
    service.upnp)                  echo "1.2.1 1.2.1.202109301733 r8" ;;
    service.useradmin)             echo "1.1.1 1.1.1.202109301733 r8" ;;
    service.wireadmin)             echo "1.0.2 1.0.2.202109301733 r8" ;;
    util.function)                 echo "1.2.0 1.2.0.202109301733 r8" ;;
    util.measurement)              echo "1.0.2 1.0.2.201802012109 r7" ;;
    util.position)                 echo "1.0.1 1.0.1.201505202026 r7" ;;
    util.promise)                  echo "1.3.0 1.3.0.202212101352 r8" ;;
    util.xml)                      echo "1.0.2 1.0.2.202109301733 r8" ;;
  esac
}

_nsver() {
  case $1 in
    extender) echo 1.0.1 ;;
    *) echo 1.0.0 ;;
  esac
}

# compile-only dependencies (bundle annotations)
_cdeps() {
  case $1 in
    service.component.annotations|service.metatype)
      echo "-c org.osgi:org.osgi.namespace.extender -c org.osgi:org.osgi.namespace.implementation" ;;
    service.component)
      echo "-c org.osgi:org.osgi.namespace.extender -c org.osgi:org.osgi.namespace.implementation -c org.osgi:org.osgi.service.component.annotations" ;;
    service.event)
      echo "-c org.osgi:org.osgi.namespace.implementation -c org.osgi:org.osgi.service.component.annotations" ;;
    service.cm) echo "-c org.osgi:org.osgi.namespace.implementation" ;;
  esac
}

# source project and excluded sources of a bundle
_project() {
  case $1 in
    service.component.annotations) echo service.component ;;
    *) echo "$1" ;;
  esac
}
_exclude() {
  case $1 in
    service.component) echo "/component/annotations/" ;;
    service.metatype) echo "/metatype/annotations/" ;;
    service.component.annotations) echo "/org/osgi/service/component/([^/]+\.java|runtime/|propertytypes/)" ;;
  esac
}

# run-time dependencies of a project (besides osgi.annotation and osgi.core)
_deps() {
  case $1 in
    service.component) echo "org.osgi:org.osgi.util.promise org.osgi:org.osgi.util.function" ;;
    util.promise) echo "org.osgi:org.osgi.util.function" ;;
    util.position) echo "org.osgi:org.osgi.util.measurement" ;;
  esac
}

prepare() {
  local p
  tar -xzf "${_core}.tar.gz" $(for p in "${_coreprojects[@]}"; do echo "${_core}/org.osgi.${p}"; done)
  mkdir -p "${_r7}"
  tar -xzf "${_r7}.tar.gz" "${_r7}/org.osgi.service.provisioning" "${_r7}/org.osgi.util.measurement" \
    "${_r7}/org.osgi.util.position"
  # prebuilt test fixtures and tools
  find "${_src}" "${_core}" "${_r7}" -type f \( -name '*.jar' -o -name '*.class' -o -name '*.dll' -o -name '*.so' \
    -o -name '*.exe' -o -name '*.dylib' -o -name '*.jnilib' \) -delete
}

# bnd instructions of a companion code bundle (cnf/includes/companion.bnd)
_bnd() {
  local bsn=$1 bver=$2 spec=$3 out=$4 tag=${5:-${pkgver}.cmpn}
  cat > "${out}" <<EOF
Bundle-SymbolicName: ${bsn}
Bundle-Version: ${bver}
Bundle-Name: org.osgi:${bsn}
Bundle-Description: OSGi Companion Code for ${bsn} Version ${spec}
Bundle-Vendor: Eclipse Foundation
Bundle-Copyright: Copyright (c) Contributors to the Eclipse Foundation
Bundle-DocURL: https://docs.osgi.org/
Bundle-License: Apache-2.0;description="This program and the accompanying materials are made available under the terms of the Apache License, Version 2.0.";link="https://opensource.org/licenses/Apache-2.0"
Bundle-SCM: url=https://github.com/osgi/osgi, connection=scm:git:https://github.com/osgi/osgi.git, developerConnection=scm:git:git@github.com:osgi/osgi.git, tag=${tag}
Bundle-Developers: osgi; email=osgi-wg@eclipse.org; name="OSGi Working Group"; organization="Eclipse Foundation"; organizationUrl="https://www.osgi.org/"
SPDX-License-Identifier: Apache-2.0
Automatic-Module-Name: ${bsn}
Export-Package: ${bsn}.*
-noee: true
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE/compact1)(version=1.8))"
EOF
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=8
  mkdir -p bnd
  # compile-time APIs
  jb_module org.osgi:osgi.annotation:${pkgver} - \
    -s "${_src}/org.osgi.annotation.versioning/src" -s "${_src}/org.osgi.annotation.bundle/src" \
    -m 'Automatic-Module-Name: osgi.annotation'
  local -a core=()
  local p
  for p in "${_coreprojects[@]}"; do
    core+=(-s "${_core}/org.osgi.${p}/src")
  done
  jb_module org.osgi:osgi.core:8.0.0 - "${core[@]}" -m 'Automatic-Module-Name: osgi.core' \
    -c org.osgi:osgi.annotation
  local n
  for n in "${_namespaces[@]}"; do
    _bnd "org.osgi.namespace.${n}" "$(_nsver "$n")" "$(_nsver "$n")" "bnd/org.osgi.namespace.${n}.bnd"
    jb_module "org.osgi:org.osgi.namespace.${n}:$(_nsver "$n")" "${_src}/org.osgi.namespace.${n}/src" \
      -b "bnd/org.osgi.namespace.${n}.bnd" -c org.osgi:osgi.annotation -c org.osgi:osgi.core
  done
  # companion code bundles
  local b mv bv tree d
  for b in "${_bundles[@]}"; do
    read -r mv bv tree <<< "$(_spec "$b")"
    local root=${_src} x r
    [[ $tree == r7 ]] && root=${_r7}
    d="${root}/org.osgi.$(_project "$b")/src"
    x=$(_exclude "$b")
    local tag=${pkgver}.cmpn
    [[ $tree == r7 ]] && tag=r7-cmpn-ri-ct-final
    _bnd "org.osgi.${b}" "${bv}" "${mv}" "bnd/org.osgi.${b}.bnd" "${tag}"
    # like the upstream jars: LICENSE/NOTICE, the sources in OSGI-OPT/src
    # and the XML schemas of the specification
    r="res/org.osgi.${b}"
    rm -rf "${r}"
    mkdir -p "${r}/META-INF" "${r}/OSGI-OPT/src"
    cp "${_src}/LICENSE" "${_src}/NOTICE" "${r}/META-INF/"
    (cd "${d}" && find . -name '*.java' | sed 's|^\./||' | { if [[ -n $x ]]; then grep -Ev "$x"; else cat; fi; } \
      | xargs cp --parents -t "${srcdir}/${r}/OSGI-OPT/src")
    case $b in
      service.component) mkdir -p "${r}/xmlns" && cp -r "${_src}/xmlns/scr" "${r}/xmlns/" ;;
      service.metatype) mkdir -p "${r}/xmlns" && cp -r "${_src}/xmlns/metatype" "${r}/xmlns/" ;;
    esac
    local -a j=()
    # the annotations refer back to classes of the component package
    [[ $b == service.component.annotations ]] && j=(-j -sourcepath -j "$(jb_w "${d}")" -j -implicit:none)
    # shellcheck disable=SC2046
    jb_module "org.osgi:org.osgi.${b}:${mv}" "${d}" -b "bnd/org.osgi.${b}.bnd" -r "${r}" ${x:+-x "$x"} "${j[@]}" \
      -c org.osgi:osgi.annotation -c org.osgi:osgi.core $(_cdeps "$b") -- $(_deps "$b")
  done
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local b
  for b in "${_bundles[@]}"; do
    jb_loadcheck --with org.osgi:osgi.core "org.osgi:org.osgi.${b}"
  done
  jb_loadcheck org.osgi:osgi.core
}

_lic() {
  install -Dm644 "${srcdir}/${_src}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/$1/LICENSE"
}

package_java-osgi-annotation() {
  pkgdesc="OSGi versioning and bundle annotations, compile-time API (mingw-w64)"
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar osgi-annotation org.osgi:osgi.annotation
  _lic java-osgi-annotation
}

package_java-osgi-core() {
  pkgdesc="OSGi Core Release 8 API, compile-time (mingw-w64)"
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar osgi-core org.osgi:osgi.core
  _lic java-osgi-core
}

_package_namespace() {
  pkgdesc="OSGi org.osgi.namespace.$1 $(_nsver "$1"), compile-time API (mingw-w64)"
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar "osgi-namespace-$1" "org.osgi:org.osgi.namespace.$1"
  _lic "java-osgi-namespace-$1"
}

for _n in "${_namespaces[@]}"; do
  eval "package_java-osgi-namespace-${_n}() { _package_namespace ${_n}; }"
done

_package_bundle() {
  local b=$1
  read -r mv bv tree <<< "$(_spec "$b")"
  pkgdesc="OSGi org.osgi.${b} ${mv} (mingw-w64)"
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar "osgi-${b//./-}" --plugin "org.osgi:org.osgi.${b}"
  _lic "java-osgi-${b//./-}"
}

for _b in "${_bundles[@]}"; do
  eval "package_java-osgi-${_b//./-}() {
    depends=($(for _d in $(_deps "${_b}"); do printf '"${MINGW_PACKAGE_PREFIX}-java-osgi-%s" ' "$(sed 's/^org.osgi:org.osgi.//; s/\./-/g' <<< "${_d}")"; done))
    _package_bundle ${_b}
  }"
done

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
