prepare() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/msbuild18-workflow/prepare.py")" \
    "$(cygpath -am "$srcdir")" > "$srcdir/prepare.log" 2>&1
}
build() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/msbuild18-workflow/build.py")" \
    "$(cygpath -am "$srcdir")" > "$srcdir/build.log" 2>&1
}
check() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/msbuild18-workflow/audit.py")" \
    "$(cygpath -am "$srcdir")" > "$srcdir/audit.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/msbuild18-workflow/stage.py")" \
    "$(cygpath -am "$srcdir")" "$(cygpath -am "$srcdir/package-prefix")" > "$srcdir/stage.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/msbuild18-workflow/check-installed.py")" \
    "$(cygpath -am "$srcdir/package-prefix")" "$(cygpath -am "$srcdir/staged-check")" > "$srcdir/staged-check.log" 2>&1
}
package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -R "$srcdir/package-prefix/." "$pkgdir$MINGW_PREFIX/"
}
