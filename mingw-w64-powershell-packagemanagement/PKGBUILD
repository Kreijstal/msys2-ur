_realname=powershell-packagemanagement
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.4.8.1
pkgrel=1
_commit=923260b2f2cbc5b66d90ef2e31f240b9d8579a74
_provider_commit=b4a79a22f65c85a5de7aa3f23c0505fb38422e1d
pkgdesc='Complete source PackageManagement Core module and NuGet PSModule package for .NET8'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/OneGet/oneget'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131-2"
             "${MINGW_PACKAGE_PREFIX}-powershell-module-test-host>=7.4.20-2" 'python')
options=('!strip' '!lto')
source=("oneget-$pkgver.tar.gz::https://codeload.github.com/OneGet/oneget/tar.gz/$_commit"
        "nugetprovider-$_provider_commit.tar.gz::https://codeload.github.com/OneGet/NuGetProvider/tar.gz/$_provider_commit"
        prepare.py
        build.sh
        audit-source.py
        stage.py
        pack.py
        check.sh
        inspect.sh
        InspectApi.cs
        InspectIdentity.cs
        verify-restored.py
        Smoke.ps1
        Offline.ps1
        prepare-fixtures.py
        0001-resource-generator-use-script-root-for-archives.patch
        0002-qualify-original-async-enumerable.patch
        published-provenance.json
        README.md
)
