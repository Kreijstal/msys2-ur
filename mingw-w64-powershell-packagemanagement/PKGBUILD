prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/oneget-$_commit" "$srcdir/NuGetProvider-$_provider_commit" "$srcdir/prepared"; }
build() {
  bash "$srcdir/build.sh" "$srcdir/prepared"
  /usr/bin/python3 "$srcdir/audit-source.py" "$srcdir/prepared" "$srcdir/oneget-$_commit" "$srcdir/NuGetProvider-$_provider_commit"
  /usr/bin/python3 "$srcdir/stage.py" "$srcdir/prepared" "$srcdir/module"
  /usr/bin/python3 "$srcdir/pack.py" "$srcdir/prepared" "$srcdir/module" "$srcdir/feed"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/oneget-$_commit" "$srcdir/NuGetProvider-$_provider_commit" "$srcdir/feed"; }
package() {
  install -Dm644 "$srcdir/feed/packagemanagement.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/packagemanagement.$pkgver.nupkg"
  local module="$pkgdir$MINGW_PREFIX/lib/powershell/Modules/PackageManagement/$pkgver"
  mkdir -p "$module"
  cp -R "$srcdir/module/." "$module/"
  install -Dm644 "$srcdir/prepared/oneget/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -m644 "$srcdir/prepared/NuGetProvider-LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -m644 "$srcdir/prepared/staged-module.json" "$srcdir/prepared/compile-inventory.json" "$srcdir/prepared/expected-resources.json" "$srcdir/published-provenance.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
}
