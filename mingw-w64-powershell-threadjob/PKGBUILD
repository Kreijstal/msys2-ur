_realname=powershell-threadjob
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.0.3
pkgrel=1
_commit=99bfe5adc30ed066973114ea18d7c5091197ee14
pkgdesc='Complete source ThreadJob PowerShell module and NuGet PSModule package for .NET8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/PaulHigin/PSThreadJob'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131-2"
             "${MINGW_PACKAGE_PREFIX}-powershell-module-test-host>=7.4.20-2" 'python')
options=('!strip' '!lto')
source=("threadjob-$pkgver.tar.gz::https://codeload.github.com/PaulHigin/PSThreadJob/tar.gz/$_commit"
        prepare.py
        build.sh
        pack.py
        check.sh
        inspect.sh
        InspectApi.cs
        InspectIdentity.cs
        verify-restored.py
        prepare-tests.py
        RunUpstream.ps1
        Smoke.ps1
        DebuggerSmoke.ps1
        0001-use-current-debugger-setbreakpoints-overload.patch
        published-provenance.json
        README.md
)
