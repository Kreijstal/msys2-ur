prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/PSThreadJob-$_commit" "$srcdir/prepared"; }
build() {
  bash "$srcdir/build.sh" "$srcdir/prepared"
  /usr/bin/python3 "$srcdir/pack.py" "$srcdir/prepared" "$srcdir/feed"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/PSThreadJob-$_commit" "$srcdir/feed"; }
package() {
  install -Dm644 "$srcdir/feed/threadjob.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/threadjob.$pkgver.nupkg"
  local module="$pkgdir$MINGW_PREFIX/lib/powershell/Modules/ThreadJob/$pkgver"
  mkdir -p "$module"
  cp -R "$srcdir/prepared/module/." "$module/"
  install -Dm644 "$srcdir/prepared/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -m644 "$srcdir/prepared/source-build.json" "$srcdir/published-provenance.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
}
