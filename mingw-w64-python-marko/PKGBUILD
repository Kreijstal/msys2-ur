_realname=marko
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.2.4
pkgrel=1
pkgdesc="Markdown parser with high extensibility (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/frostming/marko'
msys2_repository_url='https://github.com/frostming/marko'
msys2_references=(
  'purl: pkg:pypi/marko'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python")
optdepends=("${MINGW_PACKAGE_PREFIX}-python-pygments: codehilite extension")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-pdm-backend")
source=("https://pypi.org/packages/source/m/marko/marko-${pkgver}.tar.gz")
sha256sums=('c042c66f835425673123d7536b39b4660de3b68e30078c70fd26245b31170683')

build() {
  cp -r "marko-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import marko
from marko.ext.gfm import gfm
assert marko.convert("# T\n\n*a*\n") == "<h1>T</h1>\n<p><em>a</em></p>\n"
html = gfm.convert("| a | b |\n|---|---|\n| 1 | 2 |\n")
assert "<table>" in html and "<td>2</td>" in html, html
print("marko ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
