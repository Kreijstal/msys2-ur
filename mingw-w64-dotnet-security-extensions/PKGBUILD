_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
}
prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir" "$srcdir/prepared"; }
build() {
  _env
  "$MINGW_PREFIX/bin/clang" -std=c11 -shared -O2 -Wall -Wextra -Werror "$srcdir/signature-native.c" \
    -lwintrust -lcrypt32 -lole32 -o "$srcdir/prepared/msys-file-signature.dll"
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$(cygpath -am "$srcdir/prepared/Library.csproj")" -c Release \
    -o "$(cygpath -am "$srcdir/feed")" --configfile "$(cygpath -am "$srcdir/prepared/NuGet.config")" \
    -p:UseSharedCompilation=false -p:RepositoryUrl="$url" -v:minimal
}
check() {
  _env
  bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"
  bash "$srcdir/check-api.sh" "$srcdir/check" "$srcdir/check-api"
}
package() {
  install -Dm644 "$srcdir/feed/$_id.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${_id,,}.$pkgver.nupkg"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  for file in README.md ExpectedApi.json source-provenance.json signature-native.h;do
    install -Dm644 "$srcdir/$file" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/$file"
  done
}
