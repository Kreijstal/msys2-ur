# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-security-extensions
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.4.0
pkgrel=1
_id=Microsoft.Security.Extensions
pkgdesc='Windows WinTrust source replacement for the Microsoft.Security.Extensions 1.4 contract'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/PowerShell/PowerShell'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-clang" "${MINGW_PACKAGE_PREFIX}-osslsigncode>=2.14" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=(FileSignatureInfo.cs
        signature-native.c
        signature-native.h
        prepare.py
        MicrosoftShared.pubkey.hex
        Check.cs
        ExpectedApi.json
        InspectApi.cs
        check.sh
        check-api.sh
        generate-fixtures.sh
        README.md
        LICENSE
        source-provenance.json)
sha256sums=('0a47507714eda6863062000906de5e5c72f9192ef48b7382db7818ba66eea270'
