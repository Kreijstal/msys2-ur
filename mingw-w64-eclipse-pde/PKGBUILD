# Maintainer: Kreijstal <rainb@tfwno.gf>

# Eclipse PDE 4.41 (github.com/eclipse-pde/eclipse.pde).  Only the API tools
# annotations are packaged for now: Eclipse bundles with the API tools nature
# compile against them (Tycho adds them to the class path of such projects).
# The rest of PDE (UI, build, API tools) is not packaged yet.

_realname=eclipse-pde
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-eclipse-pde-api-tools-annotations")
pkgver=4.41
pkgrel=1
_tag=R${pkgver/./_}
_qualifier=v20260828-1142
pkgdesc="Eclipse PDE (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://eclipse.dev/pde/'
msys2_repository_url='https://github.com/eclipse-pde/eclipse.pde'
license=('spdx:EPL-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("eclipse.pde-${_tag}.tar.gz::https://github.com/eclipse-pde/eclipse.pde/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('a1c7509c2461809f70b37ed216a8b5fd384f2fa65a4a52394957e8e90ef4dcf9')
noextract=("eclipse.pde-${_tag}.tar.gz")

_src=eclipse.pde-${_tag}
_ann=${_src}/apitools/org.eclipse.pde.api.tools.annotations

prepare() {
  tar -xzf "eclipse.pde-${_tag}.tar.gz" "${_ann}" "${_src}/LICENSE"
  find "${_src}" -type f \( -name '*.jar' -o -name '*.class' \) -delete
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  JB_QUALIFIER=${_qualifier} jb_bundle "${_ann}"
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_bundle_loadcheck org.eclipse.pde.api.tools.annotations
}

package_eclipse-pde-api-tools-annotations() {
  pkgdesc="Eclipse PDE API tools annotations (@NoImplement, @NoExtend, ...) (mingw-w64)"
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_plugins_install org.eclipse.pde.api.tools.annotations
  install -Dm644 "${srcdir}/${_src}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/eclipse-pde-api-tools-annotations/LICENSE"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
