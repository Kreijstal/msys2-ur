--- /dev/null
+++ b/backend/localcommand/local_command_windows.go
@@ -0,0 +1,142 @@
+package localcommand
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/UserExistsError/conpty"
+	"github.com/pkg/errors"
+	"golang.org/x/sys/windows"
+)
+
+const (
+	DefaultCloseSignal  = syscall.SIGINT
+	DefaultCloseTimeout = 10 * time.Second
+)
+
+// LocalCommand runs the command attached to a Windows pseudo console (ConPTY).
+type LocalCommand struct {
+	command string
+	argv    []string
+
+	// Windows has no signals; the close signal is accepted and ignored.
+	closeSignal  syscall.Signal
+	closeTimeout time.Duration
+
+	pty       *conpty.ConPty
+	pid       int
+	closeOnce sync.Once
+	ptyClosed chan struct{}
+}
+
+func New(command string, argv []string, headers map[string][]string, options ...Option) (*LocalCommand, error) {
+	path, err := exec.LookPath(command)
+	if err != nil {
+		return nil, errors.Wrapf(err, "failed to start command `%s`", command)
+	}
+
+	env := append(os.Environ(), "TERM=xterm-256color")
+
+	// Combine headers into key=value pairs to set as env vars
+	// Prefix the headers with "http_" so we don't overwrite any other env vars
+	// which potentially has the same name and to bring these closer to what
+	// a (F)CGI server would proxy to a backend service
+	// Replace hyphen with underscore and make them all upper case
+	for key, values := range headers {
+		h := "HTTP_" + strings.Replace(strings.ToUpper(key), "-", "_", -1) + "=" + strings.Join(values, ",")
+		env = append(env, h)
+	}
+
+	cmdline := windows.ComposeCommandLine(append([]string{path}, argv...))
+	pty, err := conpty.Start(cmdline, conpty.ConPtyEnv(env))
+	if err != nil {
+		return nil, errors.Wrapf(err, "failed to start command `%s`", command)
+	}
+
+	lcmd := &LocalCommand{
+		command: command,
+		argv:    argv,
+
+		closeSignal:  DefaultCloseSignal,
+		closeTimeout: DefaultCloseTimeout,
+
+		pty:       pty,
+		pid:       pty.Pid(),
+		ptyClosed: make(chan struct{}),
+	}
+
+	for _, option := range options {
+		option(lcmd)
+	}
+
+	// When the process exits, close the pseudo console so that Read()
+	// breaks once the remaining output has been drained.
+	go func() {
+		lcmd.pty.Wait(context.Background())
+		lcmd.closePty()
+	}()
+
+	return lcmd, nil
+}
+
+func (lcmd *LocalCommand) closePty() {
+	lcmd.closeOnce.Do(func() {
+		lcmd.pty.Close()
+		close(lcmd.ptyClosed)
+	})
+}
+
+func (lcmd *LocalCommand) Read(p []byte) (n int, err error) {
+	return lcmd.pty.Read(p)
+}
+
+func (lcmd *LocalCommand) Write(p []byte) (n int, err error) {
+	return lcmd.pty.Write(p)
+}
+
+func (lcmd *LocalCommand) Close() error {
+	// Closing the pseudo console sends CTRL_CLOSE_EVENT to the attached
+	// processes; terminate the command if it is still running afterwards.
+	if p, err := os.FindProcess(lcmd.pid); err == nil {
+		defer p.Release()
+		done := make(chan struct{})
+		go func() {
+			p.Wait()
+			close(done)
+		}()
+		lcmd.closePty()
+		select {
+		case <-done:
+		case <-lcmd.closeTimeoutC():
+			p.Kill()
+		}
+		return nil
+	}
+	lcmd.closePty()
+	return nil
+}
+
+func (lcmd *LocalCommand) WindowTitleVariables() map[string]interface{} {
+	return map[string]interface{}{
+		"command": lcmd.command,
+		"argv":    lcmd.argv,
+		"pid":     lcmd.pid,
+	}
+}
+
+func (lcmd *LocalCommand) ResizeTerminal(width int, height int) error {
+	return lcmd.pty.Resize(width, height)
+}
+
+func (lcmd *LocalCommand) closeTimeoutC() <-chan time.Time {
+	if lcmd.closeTimeout >= 0 {
+		return time.After(lcmd.closeTimeout)
+	}
+
+	return make(chan time.Time)
+}
