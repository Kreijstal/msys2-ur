# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-janino
pkgname=("${MINGW_PACKAGE_PREFIX}-java-commons-compiler"
         "${MINGW_PACKAGE_PREFIX}-java-janino")
pkgver=3.1.12
pkgrel=1
pkgdesc="janino Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/dbeaver/dbeaver-deps-ce'
license=('spdx:BSD-3-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-ant")
source=('https://repo.maven.apache.org/maven2/org/codehaus/janino/commons-compiler/3.1.12/commons-compiler-3.1.12-sources.jar'
         'https://repo.maven.apache.org/maven2/org/codehaus/janino/commons-compiler/3.1.12/commons-compiler-3.1.12.pom'
         'https://repo.maven.apache.org/maven2/org/codehaus/janino/janino/3.1.12/janino-3.1.12-sources.jar'
         'https://repo.maven.apache.org/maven2/org/codehaus/janino/janino/3.1.12/janino-3.1.12.pom')
noextract=('commons-compiler-3.1.12-sources.jar'
         'commons-compiler-3.1.12.pom'
         'janino-3.1.12-sources.jar'
         'janino-3.1.12.pom')
sha256sums=('894638a7d9d056dc07abf1390169fb8f515dbb74fda66447424c4a921d21eb11'
         'eb2b5192ee22521179ade955a35984dbdbe020d680628898b3306d4ddb5862de'
         '4f4f79b38f4ebe206ba213ce6a1de248ca6fa9b8abfb0fc79de48ac0e714bf6a'
         '7b10e9034d2391572f48590decbe67719fdaee43e98e00aeff31c8011fb79982')
_artifacts=('org.codehaus.janino:commons-compiler:3.1.12'
         'org.codehaus.janino:janino:3.1.12')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.codehaus.janino:commons-compiler:3.1.12 upstream/commons-compiler \
    -r resources/commons-compiler -u commons-compiler-3.1.12.pom
  jb_module org.codehaus.janino:janino:3.1.12 upstream/janino \
    -r resources/janino -u janino-3.1.12.pom -- \
    org.codehaus.janino:commons-compiler org.apache.ant:ant/provided?
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck org.codehaus.janino:commons-compiler
  jb_loadcheck --with org.codehaus.janino:commons-compiler --with org.apache.ant:ant org.codehaus.janino:janino
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-commons-compiler() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.codehaus.janino:commons-compiler
  _license commons-compiler 3.1.12
}

package_java-janino() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-commons-compiler")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.codehaus.janino:janino
  _license janino 3.1.12
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
