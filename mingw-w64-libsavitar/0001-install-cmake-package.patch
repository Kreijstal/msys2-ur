From 0f3970ebeb7c353190883815a14882ac5ccdf610 Mon Sep 17 00:00:00 2001
From: Kreijstal <rainb@tfwno.gf>
Date: Sun, 8 Nov 2026 09:15:45 +0100
Subject: [PATCH] Install the library with a CMake package config

---
 CMakeLists.txt | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8dcd516..2963a1c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -44,3 +44,14 @@ if (ENABLE_TESTING)
     enable_testing()
     add_subdirectory(tests)
 endif ()
+
+set_target_properties(Savitar PROPERTIES EXPORT_NAME savitar)
+install(TARGETS Savitar EXPORT savitar-targets
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(DIRECTORY include/Savitar DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+install(EXPORT savitar-targets NAMESPACE savitar:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/savitar)
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/savitarConfig.cmake
+     "include(CMakeFindDependencyMacro)\nfind_dependency(pugixml)\ninclude(\${CMAKE_CURRENT_LIST_DIR}/savitar-targets.cmake)\n")
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/savitarConfig.cmake DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/savitar)
-- 
