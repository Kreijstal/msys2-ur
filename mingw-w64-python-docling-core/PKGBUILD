# Maintainer (msys2-ur): Kreijstal

_realname=docling-core
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.100.0
pkgrel=1
pkgdesc="Data types (DoclingDocument, DocTags) and serializers/chunkers for Docling (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/docling-project/docling-core'
msys2_repository_url='https://github.com/docling-project/docling-core'
msys2_references=(
  'purl: pkg:pypi/docling-core'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-defusedxml"
         "${MINGW_PACKAGE_PREFIX}-python-doclang"
         "${MINGW_PACKAGE_PREFIX}-python-jsonref"
         "${MINGW_PACKAGE_PREFIX}-python-jsonschema"
         "${MINGW_PACKAGE_PREFIX}-python-latex2mathml"
         "${MINGW_PACKAGE_PREFIX}-python-pandas"
         "${MINGW_PACKAGE_PREFIX}-python-pillow"
         "${MINGW_PACKAGE_PREFIX}-python-pydantic"
         "${MINGW_PACKAGE_PREFIX}-python-pydantic-settings"
         "${MINGW_PACKAGE_PREFIX}-python-requests"
         "${MINGW_PACKAGE_PREFIX}-python-tabulate"
         "${MINGW_PACKAGE_PREFIX}-python-typer"
         "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
         "${MINGW_PACKAGE_PREFIX}-python-yaml")
optdepends=("${MINGW_PACKAGE_PREFIX}-python-semchunk: chunking (with tree-sitter and transformers)"
            "${MINGW_PACKAGE_PREFIX}-python-tree-sitter: code chunking"
            "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-python: code chunking"
            "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-c: code chunking"
            "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-javascript: code chunking"
            "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-typescript: code chunking"
            "${MINGW_PACKAGE_PREFIX}-python-transformers: HybridChunker tokenizers")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
checkdepends=("${MINGW_PACKAGE_PREFIX}-python-semchunk"
              "${MINGW_PACKAGE_PREFIX}-python-tree-sitter"
              "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-python"
              "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-c"
              "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-javascript"
              "${MINGW_PACKAGE_PREFIX}-python-tree-sitter-typescript"
              "${MINGW_PACKAGE_PREFIX}-python-transformers")
source=("https://pypi.org/packages/source/d/docling-core/docling_core-${pkgver}.tar.gz")
sha256sums=('87a4f7318d774194364a3ac6c1e6b1df0517f28c7ac395d92aa3535eb3e5c446')

prepare() {
  cd "docling_core-${pkgver}"
  # MSYS2 has typer 0.27; docling-core only uses the long-stable typer API
  sed -i "s/'typer (>=0.12.5,<0.27.0)'/'typer (>=0.12.5)'/" pyproject.toml
}

build() {
  cp -r "docling_core-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  # build a document with a table: markdown/HTML/DocTags export, DocTags and JSON
  # round trips, hierarchical chunking
  ${MINGW_PREFIX}/bin/python - <<'PY'
from docling_core.types.doc import DoclingDocument, TableData, TableCell, DocItemLabel
from docling_core.types.doc.document import DocTagsDocument
from docling_core.transforms.chunker import HierarchicalChunker
doc = DoclingDocument(name="t")
doc.add_heading("Quarterly results")
doc.add_text(label=DocItemLabel.TEXT, text="Revenue by region.")
rows = [["Region", "Q1", "Q2"], ["North", "10", "12"], ["South", "7", "9"]]
td = TableData(num_rows=3, num_cols=3)
for r, row in enumerate(rows):
    for c, t in enumerate(row):
        td.table_cells.append(TableCell(text=t, start_row_offset_idx=r, end_row_offset_idx=r + 1,
                                        start_col_offset_idx=c, end_col_offset_idx=c + 1,
                                        column_header=(r == 0)))
doc.add_table(data=td)
md = doc.export_to_markdown()
print(md)
assert "| North    |   10 |   12 |" in md, md
assert "<table>" in doc.export_to_html()
dt = doc.export_to_doctags()
assert "<otsl>" in dt and "<ched>Region" in dt, dt
doc2 = DoclingDocument.load_from_doctags(DocTagsDocument.from_doctags_and_image_pairs([dt], [None]))
t2 = doc2.tables[0].data
assert (t2.num_rows, t2.num_cols) == (3, 3) and t2.grid[1][0].text == "North", doc2.export_to_markdown()
assert DoclingDocument.model_validate_json(doc.model_dump_json()).export_to_markdown() == md
chunks = list(HierarchicalChunker().chunk(doc))
assert any("North" in c.text for c in chunks), chunks
print("docling-core ok", len(chunks), "chunks")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
