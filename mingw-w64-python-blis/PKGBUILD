_realname=blis
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.3.3
pkgrel=1
pkgdesc="BLIS BLAS-like linear algebra library, as a self-contained C extension (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/explosion/cython-blis'
msys2_references=(
  'purl: pkg:pypi/blis'
)
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-numpy")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cython"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
        "0001-windows-honor-BLIS_COMPILER.patch")
sha256sums=('034d4560ff3cc43e8aa37e188451b0440e3261d989bb8a42ceee865607715ecd'
            '22db5500819d66f2b68f64f18122f8e72a01731295f4ee50938f334fd4f0764b')

# 0001: on win32 setup.py unconditionally compiles the BLIS kernels with
#       clang.exe (searched in PATH or C:\Program Files\LLVM). Let BLIS_COMPILER
#       (set below to the toolchain's $CC) take precedence, so the MSYS2 compiler is used.
prepare() {
  cd "${_realname}-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-windows-honor-BLIS_COMPILER.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  # The prebuilt "x86_64" kernel set includes the Knights Landing (knl)
  # kernels, which need -mavx512pf/-mavx512er; those options were removed
  # from GCC 15+/LLVM 19+. Use the "x86_64_no_skx" set (generic, penryn,
  # sandybridge, haswell, zen, bulldozer family) with runtime CPU dispatch.
  BLIS_ARCH=x86_64_no_skx BLIS_COMPILER="${CC:-gcc}" BLIS_REALLY_COMPILE=1 \
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages && ${MINGW_PREFIX}/bin/python -c "import numpy as np; from blis.py import gemm; a = np.ones((4, 3), dtype='f'); b = np.ones((3, 5), dtype='f'); assert (gemm(a, b) == 3).all()"
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
