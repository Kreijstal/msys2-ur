# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-unsafe452-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.5.2
pkgrel=1
pkgdesc='Original Unsafe4.5.2 IL and reference profiles built with source ILAsm and Csc'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/corefx'
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn44=4.4.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-cecil011-bootstrap=0.11.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-legacy-ns13-contracts-bootstrap>=20261031-4"
             "${MINGW_PACKAGE_PREFIX}-dotnet-ilasm10"
             "${MINGW_PACKAGE_PREFIX}-llvm" 'python')
options=('!strip' '!lto' '!buildflags')
source=('corefx21-unsafe452-02b11eee.tar.gz::https://codeload.github.com/dotnet/corefx/tar.gz/02b11eeee1fbc5f3ef43a1452fe07efd25fa1715'
        'roslyn-4.4.0-1ce8866c.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/1ce8866c9de4c2d67351ef6863699dee03b0804a'
        'unsafe452-source-1.tar.gz')
noextract=('corefx21-unsafe452-02b11eee.tar.gz' 'roslyn-4.4.0-1ce8866c.tar.gz')
sha256sums=('f8043a5f7853d2b667f75a3e530ba7b5e9c1a6651949d0ce2a00c044a6697b54'
            '9edb8c430576c5f5b27032afe8f79c74508b0150e03406a7a4ca6f218e03fd11'
            '2156b2f0a61f42b4d77b8c0b37e13b805a630b8c95574c157896713514cd95ec')
build() {
  /usr/bin/python3 "$srcdir/unsafe452-workflow/compiler44.py" "$srcdir/roslyn-4.4.0-1ce8866c.tar.gz" "$srcdir/compiler44" > "$srcdir/compiler44.log" 2>&1
  /usr/bin/python3 "$srcdir/unsafe452-workflow/build.py" "$srcdir/corefx21-unsafe452-02b11eee.tar.gz" "$srcdir/prepared" "$srcdir/compiler44/bin/Release/net8.0" > "$srcdir/build.log" 2>&1
  /usr/bin/python3 "$srcdir/unsafe452-workflow/pack.py" "$srcdir/prepared" > "$srcdir/pack.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/unsafe452-workflow/audit.py" "$srcdir/prepared" > "$srcdir/audit.log" 2>&1
  /usr/bin/python3 "$srcdir/unsafe452-workflow/check.py" "$srcdir/prepared" "$srcdir/check" "$srcdir/compiler44/bin/Release/net8.0" --feed "$srcdir/prepared/feed" > "$srcdir/check.log" 2>&1
}
package() {
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  local file
  install -Dm644 "$srcdir/prepared/feed/System.Runtime.CompilerServices.Unsafe.4.5.2.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/system.runtime.compilerservices.unsafe.4.5.2.nupkg"
  mkdir -p "$doc/inputs"
  for file in README.md check.py; do install -m644 "$srcdir/unsafe452-workflow/$file" "$doc/$file"; done
  for file in "$srcdir/unsafe452-workflow/inputs/"*; do install -m644 "$file" "$doc/inputs/"; done
  install -m644 "$srcdir/prepared/results.json" "$srcdir/prepared/producer-audit.json" "$doc/"
  install -m644 "$srcdir/compiler44/source-inputs.json" "$doc/compiler44-source-inputs.json"
  install -m644 "$srcdir/check/results.json" "$doc/producer-check-results.json"
  for file in LICENSE.TXT THIRD-PARTY-NOTICES.TXT; do install -Dm644 "$srcdir/prepared/source/$file" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/$file"; done
}
