# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-cecil011-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.11.0
pkgrel=1
pkgdesc='Original source Mono.Cecil0.11 Standard2.0 libraries for reference annotation'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/jbevain/cecil'
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn44=4.4.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netstandard-reference>=2.0.3-3"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netcore-platforms110=1.1.0" 'python')
options=('!strip' '!lto' '!buildflags')
source=('cecil011-12da1bf7.tar.gz::https://codeload.github.com/jbevain/cecil/tar.gz/12da1bf7e0e10278e05eeb23adfc72760bbb6668'
        'roslyn-4.4.0-1ce8866c.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/1ce8866c9de4c2d67351ef6863699dee03b0804a'
        'cecil011-source-1.tar.gz')
noextract=('cecil011-12da1bf7.tar.gz' 'roslyn-4.4.0-1ce8866c.tar.gz')
sha256sums=('ef581a6ff59c8c5993f82ec5dadd470d185823e9407846c3ac992e23efdbcad3'
            '9edb8c430576c5f5b27032afe8f79c74508b0150e03406a7a4ca6f218e03fd11'
            '7e1e8dc4aad9f9b67c5b9fe7c942ea490b7f05e66d133be2fc80b3786cea762a')
prepare() {
  /usr/bin/python3 "$srcdir/cecil011-workflow/prepare.py" "$srcdir/cecil011-12da1bf7.tar.gz" "$srcdir/prepared" > "$srcdir/prepare.log" 2>&1
}
build() {
  /usr/bin/python3 "$srcdir/cecil011-workflow/compiler44.py" "$srcdir/roslyn-4.4.0-1ce8866c.tar.gz" "$srcdir/compiler44" > "$srcdir/compiler44.log" 2>&1
  bash "$srcdir/cecil011-workflow/build.sh" "$srcdir/prepared" "$srcdir/compiler44/bin/Release/net8.0" > "$srcdir/build.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/cecil011-workflow/audit.py" "$srcdir/prepared" > "$srcdir/audit.log" 2>&1
  /usr/bin/python3 "$srcdir/cecil011-workflow/check.py" "$srcdir/prepared" "$srcdir/check" > "$srcdir/check.log" 2>&1
}
package() {
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  local licenses="$pkgdir$MINGW_PREFIX/share/licenses/$_realname"
  install -Dm644 "$srcdir/prepared/feed/Mono.Cecil.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/mono.cecil.$pkgver.nupkg"
  mkdir -p "$doc/inputs"
  local file
  for file in check.py README.md; do install -m644 "$srcdir/cecil011-workflow/$file" "$doc/$file"; done
  for file in Check.cs Api.cs published-ns2-api.json published-api-provenance.json; do
    install -m644 "$srcdir/cecil011-workflow/inputs/$file" "$doc/inputs/$file"
  done
  install -m644 "$srcdir/prepared/source-inputs.json" "$srcdir/prepared/producer-audit.json" "$doc/"
  install -m644 "$srcdir/compiler44/source-inputs.json" "$doc/compiler44-source-inputs.json"
  install -m644 "$srcdir/check/results.json" "$doc/producer-check-results.json"
  install -Dm644 "$srcdir/prepared/source/LICENSE.txt" "$licenses/LICENSE.txt"
  install -Dm644 "$srcdir/prepared/source/symbols/pdb/Microsoft.Cci.Pdb/LICENSE" "$licenses/Microsoft.Cci.Pdb/LICENSE"
  mkdir -p "$licenses/Mono.CompilerServices.SymbolWriter"
  install -m644 "$srcdir/prepared/source/symbols/mdb/Mono.CompilerServices.SymbolWriter/"*.cs "$licenses/Mono.CompilerServices.SymbolWriter/"
}
