_pn() { local b=${1#org.eclipse.}; echo "eclipse-${b//./-}"; }

pkgname=()
for _e in "${_bundles[@]}"; do pkgname+=("${MINGW_PACKAGE_PREFIX}-$(_pn "${_e%%|*}")"); done
pkgdesc="Eclipse Platform UI bundles (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://eclipse.dev/eclipse/'
msys2_repository_url='https://github.com/eclipse-platform/eclipse.platform.ui'
license=('spdx:EPL-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-osgi-annotation"
             "${MINGW_PACKAGE_PREFIX}-java-osgi-service-component-annotations"
             "${MINGW_PACKAGE_PREFIX}-eclipse-pde-api-tools-annotations"
             "${MINGW_PACKAGE_PREFIX}-eclipse-jdt-annotation"
             "${MINGW_PACKAGE_PREFIX}-eclipse-swt"
             "${MINGW_PACKAGE_PREFIX}-eclipse-swt-svg"
             "${MINGW_PACKAGE_PREFIX}-eclipse-core-resources"
             "${MINGW_PACKAGE_PREFIX}-eclipse-core-net"
             "${MINGW_PACKAGE_PREFIX}-eclipse-debug-core"
             "${MINGW_PACKAGE_PREFIX}-eclipse-team-core"
             "${MINGW_PACKAGE_PREFIX}-eclipse-help"
             "${MINGW_PACKAGE_PREFIX}-eclipse-e4-core-services"
             "${MINGW_PACKAGE_PREFIX}-eclipse-e4-core-di-extensions-supplier"
             "${MINGW_PACKAGE_PREFIX}-eclipse-equinox-bidi"
             "${MINGW_PACKAGE_PREFIX}-eclipse-equinox-p2-engine"
             "${MINGW_PACKAGE_PREFIX}-eclipse-emf-ecore-change"
             "${MINGW_PACKAGE_PREFIX}-eclipse-emf-ecore-xmi"
             "${MINGW_PACKAGE_PREFIX}-java-jna-platform")
# SWT's SVG support (JSVG) needs the Service Loader Mediator to resolve
checkdepends=("${MINGW_PACKAGE_PREFIX}-java-aries-spifly-dynamic-bundle"
              "${MINGW_PACKAGE_PREFIX}-java-felix-scr")
source=("eclipse.platform.ui-${_tag}.tar.gz::https://github.com/eclipse-platform/eclipse.platform.ui/archive/refs/tags/${_tag}.tar.gz"
        "eclipse.platform-${_tag}.tar.gz::https://github.com/eclipse-platform/eclipse.platform/archive/refs/tags/${_tag}.tar.gz"
        "eclipse.platform.releng.aggregator-${_tag}.tar.gz::https://github.com/eclipse-platform/eclipse.platform.releng.aggregator/archive/refs/tags/${_tag}.tar.gz"
        "0001-javac-compatibility.patch")
sha256sums=('5c70484fcbc01d3d8950db8e2afeea4ebdc3c05ed65940c22ef36dcfb35863d7'
            '235ea1a33d2388962b90179f64a66a48013ffe576a68210da970557870785b09'
            'f43b389cc2edf029a344f22f9819876347712105da18d3c088d189cdadd73ec1'
            '38aab7555bf93a0ca45cf14f44562a5eb52db107f9891fe1624803ba9f1947d0')
noextract=("eclipse.platform.releng.aggregator-${_tag}.tar.gz")

prepare() {
  # code that ECJ accepts and javac does not
  patch -p1 -i "${srcdir}/0001-javac-compatibility.patch"
  # only the branding bundle is needed from the aggregator
  tar -xzf "${_rel}.tar.gz" "${_rel}/eclipse.platform.releng/bundles/org.eclipse.rcp" "${_rel}/LICENSE"
  # the build id shown in the about dialog (Maven resource filtering upstream)
  sed -i "s/\${buildId}/I${_qualifier#v}/" "${_rel}/eclipse.platform.releng/bundles/org.eclipse.rcp/about.mappings"
  find "${_ui}" "${_pl}" "${_rel}" -type f \( -name '*.jar' -o -name '*.class' -o -name '*.dll' -o -name '*.so' \
    -o -name '*.exe' -o -name '*.dylib' -o -name '*.jnilib' \) -delete
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local -a dirs=()
  local e
  for e in "${_bundles[@]}"; do
    e=${e#*|}
    dirs+=("${e%%|*}")
  done
  JB_QUALIFIER=${_qualifier} jb_bundles -- "${dirs[@]}"
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local e
  for e in "${_bundles[@]}"; do
    jb_bundle_loadcheck "${e%%|*}"
  done
  jb_osgi_resolvecheck
}

_package_bundle() {
  local bsn=$1 n lic="${srcdir}/${_ui}/LICENSE"
  n=$(_pn "${bsn}")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_plugins_install "${bsn}"
  install -Dm644 "${lic}" "${pkgdir}${MINGW_PREFIX}/share/licenses/${n}/LICENSE"
}

for _e in "${_bundles[@]}"; do
  _b=${_e%%|*}
  _d=${_e##*|}
  eval "package_$(_pn "${_b}")() {
    pkgdesc='Eclipse ${_b} bundle (mingw-w64)'
    depends=($(for _x in ${_d}; do printf '"${MINGW_PACKAGE_PREFIX}-%s" ' "${_x}"; done))
    _package_bundle ${_b}
  }"
done

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
