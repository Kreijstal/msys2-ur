# Shared producer/consumer profile for Chromium 140, Windows x64 UCRT64.
# ABI compatibility is checked against resolved GN values, not just this file.
use_custom_libcxx=false
use_lld=false
use_siso=false
use_sysroot=false
chrome_pgo_phase=0
clang_use_chrome_plugins=false
enable_rust=false
treat_warnings_as_errors=false
v8_enable_etw_stack_walking=false
v8_enable_fuzztest=false
v8_enable_system_instrumentation=false
v8_enable_verify_heap=false
v8_enable_partition_alloc=false
v8_use_external_startup_data=false
v8_enable_i18n_support=true
icu_use_data_file=false
v8_enable_webassembly=true
v8_enable_pointer_compression=true
v8_enable_pointer_compression_shared_cage=true
v8_enable_external_code_space=true
v8_enable_sandbox=true
cppgc_enable_caged_heap=true
win_enable_cfg_guards=true
v8_use_perfetto=true
is_mingw=true
is_official_build=true
v8_enable_gdbjit=false
v8_imminent_deprecation_warnings=false
v8_enable_maglev_graph_printer=false
