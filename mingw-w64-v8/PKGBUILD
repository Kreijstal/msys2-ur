apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -p1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  python "${srcdir}/unpack.py" --cache "$(cygpath -m "${srcdir}")" \
    --qt-archive "${_qtarchive}" --source-name "${_srcname}"
  cp "${srcdir}/qt-build-inputs/config/"{jumbo.gni,merge_for_jumbo.py} "${srcdir}/build/config/"
  echo ":: Patching build directory"
  cd "${srcdir}"/build
  patch -p1 -i "${srcdir}"/001-add-mingw-toolchain.patch
  patch -p1 -i "${srcdir}/021-standalone-qt-args.patch"
  python "${srcdir}"/build/util/lastchange.py -o "${srcdir}"/build/util/LASTCHANGE
  echo "build_with_chromium = false" > "${srcdir}/build/config/gclient_args.gni"

  cd "${srcdir}/abseil-cpp"
  patch -p1 -i "${srcdir}/015-abseil-build-as-static-lib.patch"
  patch -p1 -i "${srcdir}/025-chromium-abseil-compat.patch"
  cd "${srcdir}/zlib"
  patch -p1 -i "${srcdir}/016-zlib-use-system-lib.patch"
  # Native GN and Python need real Windows directory junctions, not MSYS links.
  python "${srcdir}/unpack.py" --assemble --cache "$(cygpath -m "${srcdir}")" \
    --qt-archive "${_qtarchive}" --source-name "${_srcname}"

  echo ":: Patching v8 source"
  cd "${srcdir}"/${_srcname}
  apply_patch_with_msg \
    002-buildflags-fixes.patch \
    003-fix-macros-and-functions.patch \
    004-fix-static-assert-implementations.patch \
    005-fix-conflicting-macros.patch \
    006-support-clang-in-mingw-mode.patch \
    007-snapshot-use-system-zlib-header.patch \
    008-prioritized-native-thread-on-windows.patch \
    009-unicode-for-wide-char-functions.patch \
    010-disable-msvc-hack.patch \
    011-make-sure-that-__rdtsc-is-declared.patch \
    012-remove-dllimport-attributes.patch \
    013-builtin-deps-fixes.patch \
    014-heap-use-proper-sources.patch \
    017-highway-disable-avx10-on-mingw.patch \
    018-sdk-interface.patch \
    019-perfetto-mingw.patch \
    020-standalone-qt-build.patch \
    022-perfetto-protobuf-generators.patch \
    023-gn-stamp-files.patch \
    024-export-startup-blob.patch \
    026-perfetto-category-registry-linkage.patch


}

build() {
  cd ${_srcname}

  local _debug=false
  local _symbol=0
  if check_option "debug" "y"; then
    _debug=true
    _symbol=2
  fi

  local _arch=x64
  if [[ ${CARCH} == aarch64 ]]; then
    _arch=arm64
  fi

  local _clang=false
  if [[ ${MSYSTEM} == CLANG* ]]; then
    _clang=true
  fi

  local _gn_args
  _gn_args="$(cat "${srcdir}/abi-profile.gn")
    target_cpu=\"${_arch}\"
    is_debug=${_debug}
    is_clang=${_clang}
    symbol_level=${_symbol}
    v8_symbol_level=${_symbol}
    enable_iterator_debugging=${_debug}
    use_jumbo_build=true
    jumbo_file_merge_limit=8
    v8_export_startup_blob=true
    enable_resource_allowlist_generation=false"

  if [[ ${_debug} == true ]]; then
    _gn_args="${_gn_args/is_official_build=true/is_official_build=false}"
  fi

  gn gen out/shared --threads=1 --fail-on-unused-args --args="${_gn_args} is_component_build=true"
  ninja -j"${V8_BUILD_JOBS:-4}" -C out/shared v8 d8 torque torque-language-server mksnapshot v8_generate_features_json v8_sdk_config
  gn args out/shared --list --json > out/shared/resolved-args.json
  gn desc out/shared //:v8 --format=json > out/shared/interface.json
  gn desc out/shared //:cppgc --format=json > out/shared/cppgc-interface.json

  gn gen out/static --threads=1 --fail-on-unused-args --args="${_gn_args} is_component_build=false v8_monolithic=true"
  ninja -j"${V8_BUILD_JOBS:-4}" -C out/static v8_monolith v8_sdk_config
  gn args out/static --list --json > out/static/resolved-args.json
  gn desc out/static //:v8 --format=json > out/static/interface.json
  gn desc out/static //:v8_monolith libs --format=json > out/static/link-libs.json
  gn desc out/static //:cppgc --format=json > out/static/cppgc-interface.json

}

package() {
  cd "${srcdir}/${_srcname}"
  python "${srcdir}/sdk.py" install --source . --shared out/shared --static out/static \
    --dest "$(cygpath -m "${pkgdir}${MINGW_PREFIX}")" --version "${pkgver}" \
    --revision "${_v8_revision}" --runtime ucrt64 --vendor-sha256 "${sha256sums[0]}"
  install -Dm644 LICENSE* -t "${pkgdir}${MINGW_PREFIX}/share/licenses/v8"
}
