muse: fix MinGW builds of the framework

- dlib.h used dlopen() for __MINGW64__ (dlfcn-win32); use LoadLibrary on
  every Windows toolchain, and cast GetProcAddress()'s FARPROC explicitly.
- mpe/soundid.h: the id/category string maps were inline variables, used
  by other globals' constructors during dynamic initialization. clang on
  MinGW does not run inline variables' initializers first (Audacity 4,
  built on the same framework, aborted at startup with
  unordered_map::at: key not found). Make them function-local statics.
- threadutils.h: with libstdc++ on MinGW, std::thread runs on winpthreads
  and native_handle() is a pthread_t, not a HANDLE; get the HANDLE with
  pthread_gethandle().

diff --git a/src/framework/global/concurrency/threadutils.h b/src/framework/global/concurrency/threadutils.h
index f71f587f..8a34c952 100644
--- a/src/framework/global/concurrency/threadutils.h
+++ b/src/framework/global/concurrency/threadutils.h
@@ -30,6 +30,9 @@
 
 #ifdef Q_OS_WIN
 #include <windows.h>
+#if defined(__MINGW32__) && !defined(_LIBCPP_VERSION)
+#include <pthread.h> // pthread_gethandle()
+#endif
 #else
 #include <pthread.h>
 #endif
@@ -57,7 +60,13 @@ static bool setThreadPriority(std::thread& thread, ThreadPriority priority)
         break;
     }
 
-    if (!SetThreadPriority(thread.native_handle(), winPriority)) {
+#if defined(__MINGW32__) && !defined(_LIBCPP_VERSION)
+    // libstdc++ on MinGW runs on winpthreads: native_handle() is a pthread_t
+    HANDLE handle = pthread_gethandle(thread.native_handle());
+#else
+    HANDLE handle = thread.native_handle();
+#endif
+    if (!SetThreadPriority(handle, winPriority)) {
         return false;
     }
 #else
