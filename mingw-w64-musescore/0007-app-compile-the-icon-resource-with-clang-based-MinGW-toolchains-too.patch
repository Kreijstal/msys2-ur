app: compile the icon resource with clang-based MinGW toolchains too

windows_icons.rc (application and file icons, version info) was only
compiled for MSVC and GCC (CC_IS_MINGW is only set for GCC), so the
clang64 executable had no icon.

diff --git a/src/app/CMakeLists.txt b/src/app/CMakeLists.txt
index ddfc5835..b08dea7e 100644
--- a/src/app/CMakeLists.txt
+++ b/src/app/CMakeLists.txt
@@ -36,7 +36,7 @@ if (OS_IS_WIN)
     if (CC_IS_MSVC)
         # MSVC recognizes a *.rc file and will invoke the resource compiler to link it
         set(WINDOWS_ICONS_RC ${PROJECT_SOURCE_DIR}/share/icons/windows_icons.rc)
-    elseif(CC_IS_MINGW)
+    elseif(MINGW) # GCC and Clang
         set(WINDOWS_ICONS_RC ${PROJECT_BINARY_DIR}/windows_icons_rc.o)
         add_custom_command(
             OUTPUT ${PROJECT_BINARY_DIR}/windows_icons_rc.o
