             "${MINGW_PACKAGE_PREFIX}-qt6-shadertools"
             "${MINGW_PACKAGE_PREFIX}-qt6-tools"
             "${MINGW_PACKAGE_PREFIX}-utf8cpp"
             "${MINGW_PACKAGE_PREFIX}-vst3sdk")
optdepends=("${MINGW_PACKAGE_PREFIX}-ffmpeg: video export")
_patches=("0001-Do-not-fetch-the-MSVC-prebuilt-dependencies-on-MinGW.patch"
          "0002-Fix-the-MinGW-compiler-flags.patch"
          "0003-Install-into-a-shared-prefix-on-MinGW.patch"
          "0004-muse-fix-MinGW-builds-of-the-framework.patch"
          "0005-Give-header-constants-internal-linkage.patch"
          "0006-audio-do-not-use-an-inline-thread-local-member-in-RpcPacker.patch"
          "0007-app-compile-the-icon-resource-with-clang-based-MinGW-toolchains-too.patch"
          "0008-async-do-not-call-back-into-receivers-that-already-disconnected.patch"
          "0009-audio-add-MUE-COMPILE-USE-SYSTEM-FDKAAC.patch")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/musescore/MuseScore/archive/refs/tags/v${pkgver}.tar.gz"
