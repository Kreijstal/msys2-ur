prepare() {
  cd "${srcdir}/MuseScore-${pkgver}"
  local _p
  for _p in "${_patches[@]}"; do
    patch -Np1 -i "${srcdir}/${_p}"
  done

  # fdk-aac comes from the system package (0009); make sure the bundled copy
  # cannot be used
  rm -rf "${srcdir:?}/MuseScore-${pkgver}/src/framework/audio/thirdparty/fdk-aac"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # __FILE__ is used in log and assert messages; do not embed the build path
  CFLAGS+=" -ffile-prefix-map=$(cygpath -m "${srcdir}")=."
  CXXFLAGS+=" -ffile-prefix-map=$(cygpath -m "${srcdir}")=."

  # Dependencies come from MSYS2 packages wherever MuseScore offers a
  # MUE_COMPILE_USE_SYSTEM_* switch (all of them are on; fdk-aac's is added
  # by 0009); fluidsynth, KDDockWidgets, liblouis and the other
  # forked/bundled libraries are compiled in. FetchContent may not download anything.
  # The soundfont (MS Basic.sf3) is part of the release tarball.
  # Off, as in Linux distributions: update checks and crash reporting
  # (crashpad, which does not build with MinGW anyway). Unit tests are not
  # built.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -S "${srcdir}/MuseScore-${pkgver}" \
      -B "${srcdir}/build-${MSYSTEM}" \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DMUSESCORE_BUILD_CONFIGURATION=app \
      -DMUSE_APP_BUILD_MODE=release \
      -DMUSE_ENABLE_UNIT_TESTS=OFF \
      -DMUSE_COMPILE_USE_COMPILER_CACHE=OFF \
      -DMUSE_MODULE_UPDATE=OFF \
      -DMUSE_MODULE_DIAGNOSTICS_CRASHPAD_CLIENT=OFF \
      -DMUSE_MODULE_VST=ON \
      -DMUSE_MODULE_VST_VST3_SDK_PATH="${MINGW_PREFIX}/share/vst3sdk" \
      -DMUSE_MODULE_AUDIO_ASIO_SDK_PATH="$(cygpath -m "${srcdir}")" \
      -DMUE_DOWNLOAD_SOUNDFONT=OFF \
      -DMUE_COMPILE_USE_SYSTEM_FDKAAC=ON \
      -DMUE_COMPILE_USE_SYSTEM_FLAC=ON \
      -DMUE_COMPILE_USE_SYSTEM_FREETYPE=ON \
      -DMUE_COMPILE_USE_SYSTEM_HARFBUZZ=ON \
      -DMUE_COMPILE_USE_SYSTEM_LAME=ON \
      -DMUE_COMPILE_USE_SYSTEM_MNXDOM=ON \
      -DMUE_COMPILE_USE_SYSTEM_OPUS=ON \
      -DMUE_COMPILE_USE_SYSTEM_OPUSENC=ON \
      -DMUE_COMPILE_USE_SYSTEM_PUGIXML=ON \
      -DMUE_COMPILE_USE_SYSTEM_UTF8CPP=ON \
      -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
      "${_extra_config[@]}"
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/build-${MSYSTEM}"
}

check() {
  local _root="${srcdir}/check-${MSYSTEM}"
  rm -rf "${_root:?}"
  DESTDIR="${_root}" "${MINGW_PREFIX}/bin/cmake.exe" --install "${srcdir}/build-${MSYSTEM}" >/dev/null
  local _exe="${_root}${MINGW_PREFIX}/bin/MuseScore4.exe"
  local _demo="${srcdir}/MuseScore-${pkgver}/demos/Amazing_grace.mscz"
  cd "${srcdir}"
  rm -f check.{pdf,mid,wav}

  "${_exe}" --version | tr -d '\r' > version.txt
  grep -qx "MuseScore4 ${pkgver}" version.txt || { cat version.txt; return 1; }

  # the converter engraves (PDF), exports MIDI and renders audio through the
  # bundled fluidsynth with the soundfont from <prefix>/share/mscore-x.y (0003)
  local _out
  for _out in check.pdf check.mid check.wav; do
    QT_QPA_PLATFORM=offscreen "${_exe}" -o "$(cygpath -m "${srcdir}/${_out}")" "$(cygpath -m "${_demo}")"
  done
  [[ "$(head -c 5 check.pdf)" == "%PDF-" ]]
  [[ "$(head -c 4 check.mid)" == "MThd" ]]
  [[ $(stat -c %s check.wav) -gt 1000000 ]]
  rm -rf "${_root:?}" check.{pdf,mid,wav}
}

package() {
  DESTDIR="${pkgdir}" "${MINGW_PREFIX}/bin/cmake.exe" --install "${srcdir}/build-${MSYSTEM}"

  install -Dm644 "${srcdir}/MuseScore-${pkgver}/LICENSE.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.txt"
}
