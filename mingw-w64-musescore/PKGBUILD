_realname=musescore
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.7.5
pkgrel=1
pkgdesc='Music notation and composition software (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://musescore.org/'
msys2_repository_url='https://github.com/musescore/MuseScore'
msys2_changelog_url='https://github.com/musescore/MuseScore/releases'
license=('spdx:GPL-3.0-only AND GPL-2.0-or-later AND LGPL-2.1-or-later AND MIT AND OFL-1.1')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-fdk-aac"
         "${MINGW_PACKAGE_PREFIX}-flac"
         "${MINGW_PACKAGE_PREFIX}-freetype"
         "${MINGW_PACKAGE_PREFIX}-harfbuzz"
         "${MINGW_PACKAGE_PREFIX}-lame"
         "${MINGW_PACKAGE_PREFIX}-libopusenc"
         "${MINGW_PACKAGE_PREFIX}-mnxdom"
         "${MINGW_PACKAGE_PREFIX}-opus"
         "${MINGW_PACKAGE_PREFIX}-pugixml"
         "${MINGW_PACKAGE_PREFIX}-qt6-5compat"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-qt6-declarative"
         "${MINGW_PACKAGE_PREFIX}-qt6-networkauth"
         "${MINGW_PACKAGE_PREFIX}-qt6-svg"
         "${MINGW_PACKAGE_PREFIX}-zlib")
