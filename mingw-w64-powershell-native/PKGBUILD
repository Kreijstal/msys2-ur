# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=powershell-native
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=700.0.0
pkgrel=1
pkgdesc='PowerShell native WinRM plugin and ETW resources built from source with CLANG64'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/PowerShell/PowerShell-Native'
license=('spdx:MIT')
_commit=2c55e8fc288e31ce72974ad783151b06049591c4
_metadata_commit=2f767671802301cf043c717d66bf004ed7863487
depends=("${MINGW_PACKAGE_PREFIX}-libc++" "${MINGW_PACKAGE_PREFIX}-libunwind")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-lld" "${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131"
             "${MINGW_PACKAGE_PREFIX}-dotnet-event-manifest-compiler" 'python' 'binutils')
options=('!strip' '!lto')
source=("native-${pkgver}.tar.gz::https://codeload.github.com/PowerShell/PowerShell-Native/tar.gz/refs/tags/v${pkgver}"
        "eventman-${_metadata_commit}.xsd::https://raw.githubusercontent.com/microsoft/win32metadata/${_metadata_commit}/generation/WinSDK/RecompiledIdlHeaders/um/eventman.xsd"
        "winmeta-${_metadata_commit}.xml::https://raw.githubusercontent.com/microsoft/win32metadata/${_metadata_commit}/generation/WinSDK/RecompiledIdlHeaders/um/winmeta.xml"
        prepare.py prepare-manifest.py expected-events.py build-plugin.sh build-instrumentation.sh
        Native.csproj check.sh check-native.cpp README.md)
sha256sums=('a3fd1e53f1de8699f3a34a587524edffb5d5d6f862dcb9ed862cdc746da2eff9'
            'cc4e30e4c30504568cb3e83279b2b3692228ee4a7a0019656e3f5c33d0027407'
            '8d6b92db90b7c45202267fe06e81be16960bc6511f79294ee35fb86c25177e14'
            'e5b1319b84b6f2483dfe34e0e9b69d9e67a723b4af95e8aae8dac386fad7a00c'
            '94a6dee3db771aae5620eb9efeff21cd84af756c77f33104276236d00f3a0b8d'
            'ad5c5f017e7a4e06f52d9bfa6c970aecca6bf170a6d45265d8fa593cb6fe2cd5'
            'cac9eb7b2dfb50926a7175acd81ee65123bb7fae8f988d02a493bf986c59d2b5'
            '5e111214b2d96f1fb6b78f4c692be1e2d808ffa9125b6d879ec1abcb78ddfaf3'
            'e7b11499b3db1a630066e90cfdeb52ef168d60d18337a45b9bc3926e61d97e8d'
            '7d06250dec406fddccac3f6bafa1d62730bbcfb0521128a478f85b6079074060'
