            '8237a200fb9829e7b90045cccbbcb67d57b8c8e21f47c1a0865c942bde90c8f4')
_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT MSBuildEnableWorkloadResolver=false
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
}
prepare() {
  /usr/bin/python3 "$srcdir/expected-events.py" \
    "$srcdir/PowerShell-Native-$pkgver/src/PowerShell.Core.Instrumentation/PowerShell.Core.Instrumentation.man" \
    "$srcdir/winmeta-${_metadata_commit}.xml" "$srcdir/expected-events.h"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/PowerShell-Native-$pkgver"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  bash "$srcdir/build-plugin.sh" "$srcdir/PowerShell-Native-$pkgver" "$srcdir/plugin"
  bash "$srcdir/build-instrumentation.sh" "$srcdir/PowerShell-Native-$pkgver" \
    "$srcdir/eventman-${_metadata_commit}.xsd" "$srcdir/winmeta-${_metadata_commit}.xml" "$srcdir/instrumentation"
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$(cygpath -m "$srcdir/Native.csproj")" \
    -c Release -o "$(cygpath -m "$srcdir/feed")" --configfile "$(cygpath -m "$srcdir/NuGet.config")" \
    -p:UseSharedCompilation=false -v:minimal
}
check() {
  _env
  bash "$srcdir/check.sh" "$srcdir/consumer" "$srcdir/feed" "$srcdir/expected-events.h"
}
package() {
  install -Dm644 "$srcdir/feed/Microsoft.PowerShell.Native.$pkgver.nupkg" \
    "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.powershell.native.$pkgver.nupkg"
  install -Dm644 "$srcdir/PowerShell-Native-$pkgver/LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -m644 "$srcdir/expected-events.h" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/expected-events.h"
}
