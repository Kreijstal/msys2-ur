# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-sdk8-servicing
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=8.0.131
pkgrel=5
pkgdesc='Audited source SDK8 with source-built8.0.31 apphost and runtime packs (mingw-w64)'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/sdk'
license=('spdx:MIT' 'spdx:Apache-2.0' 'spdx:BSD-3-Clause')
provides=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=${pkgver}-${pkgrel}")
conflicts=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk")
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131"
         "${MINGW_PACKAGE_PREFIX}-dotnet-runtime8-servicing>=8.0.31"
         "${MINGW_PACKAGE_PREFIX}-dotnet-targeting8-servicing>=8.0.31-2"
         "${MINGW_PACKAGE_PREFIX}-dotnet-sdk-netanalyzers>=8.0.0.preview26274.2")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131"
             "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja" "${MINGW_PACKAGE_PREFIX}-llvm"
             'mingw-w64-ucrt-x86_64-mono>=6.12.0.199' 'python' 'patch' 'make')
options=('!strip' '!lto' '!buildflags')
# The SDK input is our unchanged, audited source-bootstrap package, built by
# mingw-w64-dotnet-bootstrap from the Mono seed. No vendor SDK binaries enter.
# The servicing workflows of Kreijstal/dotnet-mingw-bootstrap, for both
# environments: UCRT64 builds the host with GCC (bootstrap/m612 of the same
# tree), CLANG64 with clang (the pinned 3cbf210 bootstrap archive).
_workflow_commit=5ab58f8ba94346c59bc68ab052d8f96f124be323
case ${MINGW_PACKAGE_PREFIX} in
  *-clang-*) _seed_sha256=ff4dcc2e03a30192000fed9aca8aebb2154c1e3a7a16e12ef535b107f047dc26 ;;
  *-ucrt-*)  _seed_sha256=f66aba48a5003d48c1ab62b844b70394ed552ca22bf3fea44ac499f0a2bdcaac ;;
esac
source=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk-8.0.131-4-any.pkg.tar.zst::https://github.com/Kreijstal/msys2-ur/releases/download/x11-shared-20260731/${MINGW_PACKAGE_PREFIX}-dotnet-sdk-8.0.131-4-any.pkg.tar.zst"
        'runtime-v8.0.31.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v8.0.31'
        "dotnet-bootstrap-3cbf21078968e2290a54ab093392b4dfeb1c6f1f.tar.gz::https://github.com/Kreijstal/msys2-ur/releases/download/x11-shared-20260731/dotnet-bootstrap-3cbf21078968e2290a54ab093392b4dfeb1c6f1f.tar.gz"
        "dotnet-mingw-bootstrap-${_workflow_commit}.tar.gz::https://codeload.github.com/Kreijstal/dotnet-mingw-bootstrap/tar.gz/${_workflow_commit}"
        'README.md')
noextract=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk-8.0.131-4-any.pkg.tar.zst"
           'runtime-v8.0.31.tar.gz'
           'dotnet-bootstrap-3cbf21078968e2290a54ab093392b4dfeb1c6f1f.tar.gz')
sha256sums=("${_seed_sha256}"
            'b32a56a29cc0248bed219e1c7ef026bf8f006d997f5d6346382e63a22ecd9070'
            '75bea2026b90c7f4d5f88279c4ff25ca07b4a6eb0e435df90a41c6f485f773c6'
            '24974161228063be2625cb833d8df112e7d4ae3dd60d7acf5d4bdd3ec6984e63'
            'd1d249d6b14ec818b268e451fb09e91da1a40a443e4797880e7ea082957e8126')
if [[ ${MINGW_PACKAGE_PREFIX} == *-ucrt-* ]]; then
  makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131"
               "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-cmake"
               "${MINGW_PACKAGE_PREFIX}-ninja" "${MINGW_PACKAGE_PREFIX}-python"
               'mingw-w64-ucrt-x86_64-mono>=6.12.0.199' 'python' 'patch' 'make' 'zstd')
fi
_wf() { printf '%s/dotnet-mingw-bootstrap-%s/workflows/%s' "${srcdir}" "${_workflow_commit}" "$1"; }

build() {
  bash "$(_wf sdk8-servicing)/build-host.sh" "$(_wf runtime-servicing)" \
    "$srcdir/runtime-v8.0.31.tar.gz" \
    "$srcdir/dotnet-bootstrap-3cbf21078968e2290a54ab093392b4dfeb1c6f1f.tar.gz" \
    "$srcdir/prepared" "$srcdir/dotnet-mingw-bootstrap-${_workflow_commit}"
  /usr/bin/python3 "$(_wf sdk8-servicing)/stage-sdk.py" \
    "$srcdir/${MINGW_PACKAGE_PREFIX}-dotnet-sdk-8.0.131-4-any.pkg.tar.zst" \
    "$srcdir/prepared" "$srcdir/sdk-stage"
}

check() {
  /usr/bin/python3 "$(_wf sdk8-servicing)/prepare-check-layout.py" "$srcdir/sdk-stage" "$srcdir/sdk-check-root"
  bash "$(_wf sdk8-servicing)/check-packs.sh" "$srcdir/sdk-check-root" "$srcdir/sdk-pack-check"
}

package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -a "$srcdir/sdk-stage/${MINGW_PREFIX#/}/." "$pkgdir$MINGW_PREFIX/"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$doc"
  install -m644 "$srcdir/README.md" "$doc/"
  install -m644 "$srcdir/sdk-stage/source-sdk-servicing.json" "$doc/"
  for file in source-inputs version-build-inputs file-version-adapters; do
    install -m644 "$srcdir/prepared/$file.json" "$doc/host-$file.json"
  done
  install -m644 "$(_wf sdk8-servicing)/check-packs.sh" "$doc/"
  install -m644 "$(_wf sdk8-servicing)/audit-packs-check.py" "$doc/"
  install -m644 "$(_wf sdk8-servicing)/inputs/source-inputs.json" "$doc/runtime-list-source-inputs.json"
  local licenses="$pkgdir$MINGW_PREFIX/share/licenses/$_realname"
  install -Dm644 "$srcdir/prepared/m/src/runtime-8.0.31-native/LICENSE.TXT" "$licenses/runtime-LICENSE.TXT"
  install -m644 "$srcdir/prepared/m/src/runtime-8.0.31-native/THIRD-PARTY-NOTICES.TXT" "$licenses/runtime-THIRD-PARTY-NOTICES.TXT"
  install -m644 "$(_wf sdk8-servicing)/inputs/LICENSE.TXT" "$licenses/Arcade-LICENSE.TXT"
}
