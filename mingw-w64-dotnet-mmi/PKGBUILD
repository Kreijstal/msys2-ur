# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-mmi
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.0.0.preview1
pkgrel=4
_nugetver=2.0.0-preview.1
pkgdesc='Experimental source-built MMI CIM bindings with native async and XML serialization ports for .NET 8'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/PowerShell/MMI'
license=('spdx:MIT')
_commit=cf32fc695b32c2eae848b693395c09222fe1d2ae
_tree=MMI-${_commit}
_id=Microsoft.Management.Infrastructure
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" "${MINGW_PACKAGE_PREFIX}-clang" 'python' 'patch')
options=('!strip' '!lto')
source=("mmi-${_commit}.tar.gz::https://codeload.github.com/PowerShell/MMI/tar.gz/${_commit}"
        prepare.py 0001-validate-native-handles.patch 0002-accept-empty-operation-callbacks.patch 0003-implement-timeouts-and-xml-serialization.patch 0004-native-result-callbacks-and-operation-lifetime.patch 0005-native-destination-and-proxy-credentials.patch 0006-extended-callbacks-and-operation-options-clone.patch 0007-streamed-method-results-and-native-wrapper-ownership.patch MmiStreamChecks.cs check-streamed-results.c MmiExtendedCallbackChecks.cs check-extended-callbacks.c MmiCredentialChecks.cs check-credential-abi.c MmiProbe.cs MmiPortChecks.cs NativeDependencies.cs README.md)
