_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/$_tree" "$srcdir/mmi" --patched --public-sign
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$(cygpath -m "$srcdir/mmi/Mmi.csproj")" -c Release \
    -o "$(cygpath -m "$srcdir/feed")" --configfile "$(cygpath -m "$srcdir/NuGet.config")" \
    -p:PackageId="$_id" -p:PackageVersion="$_nugetver" -p:Version="$_nugetver" \
    -p:RepositoryUrl="$url" -p:RepositoryCommit="$_commit" -p:PackageLicenseExpression=MIT \
    -p:PackageDescription="$pkgdesc" -p:GeneratePackageOnBuild=false -p:UseSharedCompilation=false -v:minimal
}
check() {
  _env
  mkdir -p "$srcdir/check"
  "$MINGW_PREFIX/bin/clang" -std=c11 -Wall -Wextra -Werror "$srcdir/check-credential-abi.c" -lmi -o "$srcdir/check-credential-abi.exe"
  "$srcdir/check-credential-abi.exe"
  "$MINGW_PREFIX/bin/clang" -std=c11 -shared -Wall -Wextra -Werror "$srcdir/check-extended-callbacks.c" -o "$srcdir/check/mmi-callback-driver.dll"
  "$MINGW_PREFIX/bin/clang" -std=c11 -shared -Wall -Wextra -Werror "$srcdir/check-streamed-results.c" -o "$srcdir/check/mmi-stream-driver.dll"
  cp "$srcdir/MmiStreamChecks.cs" "$srcdir/MmiExtendedCallbackChecks.cs" "$srcdir/MmiCredentialChecks.cs" "$srcdir/MmiProbe.cs" "$srcdir/MmiPortChecks.cs" "$srcdir/NativeDependencies.cs" "$srcdir/check/"
  cat > "$srcdir/check/check.csproj" <<PROJECT
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="$_id" Version="[$_nugetver]" /><None Include="mmi-callback-driver.dll" CopyToOutputDirectory="PreserveNewest" /><None Include="mmi-stream-driver.dll" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" build "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    --configfile "$(cygpath -m "$srcdir/NuGet.config")" -p:RestoreSources="$(cygpath -m "$srcdir/feed")" -p:UseSharedCompilation=false -v:minimal
  for mode in local port capabilities; do
    args=()
    [[ $mode == local ]] || args+=("--${mode}-checks")
    [[ $mode != capabilities ]] || args=(--capabilities)
    timeout 90 "$MINGW_PREFIX/lib/dotnet/dotnet.exe" "$(cygpath -m "$srcdir/check/bin/Release/net8.0/check.dll")" "${args[@]}"
  done
}
package() {
  install -Dm644 "$srcdir/feed/$_id.$_nugetver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${_id,,}.$_nugetver.nupkg"
  install -Dm644 "$srcdir/$_tree/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
}
