# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-ilasm10
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.5
pkgrel=1
pkgdesc='Source-built .NET10 native IL assembler with MinGW resource handling'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing=8.0.131"
             "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja" "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-uasm" "${MINGW_PACKAGE_PREFIX}-python"
             'python' 'patch')
options=('!strip' '!lto' '!buildflags' '!debug')
source=('runtime-v10.0.5.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.5'
        'dotnet-ilasm10-source-1.tar.gz'
        'maintenance-ab95a1f1.tar.gz::https://codeload.github.com/dotnet/maintenance-packages/tar.gz/ab95a1f103b49919ba02577a99f3173405bb50ca')
noextract=('runtime-v10.0.5.tar.gz' 'maintenance-ab95a1f1.tar.gz')
sha256sums=('1692acae5e3adfd625452fbc9db4fd4e982c10e38189358ae245c74dd5514d7a'
            'bda8b3a735b501c0b51f491984decf81928412fa62a74f5ddbd4b914df3c168a'
            '6e6f764834ebf0d9135d0c0dff9d78209df629eee496192c022a531e7f915a7e')
prepare() {
  /usr/bin/python3 "$srcdir/ilasm10/prepare.py" "$srcdir/runtime-v10.0.5.tar.gz" "$srcdir/prepared"
}
build() {
  bash "$srcdir/ilasm10/build.sh" "$srcdir/prepared" "$srcdir/runtime-v10.0.5.tar.gz" "${ILASM10_JOBS:-2}"
}
check() {
  /usr/bin/python3 "$srcdir/ilasm10/check.py" "$srcdir/prepared" "$srcdir/maintenance-ab95a1f1.tar.gz" "$srcdir/check"
  bash "$srcdir/ilasm10/audit.sh" "$srcdir/prepared" "$srcdir/runtime-v10.0.5.tar.gz"
}
package() {
  install -Dm755 "$srcdir/prepared/coreclr-build/ilasm/ilasm.exe" "$pkgdir$MINGW_PREFIX/bin/ilasm10.exe"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$doc"
  install -m644 "$srcdir/ilasm10/README.md" "$doc/"
  install -m644 "$srcdir/prepared/"{source-audit,patch-inputs,version-build-inputs,native-version-inputs,ilasm-image-results}.json "$doc/"
  install -m644 "$srcdir/check/results.json" "$doc/check-results.json"
  install -Dm644 "$srcdir/prepared/r/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE.TXT"
  install -Dm644 "$srcdir/prepared/r/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.TXT"
}
