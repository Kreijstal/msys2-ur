# Maintainer: Kreijstal <rainb@tfwno.gf>

# zstd-jni (built with sbt upstream): the Java classes compiled with javac
# and the JNI library, with the zstd sources it bundles, compiled with the
# GCC flags of build.sbt into the jar as /win/amd64/libzstd-jni-<ver>.dll,
# where com.github.luben.zstd.util.Native looks for it.

_realname=zstd-jni
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=1.5.7.6
_ver=1.5.7-6
pkgrel=1
pkgdesc="JNI bindings for the Zstd compression library, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/luben/zstd-jni'
license=('spdx:BSD-2-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-cc")
source=("${_realname}-${_ver}.tar.gz::https://github.com/luben/zstd-jni/archive/refs/tags/v${_ver}.tar.gz")
sha256sums=('ff3a5989d1e0f0b51aa3087e276080be97679d0ace64c6f9c195116a5fcd6d28')

_src=${_realname}-${_ver}

prepare() {
  # sbt launcher and gradle wrapper
  find "${_src}" -name '*.jar' -print -delete
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  # generated by build.sbt
  mkdir -p "${srcdir}/generated/com/github/luben/zstd/util"
  printf 'package com.github.luben.zstd.util;\n\npublic class ZstdVersion {\n\tpublic static final String VERSION = "%s";\n}\n' \
    "${_ver}" > "${srcdir}/generated/com/github/luben/zstd/util/ZstdVersion.java"

  # the JNI library; the tag carries no legacy/ sources, so no support for
  # pre-0.8 zstd frames (ZSTD_LEGACY_SUPPORT=0)
  local inc out="${srcdir}/native-res/win/amd64" o
  inc=$(ls -d "${MINGW_PREFIX}"/lib/jvm/*/include | head -1)
  mkdir -p "${out}" "${srcdir}/native-obj"
  local -a flags=(-std=c99 -O2 -Wno-unused-variable -DZSTD_LEGACY_SUPPORT=0 -DZSTD_MULTITHREAD=1
                  -D_JNI_IMPLEMENTATION_ -I"${inc}" -I"${inc}/win32"
                  -Isrc/main/native -Isrc/main/native/common)
  local f
  while read -r f; do
    o="${srcdir}/native-obj/$(echo "${f#src/main/native/}" | tr '/' '_').o"
    ${CC:-gcc} "${flags[@]}" -c "${f}" -o "${o}" || return 1
  done < <(find src/main/native \( -name '*.c' -o -name '*.S' \) | sort)
  ${CC:-gcc} -shared -o "${out}/libzstd-jni-${_ver}.dll" "${srcdir}"/native-obj/*.o \
    -Wl,--kill-at -static-libgcc -Wl,--version-script=libzstd-jni.so.map -lpthread
  strip "${out}/libzstd-jni-${_ver}.dll"

  jb_module com.github.luben:zstd-jni:${_ver} src/main/java -s "${srcdir}/generated" \
    -r "${srcdir}/native-res" -m 'Automatic-Module-Name: com.github.luben.zstd_jni'
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests are written in Scala (ScalaTest); round-trip data
  # through the freshly built native library instead
  jb_loadcheck com.github.luben:zstd-jni
  local t="${srcdir}/smoke" cp
  mkdir -p "${t}"
  cat > "${t}/Smoke.java" <<'JAVA'
import com.github.luben.zstd.Zstd;
import java.util.Arrays;
public class Smoke {
  public static void main(String[] a) {
    byte[] data = new byte[100000];
    for (int i = 0; i < data.length; i++) data[i] = (byte) (i % 7);
    byte[] c = Zstd.compress(data, 3);
    byte[] d = Zstd.decompress(c, data.length);
    if (!Arrays.equals(data, d)) throw new AssertionError();
    System.out.println("zstd-jni smoke test ok: level " + Zstd.defaultCompressionLevel()
        + ", 100000 -> " + c.length + " bytes");
  }
}
JAVA
  cp=$(jb_cp com.github.luben:zstd-jni)
  javac -nowarn -d "$(jb_w "${t}")" -cp "${cp}" "$(jb_w "${t}/Smoke.java")"
  java --enable-native-access=ALL-UNNAMED -cp "$(jb_w "${t}");${cp}" Smoke
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.github.luben:zstd-jni
  install -Dm644 "${_src}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-${_realname}/LICENSE"
}
