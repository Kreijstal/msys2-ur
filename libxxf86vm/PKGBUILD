# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=libxxf86vm
urlpkgname=libXxf86vm
pkgver=1.1.6
pkgrel=1
pkgdesc="X11 XFree86 video mode extension library"
arch=('i686' 'x86_64')
url="https://www.x.org/"
license=('MIT')
depends=('libx11' 'libxext')
makedepends=('xorgproto' 'xorg-util-macros' 'autoconf' 'automake' 'libtool' 'gcc' 'pkgconf')

XORG_SRC_COMPRESSION=${XORG_SRC_COMPRESSION:-xz}
source=(https://www.x.org/archive/individual/lib/${urlpkgname}-${pkgver}.tar.${XORG_SRC_COMPRESSION})
sha256sums=('SKIP')  # Replace SKIP with the actual checksum

prepare() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Use the configure shipped in the tarball when present. Regenerating with the
  # guest's autotools pulls in the local libtool.m4, which is the one missing the
  # msys case, and the guest's autoconf/automake split has been unreliable.
  autoreconf -vif
}

build() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Use MSYS2's declared host triple ($CHOST). libtool has no msys case: for an *-msys host
  # it falls through to the default branch and sets build_libtool_libs=no with
  # an empty library_names_spec, so it emits a STATIC ARCHIVE ONLY - silently,
  # with configure still exiting 0. --enable-shared does not override this; the
  # host triple is decisive. $CHOST selects the branch that has full
  # shared-library support. --build is passed identically so autoconf does not
  # treat this as a cross build, and CC stays the msys gcc; only libtool's
  # naming and behaviour follow the cygwin path.
  #
  # This is not cosmetic: winex11.drv dlopens SONAME_LIBXXF86VM at runtime, so a static
  # build satisfies Wine's configure and then fails to load with no diagnostic.
  # The triple is $CHOST, MSYS2's own declaration for this environment: stock
  # /etc/makepkg.conf (straight from the pacman package) sets
  # CHOST=x86_64-pc-cygwin. Never hardcode one here - an earlier revision of this
  # file hardcoded x86_64-pc-msys, which is precisely what produced the
  # static-only build described above.
  local _host="${CHOST:?CHOST unset - /etc/makepkg.conf was not sourced}"

  ./configure --prefix=/usr \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --datadir=/usr/share \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info \
    --build=${_host} \
    --host=${_host} \
    --enable-shared \
    --enable-static


  make AUTOMAKE=: AUTOCONF=: AUTOHEADER=: ACLOCAL=: MAKEINFO=:
}

check() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  make check
}

package() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Install the package to the system
  make DESTDIR=${pkgdir} install AUTOMAKE=: AUTOCONF=: AUTOHEADER=: ACLOCAL=: MAKEINFO=:
}
