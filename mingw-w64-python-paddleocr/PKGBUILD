_realname=paddleocr
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=3.7.0
pkgrel=1
pkgdesc="Multilingual OCR and document parsing toolkit based on PaddlePaddle (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/PaddlePaddle/PaddleOCR'
msys2_repository_url='https://github.com/PaddlePaddle/PaddleOCR'
msys2_references=(
  'purl: pkg:pypi/paddleocr'
)
license=('spdx:Apache-2.0')
# paddlex[ocr-core] + PaddlePaddle for local inference
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-aiohttp"
         "${MINGW_PACKAGE_PREFIX}-python-bidi"
         "${MINGW_PACKAGE_PREFIX}-python-imagesize"
         "${MINGW_PACKAGE_PREFIX}-python-opencv"
         "${MINGW_PACKAGE_PREFIX}-python-paddlepaddle"
         "${MINGW_PACKAGE_PREFIX}-python-paddlex"
         "${MINGW_PACKAGE_PREFIX}-python-pyclipper"
         "${MINGW_PACKAGE_PREFIX}-python-pypdfium2"
         "${MINGW_PACKAGE_PREFIX}-python-requests"
         "${MINGW_PACKAGE_PREFIX}-python-shapely"
         "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
         "${MINGW_PACKAGE_PREFIX}-python-yaml")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools-scm"
             "${MINGW_PACKAGE_PREFIX}-python-wheel")
source=("https://pypi.org/packages/source/p/paddleocr/paddleocr-${pkgver}.tar.gz")
sha256sums=('9b81eb62cf37e590d4873e60262ff56f968ff9de6ce1f565749760ceb1c422e2')

build() {
  cp -r "paddleocr-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  # build-system pins setuptools==72.1.0; any recent setuptools works
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import paddleocr
from paddleocr import PaddleOCR
from paddlex.utils.deps import is_extra_available
assert is_extra_available("ocr-core")
print("paddleocr", paddleocr.__version__)
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
