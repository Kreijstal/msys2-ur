# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-runtime10-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.5
pkgrel=1
pkgdesc='Complete source managed NET10 graph and isolated runtime bootstrap; SDK not included'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT' 'spdx:Apache-2.0' 'spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-corelib10-bootstrap=10.0.5"
         "${MINGW_PACKAGE_PREFIX}-dotnet-host10-bootstrap=10.0.5"
         "${MINGW_PACKAGE_PREFIX}-dotnet-runtime10-native-bootstrap=10.0.5")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-visualbasic-compiler=4.9.2"
             "${MINGW_PACKAGE_PREFIX}-dotnet-reference10=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-runtime10-generators=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-illink10-bootstrap=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-genfacades10-bootstrap=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags' '!debug')
source=('runtime-v10.0.5.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.5'
        'arcade-runtime10-4bf37ce6.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/4bf37ce670528cf2aef4d9b1cd892554b1b02d9d'
        'runtime10-bootstrap-source-1.tar.gz')
noextract=('runtime-v10.0.5.tar.gz' 'arcade-runtime10-4bf37ce6.tar.gz')
sha256sums=('1692acae5e3adfd625452fbc9db4fd4e982c10e38189358ae245c74dd5514d7a'
            '82f5f6dd63c0dcf3c0fc49b282207db5d889d9cc0939589d43b16c7fcfdf7d66'
            '75ad674d3be2cc645c850fb688228a009a90f3dbcdc49d9201ea6ec6726b2c33')

build() {
  bash "$srcdir/framework-workflow/build-all.sh" "$srcdir" >"$srcdir/build.log" 2>&1
}

check() {
  /usr/bin/python3 "$srcdir/framework-workflow/check-built.py" "$srcdir/build-plan" "$srcdir/linked-check" >"$srcdir/linked-check.log" 2>&1
  /usr/bin/python3 "$srcdir/framework-workflow/check-framework.py" "$srcdir/build-plan" "$srcdir/runtime-check" >"$srcdir/runtime-check.log" 2>&1
  /usr/bin/python3 "$srcdir/framework-workflow/stage-framework.py" "$srcdir/build-plan" "$srcdir/runtime-layout" >"$srcdir/stage.log" 2>&1
  /usr/bin/python3 "$srcdir/framework-workflow/check-host.py" "$srcdir/runtime-layout" "$srcdir/host-check" \
    "$srcdir/runtime-check/complete CLR10 λ/native.dll" "$srcdir/runtime-check/complete CLR10 λ/framework.dll" \
    "$srcdir/runtime-check/complete CLR10 λ/javascript.dll" >"$srcdir/host-check.log" 2>&1
  # Preserve the strict check's actual exit status and every difference.
  # This explicit bootstrap requires all declarations; strict shape parity is open.
  local contract_status=0
  /usr/bin/python3 "$srcdir/framework-workflow/check-contracts.py" "$srcdir/build-plan" "$srcdir/contract-check" >"$srcdir/contract-check.log" 2>&1 || contract_status=$?
  [[ $contract_status == 0 || $contract_status == 1 ]]
  /usr/bin/python3 - "$srcdir/contract-check/results.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]));assert len(p['assemblies'])==167
assert not any(v['missing'] for v in p['assemblies'].values()),'Missing original NET10 contract declarations'
print('Strict reference comparison retained:',p['total_differences'],'extra/changed entries; full parity is not certified')
PY
  /usr/bin/python3 "$srcdir/package-workflow/stage-package.py" "$srcdir" "$srcdir/package-prefix" >"$srcdir/package-stage.log" 2>&1
  /usr/bin/python3 "$srcdir/package-workflow/check-installed.py" "$srcdir/package-prefix" "$srcdir/staged-installed-check" >"$srcdir/staged-installed-check.log" 2>&1
}

package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -a "$srcdir/package-prefix/." "$pkgdir$MINGW_PREFIX/"
}
