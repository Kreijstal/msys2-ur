build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local name spec key path
  local -a roots=()
  while IFS= read -r name; do
    mapfile -t roots < <(python -c 'import json,sys; sys.stdout.reconfigure(newline="\n"); print("\n".join(json.load(open(sys.argv[1]))[sys.argv[2]]["roots"]))' "$(cygpath -m "$srcdir/bundles.json")" "$name")
    : > "$name-inputs.tsv"
    while IFS= read -r spec; do
      path=$(jb_jarpath "$spec")
      printf '%s\t%s\n' "$spec" "$(jb_w "$path")" >> "$name-inputs.tsv"
    done < <(jb_closure "${roots[@]}")
    python pack-composites.py "$(jb_w bundles.json)" "$name" "$(jb_w "$_source_dir")" "$(jb_w "$name-inputs.tsv")" "$(jb_w "$JB_PSTAGE")"
  done < <(python -c 'import json,sys; sys.stdout.reconfigure(newline="\n"); print("\n".join(json.load(open(sys.argv[1]))))' "$(cygpath -m "$srcdir/bundles.json")")
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_osgi_resolvecheck
}

_package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_plugins_install "$1"
  install -Dm644 "${srcdir}/$_source_dir/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${pkgname#${MINGW_PACKAGE_PREFIX}-}/LICENSE.composite"
}

