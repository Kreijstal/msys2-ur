Install into a shared Unix-like prefix on MinGW

The Windows build installs a self-contained application directory:
data files next to bin/ (prefix/workspaces, prefix/locale, ...), the Nyquist
files in bin/, plus a windeployqt copy of Qt and the compiler runtime,
and it even writes the executable into ${CMAKE_INSTALL_PREFIX}/bin at
build time. None of that fits a MinGW distribution such as MSYS2, where
Audacity shares the prefix with Qt and everything else.

- MinGW uses the Linux data layout (share/audacity-4.0/, share/audacity/
  for Nyquist); the muse resource lookup on Windows now honours
  MUSE_APP_INSTALL_RESOURCES_LOCATION (which is "./" for MSVC, so nothing
  changes there), and au3's path list also searches <prefix>/share/audacity.
- New option AU_DEPLOY_RUNTIME (default ON, as before) to skip copying Qt
  and the compiler runtime and pruning the Qt QML tree in the install dir,
  and to keep the build output out of CMAKE_INSTALL_PREFIX.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7c9ff37..798487f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -154,6 +154,7 @@ endif()
 
 # === Pack ===
 option(AU_RUN_LRELEASE "Generate .qm files" ON)
+option(AU_DEPLOY_RUNTIME "Windows: copy Qt and the compiler runtime into the install tree" ON)
 
 # === Tests ===
 set(APP_WORKSPACE_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/src/app/configs/workspaces.cfg")
diff --git a/SetupConfigure.cmake b/SetupConfigure.cmake
index f85f358..cb4d12d 100644
--- a/SetupConfigure.cmake
+++ b/SetupConfigure.cmake
@@ -89,6 +89,10 @@ if (OS_IS_MAC)
     SET(AU4_INSTALL_NAME  "Contents/Resources/")
     SET(AU4_SHARE_NAME    "audacity.app/")
     SET(AU4_FRAMEWORKS_NAME "Frameworks/")
+elseif (OS_IS_WIN AND MINGW)
+    # MinGW distributions (MSYS2) install into a shared Unix-like prefix
+    SET(AU4_INSTALL_NAME  "audacity${MUSE_APP_INSTALL_SUFFIX}-${MUSE_APP_VERSION_MAJ_MIN}/")
+    SET(AU4_SHARE_NAME    "share/")
 elseif (OS_IS_WIN)
     SET(AU4_INSTALL_NAME  "")
     SET(AU4_SHARE_NAME    "./")
diff --git a/au3/libraries/au3-files/PathList.cpp b/au3/libraries/au3-files/PathList.cpp
index 1686267..f45922b 100644
--- a/au3/libraries/au3-files/PathList.cpp
+++ b/au3/libraries/au3-files/PathList.cpp
@@ -133,6 +133,10 @@ void FileNames::InitializePathList()
     // Windows: executable directory and Languages subdirectory
     addUniquePath(searchPaths, binDir);
     addUniquePath(searchPaths, binDir + "\\Languages");
+#ifdef __MINGW32__
+    // MinGW distributions keep the data files in <prefix>/share/audacity
+    addUniquePath(searchPaths, PC::GetParentDir(binDir) + "\\share\\audacity");
+#endif
 
     // Set up temp directory in user local data
     PC::MakePath(userAppData);
