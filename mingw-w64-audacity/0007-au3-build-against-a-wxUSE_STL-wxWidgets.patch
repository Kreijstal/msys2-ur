diff --git a/au3/libraries/au3-strings/TranslatableString.h b/au3/libraries/au3-strings/TranslatableString.h
index 94dea21..dd93e8f 100644
--- a/au3/libraries/au3-strings/TranslatableString.h
+++ b/au3/libraries/au3-strings/TranslatableString.h
@@ -97,7 +97,10 @@ public:
     { return TranslatableString(nullptr, s); }
     static TranslatableString untranslatable(const QString& s)
     { return TranslatableString(nullptr, s); }
-    //! wxString overload lives in WxMuseStringCompat.h.
+    //! UTF-8-correct wxString overload; defined in WxMuseStringCompat.h.
+    //! Without it, wxString arguments depend on the implicit const char*
+    //! conversion, which wxUSE_STL builds of wxWidgets do not have.
+    static TranslatableString untranslatable(const wxString& s);
 
     bool isEmpty()        const { return m_source.isEmpty(); }
     bool empty()          const { return isEmpty(); }
diff --git a/au3/libraries/au3-strings/WxMuseStringCompat.h b/au3/libraries/au3-strings/WxMuseStringCompat.h
index 79210d8..f18e092 100644
--- a/au3/libraries/au3-strings/WxMuseStringCompat.h
+++ b/au3/libraries/au3-strings/WxMuseStringCompat.h
@@ -37,6 +37,14 @@ inline ::TranslatableString untranslatable(const wxString& s)
 {
     return ::TranslatableString::untranslatable(wxToQt(s));
 }
+} // namespace au3
+
+inline TranslatableString TranslatableString::untranslatable(const wxString& s)
+{
+    return untranslatable(au3::wxToQt(s));
+}
+
+namespace au3 {
 
 //! Non-template overload of TranslatableString.h's argDecay so
 //! `.arg(wxStringValue)` resolves: wxString -> QString -> Arg<QString>.
