au3: fix MSVC-only constructs

- Registry.h already holds the explicit instantiation definition of
  GroupItem<DefaultTraits> on Windows; the second one in Registry.cpp is a
  hard error for clang and gcc.
- std::exception has no const char* constructor outside MSVC; use
  std::runtime_error.
- Cast GetProcAddress()'s FARPROC explicitly.
- SpectrumCache.cpp: include <QtConcurrent> before the wxWidgets headers.
  On MinGW those pull in <w32api.h>, whose Windows7/Windows8 macros break
  QOperatingSystemVersion's declarations.

diff --git a/au3/libraries/au3-registries/Registry.cpp b/au3/libraries/au3-registries/Registry.cpp
index 69d11e1..4dbec99 100644
--- a/au3/libraries/au3-registries/Registry.cpp
+++ b/au3/libraries/au3-registries/Registry.cpp
@@ -848,5 +848,8 @@ void detail::RegisterItem(GroupItemBase& registry, const Placement& placement,
     pItems->insert(find(pItem->name).second, std::move(pItem));
 }
 
+#ifndef _WIN32
+// on Windows Registry.h already holds the explicit instantiation definition
 template struct GroupItem<DefaultTraits>;
+#endif
 }
