prepare() {
  local _src="${srcdir}/${_realname}-Audacity-${pkgver}"
  rm -rf "${_src:?}/muse" "${_src:?}/muse_deps" "${srcdir:?}/extdeps-cache"
  cp -a "${srcdir}/muse_framework-${_muse}" "${_src}/muse"
  cp -a "${srcdir}/muse_deps-${_muse_deps}" "${_src}/muse_deps"

  local _e
  for _e in "${_extdeps[@]}"; do
    mkdir -p "${srcdir}/extdeps-cache/downloads/${_e%%:*}"
    cp -L "${srcdir}/${_e#*:}" "${srcdir}/extdeps-cache/downloads/${_e%%:*}/"
  done

  cd "${_src}"
  local _p
  for _p in "${_patches[@]}"; do
    patch -Np1 -i "${srcdir}/${_p}"
  done
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # Dependencies: MSYS2 packages through muse_deps' SYSTEM mode, except the
  # pinned sources above (nyquist, pffft, loop-tempo-estimator, tft, picojson
  # are compiled in; portaudio is built with Audacity's patches and linked
  # statically, see 0002).
  # Off, as in Linux distributions: update checks, crash reporting (crashpad,
  # already off by default) and the usage-info UUID (telemetry). Testflow
  # (scripted UI tests) is off in release mode; unit tests are not built.
  # LV2 is Linux-only in Audacity 4 (AU_MODULE_EFFECTS_LV2 is not offered on
  # Windows), so it stays off and suil is not needed.
  # AU_DEPLOY_RUNTIME=OFF (0004): use the shared Qt and compiler runtime
  # instead of copying them next to the executable.
  EXTDEPS_CACHE="$(cygpath -m "${srcdir}/extdeps-cache")" \
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -S "${srcdir}/${_realname}-Audacity-${pkgver}" \
      -B "${srcdir}/build-${MSYSTEM}" \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DAU4_BUILD_MODE=release \
      -DAU_DEPLOY_RUNTIME=OFF \
      -DAU_BUILD_USAGEINFO_MODULE=OFF \
      -DMUSE_MODULE_UPDATE=OFF \
      -DMUSE_MODULE_DIAGNOSTICS_CRASHPAD_CLIENT=OFF \
      -DMUSE_ENABLE_UNIT_TESTS=OFF \
      -DMUSE_COMPILE_USE_CCACHE=OFF \
      -DEXTDEPS_OVERRIDE_ALL=SYSTEM \
      -DVST3SDK="${MINGW_PREFIX}/share/vst3sdk" \
      "${_extra_config[@]}"
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/build-${MSYSTEM}"

  # Not installed: the SDK's "adelay" sample, for check() to load into
  # Audacity's VST3 host.
  "${MINGW_PREFIX}/bin/cmake.exe" \
    -GNinja \
    -S "${MINGW_PREFIX}/share/vst3sdk" \
    -B "${srcdir}/vst3-adelay-${MSYSTEM}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DSMTG_ENABLE_VSTGUI_SUPPORT=OFF \
    -DSMTG_ENABLE_VST3_PLUGIN_EXAMPLES=ON \
    -DSMTG_ENABLE_VST3_HOSTING_EXAMPLES=OFF \
    -DSMTG_CREATE_PLUGIN_LINK=OFF \
    -DSMTG_RUN_VST_VALIDATOR=OFF
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/vst3-adelay-${MSYSTEM}" --target adelay
}

check() {
  local _root="${srcdir}/check-${MSYSTEM}"
  rm -rf "${_root:?}"
  DESTDIR="${_root}" "${MINGW_PREFIX}/bin/cmake.exe" --install "${srcdir}/build-${MSYSTEM}" >/dev/null
  local _exe="${_root}${MINGW_PREFIX}/bin/Audacity4.exe"
  cd "${srcdir}"

  # starts up through the Qt/muse module framework and prints its version
  "${_exe}" --version | tr -d '\r' > version.txt
  grep -qx "Audacity4 ${pkgver}" version.txt || { cat version.txt; return 1; }

  # the background plugin-registration app initialises all modules
  "${_exe}" --plugin-registration-self-test

  # the VST3 host loads, instantiates and validates a real plug-in
  local _vst3
  _vst3=$(find "${srcdir}/vst3-adelay-${MSYSTEM}" -type d -name 'adelay.vst3' -print -quit)
  rm -f vst3-registration.json
  "${_exe}" --register-audio-plugin "$(cygpath -m "${_vst3}")" \
    --register-audio-plugin-out "$(cygpath -m "${srcdir}/vst3-registration.json")"
  grep -q '"title": "ADelay"' vst3-registration.json \
    && grep -q '"state": "Validated"' vst3-registration.json \
    || { cat vst3-registration.json; return 1; }

  # the data files are where the MinGW layout (0004) looks for them
  [[ -f "${_root}${MINGW_PREFIX}/share/audacity/nyquist-runtime/nyquist.lsp" ]]
  [[ -n "$(ls "${_root}${MINGW_PREFIX}"/share/audacity/nyquist-plug-ins/*.ny)" ]]
  [[ -n "$(ls "${_root}${MINGW_PREFIX}"/share/audacity-4.0/workspaces/*.mws)" ]]
  rm -rf "${_root:?}"
}

package() {
  DESTDIR="${pkgdir}" "${MINGW_PREFIX}/bin/cmake.exe" --install "${srcdir}/build-${MSYSTEM}"

  local _lic="${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 "${srcdir}/${_realname}-Audacity-${pkgver}/LICENSE.txt" "${_lic}/LICENSE.txt"
  # licenses of the statically linked portaudio (muse_deps puts them in <prefix>/licenses)
  if [[ -d "${pkgdir}${MINGW_PREFIX}/licenses" ]]; then
    cp -r "${pkgdir}${MINGW_PREFIX}/licenses/." "${_lic}/"
    rm -rf "${pkgdir:?}${MINGW_PREFIX}/licenses"
  fi
}
