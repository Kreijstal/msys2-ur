diff --git a/muse_deps/recipes/nyquist/patch/0031-xlisp-function-like-setjmp-aliases-for-mingw.patch b/muse_deps/recipes/nyquist/patch/0031-xlisp-function-like-setjmp-aliases-for-mingw.patch
new file mode 100644
index 0000000..70342a0
--- /dev/null
+++ b/muse_deps/recipes/nyquist/patch/0031-xlisp-function-like-setjmp-aliases-for-mingw.patch
@@ -0,0 +1,22 @@
+xlisp: alias _setjmp/_longjmp with function-like macros
+
+mingw-w64's setjmp() is itself a macro expanding to the two-argument
+_setjmp(buf, frame). With the object-like '#define _setjmp setjmp' the
+expansion ends in a call to the one-argument _setjmp that clang knows as a
+builtin, and the build fails (too many arguments / undeclared setjmp).
+Function-like aliases expand the same way everywhere else.
+
+diff --git a/nyquist/xlisp/xlisp.h b/nyquist/xlisp/xlisp.h
+--- a/nyquist/xlisp/xlisp.h
++++ b/nyquist/xlisp/xlisp.h
+@@ -56,8 +56,8 @@
+ // #endif
+ /* #define SAVERESTORE */
+ #define XL_LITTLE_ENDIAN 
+-#define _longjmp longjmp
+-#define _setjmp setjmp
++#define _longjmp(env, val) longjmp(env, val)
++#define _setjmp(env) setjmp(env)
+ #endif
+ 
+ /* for the Turbo C compiler - MS-DOS, large model */
