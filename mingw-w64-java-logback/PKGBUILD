# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-logback
pkgname=("${MINGW_PACKAGE_PREFIX}-java-logback-core"
         "${MINGW_PACKAGE_PREFIX}-java-logback-classic")
pkgver=1.5.32
pkgrel=1
pkgdesc="logback Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/dbeaver/dbeaver-deps-ce'
license=('spdx:EPL-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-commons-compiler"
             "${MINGW_PACKAGE_PREFIX}-java-jakarta-activation-api"
             "${MINGW_PACKAGE_PREFIX}-java-jakarta-mail-api"
             "${MINGW_PACKAGE_PREFIX}-java-jakarta-servlet-api"
             "${MINGW_PACKAGE_PREFIX}-java-janino"
             "${MINGW_PACKAGE_PREFIX}-java-jansi"
             "${MINGW_PACKAGE_PREFIX}-java-slf4j-api"
             "${MINGW_PACKAGE_PREFIX}-java-xz")
source=('https://repo.maven.apache.org/maven2/ch/qos/logback/logback-core/1.5.32/logback-core-1.5.32-sources.jar'
         'https://repo.maven.apache.org/maven2/ch/qos/logback/logback-core/1.5.32/logback-core-1.5.32.pom'
         'https://repo.maven.apache.org/maven2/ch/qos/logback/logback-classic/1.5.32/logback-classic-1.5.32-sources.jar'
         'https://repo.maven.apache.org/maven2/ch/qos/logback/logback-classic/1.5.32/logback-classic-1.5.32.pom')
noextract=('logback-core-1.5.32-sources.jar'
         'logback-core-1.5.32.pom'
         'logback-classic-1.5.32-sources.jar'
         'logback-classic-1.5.32.pom')
sha256sums=('a73a40370a2a086a36b626b71f16c529e54e2a75845faf08134b689c607508e1'
         '1f393c4414458569b53b52eb3297bfe861b00066f59d6d2babf227eb65da3fb8'
         'be553204e18ce1f628c535bb063a1e611182854d15154382b00afd4968ce591f'
         'd23b272e705760f835711076441e6a8a9b12ed0900e1ba618a0cd6bcf7a1626a')
_artifacts=('ch.qos.logback:logback-core:1.5.32'
         'ch.qos.logback:logback-classic:1.5.32')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module ch.qos.logback:logback-core:1.5.32 upstream/logback-core \
    -r resources/logback-core -u logback-core-1.5.32.pom -- \
    org.codehaus.janino:janino? org.codehaus.janino:commons-compiler? org.fusesource.jansi:jansi? org.tukaani:xz/provided? jakarta.mail:jakarta.mail-api? jakarta.servlet:jakarta.servlet-api?
  jb_module ch.qos.logback:logback-classic:1.5.32 upstream/logback-classic \
    -r resources/logback-classic -u logback-classic-1.5.32.pom -- \
    ch.qos.logback:logback-core org.slf4j:slf4j-api jakarta.mail:jakarta.mail-api? jakarta.activation:jakarta.activation-api? org.codehaus.janino:janino? jakarta.servlet:jakarta.servlet-api/provided?
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.codehaus.janino:janino --with org.codehaus.janino:commons-compiler --with org.fusesource.jansi:jansi --with org.tukaani:xz --with jakarta.mail:jakarta.mail-api --with jakarta.servlet:jakarta.servlet-api ch.qos.logback:logback-core
  jb_loadcheck --with ch.qos.logback:logback-core --with org.slf4j:slf4j-api --with jakarta.mail:jakarta.mail-api --with jakarta.activation:jakarta.activation-api --with org.codehaus.janino:janino --with jakarta.servlet:jakarta.servlet-api ch.qos.logback:logback-classic
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-logback-core() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install ch.qos.logback:logback-core
  _license logback-core 1.5.32
}

package_java-logback-classic() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-logback-core"
           "${MINGW_PACKAGE_PREFIX}-java-slf4j-api")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install ch.qos.logback:logback-classic
  _license logback-classic 1.5.32
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
