# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-log4j-api
pkgname=("${MINGW_PACKAGE_PREFIX}-java-log4j-api")
pkgver=2.24.3
pkgrel=1
pkgdesc="log4j-api Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/dbeaver/dbeaver-deps-ce'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-bnd-annotation"
             "${MINGW_PACKAGE_PREFIX}-java-error-prone-annotations"
             "${MINGW_PACKAGE_PREFIX}-java-jspecify"
             "${MINGW_PACKAGE_PREFIX}-java-osgi-annotation"
             "${MINGW_PACKAGE_PREFIX}-java-osgi-core"
             "${MINGW_PACKAGE_PREFIX}-java-spotbugs-annotations")
source=('https://repo.maven.apache.org/maven2/org/apache/logging/log4j/log4j-api/2.24.3/log4j-api-2.24.3-sources.jar'
         'https://repo.maven.apache.org/maven2/org/apache/logging/log4j/log4j-api/2.24.3/log4j-api-2.24.3.pom')
noextract=('log4j-api-2.24.3-sources.jar'
         'log4j-api-2.24.3.pom')
sha256sums=('a7e2290fd22242d85d8423efb8eff5fd7e14f80fed94bc959415d61cb8aa0d11'
         'bc05de33533a1259adbacbfcc826cd66376a2d9c4ee53fb836009f44a45b8239')
_artifacts=('org.apache.logging.log4j:log4j-api:2.24.3')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.apache.logging.log4j:log4j-api:2.24.3 upstream/log4j-api \
    -r resources/log4j-api -u log4j-api-2.24.3.pom -- \
    biz.aQute.bnd:biz.aQute.bnd.annotation/provided com.google.errorprone:error_prone_annotations/provided org.osgi:osgi.annotation/provided com.github.spotbugs:spotbugs-annotations/provided org.jspecify:jspecify/provided org.osgi:osgi.core/provided
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with biz.aQute.bnd:biz.aQute.bnd.annotation --with com.google.errorprone:error_prone_annotations --with org.osgi:osgi.annotation --with com.github.spotbugs:spotbugs-annotations --with org.jspecify:jspecify --with org.osgi:osgi.core org.apache.logging.log4j:log4j-api
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-log4j-api() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.logging.log4j:log4j-api
  _license log4j-api 2.24.3
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
