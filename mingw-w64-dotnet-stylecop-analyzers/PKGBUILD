prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/stylecop" "$srcdir/prepared"; }
build() { bash "$srcdir/build.sh" "$srcdir/stylecop" "$srcdir/prepared"; }
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed" "$srcdir/prepared/checkdata"; }
_install() {
 local suffix=$1 id=$2 version=$3
 install -Dm644 "$srcdir/feed/$id.$version.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${id,,}.$version.nupkg"
 for file in LICENSE THIRD-PARTY-NOTICES.txt;do
  install -Dm644 "$srcdir/stylecop/$file" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-stylecop-analyzers$suffix/$file"
 done
 install -Dm644 "$srcdir/Apache-2.0.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-stylecop-analyzers$suffix/Apache-2.0.txt"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-stylecop-analyzers$suffix/README.md"
 if [[ -z $suffix ]];then cp -r "$srcdir/prepared/checkdata/"* "$pkgdir$MINGW_PREFIX/share/doc/dotnet-stylecop-analyzers/";fi
}
package_mingw-w64-clang-x86_64-dotnet-stylecop-analyzers() {
 pkgdesc='Source-built StyleCop.Analyzers beta.556 dependency package'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-stylecop-analyzers-unstable=$pkgver")
 _install '' StyleCop.Analyzers 1.2.0-beta.556
}
package_mingw-w64-clang-x86_64-dotnet-stylecop-analyzers-unstable() {
 pkgdesc='Source-built StyleCop.Analyzers 1.2.0.556 analyzer and code-fix implementation'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2")
 _install '-unstable' StyleCop.Analyzers.Unstable 1.2.0.556
}
