pkgbase=mingw-w64-dotnet-stylecop-analyzers
pkgname=("${MINGW_PACKAGE_PREFIX}-dotnet-stylecop-analyzers"
         "${MINGW_PACKAGE_PREFIX}-dotnet-stylecop-analyzers-unstable")
pkgver=1.2.0.beta556
pkgrel=1
_commit=73a46ae2e65e7870fefe35e2c4c12bb7152f4ec5
pkgdesc='Source-built StyleCop analyzers and code fixes for .NET 8'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/DotNetAnalyzers/StyleCopAnalyzers'
license=('spdx:MIT' 'spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'git' 'python')
options=('!strip' '!lto')
source=("stylecop::git+https://github.com/DotNetAnalyzers/StyleCopAnalyzers#commit=$_commit"
        prepare.py verify-source.py source-inputs.json upstream-commit.txt build-libraries.sh build.sh pack.py
        CheckPrototype.cs CheckGenerated.cs CheckFixtures.cs CheckSpecialFixes.cs ExtractFixtures.cs InspectInventory.cs check.sh
        ExpectedInventory.json UpstreamFixtures.json published-metadata-provenance.json README.md Apache-2.0.txt)
# Git commit and exact signed tree are independently checked by prepare().
