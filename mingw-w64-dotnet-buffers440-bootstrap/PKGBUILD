# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-buffers440-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.4.0
pkgrel=1
pkgdesc='Original Buffers4.4 runtime and reference profiles built with source SDK and Csc'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/corefx'
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn44=4.4.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-cecil011-bootstrap=0.11.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-legacy-ns13-contracts-bootstrap>=20261031-4"
             "${MINGW_PACKAGE_PREFIX}-llvm" 'python')
options=('!strip' '!lto' '!buildflags')
source=('corefx-buffers440-8321c729.tar.gz::https://codeload.github.com/dotnet/corefx/tar.gz/8321c729934c0f8be754953439b88e6e1c120c24'
        'roslyn-4.4.0-1ce8866c.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/1ce8866c9de4c2d67351ef6863699dee03b0804a'
        'buffers440-source-1.tar.gz')
noextract=('corefx-buffers440-8321c729.tar.gz' 'roslyn-4.4.0-1ce8866c.tar.gz')
sha256sums=('f5ebd955cac6ff630689bf6cee2f2c2ffe30b1c7b22c4106d12bb3982abc6c69'
            '9edb8c430576c5f5b27032afe8f79c74508b0150e03406a7a4ca6f218e03fd11'
            'c1a40cceadaa9e10ec18672c8fe49cb047ca73a35ee4440613a596a3d80f6eb1')
build() {
  /usr/bin/python3 "$srcdir/buffers440-workflow/compiler44.py" "$srcdir/roslyn-4.4.0-1ce8866c.tar.gz" "$srcdir/compiler44" > "$srcdir/compiler44.log" 2>&1
  /usr/bin/python3 "$srcdir/buffers440-workflow/build.py" "$srcdir/corefx-buffers440-8321c729.tar.gz" "$srcdir/prepared" "$srcdir/compiler44/bin/Release/net8.0" > "$srcdir/build.log" 2>&1
  /usr/bin/python3 "$srcdir/buffers440-workflow/pack.py" "$srcdir/prepared" > "$srcdir/pack.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/buffers440-workflow/audit.py" "$srcdir/prepared" > "$srcdir/audit.log" 2>&1
  /usr/bin/python3 "$srcdir/buffers440-workflow/check.py" "$srcdir/prepared" "$srcdir/check" "$srcdir/compiler44/bin/Release/net8.0" --feed "$srcdir/prepared/feed" > "$srcdir/check.log" 2>&1
}
package() {
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  local file
  install -Dm644 "$srcdir/prepared/feed/System.Buffers.4.4.0.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/system.buffers.4.4.0.nupkg"
  mkdir -p "$doc/inputs"
  for file in README.md check.py; do install -m644 "$srcdir/buffers440-workflow/$file" "$doc/$file"; done
  for file in "$srcdir/buffers440-workflow/inputs/"*; do install -m644 "$file" "$doc/inputs/"; done
  install -m644 "$srcdir/prepared/results.json" "$srcdir/prepared/producer-audit.json" "$doc/"
  install -m644 "$srcdir/compiler44/source-inputs.json" "$doc/compiler44-source-inputs.json"
  install -m644 "$srcdir/check/results.json" "$doc/producer-check-results.json"
  for file in LICENSE.TXT THIRD-PARTY-NOTICES.TXT; do install -Dm644 "$srcdir/prepared/source/$file" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/$file"; done
}
