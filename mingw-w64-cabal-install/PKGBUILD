pkgrel=2
pkgdesc="Command-line interface for Cabal and Hackage (mingw-w64)"
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://www.haskell.org/cabal/'
msys2_repository_url='https://github.com/haskell/cabal'
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-zlib")
makedepends=("${MINGW_PACKAGE_PREFIX}-ghc"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-pkgconf")
optdepends=("${MINGW_PACKAGE_PREFIX}-ghc: Haskell compiler")
options=('!strip')

