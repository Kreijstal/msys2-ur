source=("cabal-${pkgver}.tar.gz::https://github.com/haskell/cabal/archive/refs/tags/cabal-install-v${pkgver}.tar.gz"
        0001-pkg-config-query-in-chunks.patch)
sha256sums=('c3d51e23a7e10cc9c13c59320267f831732d281ba3fc7897423e0b83b8221a41'
            '1ba227d5e159730b86909ffc5888d375f56c6a6ebaca801c8d837dcc9d8ace05')
# The source tree has test fixtures with symlinks, which cannot be created on
# Windows; extract only what bootstrapping needs in prepare().
noextract=("cabal-${pkgver}.tar.gz")
for _dep in "${_deps[@]}"; do
  read -r _n _v _r _c _ssha _csha _f <<< "${_dep}"
  [[ ${_r} == - || " ${source[*]} " == *" ${_n}-${_v}.tar.gz::"* ]] && continue
  source+=("${_n}-${_v}.tar.gz::https://hackage.haskell.org/package/${_n}-${_v}/${_n}-${_v}.tar.gz"
           "${_n}-${_v}-r${_r}.cabal::https://hackage.haskell.org/package/${_n}-${_v}/revision/${_r}.cabal")
  sha256sums+=("${_ssha}" "${_csha}")
  noextract+=("${_n}-${_v}.tar.gz")
done
unset _dep _n _v _r _c _ssha _csha _f

prepare() {
  rm -rf "${srcdir}/cabal"
  mkdir -p "${srcdir}/cabal"
  local _d _dirs=()
  for _d in bootstrap Cabal Cabal-syntax Cabal-hooks cabal-install \
            cabal-install-solver hooks-exe; do
    _dirs+=("cabal-cabal-install-v${pkgver}/${_d}")
  done
  bsdtar -xf "${srcdir}/cabal-${pkgver}.tar.gz" -C "${srcdir}/cabal" \
    --strip-components=1 --exclude '*/tests/*' "${_dirs[@]}"

  cd "${srcdir}/cabal"
  patch -p1 -i "${srcdir}/0001-pkg-config-query-in-chunks.patch"

  mkdir -p _build/tarballs
  local _dep _n _v _r _rest
  for _dep in "${_deps[@]}"; do
    read -r _n _v _r _rest <<< "${_dep}"
    [[ ${_r} == - ]] && continue
    cp "${srcdir}/${_n}-${_v}.tar.gz" _build/tarballs/
    cp "${srcdir}/${_n}-${_v}-r${_r}.cabal" "_build/tarballs/${_n}.cabal"
  done

  local IFS=$'\n'
  python - "${_builtin[*]}" "${_deps[*]}" > bootstrap/windows.json <<'PY'
import json, sys
null = lambda s: None if s == "-" else s
builtin = [dict(zip(("package", "version"), l.split())) for l in sys.argv[1].splitlines()]
deps = []
for l in sys.argv[2].splitlines():
    n, v, r, c, ssha, csha, *flags = l.split()
    deps.append(dict(package=n, version=v, source="local" if r == "-" else "hackage",
                     revision=None if r == "-" else int(r), component=c,
                     src_sha256=null(ssha), cabal_sha256=null(csha), flags=flags))
json.dump(dict(builtin=builtin, dependencies=deps), sys.stdout, indent=2)
PY
}

build() {
  cd "${srcdir}/cabal"
  python bootstrap/bootstrap.py --no-archive -j "$(nproc)" \
    -w "$(cygpath -m "${MINGW_PREFIX}/bin/ghc.exe")" \
    -d bootstrap/windows.json
}

check() {
  cd "${srcdir}/cabal"
  _build/bin/cabal.exe --version
}

package() {
  cd "${srcdir}/cabal"
  install -Dm755 _build/bin/cabal.exe "${pkgdir}${MINGW_PREFIX}/bin/cabal.exe"
  install -Dm644 cabal-install/LICENSE \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
