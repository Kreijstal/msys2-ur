++// Leave overload sets with typed alternatives to normal Sema. Boxing an
++// arithmetic/enum argument is unambiguous when every arity-compatible method
++// declares this position as System.Object, after excluding impossible scalar
++// conversions to unrelated managed reference classes.
++static bool cppcliObjectArgument(Sema &Actions, Expr *Function, Expr *Argument, unsigned Index, unsigned Count) {
++  bool Found = false, AllObject = true;
++  auto Inspect = [&](const NamedDecl *Decl) {
++    auto *Method = dyn_cast<CXXMethodDecl>(Decl);
++    if (!Method || Index >= Method->getNumParams() || Count > Method->getNumParams() ||
++        Count < Method->getMinRequiredArguments()) return;
++    auto Type = Method->getParamDecl(Index)->getType();
++    auto *Record = Type->isPointerType() ? Type->getPointeeType()->getAsCXXRecordDecl() : nullptr;
++    // A non-null scalar cannot initialize an unrelated CLR reference class.
++    // Keep interfaces, Enum/ValueType boxes and zero/null alternatives with
++    // normal Sema, where broader boxing overload resolution remains pending.
++    if(Record && Record->getQualifiedNameAsString()!="System::Object" &&
++        Record->getQualifiedNameAsString()!="System::Enum" && Record->getQualifiedNameAsString()!="System::ValueType" &&
++        (Argument->getType()->isArithmeticType() || Argument->getType()->isEnumeralType()) &&
++        !Argument->isNullPointerConstant(Actions.Context,Expr::NPC_ValueDependentIsNotNull)) {
++      bool Reference=false,Interface=false;
++      auto *Owner=Record->getDefinition(); if(!Owner) Owner=Record;
++      for(auto *Attr:Owner->specific_attrs<AnnotateAttr>()) {
++        Reference |= Attr->getAnnotation()=="cli.ref" || Attr->getAnnotation().starts_with("cli.external:");
++        Interface |= Attr->getAnnotation()=="cli.interface" || Attr->getAnnotation()=="cli.value";
++      }
++      if(Reference && !Interface) return;
++    }
++    Found = true;
++    AllObject &= cppcliStringSlot(Method, Index, Count) && Record &&
++                 Record->getQualifiedNameAsString() == "System::Object";
++  };
++  Function = Function->IgnoreParenImpCasts();
++  if (auto *Member = dyn_cast<MemberExpr>(Function)) Inspect(Member->getMemberDecl());
++  else if (auto *Reference = dyn_cast<DeclRefExpr>(Function)) Inspect(Reference->getDecl());
++  else if (auto *Overloads = dyn_cast<OverloadExpr>(Function))
++    for (auto *Candidate : Overloads->decls()) Inspect(Candidate);
++  return Found && AllObject;
++}
