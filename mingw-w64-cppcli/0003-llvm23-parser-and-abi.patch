++// A source tracking reference may receive a directly constructed ref-class
++// temporary. Native references and ambiguous overloads keep ordinary Sema.
++static bool cppcliTrackingTemporaryArgument(Sema &Actions, Preprocessor &PP,
++    Expr *Function, Expr *Argument, unsigned Index, unsigned Count) {
++  if(!Argument->isPRValue()) return false;
++  auto *Value=Argument->IgnoreParenImpCasts();
++  if(auto *Cast=dyn_cast<CXXFunctionalCastExpr>(Value); Cast && Cast->getCastKind()==CK_ConstructorConversion)
++    Value=Cast->getSubExpr()->IgnoreParenImpCasts();
++  if(auto *Temporary=dyn_cast<CXXBindTemporaryExpr>(Value)) Value=Temporary->getSubExpr()->IgnoreParenImpCasts();
++  auto *Construction=dyn_cast<CXXConstructExpr>(Value);
++  if(!Construction) return false;
++  auto *Record=Construction->getType()->getAsCXXRecordDecl();
++  if(!Record || !Record->getDefinition()) return false;
++  bool Managed=false;
++  for(auto *Attr:Record->getDefinition()->specific_attrs<AnnotateAttr>()) Managed |= Attr->getAnnotation()=="cli.ref";
++  if(!Managed) return false;
++  bool Found=false,AllTracking=true;
++  auto Inspect=[&](const NamedDecl *Decl) {
++    auto *Method=dyn_cast<CXXMethodDecl>(Decl);
++    if(!Method || Index>=Method->getNumParams() || Count>Method->getNumParams() || Count<Method->getMinRequiredArguments()) return;
++    Found=true;
++    auto *Parameter=Method->getParamDecl(Index);
++    auto Type=Parameter->getType();
++    if(!Type->isLValueReferenceType() || !Actions.Context.hasSameUnqualifiedType(Type->getPointeeType(),Construction->getType()) ||
++        !Parameter->getTypeSourceInfo()) { AllTracking=false; return; }
++    auto Reference=Parameter->getTypeSourceInfo()->getTypeLoc().getAs<ReferenceTypeLoc>();
++    auto Loc=Reference.isNull() ? SourceLocation() : PP.getSourceManager().getSpellingLoc(Reference.getSigilLoc());
++    AllTracking &= Loc.isValid() && *PP.getSourceManager().getCharacterData(Loc)=='%';
++  };
++  Function=Function->IgnoreParenImpCasts();
++  if(auto *Member=dyn_cast<MemberExpr>(Function)) Inspect(Member->getMemberDecl());
++  else if(auto *Reference=dyn_cast<DeclRefExpr>(Function)) Inspect(Reference->getDecl());
++  else if(auto *Overloads=dyn_cast<OverloadExpr>(Function)) for(auto *Candidate:Overloads->decls()) Inspect(Candidate);
++  return Found && AllTracking;
++}
