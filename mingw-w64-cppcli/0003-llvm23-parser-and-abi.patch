++static const MemberExpr *cppcliEvent(Expr *Value) {
++  auto *Member = dyn_cast<MemberExpr>(Value->IgnoreParenImpCasts());
++  if (!Member) return nullptr;
++  for (auto *Attr : Member->getMemberDecl()->specific_attrs<AnnotateAttr>())
++    if (Attr->getAnnotation() == "cli.event") return Member;
++  return nullptr;
++}
