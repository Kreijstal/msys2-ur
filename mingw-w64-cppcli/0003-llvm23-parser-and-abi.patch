++// Inspect resolved managed overload declarations, including inherited methods.
++// Literal arguments in String/Object slots become managed strings; native calls
++// and caller-provided char/wchar buffers retain ordinary C++ semantics.
++static bool cppcliStringSlot(const NamedDecl *Decl, unsigned Index, unsigned Count) {
++  auto *Method = dyn_cast<CXXMethodDecl>(Decl);
++  if (!Method || Index >= Method->getNumParams() || Count > Method->getNumParams() || Count < Method->getMinRequiredArguments()) return false;
++  const CXXRecordDecl *Owner = Method->getParent()->getDefinition();
++  if (!Owner) Owner = Method->getParent();
++  bool Managed = false;
++  for (auto *Attr : Owner->specific_attrs<AnnotateAttr>())
++    Managed |= Attr->getAnnotation() == "cli.ref" || Attr->getAnnotation().starts_with("cli.external:");
++  if (!Managed) return false;
++  QualType Type = Method->getParamDecl(Index)->getType();
++  if (!Type->isPointerType()) return false;
++  auto *Record = Type->getPointeeType()->getAsCXXRecordDecl();
++  return Record && (Record->getQualifiedNameAsString() == "System::String" || Record->getQualifiedNameAsString() == "System::Object");
++}
++
++static bool cppcliStringArgument(Expr *Function, unsigned Index, unsigned Count) {
++  Function = Function->IgnoreParenImpCasts();
++  if (auto *Member = dyn_cast<MemberExpr>(Function))
++    return cppcliStringSlot(Member->getMemberDecl(), Index, Count);
++  if (auto *Reference = dyn_cast<DeclRefExpr>(Function))
++    return cppcliStringSlot(Reference->getDecl(), Index, Count);
++  if (auto *Overloads = dyn_cast<OverloadExpr>(Function))
++    for (auto *Candidate : Overloads->decls())
++      if (cppcliStringSlot(Candidate, Index, Count)) return true;
++  return false;
++}
