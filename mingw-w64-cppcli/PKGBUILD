noextract=("${source[@]%%::*}")

_tree() { printf '%s/dotnet-bootstrap-%s' "${srcdir}" "${_bootstrap_commit}"; }
_frontend() { printf '%s/bootstrap/m612/cppcli' "$(_tree)"; }

prepare() {
  tar -xf "${srcdir}/dotnet-bootstrap-${_bootstrap_commit}.tar.gz" -C "${srcdir}"
  if ! grep -Fq 'ap.add_argument("--framework"' "$(_frontend)/cli-clang.py"; then
    patch -d "$(_tree)" -Np1 -i "${srcdir}/0002-windowsforms-framework.patch"
  fi
  if ! grep -q 'std::filesystem::u8path(path)' "$(_frontend)/frontend.cpp"; then
    patch -d "$(_tree)" -Np1 -i "${srcdir}/0001-windows-unicode-output-path.patch"
  fi
  mkdir -p "${srcdir}/parse-cache"
  local file
  for file in "${source[@]:4:18}"; do
    file=${file%%::*}
    cp "${srcdir}/${file}" "${srcdir}/parse-cache/${file}"
  done
  HTTP_PROXY=http://127.0.0.1:9 HTTPS_PROXY=http://127.0.0.1:9 NO_PROXY= \
    "${MINGW_PREFIX}/bin/python.exe" "$(_frontend)/fetch-clang-parse.py" \
      "${srcdir}/parse-cache" "${srcdir}/clang-parse"
}

_sdkroot() { printf '%s' "${CPPCLI_SDK:-${MINGW_PREFIX}/lib/dotnet}"; }
_ilasm() { printf '%s' "${CPPCLI_ILASM:-${MINGW_PREFIX}/bin/ilasm-dotnet.exe}"; }

build() {
  mkdir -p "${srcdir}/build-${_bootstrap_commit}"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "${srcdir}/build-${_bootstrap_commit}/NuGet.config"
  "$(_sdkroot)/dotnet.exe" build "$(cygpath -m "$(_frontend)/metadata/metadata.csproj")" -c Release -nologo \
    --configfile "$(cygpath -m "${srcdir}/build-${_bootstrap_commit}/NuGet.config")" -p:UseSharedCompilation=false \
    "-p:BaseIntermediateOutputPath=$(cygpath -m "${srcdir}/build-${_bootstrap_commit}/metadata-obj")/" \
    "-p:OutputPath=$(cygpath -m "${srcdir}/build-${_bootstrap_commit}/metadata")/" -p:NuGetAudit=false
  "${MINGW_PREFIX}/bin/cmake" -S "$(_frontend)" -B "${srcdir}/build-${_bootstrap_commit}" -GNinja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER="${MINGW_PREFIX}/bin/clang.exe" \
    -DCMAKE_CXX_COMPILER="${MINGW_PREFIX}/bin/clang++.exe" \
    -DLLVM_DIR="${MINGW_PREFIX}/lib/cmake/llvm" -DCPPCLI_PARSE_DIR="${srcdir}/clang-parse"
  "${MINGW_PREFIX}/bin/cmake" --build "${srcdir}/build-${_bootstrap_commit}" --target cli_ast -j2
  printf '#define TARGET_RELATIVE L"../bin/python.exe"\n#define TOOL_RELATIVE L"../lib/cppcli/package-driver.py"\n' \
    > "${srcdir}/launcher-config.h"
  "${MINGW_PREFIX}/bin/cc" -std=c11 -O2 -Wall -Wextra -Werror -municode \
    -include "${srcdir}/launcher-config.h" "${srcdir}/launcher.c" -o "${srcdir}/cli-clang.exe"
}

check() {
  "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/check-launcher.py" \
    "$(cygpath -m "${srcdir}/launcher.c")" "$(cygpath -m "${MINGW_PREFIX}/bin/cc.exe")" "$(cygpath -m "${srcdir}")"

  # Use the build tree through the same driver as the installed package.
  local test="${srcdir}/check"
  mkdir -p "${test}"
  CPPCLI_SDK="$(cygpath -m "$(_sdkroot)")" CPPCLI_ILASM="$(cygpath -m "$(_ilasm)")" \
    CPPCLI_CLANG="$(cygpath -m "${MINGW_PREFIX}/bin/clang++.exe")" \
    "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/build-${_bootstrap_commit}/cli-clang" \
      "$(cygpath -m "$(_frontend)/../cli-poc/hello.cpp")" -o "$(cygpath -m "${test}/hello.dll")"
  "$(_sdkroot)/dotnet.exe" "$(cygpath -m "${test}/hello.dll")" | tr -d '\r' > "${test}/hello.txt"
  grep -qx 'Hello from C++/CLI through a GCC plugin!' "${test}/hello.txt"
  local unicode="${test}/Unicode λ 😀 space"
  mkdir -p "$unicode"
  CPPCLI_SDK="$(cygpath -m "$(_sdkroot)")" CPPCLI_ILASM="$(cygpath -m "$(_ilasm)")" \
    CPPCLI_CLANG="$(cygpath -m "${MINGW_PREFIX}/bin/clang++.exe")" \
    "${MINGW_PREFIX}/bin/python.exe" "${srcdir}/build-${_bootstrap_commit}/cli-clang" \
      "$(cygpath -m "$(_frontend)/../cli-poc/hello.cpp")" -o "$(cygpath -m "$unicode/hello.dll")"
  "$(_sdkroot)/dotnet.exe" "$(cygpath -m "$unicode/hello.dll")" | tr -d '\r' > "$unicode/hello.txt"
  grep -qx 'Hello from C++/CLI through a GCC plugin!' "$unicode/hello.txt"
  CPPCLI_BUILD="${srcdir}/build-${_bootstrap_commit}" CPPCLI_TESTDIR="${test}" CPPCLI_SDK="$(_sdkroot)" CPPCLI_ILASM="$(_ilasm)" \
    bash "$(_frontend)/../cppcli.sh" test-core test-objects test-properties test-virtuals test-arrays test-exceptions test-interop test-enums test-values test-tracking test-adapter-gate test-nested-enums test-native-local-arrays test-native-com-aggregates test-interior-assignment test-inline-array-pins test-type-tokens test-managed-sizeof
}

package() {
  local dest="${pkgdir}${MINGW_PREFIX}/lib/${_realname}" file
  install -Dm755 "${srcdir}/cli-clang.exe" "${pkgdir}${MINGW_PREFIX}/bin/cli-clang.exe"
  install -Dm755 "${srcdir}/build-${_bootstrap_commit}/cli_ast.dll" "${dest}/cli_ast.dll"
  install -Dm644 "$(_frontend)/cli-clang.py" "${dest}/cli-clang.py"
  install -Dm644 "${srcdir}/package-driver.py" "${dest}/package-driver.py"
  install -Dm644 "$(_frontend)/include/vcclr.h" "${dest}/include/vcclr.h"
  mkdir -p "${dest}/metadata"
  for file in metadata.dll metadata.deps.json metadata.runtimeconfig.json; do
    install -m644 "${srcdir}/build-${_bootstrap_commit}/metadata/${file}" "${dest}/metadata/${file}"
  done
  for file in capabilities.json roadmap.json adapter-gate.json clang-parse-manifest.json clang-caret.patch; do
    install -Dm644 "$(_frontend)/${file}" "${pkgdir}${MINGW_PREFIX}/share/${_realname}/${file}"
  done
  cp -a "$(_frontend)/tests" "${pkgdir}${MINGW_PREFIX}/share/${_realname}/"
  install -Dm644 "${srcdir}/LICENSE.launcher" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.launcher"
  install -Dm644 "${srcdir}/LLVM-LICENSE.TXT" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LLVM-LICENSE.TXT"
}
