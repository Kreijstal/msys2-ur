# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-poi-shared-strings
pkgname=("${MINGW_PACKAGE_PREFIX}-java-poi-shared-strings")
pkgver=2.9.0
pkgrel=1
pkgdesc="poi-shared-strings Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/pjfanning/poi-shared-strings'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-commons-text"
             "${MINGW_PACKAGE_PREFIX}-java-h2"
             "${MINGW_PACKAGE_PREFIX}-java-poi"
             "${MINGW_PACKAGE_PREFIX}-java-poi-ooxml"
             "${MINGW_PACKAGE_PREFIX}-java-slf4j-api"
             "${MINGW_PACKAGE_PREFIX}-java-xmlbeans")
source=('https://repo.maven.apache.org/maven2/com/github/pjfanning/poi-shared-strings/2.9.0/poi-shared-strings-2.9.0-sources.jar'
         'https://repo.maven.apache.org/maven2/com/github/pjfanning/poi-shared-strings/2.9.0/poi-shared-strings-2.9.0.pom')
noextract=('poi-shared-strings-2.9.0-sources.jar'
         'poi-shared-strings-2.9.0.pom')
sha256sums=('d6726dc7174c49acc8faa3888051c24a4b54cbc09b5df0f9dfe7c966b30de542'
         '103ffde7307ac0da1e99576612767300ed979d381ef9f5e4b6cdf162054dc743')
_artifacts=('com.github.pjfanning:poi-shared-strings:2.9.0')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module com.github.pjfanning:poi-shared-strings:2.9.0 upstream/poi-shared-strings \
    -r resources/poi-shared-strings -u poi-shared-strings-2.9.0.pom -- \
    org.slf4j:slf4j-api/runtime com.h2database:h2/runtime org.apache.poi:poi-ooxml/runtime org.apache.poi:poi/runtime org.apache.xmlbeans:xmlbeans/runtime org.apache.commons:commons-text/runtime
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.slf4j:slf4j-api --with com.h2database:h2 --with org.apache.poi:poi-ooxml --with org.apache.poi:poi --with org.apache.xmlbeans:xmlbeans --with org.apache.commons:commons-text com.github.pjfanning:poi-shared-strings
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-poi-shared-strings() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-slf4j-api"
           "${MINGW_PACKAGE_PREFIX}-java-h2"
           "${MINGW_PACKAGE_PREFIX}-java-poi-ooxml"
           "${MINGW_PACKAGE_PREFIX}-java-poi"
           "${MINGW_PACKAGE_PREFIX}-java-xmlbeans"
           "${MINGW_PACKAGE_PREFIX}-java-commons-text")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.github.pjfanning:poi-shared-strings
  _license poi-shared-strings 2.9.0
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
