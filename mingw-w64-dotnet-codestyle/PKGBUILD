pkgbase=mingw-w64-dotnet-codestyle
pkgname=("${MINGW_PACKAGE_PREFIX}-dotnet-codestyle-csharp" "${MINGW_PACKAGE_PREFIX}-dotnet-codestyle-visualbasic" "${MINGW_PACKAGE_PREFIX}-dotnet-sdk-codestyle")
pkgver=4.9.2
pkgrel=1
_commit=9934fb9e3527e1c0c51314e57d4aab30f97e8f9e
pkgdesc='Complete source-built Roslyn CodeStyle analyzers and fixes for the .NET 8 toolchain'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/roslyn'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-visualbasic-workspaces=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-visualbasic-compiler=$pkgver")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("roslyn-$pkgver.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/$_commit"
        prepare.py build-libraries.sh build.sh pack.py check.sh check-api.sh check-msbuild.sh verify-build-assets.py
        Check.cs ExtractFixtures.cs InspectApi.cs InspectInventory.cs InspectMetadata.cs
        ExpectedAssemblies.json ExpectedBuildAssets.json UpstreamFixtures.json published-metadata-provenance.json README.md)
