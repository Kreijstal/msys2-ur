prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/roslyn-$_commit" "$srcdir/prepared"; }
build() { bash "$srcdir/build.sh" "$srcdir/roslyn-$_commit" "$srcdir/prepared"; }
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"; }
_install_language() {
 local suffix=$1 language=$2
 install -Dm644 "$srcdir/feed/Microsoft.CodeAnalysis.$language.CodeStyle.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.codeanalysis.${language,,}.codestyle.$pkgver.nupkg"
 install -Dm644 "$srcdir/roslyn-$_commit/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-codestyle-$suffix/License.txt"
 install -m644 "$srcdir/roslyn-$_commit/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-codestyle-$suffix/THIRD-PARTY-NOTICES.txt"
 for file in README.md ExpectedAssemblies.json ExpectedBuildAssets.json UpstreamFixtures.json published-metadata-provenance.json;do
  install -Dm644 "$srcdir/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-codestyle-$suffix/$file"
 done
 for file in source-items.json localization.json removed-binaries.json;do
  install -m644 "$srcdir/prepared/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-codestyle-$suffix/$file"
 done
}
package_dotnet-codestyle-csharp() {
 pkgdesc='Full source-built CSharp CodeStyle analyzers and fixes4.9.2'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler=$pkgver")
 _install_language csharp CSharp
}
package_dotnet-codestyle-visualbasic() {
 pkgdesc='Full source-built VisualBasic CodeStyle analyzers and fixes4.9.2'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-visualbasic-workspaces=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-visualbasic-compiler=$pkgver")
 _install_language visualbasic VisualBasic
}
package_dotnet-sdk-codestyle() {
 pkgdesc='Source-built CSharp/VisualBasic CodeStyle integration for source SDK8.0.131'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codestyle-csharp=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-codestyle-visualbasic=$pkgver")
 local language short target payload
 for language in CSharp VisualBasic;do
  short=cs;[[ $language != VisualBasic ]] || short=vb
  target="$pkgdir$MINGW_PREFIX/lib/dotnet/sdk/8.0.131/Sdks/Microsoft.NET.Sdk/codestyle/$short"
  payload="$srcdir/prepared/packages/$language/payload"
  mkdir -p "$target/build"
  cp -R "$payload/analyzers/dotnet/$short/"* "$target/"
  cp "$payload/build/Microsoft.CodeAnalysis.$language.CodeStyle.targets" "$target/build/"
  cp -R "$payload/build/config" "$target/build/"
 done
 install -Dm644 "$srcdir/roslyn-$_commit/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-sdk-codestyle/License.txt"
 install -m644 "$srcdir/roslyn-$_commit/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-sdk-codestyle/THIRD-PARTY-NOTICES.txt"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-sdk-codestyle/README.md"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
