# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-jsch
pkgname=("${MINGW_PACKAGE_PREFIX}-java-jsch")
pkgver=2.28.7
pkgrel=1
pkgdesc="jsch Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/mwiede/jsch'
license=('spdx:BSD-3-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-bcprov"
             "${MINGW_PACKAGE_PREFIX}-java-jna"
             "${MINGW_PACKAGE_PREFIX}-java-jna-platform"
             "${MINGW_PACKAGE_PREFIX}-java-jzlib"
             "${MINGW_PACKAGE_PREFIX}-java-log4j-api"
             "${MINGW_PACKAGE_PREFIX}-java-slf4j-api")
source=('https://repo.maven.apache.org/maven2/com/github/mwiede/jsch/2.28.7/jsch-2.28.7-sources.jar'
         'https://repo.maven.apache.org/maven2/com/github/mwiede/jsch/2.28.7/jsch-2.28.7.pom'
         '0001-use-the-JDK-agent-socket-factory.patch')
noextract=('jsch-2.28.7-sources.jar'
         'jsch-2.28.7.pom')
sha256sums=('a41193979311f54883c9ecdead4ca6350c7721b9214c66be48a44f32c3971915'
         '2c2893c00f354ba6dae2a64800d7fd5989a2763d051d4a9f0b878c9216bc0c46'
         'c5d95bc7bd104ce079b488f7ff7b39ca60f9529342b854f972344c88a8c8bb34')
_artifacts=('com.github.mwiede:jsch:2.28.7')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    # Use the upstream JDK implementations available at our Java 21 baseline.
    for release in 9 10 11 15 16 19; do
      if [[ -d upstream/$a/META-INF/versions/$release/com ]]; then
        cp -r "upstream/$a/META-INF/versions/$release/com/." "upstream/$a/com/"
      fi
    done
    cp -r "upstream/$a/META-INF/versions/23" "${srcdir}/jsch-mr23"
    cp -r "upstream/$a/META-INF/versions/24" "${srcdir}/jsch-mr24"
    rm -rf "upstream/$a/META-INF/versions"
    # Java 16 supplies UnixDomainSocketFactory directly; the optional native
    # junixsocket adapter is unnecessary on the supported Java 21+ runtime.
    rm -f "upstream/$a/com/jcraft/jsch/JUnixSocketFactory.java"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
  patch -p1 -i "${srcdir}/0001-use-the-JDK-agent-socket-factory.patch"
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module com.github.mwiede:jsch:2.28.7 upstream/jsch \
    -r resources/jsch -u jsch-2.28.7.pom -v "23:${srcdir}/jsch-mr23" -v "24:${srcdir}/jsch-mr24" -- \
    net.java.dev.jna:jna net.java.dev.jna:jna-platform org.slf4j:slf4j-api org.apache.logging.log4j:log4j-api org.bouncycastle:bcprov-jdk18on com.jcraft:jzlib
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with net.java.dev.jna:jna --with net.java.dev.jna:jna-platform --with org.slf4j:slf4j-api --with org.apache.logging.log4j:log4j-api --with org.bouncycastle:bcprov-jdk18on --with com.jcraft:jzlib com.github.mwiede:jsch
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-jsch() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-jna"
           "${MINGW_PACKAGE_PREFIX}-java-jna-platform"
           "${MINGW_PACKAGE_PREFIX}-java-slf4j-api"
           "${MINGW_PACKAGE_PREFIX}-java-log4j-api"
           "${MINGW_PACKAGE_PREFIX}-java-bcprov"
           "${MINGW_PACKAGE_PREFIX}-java-jzlib")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.github.mwiede:jsch
  _license jsch 2.28.7
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
