prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/roslyn-analyzers-$_commit" "$srcdir/prepared"; }
build() { bash "$srcdir/build.sh" "$srcdir/roslyn-analyzers-$_commit" "$srcdir/prepared"; }
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed" "$srcdir/prepared/package/payload/source-build"; }
package() {
 install -Dm644 "$srcdir/feed/Microsoft.CodeAnalysis.Analyzers.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/microsoft.codeanalysis.analyzers.$pkgver.nupkg"
 install -Dm644 "$srcdir/roslyn-analyzers-$_commit/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-codeanalysis-analyzers/License.txt"
 install -m644 "$srcdir/roslyn-analyzers-$_commit/assets/ThirdPartyNotices.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-codeanalysis-analyzers/ThirdPartyNotices.txt"
 for file in README.md ExpectedApi.json ExpectedInventory.json ExpectedMetadata.json ExpectedGeneratedAssets.json UpstreamFixtures.json published-metadata-provenance.json;do
  install -Dm644 "$srcdir/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-codeanalysis-analyzers/$file"
 done
 for file in fixtures.json localization.json source-items.json removed-binaries.json;do
  install -m644 "$srcdir/prepared/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-codeanalysis-analyzers/$file"
 done
}
