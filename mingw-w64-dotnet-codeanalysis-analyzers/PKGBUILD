pkgrel=1
_commit=22ea6422f85b05ca0793cc3b76375487be407f5d
pkgdesc='Complete source-built Roslyn analyzers, CSharp and VisualBasic code fixes for .NET 8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/roslyn-analyzers'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-visualbasic-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-visualbasic-compiler>=4.9.2")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("roslyn-analyzers-$pkgver.tar.gz::https://codeload.github.com/dotnet/roslyn-analyzers/tar.gz/$_commit"
        prepare.py build-libraries.sh generate-config.sh pack.py build.sh check.sh check-api.sh
        Check.cs CheckSpecialFixes.cs ExtractFixtures.cs InspectApi.cs InspectInventory.cs InspectMetadata.cs
        MicrosoftShared.pubkey.hex ExpectedApi.json ExpectedInventory.json ExpectedMetadata.json
        ExpectedGeneratedAssets.json UpstreamFixtures.json published-metadata-provenance.json README.md)
