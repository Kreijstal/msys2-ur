# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-host10-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.5
pkgrel=1
pkgdesc='Source-built native .NET10 host bootstrap component; runtime and SDK not included (mingw-w64)'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131"
             "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja" "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-uasm" "${MINGW_PACKAGE_PREFIX}-python"
             'python' 'patch')
options=('!strip' '!lto' '!buildflags' '!debug')
source=('runtime-v10.0.5.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.5'
        "dotnet-host10-source-1.tar.gz::https://github.com/Kreijstal/msys2-ur/releases/download/x11-shared-20260731/dotnet-host10-source-1.tar.gz" 'README.md')
noextract=('runtime-v10.0.5.tar.gz')
sha256sums=('1692acae5e3adfd625452fbc9db4fd4e982c10e38189358ae245c74dd5514d7a'
            'ed3ae779bffb536e8580b1791e1e2e9c0109dd936818155a2a1921eea34c4084' '6af00dfe6c5a07ef3659ff62d7aecc344c4e65176e8447cebff0425163fcc8a3')

build() {
  bash "$srcdir/host10/build-all-host.sh" "$srcdir/runtime-v10.0.5.tar.gz" "$srcdir/prepared" "${HOST10_JOBS:-2}"
  /usr/bin/python3 "$srcdir/host10/audit-host.py" "$srcdir/prepared"
}

check() {
  /clang64/bin/python.exe "$(cygpath -am "$srcdir/host10/check-native-host.py")" \
    "$(cygpath -am "$srcdir/prepared/host/corehost")" "$(cygpath -am "$srcdir/native-check")" \
    "$(cygpath -am "$srcdir/prepared/host/corehost_test")"
}

package() {
  /usr/bin/python3 "$srcdir/host10/stage-host-package.py" "$srcdir/prepared" "$srcdir/package-prefix" "$srcdir/README.md"
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -a "$srcdir/package-prefix/." "$pkgdir$MINGW_PREFIX/"
}
