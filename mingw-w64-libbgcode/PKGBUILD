# Contributor: Kreijstal <elektrischrainbow@gmail.com>

_realname=libbgcode
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
# the commit PrusaSlicer 2.9.7 pins (upstream has no tags)
_commit=167c8e19a26e74de42bbb3622480ee04a9420394
pkgver=0.3.0.r249.g167c8e19
pkgrel=1
pkgdesc="Prusa binary G-code format library and bgcode tool (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'mingw64')
url='https://github.com/prusa3d/libbgcode'
msys2_repository_url='https://github.com/prusa3d/libbgcode'
license=('spdx:AGPL-3.0-only')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-heatshrink"
         "${MINGW_PACKAGE_PREFIX}-zlib")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-boost"
             "${MINGW_PACKAGE_PREFIX}-catch"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja")
source=("${_realname}-${_commit}.tar.gz::https://github.com/prusa3d/libbgcode/archive/${_commit}.tar.gz")
options=('staticlibs')
sha256sums=('1ada7f3e095d0140f82080839b4d50dfeee664957aaf82a682e06a42a69bd487')

build() {
  # static like PrusaSlicer's own deps build: the tests use unexported
  # internals (MeatPack), which only link against static libraries
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake -S "${_realname}-${_commit}" -B "build-${MSYSTEM}" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DLibBGCode_BUILD_TESTS=ON

  cmake --build "build-${MSYSTEM}"
}

check() {
  ctest --test-dir "build-${MSYSTEM}" --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${_commit}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
