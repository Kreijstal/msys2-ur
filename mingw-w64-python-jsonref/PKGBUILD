_realname=jsonref
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.1.0
pkgrel=1
pkgdesc="Automatic dereferencing of JSON Reference objects (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/gazpachoking/jsonref'
msys2_repository_url='https://github.com/gazpachoking/jsonref'
msys2_references=(
  'purl: pkg:pypi/jsonref'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-pdm-backend")
source=("https://pypi.org/packages/source/j/jsonref/jsonref-${pkgver}.tar.gz")
sha256sums=('32fe8e1d85af0fdefbebce950af85590b22b60f9e95443176adbde4e1ecea552')

prepare() {
  cd "jsonref-${pkgver}"
  # pdm-pep517 is deprecated and not packaged; pdm-backend reads the same
  # [tool.pdm] build/version settings
  sed -i 's/"pdm-pep517>=1.0.0"/"pdm-backend"/; s/pdm.pep517.api/pdm.backend/' pyproject.toml
}

build() {
  cp -r "jsonref-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import jsonref
doc = jsonref.replace_refs({"a": {"$ref": "#/defs/b"}, "defs": {"b": {"c": [1, 2]}}})
assert doc["a"]["c"] == [1, 2]
s = jsonref.loads('{"x": {"$ref": "#/y"}, "y": 3}')
assert s["x"] == 3
print("jsonref ok", jsonref.__version__)
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
