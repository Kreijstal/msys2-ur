diff --git a/CMakeLists.txt b/CMakeLists.txt
index 325f6a8..3eb3976 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -228,13 +228,19 @@ target_link_libraries(TitanEngine PRIVATE
 	Psapi.lib
 )
 
-if(CMAKE_SIZEOF_VOID_P EQUAL 8) # x64
+if(MINGW) # mingw
+	target_link_libraries(TitanEngine PRIVATE
+		ntdll
+	)
+endif()
+
+if(MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8) # x64-msvc
 	target_link_libraries(TitanEngine PRIVATE
 		"${CMAKE_CURRENT_SOURCE_DIR}/TitanEngine/ntdll_x64.lib"
 	)
 endif()
 
-if(CMAKE_SIZEOF_VOID_P EQUAL 4) # x32
+if(MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 4) # x32-msvc
 	target_link_libraries(TitanEngine PRIVATE
 		"${CMAKE_CURRENT_SOURCE_DIR}/TitanEngine/ntdll_x86.lib"
 	)
