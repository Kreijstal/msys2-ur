pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2026.05.27
pkgrel=2
pkgdesc='Open-source user mode debugger for Windows, built from source with MinGW-w64 (mingw-w64)'
arch=('any')
# x64 only: x32dbg needs a 32-bit environment
mingw_arch=('clang64')
url='https://x64dbg.com'
msys2_repository_url='https://github.com/x64dbg/x64dbg'
msys2_references=('x64dbg')
license=('spdx:GPL-3.0-only AND LGPL-3.0-only AND MIT AND MPL-2.0 AND Zlib AND Apache-2.0 WITH LLVM-exception AND BSD-2-Clause AND GPL-2.0-or-later')
# x64dbg upstream ships prebuilt DLLs and import libraries for all of these
# (deps/, src/dbg/*/*.lib) and downloads Qt 5.12 for MSVC. Here:
#  - system packages: Qt 5 (widgets, winextras; lrelease for the
#    translations), jansson, lz4, XEDParse (msys2-ur, ported to the
#    open-source Intel XED), msdia140.dll (openmsdia, msys2-ur), the
#    toolchain's ntdll and dbghelp import libraries for the DLLs of Windows
#  - built here from pinned sources: TitanEngine, GleeBug, btparser (git
#    submodules), DeviceNameResolver, LLVMDemangle, ldconvert, x64dbg's lz4
#    file helpers and asmjit.dll (asmjit_xedparse with its asmjit and asmtk)
#  - not used: the MSVC runtime DLLs, Microsoft's dbghelp.dll (Windows'
#    own is used) and msdia140.dll, cmkr.exe, AStyle, Scylla.dll (needs ATL;
#    not packaged, the StartScylla command reports it missing)
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-jansson"
         "${MINGW_PACKAGE_PREFIX}-lz4"
         "${MINGW_PACKAGE_PREFIX}-openmsdia"
         "${MINGW_PACKAGE_PREFIX}-qt5-base"
         "${MINGW_PACKAGE_PREFIX}-qt5-winextras"
         "${MINGW_PACKAGE_PREFIX}-xedparse")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-qt5-tools"
             "unzip")
