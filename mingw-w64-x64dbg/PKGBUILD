# Sources use CRLF line endings: MSYS patch needs --binary to keep them
_patch() {
  local _p
  for _p in "$@"; do
    msg2 "Applying ${_p}"
    patch --binary -Np1 -i "${srcdir}/${_p}"
  done
}

prepare() {
  local _src="${srcdir}/${_realname}-${pkgver}"

  # Symlinks of the Wine helper scripts and the (unused) cross-platform GUI
  # cannot be created on Windows
  rm -rf "${_src}"
  bsdtar -xf "${srcdir}/${_realname}-${pkgver}.tar.gz" -C "${srcdir}" \
    --exclude "${_realname}-${pkgver}/cmake/wine" \
    --exclude "${_realname}-${pkgver}/src/cross"

  # Submodules (the GitHub tarball has empty directories)
  rmdir "${_src}/src/dbg/btparser" "${_src}/src/third_party/TitanEngine" \
        "${_src}/src/third_party/GleeBug" "${_src}/deps" 2>/dev/null || true
  rm -rf "${_src}/src/dbg/btparser" "${_src}/src/third_party/TitanEngine" "${_src}/src/third_party/GleeBug"
  cp -a "${srcdir}/btparser-${_btparser}" "${_src}/src/dbg/btparser"
  cp -a "${srcdir}/TitanEngine-${_titanengine}" "${_src}/src/third_party/TitanEngine"
  cp -a "${srcdir}/GleeBug-${_gleebug}" "${_src}/src/third_party/GleeBug"

  # Sources of the small dependencies upstream ships as binaries
  rm -rf "${srcdir}/deps-src"
  mkdir -p "${srcdir}/deps-src"
  cp -a "${srcdir}/DeviceNameResolver-${_devicenameresolver}" "${srcdir}/deps-src/DeviceNameResolver"
  cp -a "${srcdir}/LLVMDemangle-${_llvmdemangle}" "${srcdir}/deps-src/LLVMDemangle"
  cp -a "${srcdir}/ldconvert-${_ldconvert}" "${srcdir}/deps-src/ldconvert"
  cp -a "${srcdir}/lz4-${_lz4}" "${srcdir}/deps-src/lz4"
  cp -a "${srcdir}/asmjit_xedparse-${_asmjit_xedparse}" "${srcdir}/deps-src/asmjit_xedparse"
  rmdir "${srcdir}/deps-src/asmjit_xedparse/asmjit/asmjit" "${srcdir}/deps-src/asmjit_xedparse/asmjit/asmtk"
  cp -a "${srcdir}/asmjit-${_asmjit}" "${srcdir}/deps-src/asmjit_xedparse/asmjit/asmjit"
  cp -a "${srcdir}/asmtk-${_asmtk}" "${srcdir}/deps-src/asmjit_xedparse/asmjit/asmtk"
  # lz4file.cpp builds on the system lz4, not on the fork's 2015 copy
  rm -f "${srcdir}/deps-src/lz4/"lz4{,hc}.{c,h}

  # No prebuilt binaries: import libraries (MSVC, x64dbg's dependencies,
  # ntdll), loaders, formatters and the cmkr executable. cmkr.cmake would run
  # cmkr.exe and git; the checked-in generated CMakeLists.txt is used as is.
  find "${_src}" "${srcdir}/deps-src" -type f \
    \( -iname '*.lib' -o -iname '*.dll' -o -iname '*.exe' -o -iname '*.pdb' \) -print -delete
  rm -f "${_src}/cmake/cmkr.cmake"

  cd "${_src}"
  _patch 0001-Build-with-MinGW-w64-and-source-built-dependencies.patch \
         0002-Fix-the-debugger-core-for-GCC-and-Clang.patch \
         0003-Find-dependencies-outside-the-application-directory.patch
  cd "${_src}/src/third_party/TitanEngine"
  _patch 0101-TitanEngine-build-with-MinGW-w64.patch
  cd "${_src}/src/third_party/GleeBug"
  _patch 0201-GleeBug-build-with-MinGW-w64.patch
  cd "${srcdir}/deps-src/DeviceNameResolver"
  _patch 0301-DeviceNameResolver-include-string.patch
  cd "${srcdir}/deps-src/LLVMDemangle"
  _patch 0302-LLVMDemangle-build-with-libc++-23.patch
  cd "${srcdir}/deps-src/asmjit_xedparse"
  _patch 0303-asmjit_xedparse-cast-the-callback-to-void-pointer.patch

  # The bundled jansson 2.9 and lz4 headers forward to the system ones
  # (they are also the plugin SDK's)
  cd "${_src}/src/dbg"
  local _h
  for _h in jansson/jansson.h jansson/jansson_config.h lz4/lz4.h lz4/lz4hc.h; do
    printf '// MinGW package: the system header\n#include_next <%s>\n' "${_h#*/}" > "${_h}"
  done

  rm -rf "${srcdir}/translations"
  bsdtar -xf "${srcdir}/x64dbg-translations-ts-${_tsdate}.zip" -C "${srcdir}"
}

build() {
  local _src="${srcdir}/${_realname}-${pkgver}"
  local _b="${srcdir}/build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -S "${_src}" \
      -B "${_b}" \
      -DCMAKE_BUILD_TYPE=Release \
      -DX64DBG_BUILD_IN_TREE=OFF \
      -DX64DBG_DEPS_SOURCE_DIR="$(cygpath -m "${srcdir}/deps-src")" \
      -DX64DBG_EXTRA_DLL_DIRECTORY=../../../bin
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${_b}"

  # Translations
  mkdir -p "${_b}/translations"
  local _ts
  for _ts in "${srcdir}"/translations/x64dbg_*.ts; do
    "${MINGW_PREFIX}/bin/lrelease.exe" -silent "${_ts}" \
      -qm "${_b}/translations/$(basename "${_ts%.ts}").qm"
  done

  # Launchers for ${MINGW_PREFIX}/bin
  ${CC:-cc} -O2 -municode -mwindows -DTARGET='L"x64dbg.exe"' \
    "${srcdir}/x64dbg-launcher.c" -o "${_b}/x64dbg-launcher.exe"
  ${CC:-cc} -O2 -municode -DLAUNCHER_CONSOLE -DTARGET='L"headless.exe"' \
    "${srcdir}/x64dbg-launcher.c" -o "${_b}/x64dbg-headless-launcher.exe"
}

check() {
  # Upstream's headless regression tests (debuggee programs and test plugins
  # built against the plugin SDK) with both debug engines CI tests
  local _src="${srcdir}/${_realname}-${pkgver}"
  cp -a "${srcdir}/build-${MSYSTEM}/bin/." "${_src}/bin/x64/"
  # run.py passes paths to headless.exe, which wants Windows separators
  sed -e 's|        str(userdir),|        str(userdir).replace("/", "\\\\"),|' \
      -e 's|        return os.path.relpath(path, cwd)$|        return os.path.relpath(path, cwd).replace("/", "\\\\")|' \
      "${_src}/src/tests/run.py" > "${_src}/src/tests/run_mingw.py"
  local _tests=(cmdline_init cmdline_setcommandline guard_page issue3803 issue3808 issue3865
                script_run_exit scriptcmd_call scriptcmd_call_threads)
  local _engine
  for _engine in TitanEngine GleeBug; do
    "${MINGW_PREFIX}/bin/python.exe" "${_src}/src/tests/run_mingw.py" --arch x64 \
      --engine ${_engine} --timeout 120 "${_tests[@]}"
  done
}

package() {
  local _src="${srcdir}/${_realname}-${pkgver}"
  local _b="${srcdir}/build-${MSYSTEM}"
  local _dest="${pkgdir}${MINGW_PREFIX}/lib/x64dbg"

  # Upstream's release layout: data files beside the x64 directory
  install -d "${_dest}/x64/plugins" "${_dest}/translations"
  cp -a "${_b}/bin/." "${_dest}/x64/"
  install -m644 "${_b}"/translations/*.qm "${_dest}/translations/"
  install -m644 "${_src}"/bin/{errordb.txt,exceptiondb.txt,ntstatusdb.txt,winconstants.txt,mnemdb.json} "${_dest}/"
  cp -a "${_src}/bin/themes" "${_dest}/themes"
  # An empty userdir file moves x64dbg.ini, the databases and the symbol
  # cache from the (read-only) program directory to %APPDATA%\x64dbg
  : > "${_dest}/x64/userdir"

  install -Dm755 "${_b}/x64dbg-launcher.exe" "${pkgdir}${MINGW_PREFIX}/bin/x64dbg.exe"
  install -Dm755 "${_b}/x64dbg-headless-launcher.exe" "${pkgdir}${MINGW_PREFIX}/bin/x64dbg-headless.exe"

  # Plugin SDK (upstream's pluginsdk folder): headers and import libraries
  local _sdk="${pkgdir}${MINGW_PREFIX}/include/x64dbg/pluginsdk"
  install -d "${_sdk}/jansson" "${_sdk}/lz4" "${_sdk}/XEDParse" "${_sdk}/dbghelp" "${_sdk}/TitanEngine"
  install -m644 "${_src}"/src/dbg/{_plugin_types.h,_plugins.h,_dbgfunctions.h} "${_sdk}/"
  install -m644 "${_src}"/src/dbg/_scriptapi*.h "${_sdk}/"
  install -m644 "${_src}"/src/bridge/bridge*.h "${_sdk}/"
  install -m644 "${_src}"/src/dbg/jansson/*.h "${_sdk}/jansson/"
  install -m644 "${_src}"/src/dbg/lz4/*.h "${_sdk}/lz4/"
  # The SDK's jansson and lz4 headers stand for the system ones; in the
  # installed tree #include_next would start after ${MINGW_PREFIX}/include
  local _h
  for _h in jansson/jansson.h jansson/jansson_config.h lz4/lz4.h lz4/lz4hc.h; do
    printf '// MinGW package: the system header\n#include <%s>\n' "${_h#*/}" > "${_sdk}/${_h}"
  done
  install -m644 "${_src}"/src/dbg/XEDParse/*.h "${_sdk}/XEDParse/"
  install -m644 "${_src}"/src/dbg/dbghelp/*.h "${_sdk}/dbghelp/"
  install -m644 "${_src}"/src/dbg/TitanEngine/TitanEngine.h "${_sdk}/TitanEngine/"
  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/lib" "${_b}"/lib/libx64bridge.dll.a "${_b}"/lib/libx64dbg.dll.a

  install -Dm644 "${_src}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${_src}/src/third_party/TitanEngine/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.TitanEngine"
  install -Dm644 "${_src}/src/third_party/GleeBug/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.GleeBug"
  install -Dm644 "${_src}/src/dbg/btparser/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.btparser"
  install -Dm644 "${srcdir}/deps-src/LLVMDemangle/LICENSE.TXT" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.LLVMDemangle"
  install -Dm644 "${srcdir}/deps-src/ldconvert/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.ldconvert"
  install -Dm644 "${srcdir}/deps-src/lz4/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.lz4"
  install -Dm644 "${srcdir}/deps-src/asmjit_xedparse/asmjit/asmjit/LICENSE.md" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.asmjit"
  install -Dm644 "${srcdir}/deps-src/asmjit_xedparse/asmjit/asmtk/LICENSE.md" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.asmtk"
  # DeviceNameResolver has no license file; its readme names the licenses
  # of the projects its code comes from (Scylla: GPL-3.0, TitanEngine: LGPL-3.0)
  install -Dm644 "${srcdir}/deps-src/DeviceNameResolver/readme.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.DeviceNameResolver"
  # asmjit_xedparse has no license file either; it is a component of x64dbg
  # by the same author and is distributed here under x64dbg's license
  printf '%s\n' \
    'asmjit_xedparse (https://github.com/x64dbg/asmjit_xedparse) ships no' \
    'license file. It is part of the x64dbg project, by the same author, and' \
    'is distributed with x64dbg under the same license: GPL-3.0-only (see' \
    'LICENSE). Its XEDParse.h comes from XEDParse (LGPL-3.0); asmjit and asmtk' \
    'are Zlib (LICENSE.asmjit, LICENSE.asmtk).' \
    > "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.asmjit_xedparse"
}
