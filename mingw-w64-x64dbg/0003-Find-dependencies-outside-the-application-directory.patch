diff --git a/src/exe/signaturecheck.cpp b/src/exe/signaturecheck.cpp
index dbfc8407..978d4870 100644
--- a/src/exe/signaturecheck.cpp
+++ b/src/exe/signaturecheck.cpp
@@ -465,6 +465,24 @@ bool InitializeSignatureCheck()
         if(!pSetDllDirectoryW(L""))
             return false;
 
+#ifdef X64DBG_EXTRA_DLL_DIRECTORY
+        // MinGW packages install x64dbg in <prefix>/lib/x64dbg/x64 and its
+        // dependencies (Qt, the C++ runtime, ...) in <prefix>/bin, which the
+        // restricted search order below would no longer find through PATH.
+        // Added first, so it is searched after the application directory.
+        {
+            std::wstring extraDir = szApplicationDir;
+            extraDir += L"" X64DBG_EXTRA_DLL_DIRECTORY;
+            wchar_t szExtraDir[MAX_PATH] = L"";
+            if(GetFullPathNameW(extraDir.c_str(), _countof(szExtraDir), szExtraDir, nullptr))
+            {
+                auto attributes = GetFileAttributesW(szExtraDir);
+                if(attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY))
+                    pAddDllDirectory(szExtraDir);
+            }
+        }
+#endif // X64DBG_EXTRA_DLL_DIRECTORY
+
         // Thanks to daax for finding this order
         // > If more than one directory has been added, the order in which those directories are searched is unspecified.
         // Reversing ntdll shows that it is using a singly-linked list, so the order is the opposite in which you add it
@@ -510,7 +528,7 @@ bool InitializeSignatureCheck()
         return false;
 #endif // DEBUG_SIGNATURE_CHECKS
 
-#ifndef _DEBUG
+#if !defined(_DEBUG) && defined(_MSC_VER)
     // Safely load the MSVC runtime DLLs (since they cannot be delay loaded)
