diff --git a/cmake/MinGW.cmake b/cmake/MinGW.cmake
new file mode 100644
index 00000000..092d018d
--- /dev/null
+++ b/cmake/MinGW.cmake
@@ -0,0 +1,113 @@
+# MinGW-w64 (GCC or Clang) build support.
+#
+# The MSVC build links the prebuilt import libraries checked into src/ and
+# copies the prebuilt DLLs from deps/. A MinGW build uses none of them:
+#  - ntdll, dbghelp: the toolchain's import libraries (the DLLs of Windows)
+#  - jansson, lz4, XEDParse: system libraries (pkg-config / find_library)
+#  - DeviceNameResolver, LLVMDemangle, ldconvert, asmjit (asmjit_xedparse):
+#    built here from their x64dbg source repositories, found in
+#    X64DBG_DEPS_SOURCE_DIR
+if(NOT MINGW)
+    return()
+endif()
+
+# DLLs keep their upstream names (x64dbg.dll, not libx64dbg.dll): the
+# executables and plugins load them by name.
+set(CMAKE_SHARED_LIBRARY_PREFIX "")
+set(CMAKE_SHARED_MODULE_PREFIX "")
+
+set(X64DBG_DEPS_SOURCE_DIR "${PROJECT_SOURCE_DIR}/deps-src" CACHE PATH
+    "Directory with the DeviceNameResolver, LLVMDemangle, ldconvert, asmjit_xedparse and lz4 sources")
+set(_deps "${X64DBG_DEPS_SOURCE_DIR}")
+
+add_compile_options(
+    # The code relies on MSVC's permissive defaults
+    $<$<COMPILE_LANGUAGE:CXX>:-fms-extensions>
+    $<$<COMPILE_LANGUAGE:CXX>:-Wno-invalid-offsetof>
+    -Wno-unknown-pragmas
+    -Wno-multichar
+)
+if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    add_compile_options(-Wno-microsoft -Wno-unknown-warning-option -Wno-nonportable-include-path
+        -Wno-writable-strings -Wno-format-security -Wno-switch)
+endif()
+
+# x64dbg.exe restricts the DLL search path to its own and the system
+# directory (src/exe/signaturecheck.cpp). A packaged build whose
+# dependencies live elsewhere names that directory here, relative to the
+# executable, for example ../../../bin for <prefix>/lib/x64dbg/x64.
+set(X64DBG_EXTRA_DLL_DIRECTORY "" CACHE STRING
+    "Additional DLL directory for x64dbg.exe, relative to its directory")
+if(X64DBG_EXTRA_DLL_DIRECTORY)
+    add_compile_definitions(X64DBG_EXTRA_DLL_DIRECTORY="${X64DBG_EXTRA_DLL_DIRECTORY}")
+endif()
+
+# All binaries go to one directory, like the MSVC build (bin/x64)
+if(NOT CMAKE_RUNTIME_OUTPUT_DIRECTORY)
+    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/bin")
+    set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/bin")
+    set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/lib")
+endif()
+
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(JANSSON REQUIRED IMPORTED_TARGET jansson>=2.9)
+pkg_check_modules(LZ4 REQUIRED IMPORTED_TARGET liblz4)
+find_library(XEDPARSE_LIBRARY NAMES XEDParse REQUIRED)
+
+# x64dbg's LZ4_compress_file and friends (lz4file.cpp of its lz4 fork, which
+# upstream builds into its lz4.dll) on top of the system liblz4
+add_library(lz4file SHARED "${_deps}/lz4/lz4file.cpp")
+target_compile_definitions(lz4file PRIVATE LZ4_DISABLE_DEPRECATE_WARNINGS)
+target_link_libraries(lz4file PRIVATE PkgConfig::LZ4)
+
+add_library(DeviceNameResolver SHARED
+    "${_deps}/DeviceNameResolver/DeviceNameResolver.cpp"
+    "${_deps}/DeviceNameResolver/DeviceNameResolverInternal.cpp"
+    "${_deps}/DeviceNameResolver/NativeWinApi.cpp"
+)
+# A Unicode (TCHAR = wchar_t) project upstream
+target_compile_definitions(DeviceNameResolver PRIVATE UNICODE _UNICODE)
+
+add_library(LLVMDemangle SHARED
+    "${_deps}/LLVMDemangle/LLVMDemangle.cpp"
+    "${_deps}/LLVMDemangle/llvm/lib/Demangle/DLangDemangle.cpp"
+    "${_deps}/LLVMDemangle/llvm/lib/Demangle/Demangle.cpp"
+    "${_deps}/LLVMDemangle/llvm/lib/Demangle/ItaniumDemangle.cpp"
+    "${_deps}/LLVMDemangle/llvm/lib/Demangle/MicrosoftDemangle.cpp"
+    "${_deps}/LLVMDemangle/llvm/lib/Demangle/MicrosoftDemangleNodes.cpp"
+    "${_deps}/LLVMDemangle/llvm/lib/Demangle/RustDemangle.cpp"
+)
+target_include_directories(LLVMDemangle PRIVATE "${_deps}/LLVMDemangle/include")
+target_compile_features(LLVMDemangle PRIVATE cxx_std_17)
+
+# 80-bit long double <-> string. MinGW's long double is the x87 type, which
+# is why upstream builds this one DLL with MinGW even for the MSVC release.
+add_library(ldconvert SHARED "${_deps}/ldconvert/ldconvert.cpp" "${_deps}/ldconvert/ldconvert.def")
+target_compile_features(ldconvert PRIVATE cxx_std_17)
+
+# asmjit.dll: XEDParseAssemble on top of asmjit/asmtk, loaded at run time
+set(_aj "${_deps}/asmjit_xedparse/asmjit")
+file(GLOB_RECURSE _asmjit_sources CONFIGURE_DEPENDS
+    "${_aj}/asmjit/src/asmjit/*.cpp"
+    "${_aj}/asmtk/src/asmtk/*.cpp"
+)
+add_library(asmjit SHARED "${_aj}/XEDParseEmulator.cpp" ${_asmjit_sources})
+target_include_directories(asmjit PRIVATE "${_aj}" "${_aj}/asmjit/src" "${_aj}/asmtk/src")
+target_compile_definitions(asmjit PRIVATE ASMJIT_STATIC ASMJIT_NO_JIT XEDPARSE_BUILD)
+target_compile_features(asmjit PRIVATE cxx_std_17)
+
+add_library(x64dbg_mingw_deps INTERFACE)
+target_link_libraries(x64dbg_mingw_deps INTERFACE
+    PkgConfig::JANSSON
+    lz4file
+    DeviceNameResolver
+    LLVMDemangle
+    "${XEDPARSE_LIBRARY}"
+    dbghelp
+    ntdll
+)
+
+# deps.cmake (windeployqt and the prebuilt DLLs) is MSVC only
+if(NOT TARGET deps)
+    add_custom_target(deps)
+endif()
