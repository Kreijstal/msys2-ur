_realname=mapbox-geometry
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.0.3
pkgrel=1
pkgdesc="Header-only C++ geometry types (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/mapbox/geometry.hpp'
msys2_repository_url='https://github.com/mapbox/geometry.hpp'
license=('spdx:ISC')
depends=("${MINGW_PACKAGE_PREFIX}-mapbox-variant")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/mapbox/geometry.hpp/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('9d750d34576069bcc4f39677af08cde2862fbe4b8c0d9af504877c2fae2ae273')

package() {
  cd geometry.hpp-${pkgver}
  mkdir -p "${pkgdir}${MINGW_PREFIX}/include"
  cp -r include/mapbox "${pkgdir}${MINGW_PREFIX}/include/"
  install -Dm644 LICENSE* -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
