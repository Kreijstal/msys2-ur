pkgbase = mingw-w64-retroarch
	pkgdesc = Reference frontend for the libretro API (mingw-w64)
	pkgver = 1.22.2
	pkgrel = 1
	url = https://www.libretro.com/
	install = retroarch-UCRT64.install
	arch = any
	groups = mingw-w64-ucrt-x86_64-libretro
	license = spdx:GPL-3.0-only
	makedepends = mingw-w64-ucrt-x86_64-cc
	makedepends = mingw-w64-ucrt-x86_64-pkgconf
	makedepends = mingw-w64-ucrt-x86_64-vulkan-headers
	makedepends = git
	depends = mingw-w64-ucrt-x86_64-cc-libs
	depends = mingw-w64-ucrt-x86_64-ffmpeg
	depends = mingw-w64-ucrt-x86_64-fontconfig
	depends = mingw-w64-ucrt-x86_64-freetype
	depends = mingw-w64-ucrt-x86_64-fribidi
	depends = mingw-w64-ucrt-x86_64-libass
	depends = mingw-w64-ucrt-x86_64-libusb
