	depends = mingw-w64-ucrt-x86_64-qt6-base
	optdepends = mingw-w64-ucrt-x86_64-retroarch-assets: menu UI assets (XMB, Ozone, GLUI, RGUI)
	optdepends = mingw-w64-ucrt-x86_64-libretro-core-info: core info files (required for the menu to list cores)
	optdepends = mingw-w64-ucrt-x86_64-libretro-database: content database / playlist scanning
	optdepends = mingw-w64-ucrt-x86_64-libretro-overlays: on-screen controller overlays
	optdepends = mingw-w64-ucrt-x86_64-libretro-shaders-slang: slang/SPIRV shaders for vulkan/d3d/glcore
	optdepends = mingw-w64-ucrt-x86_64-libretro-shaders-glsl: GLSL shaders for legacy GL drivers
	backup = ucrt64/bin/retroarch.cfg
