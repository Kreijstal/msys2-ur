# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=maven-file-management
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.2.0
pkgrel=1
pkgdesc="Apache Maven shared file-management API (file sets), built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://maven.apache.org/shared/file-management/'
msys2_repository_url='https://github.com/apache/maven-file-management'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-java-slf4j-api"
         "${MINGW_PACKAGE_PREFIX}-java-plexus-utils"
         "${MINGW_PACKAGE_PREFIX}-java-commons-io")
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-modello-plugin-xpp3")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/apache/maven-file-management/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('dbf57f6b5ce5f4fd66bbbd99a0ec0a33177afdf87815deacbe008433250c6e40')

_src=${_realname}-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  rm -rf "${srcdir}/generated"
  jb_modello src/main/mdo/fileset.mdo "${srcdir}/generated" 1.1.0 java
  jb_module org.apache.maven.shared:file-management:${pkgver} src/main/java -s "${srcdir}/generated" \
    -r src/main/resources -u pom.xml \
    -- org.slf4j:slf4j-api org.codehaus.plexus:plexus-utils commons-io:commons-io
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests need JUnit 5
  jb_loadcheck org.apache.maven.shared:file-management
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar maven-file-management org.apache.maven.shared:file-management
}
