# Maintainer: Kreijstal <rainb@tfwno.gf>

# JetBrains annotations (@NotNull, @Nullable, @Contract, ...), the Java 8
# artifact org.jetbrains:annotations: the common sources with the java8
# overlay.  CLASS-retention annotations, needed to compile JSVG.

_realname=jetbrains-annotations
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=23.0.0
pkgrel=1
pkgdesc="JetBrains Java annotations (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/JetBrains/java-annotations'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("java-annotations-${pkgver}.tar.gz::https://github.com/JetBrains/java-annotations/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('5ff6c157f6e5f52289fcf4e1793afaf79bad17269cfb425d2d5548fe07dd4ffc')

_src=java-annotations-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  # the java8 overlay replaces some of the common annotations
  local x f
  x=$(cd java8/src/main/java && find . -name '*.java' | sed 's|^\./||' | while read -r f; do
    printf '%s|' "common/src/main/java/${f//./\\.}"; done)
  local JB_RELEASE=8
  jb_module org.jetbrains:annotations:${pkgver} java8/src/main/java -s common/src/main/java -x "(${x%|})\$" \
    -m 'Automatic-Module-Name: org.jetbrains.annotations'
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck org.jetbrains:annotations
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --jar jetbrains-annotations org.jetbrains:annotations
  install -Dm644 "${_src}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-${_realname}/LICENSE.txt"
}
