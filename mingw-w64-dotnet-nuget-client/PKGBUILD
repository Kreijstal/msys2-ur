prepare() {
  /usr/bin/python3 "$srcdir/extract.py" "$srcdir/nuget-client-$_commit.tar.gz" "$srcdir/source"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/source" "$srcdir/prepared"
  cat > "$srcdir/NuGet.config" <<XML
<configuration><packageSources><clear/><add key="installed-source" value="$(cygpath -am /clang64/lib/dotnet/library-packs)"/></packageSources></configuration>
XML
}
build() {
  export DOTNET_ROOT=$(cygpath -am /clang64/lib/dotnet) DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
  export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_HOME=$(cygpath -am "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -am "$srcdir/empty-packages")
  export BUILD_SOURCEVERSION=$_commit
  /clang64/lib/dotnet/dotnet.exe build "$(cygpath -am "$srcdir/prepared/src/NuGet.Core/NuGet.Commands/NuGet.Commands.csproj")" -c Release \
    --configfile "$(cygpath -am "$srcdir/NuGet.config")" -p:DotNetBuildFromSource=true -p:TargetFrameworks=net8.0 -p:NETCoreTargetFramework=net8.0 \
    -p:IsXPlat=true -p:BuildRTM=true -p:BuildNumber=3 -p:RepositoryCommit=$_commit -p:SourceRevisionId=$_commit \
    -p:NewtonsoftJsonPackageVersion=13.0.4 -p:SystemSecurityCryptographyPkcsVersion=8.0.1 -p:DebugType=portable -p:GenerateDocumentationFile=true \
    -p:TreatWarningsAsErrors=false -p:MSBuildTreatWarningsAsErrors=false -p:UseSharedCompilation=false -v:minimal
  /usr/bin/python3 "$srcdir/verify-build.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/empty-packages"
  /usr/bin/python3 "$srcdir/pack.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/feed"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"; }
_package() {
  local name=$1 suffix=$2
  install -Dm644 "$srcdir/feed/$name.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/$name.$pkgver.nupkg"
  install -Dm644 "$srcdir/source/LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$suffix/LICENSE"
  install -m644 "$srcdir/source/build/NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$suffix/NOTICES.txt"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$suffix/README.md"
  /usr/bin/python3 - "$srcdir/prepared/verified-build.json" "$name" "$pkgdir$MINGW_PREFIX/share/doc/$suffix/source-inventory.json" <<'PYINNER'
from pathlib import Path
import json,sys
record=json.loads(Path(sys.argv[1]).read_text())
name=sys.argv[2]
record['projects']={name:record['projects'][name]}
record['original_compile_items']=len(record['projects'][name]['actual_original_compile_items'])
Path(sys.argv[3]).write_text(json.dumps(record,indent=2)+'\n')
PYINNER
}
package_mingw-w64-clang-x86_64-dotnet-nuget-frameworks() {
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
  _package NuGet.Frameworks dotnet-nuget-frameworks
}
