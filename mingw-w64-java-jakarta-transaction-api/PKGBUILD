# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-jakarta-transaction-api
pkgname=("${MINGW_PACKAGE_PREFIX}-java-jakarta-transaction-api")
pkgver=2.0.1
pkgrel=1
pkgdesc="jakarta-transaction-api Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://projects.eclipse.org/projects/ee4j.jta'
license=('spdx:EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-jakarta-enterprise-cdi-api"
             "${MINGW_PACKAGE_PREFIX}-java-jakarta-interceptor-api")
source=('https://repo.maven.apache.org/maven2/jakarta/transaction/jakarta.transaction-api/2.0.1/jakarta.transaction-api-2.0.1-sources.jar'
         'https://repo.maven.apache.org/maven2/jakarta/transaction/jakarta.transaction-api/2.0.1/jakarta.transaction-api-2.0.1.pom')
noextract=('jakarta.transaction-api-2.0.1-sources.jar'
         'jakarta.transaction-api-2.0.1.pom')
sha256sums=('fef60299cebc6f83d6ac0d7feb025ba23a0b85cc5908769869cd741f4e482614'
         '5fe349981c156fbbe26388d59949fdac16bb8d7879ee61b34c49c7b5ce0f2f23')
_artifacts=('jakarta.transaction:jakarta.transaction-api:2.0.1')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module jakarta.transaction:jakarta.transaction-api:2.0.1 upstream/jakarta.transaction-api \
    -r resources/jakarta.transaction-api -u jakarta.transaction-api-2.0.1.pom -- \
    jakarta.enterprise:jakarta.enterprise.cdi-api/provided jakarta.interceptor:jakarta.interceptor-api/provided
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with jakarta.enterprise:jakarta.enterprise.cdi-api --with jakarta.interceptor:jakarta.interceptor-api jakarta.transaction:jakarta.transaction-api
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-jakarta-transaction-api() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install jakarta.transaction:jakarta.transaction-api
  _license jakarta.transaction-api 2.0.1
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
