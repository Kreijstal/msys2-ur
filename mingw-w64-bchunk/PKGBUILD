# Contributor: Kreijstal <elektrischrainbow@gmail.com>

_realname=bchunk
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.3.0.r3.gc60fdf9
pkgrel=1
pkgdesc="CD image format converter from bin/cue to iso/cdr (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/Kreijstal/bchunk"
msys2_repository_url='https://github.com/Kreijstal/bchunk'
license=('spdx:GPL-2.0-or-later')
makedepends=("${MINGW_PACKAGE_PREFIX}-cc")
_commit='c60fdf9aba1e0413bdc046cdc711e04d4a91a438'
source=("${_realname}-${pkgver}.tar.gz::https://github.com/Kreijstal/bchunk/archive/${_commit}.tar.gz")
sha256sums=('68755430c1af09ed0770c0d5b1511e36299a21ba0fc6577e9ea2f91d49d31e30')

build() {
  cd "${srcdir}/${_realname}-${_commit}"
  make \
    CC="${CC}" \
    LD="${CC}" \
    CFLAGS="${CFLAGS}" \
    LDFLAGS="${LDFLAGS} -lws2_32"
}

package() {
  cd "${srcdir}/${_realname}-${_commit}"
  install -Dm755 bchunk.exe "${pkgdir}${MINGW_PREFIX}/bin/bchunk.exe"
  install -Dm644 bchunk.1 "${pkgdir}${MINGW_PREFIX}/share/man/man1/bchunk.1"
  install -Dm644 README "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README"
  install -Dm644 COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
