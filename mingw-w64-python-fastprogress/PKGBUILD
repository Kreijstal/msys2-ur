# 1.1 needs python-fasthtml (a web framework) for its notebook bars; 1.0.x
# has no dependencies and satisfies fastai (>=0.2.4)
_realname=fastprogress
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.0.5
pkgrel=1
pkgdesc="Simple and flexible progress bar for Jupyter Notebook and console (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://github.com/AnswerDotAI/fastprogress'
msys2_references=(
  'purl: pkg:pypi/fastprogress'
)
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-python")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
options=('!strip')
source=("https://pypi.org/packages/source/f/fastprogress/fastprogress-${pkgver}.tar.gz")
sha256sums=('58ca16a981f0292804d905f2e0042ad608d788bf6cbe6ab96b71ec4b20453aef')

prepare() {
  cd "fastprogress-${pkgver}"
  # a setuptools version assertion through pkg_resources, which setuptools
  # no longer ships
  sed -i '/pkg_resources/d;/^assert parse_version/d' setup.py
}

build() {
  cp -r "fastprogress-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages && ${MINGW_PREFIX}/bin/python -c "import fastprogress"
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
