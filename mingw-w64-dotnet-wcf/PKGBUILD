_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
}
prepare() {
  tar -xzf "$srcdir/wcf-$pkgver.tar.gz" -C "$srcdir"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/wcf-$_commit" "$srcdir/build"
}
build() {
  _env
  bash "$srcdir/build.sh" "$srcdir/build"
  bash "$srcdir/probe.sh" "$srcdir/build" "$srcdir/bootstrap-probe"
  bash "$srcdir/facades.sh" "$srcdir/build" "$srcdir/bootstrap-probe/bin/Release/net8.0"
  /usr/bin/python3 - "$MINGW_PREFIX/lib/dotnet/library-packs/system.servicemodel.syndication.8.0.0.nupkg" "$srcdir/System.ServiceModel.Syndication.dll" <<'PYTHON'
import sys,zipfile
from pathlib import Path
with zipfile.ZipFile(sys.argv[1]) as archive:
    Path(sys.argv[2]).write_bytes(archive.read('lib/net8.0/System.ServiceModel.Syndication.dll'))
PYTHON
  /usr/bin/python3 "$srcdir/prepare-legacy.py" "$srcdir/build" "$srcdir/System.ServiceModel.Syndication.dll"
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" build "$(cygpath -m "$srcdir/build/legacy/build.csproj")" -c Release     --configfile "$(cygpath -m "$srcdir/build/NuGet.config")" -p:UseSharedCompilation=false -v:minimal
  bash "$srcdir/pack.sh" "$srcdir/build" "$srcdir/feed"
}
check() {
  _env
  bash "$srcdir/check-installed.sh" "$srcdir/consumer" "$srcdir/build/localization.json" "$srcdir/feed"
  bash "$srcdir/check-api.sh" "$srcdir/build" "$srcdir/consumer/bin/Release/net8.0"
  bash "$srcdir/check-legacy.sh" "$srcdir/build"
}
_install() {
  local suffix=$1 id=$2
  install -Dm644 "$srcdir/feed/$id.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${id,,}.$pkgver.nupkg"
  install -Dm644 "$srcdir/wcf-$_commit/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/LICENSE"
  install -Dm644 "$srcdir/wcf-$_commit/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/THIRD-PARTY-NOTICES"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/README.md"
  for file in removed-binaries.json localization.json packages/manifest.json; do
    install -Dm644 "$srcdir/build/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/$(basename "$file")"
  done
  install -m644 "$srcdir/upstream-api-mismatches.json" "$srcdir/legacy-forwards.json" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/"
}

package_mingw-w64-clang-x86_64-dotnet-private-servicemodel() {
  pkgdesc='Source-built System.Private.ServiceModel 4.10.3 for .NET 8'
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-objectpool>=8.0.31" "${MINGW_PACKAGE_PREFIX}-dotnet-cryptography-xml>=8.0.31")
  _install private-servicemodel System.Private.ServiceModel
}

