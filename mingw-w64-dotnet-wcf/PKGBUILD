pkgrel=1
pkgdesc='Source-built WCF client libraries for the .NET 8 offline feed'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/wcf'
license=('spdx:MIT')
_commit=6c05fa33450ee3960f0763948e91327f049b302b
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131"
             "${MINGW_PACKAGE_PREFIX}-dotnet-objectpool>=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-dotnet-cryptography-xml>=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-dotnet-syndication8>=8.0.31" 'python')
options=('!strip' '!lto')
source=("wcf-$pkgver.tar.gz::https://codeload.github.com/dotnet/wcf/tar.gz/$_commit"
        prepare.py build.sh Microsoft.pubkey.hex Probe.cs probe.sh CheckAssets.cs TransportProbe.cs SecurityProbe.cs
        GenerateFacades.cs facades.sh prepare-facades.py prepare-legacy.py legacy-forwards.json
        CheckLegacyMetadata.cs check-legacy.sh prepare-packages.py pack.sh
        CheckApi.cs check-api.sh upstream-api-mismatches.json check-installed.sh README.md)
noextract=("wcf-$pkgver.tar.gz")
