# Maintainer (msys2-ur): Kreijstal

_realname=jax
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.11.2
pkgrel=1
pkgdesc="Differentiate, compile, and transform Numpy code (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/jax-ml/jax'
msys2_repository_url='https://github.com/jax-ml/jax'
msys2_references=(
  'purl: pkg:pypi/jax'
)
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-jaxlib>=${pkgver}"
         "${MINGW_PACKAGE_PREFIX}-python-ml_dtypes"
         "${MINGW_PACKAGE_PREFIX}-python-numpy"
         "${MINGW_PACKAGE_PREFIX}-python-opt_einsum"
         "${MINGW_PACKAGE_PREFIX}-python-scipy")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-python-wheel")
source=("jax-${pkgver}.tar.gz::https://github.com/jax-ml/jax/archive/refs/tags/jax-v${pkgver}.tar.gz")
sha256sums=('12dd77d86ec5a316be6038c9a597a1479bce13c828722a249b022e774b2eff75')

build() {
  cp -r "jax-jax-v${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  # Release version (otherwise the version gets a .devDATE+git suffix).
  JAX_RELEASE=1 ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import jax, jax.numpy as jnp
assert jax.__version__ == "0.11.2", jax.__version__
print(jax.devices())
x = jnp.linspace(0.0, 1.0, 8)
assert jnp.allclose(jax.jit(jax.grad(lambda v: jnp.sum(v ** 3)))(x), 3 * x ** 2)
print("jax ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
