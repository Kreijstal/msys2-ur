 0003-pass-complete-spns-to-windows-sspi.patch
 0004-accept-short-custom-named-pipe-paths.patch
 0005-honor-inclusive-smp-send-window.patch
 0006-stop-after-localdb-lookup-failure.patch
 0007-honor-localdb-start-results-and-buffer-sizes.patch
 0008-load-localdb-messages-through-managed-sni.patch
 0009-format-localdb-errors-for-managed-sni.patch
 0010-validate-sql-browser-port-responses.patch
 BrowserChecks.cs
 check-browser.sh
 LocalDbChecks.cs
 localdb-driver.c
 check-localdb.sh
 README.md
)
noextract=("maintenance-packages-$_commit.tar.gz")
