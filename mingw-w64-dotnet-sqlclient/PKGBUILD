pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.9.1
pkgrel=3
_commit=84b081710c66cc560b77d4de38cee493c3a38e9d
pkgdesc='Experimental complete Windows SqlClient source port with managed SNI; full native compatibility unverified'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/maintenance-packages'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131-2" 'python' 'patch')
checkdepends=("${MINGW_PACKAGE_PREFIX}-clang" "${MINGW_PACKAGE_PREFIX}-powershell-module-test-host>=7.4.20-3")
options=('!strip' '!lto')
source=("maintenance-packages-$_commit.tar.gz::https://codeload.github.com/dotnet/maintenance-packages/tar.gz/$_commit"
