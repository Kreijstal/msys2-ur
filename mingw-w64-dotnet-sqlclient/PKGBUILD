 0002-tds-test-peer-return-partial-handshake-reads.patch
 0003-pass-complete-spns-to-windows-sspi.patch
 0004-accept-short-custom-named-pipe-paths.patch
 0005-honor-inclusive-smp-send-window.patch
 README.md
)
noextract=("maintenance-packages-$_commit.tar.gz")
