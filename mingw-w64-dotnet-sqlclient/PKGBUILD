prepare() {
 /usr/bin/python3 "$srcdir/extract.py" "$srcdir/maintenance-packages-$_commit.tar.gz" "$srcdir/source"
 /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/source" "$srcdir/prepared" --managed-sni
}
build() {
 bash "$srcdir/build.sh" "$srcdir/prepared"
 /usr/bin/python3 "$srcdir/audit-source-sni.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/maintenance-packages-$_commit.tar.gz"
 /usr/bin/python3 "$srcdir/pack.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/feed"
}
check() {
 bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/source" "$srcdir/feed"
 /usr/bin/python3 "$srcdir/audit-source-sni.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/check/protocol" "$srcdir/maintenance-packages-$_commit.tar.gz"
}
package() {
 install -Dm644 "$srcdir/feed/system.data.sqlclient.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/system.data.sqlclient.$pkgver.nupkg"
 install -Dm644 "$srcdir/source/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
 install -m644 "$srcdir/prepared/source-inventory.json" "$srcdir/prepared/source-sni-audit.json" "$srcdir/prepared/managed-sni-port.json" "$srcdir/check/protocol/tds-source-inventory.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
}
