_system_gen_dir = get_label_info(":system_v8_runtime", "target_gen_dir")
_system_expected_path = "$_system_gen_dir/system-v8-expected.json"
write_file(_system_expected_path, _system_expected, "json")
_system_verify_args = [
  "--expected",
  rebase_path(_system_expected_path, root_build_dir),
  "--pkg-config",
  system_v8_pkg_config,
]
if (system_v8_manifest != "") {
  _system_verify_args += [
    "--manifest",
    system_v8_manifest,
  ]
}
_system_probe =
    exec_script("system_v8/verify_sdk.py", _system_verify_args, "json")

# Depend on the manifest as well as the verifier, so package changes rerun GN.
_system_sdk = exec_script("system_v8/verify_sdk.py",
                          _system_verify_args,
                          "json",
                          _system_probe.inputs)

_sdk_root = _system_sdk.sdk
_system_libraries = _system_sdk.libraries
_system_tools = _system_sdk.tools

config("system_v8_private_headers") {
  defines = _system_sdk.private_defines
}

config("system_v8_headers") {
  include_dirs = [
    _system_sdk.sdk,
    "${_sdk_root}/v8",
    "${_sdk_root}/v8/include",
    "${_sdk_root}/gen",
    "${_sdk_root}/gen/v8",
    "${_sdk_root}/gen/v8/include",
    "${_sdk_root}/v8/third_party/abseil-cpp",
  ]
  defines = _system_sdk.defines
}

# Chromium and the engine must use one tracing muxer. Keeping Chromium's
# static client beside this DLL would split registration and tracing sessions.
config("system_v8_perfetto_link") {
  libs = [ _system_libraries.v8_libperfetto ]
}
group("system_v8_perfetto") {
  public_configs = [ ":system_v8_perfetto_link" ]
  public_deps = [ ":system_v8_runtime" ]
}

foreach(_name,
        [
          "v8",
          "v8_libbase",
          "v8_libplatform",
        ]) {
  config("system_${_name}_link") {
    if (_name == "v8") {
      libs = [ _system_libraries.v8 ]
    } else if (_name == "v8_libbase") {
      libs = [ _system_libraries.v8_libbase ]
    } else {
      libs = [ _system_libraries.v8_libplatform ]
    }
  }
}

group("v8") {
  public_configs = [
    ":system_v8_headers",
    ":system_v8_link",
  ]
  public_deps = [
    ":system_v8_runtime",
    ":v8_libbase",
    ":v8_libplatform",
  ]
}
group("v8_libbase") {
  public_configs = [
    ":system_v8_headers",
    ":system_v8_libbase_link",
  ]
}
group("v8_libplatform") {
  public_configs = [
    ":system_v8_headers",
    ":system_v8_libplatform_link",
  ]
  public_deps = [ ":v8_libbase" ]
}

# These implementations are exported by the same V8 DLL, including heap-base
# globals. Do not compile another copy of their source sets in the consumer.
foreach(_name,
        [
          "cppgc",
          "cppgc_base",
          "v8_heap_base",
          "v8_snapshot",
        ]) {
  group(_name) {
    public_deps = [ ":v8" ]
  }
}
foreach(_name,
        [
          "v8_headers",
          "cppgc_headers",
          "v8_config_headers",
          "v8_internal_headers",
          "v8_shared_internal_headers",
          "v8_heap_base_headers",
          "v8_version",
        ]) {
  group(_name) {
    public_configs = [
      ":system_v8_headers",
      ":system_v8_private_headers",
    ]
  }
}

# Copy real installed generators; consumer-specific snapshots still run in the
# consumer graph. Generator outputs have the same locations as bundled V8.
foreach(_name,
        [
          "d8",
          "mksnapshot",
          "torque",
          "torque-language-server",
        ]) {
  copy(_name) {
    if (_name == "d8") {
      sources = [ _system_tools.d8 ]
    } else if (_name == "mksnapshot") {
      sources = [ _system_tools.mksnapshot ]
    } else if (_name == "torque") {
      sources = [ _system_tools.torque ]
    } else {
      sources = [ _system_tools.torque_language_server ]
    }
    outputs = [ "$root_out_dir/${_name}.exe" ]
    deps = [ ":system_v8_runtime" ]
  }
}
copy("system_v8_runtime") {
  sources = _system_sdk.runtime_dlls
  outputs = [ "$root_out_dir/{{source_file_part}}" ]
}
group("v8_shell") {
  public_deps = [ ":d8" ]
}
group("v8_for_testing") {
  testonly = true
  public_deps = [ ":v8" ]
}

# This profile embeds its default startup snapshot in the DLL. Chromium's gin
# context snapshot is separate and continues to use its own generator target.
assert(!v8_use_external_startup_data,
       "This installed SDK embeds startup data; use a matching SDK profile.")
copy("run_mksnapshot_default") {
  sources = [ _system_sdk.startup_blob ]
  outputs = [ "$root_out_dir/snapshot_blob.bin" ]
}
group("gn_all") {
  testonly = true
  public_deps = [
    ":cppgc",
    ":d8",
    ":v8",
  ]
}
