pkgbase=mingw-w64-dotnet-windows-compatibility-libraries
pkgname=(
  "${MINGW_PACKAGE_PREFIX}-dotnet-codedom"
  "${MINGW_PACKAGE_PREFIX}-dotnet-reflection-context"
  "${MINGW_PACKAGE_PREFIX}-dotnet-composition"
  "${MINGW_PACKAGE_PREFIX}-dotnet-composition-registration"
  "${MINGW_PACKAGE_PREFIX}-dotnet-odbc"
  "${MINGW_PACKAGE_PREFIX}-dotnet-oledb"
  "${MINGW_PACKAGE_PREFIX}-dotnet-directoryservices-accountmanagement"
  "${MINGW_PACKAGE_PREFIX}-dotnet-io-ports"
  "${MINGW_PACKAGE_PREFIX}-dotnet-speech"
)
pkgver=8.0.31
pkgrel=1
pkgdesc='Source-built remaining Windows compatibility libraries for .NET 8'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131"
             "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2"
             "${MINGW_PACKAGE_PREFIX}-dotnet-configuration-manager>=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-dotnet-performancecounter>=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-dotnet-directoryservices>=8.0.31"
             "${MINGW_PACKAGE_PREFIX}-dotnet-directoryservices-protocols>=8.0.31" 'python')
options=('!strip' '!lto')
source=("runtime-v$pkgver.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v$pkgver"
        prepare.py libraries.json Open.pubkey.hex ECMA.pubkey.hex MicrosoftShared.pubkey.hex
        build.sh check.cs CheckResources.cs check.sh check-api.cs check-api.sh README.md)
noextract=("runtime-v$pkgver.tar.gz")
sha256sums=('b32a56a29cc0248bed219e1c7ef026bf8f006d997f5d6346382e63a22ecd9070'
            'bcc059f4ac0d09a362d08f929c861fc79fa2fc1f4b768647701d44eb881d03f0'
            '7c9d281111887567d4ff8826dba9e6504a5dd4ad847bbc5305bec822d5da1e89'
            '68908864c4084a0713b7201ff84082db6c158afcbf9cafef0f4a83204759afa5'
            '6c11546f600ca15ea07e0c461b5a9b4d56f00d553e312e3050faae1f54f0a53d'
            '8411f29cc43951595bacd05a9ba7c73628bb7d77b508fa3486916ade5fd0e0ed'
            'c337485463ea88786b23016703192b455cbd720e9ad3c38bd1184cdc21838acd'
            '2dbaab69172e9e85a509b4f736a2a9e760531775e25ead79462c2063a107673d'
            'fed65a6a80487079726efc093fd3ab342a4c430828cad2c60e8773a1a748a7e0'
            'dac38e270e141a01c6f49bf4a8269d69ed8ab785b6b0e2515ba7a97ead18a797'
            'f2f865f6b1a6e567c7f2b87fba1fa2d4b52e4e3d9d54877e09f40c9857b26b52'
            '18fa3eb6195d768a93788cd3a1a02fa95a488474c0ba5dd3a021a9c26373433f'
            '09c7d0214e6976ff8ec70233cfde4611c581bcd73f0c0c639d21c0ca657a1bbf')
prepare() {
  local inputs=("runtime-$pkgver/LICENSE.TXT" "runtime-$pkgver/THIRD-PARTY-NOTICES.TXT"
                "runtime-$pkgver/src/libraries/Common/src" "runtime-$pkgver/src/libraries/System.Private.CoreLib/src")
  while read -r id; do inputs+=("runtime-$pkgver/src/libraries/$id"); done < <(/usr/bin/python3 -c 'import json,sys;[print(x["id"]) for x in json.load(open(sys.argv[1]))]' "$srcdir/libraries.json")
  tar -xzf "$srcdir/runtime-v$pkgver.tar.gz" -C "$srcdir" "${inputs[@]}"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/runtime-$pkgver" "$srcdir/prepared"
}
build() {
  bash "$srcdir/build.sh" "$srcdir/prepared"
}
check() {
  bash "$srcdir/check.sh" "$srcdir/consumer" "$srcdir/prepared/localization.json" "$srcdir/feed"
  bash "$srcdir/check-api.sh" "$srcdir/prepared" "$srcdir/consumer" "$srcdir/api-check"
}
_install() {
  local suffix=$1 id=$2 version=$3
  install -Dm644 "$srcdir/feed/$id.$version.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${id,,}.$version.nupkg"
  install -Dm644 "$srcdir/runtime-$pkgver/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/LICENSE"
  install -Dm644 "$srcdir/runtime-$pkgver/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/THIRD-PARTY-NOTICES"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/README.md"
  install -m644 "$srcdir/prepared/removed-binaries.json" "$srcdir/prepared/localization.json" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/"
}

package_mingw-w64-clang-x86_64-dotnet-codedom() {
  pkgdesc='Source-built System.CodeDom 8.0.0 from .NET 8.0.31 sources'
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
  _install codedom System.CodeDom 8.0.0
}

