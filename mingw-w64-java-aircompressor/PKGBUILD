# Maintainer: Kreijstal <rainb@tfwno.gf>

# Pure Java LZ4, LZO, Snappy and Zstandard.  The Hadoop codec adapters
# (Hadoop is a provided dependency upstream, not packaged) are left out.

_realname=aircompressor
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=0.27
pkgrel=1
pkgdesc="Aircompressor: pure Java compression algorithms, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/airlift/aircompressor'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/airlift/aircompressor/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('255a8845ef6d9f2b33f9f0901a6657ab3a6bd7e3fa8818a624e534b9663320a2')

_src=${_realname}-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  # sun.misc.Unsafe is not in JDK 28's --release 8 data: compile with
  # -source/-target 8 against the running JDK, as upstream (airbase) does;
  # leave out the Hadoop CompressionCodec adapters and what uses them
  JB_TARGET=8 jb_module io.airlift:aircompressor:${pkgver} src/main/java -u pom.xml \
    -x "$(_jb_users src/main/java '^import (static )?org\.apache\.hadoop')"
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests need TestNG, Hadoop and the native codecs; round-trip
  # data through each codec instead
  jb_loadcheck io.airlift:aircompressor
  local t="${srcdir}/smoke" cp
  mkdir -p "${t}"
  cat > "${t}/Smoke.java" <<'JAVA'
import io.airlift.compress.*;
import java.util.Arrays;
public class Smoke {
  public static void main(String[] a) {
    byte[] data = new byte[65536];
    for (int i = 0; i < data.length; i++) data[i] = (byte) (i % 13);
    Object[][] codecs = {
      {new io.airlift.compress.lz4.Lz4Compressor(), new io.airlift.compress.lz4.Lz4Decompressor()},
      {new io.airlift.compress.snappy.SnappyCompressor(), new io.airlift.compress.snappy.SnappyDecompressor()},
      {new io.airlift.compress.zstd.ZstdCompressor(), new io.airlift.compress.zstd.ZstdDecompressor()},
      {new io.airlift.compress.lzo.LzoCompressor(), new io.airlift.compress.lzo.LzoDecompressor()}};
    for (Object[] c : codecs) {
      Compressor co = (Compressor) c[0];
      Decompressor de = (Decompressor) c[1];
      byte[] out = new byte[co.maxCompressedLength(data.length)];
      int n = co.compress(data, 0, data.length, out, 0, out.length);
      byte[] back = new byte[data.length];
      int m = de.decompress(out, 0, n, back, 0, back.length);
      if (m != data.length || !Arrays.equals(data, back)) throw new AssertionError(co);
      System.out.println("aircompressor " + co.getClass().getSimpleName() + ": " + data.length + " -> " + n);
    }
  }
}
JAVA
  cp=$(jb_cp io.airlift:aircompressor)
  javac -nowarn -d "$(jb_w "${t}")" -cp "${cp}" "$(jb_w "${t}/Smoke.java")"
  java -cp "$(jb_w "${t}");${cp}" Smoke
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install io.airlift:aircompressor
  install -Dm644 "${_src}/license.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-${_realname}/license.txt"
}
