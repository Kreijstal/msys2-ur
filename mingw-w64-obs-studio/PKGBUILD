source=("${_realname}-${pkgver}.tar.gz::${msys2_repository_url}/archive/refs/tags/${pkgver}.tar.gz"
        "libdshowcapture-${_dshow_commit}.tar.gz::https://github.com/obsproject/libdshowcapture/archive/${_dshow_commit}.tar.gz"
        "capture-device-support-${_cds_commit}.tar.gz::https://github.com/elgatosf/capture-device-support/archive/${_cds_commit}.tar.gz"
