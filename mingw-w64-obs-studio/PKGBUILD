        0001-build-with-mingw-w64.patch
        0002-libdshowcapture-mingw-w64.patch
        0003-capture-device-support-mingw-w64.patch)
sha256sums=('9174ee0e3677c92d0d060bdce4c5d44dfee9fd3afddfb6333f098fd029b8de2b'
