prepare() {
  cd ${_realname}-${pkgver}
  rmdir deps/libdshowcapture/src
  mv ../libdshowcapture-${_dshow_commit} deps/libdshowcapture/src
  rmdir deps/libdshowcapture/src/external/capture-device-support
  mv ../capture-device-support-${_cds_commit} deps/libdshowcapture/src/external/capture-device-support
  # submodules the build requires even when these plugins are off
  rmdir plugins/obs-browser plugins/obs-websocket
  mv ../obs-browser-${_browser_commit} plugins/obs-browser
  mv ../obs-websocket-${_websocket_commit} plugins/obs-websocket
  patch -Np1 -i ../0001-build-with-mingw-w64.patch
  patch -d deps/libdshowcapture/src -Np1 -i "${srcdir}"/0002-libdshowcapture-mingw-w64.patch
  patch -d deps/libdshowcapture/src/external/capture-device-support -Np1 -i "${srcdir}"/0003-capture-device-support-mingw-w64.patch
}

build() {
  # upstream's Windows tree (bin/64bit, core, data) resolves everything relative to obs64.exe
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -G Ninja -S ${_realname}-${pkgver} -B build-${MSYSTEM} \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}/lib/${_realname}" \
      -DOBS_VERSION_OVERRIDE=${pkgver} \
      -DCMAKE_COMPILE_WARNING_AS_ERROR=OFF \
      -DHAS_INTERPROCEDURAL_OPTIMIZATION=OFF \
      -DENABLE_BROWSER=OFF \
      -DENABLE_WEBRTC=OFF \
      -DENABLE_WEBSOCKET=OFF \
      -DENABLE_AJA=OFF \
      -DENABLE_DECKLINK=OFF \
      -DENABLE_QSV11=OFF \
      -DENABLE_NVENC=OFF \
      -DENABLE_NVAFX=OFF \
      -DENABLE_NVVFX=OFF \
      -DENABLE_COREAUDIO_ENCODER=OFF \
      -DENABLE_VIRTUALCAM=OFF \
      -DENABLE_SCRIPTING_PYTHON=OFF \
      -DENABLE_WHATSNEW=OFF \
      -DENABLE_SERVICE_UPDATES=OFF \
      -DENABLE_COMPAT_UPDATES=OFF \
      -DENABLE_LIBFDK=OFF
  cmake --build build-${MSYSTEM}
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}
  # obs64.exe needs the prefix DLLs on PATH and its own directory as cwd
  mkdir -p "${pkgdir}${MINGW_PREFIX}/bin"
  printf '@set "PATH=%%~dp0;%%PATH%%"\r\n@set "OBSDIR=%%~dp0..\\lib\\%s\\bin\\64bit"\r\n@start "" /D "%%OBSDIR%%" "%%OBSDIR%%\\obs64.exe" %%*\r\n' \
    ${_realname} > "${pkgdir}${MINGW_PREFIX}/bin/obs64.cmd"
  install -Dm644 ${_realname}-${pkgver}/COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
