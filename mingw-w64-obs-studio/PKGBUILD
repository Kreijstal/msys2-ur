_realname=obs-studio
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=33.0.1
pkgrel=1
_dshow_commit=8878638324393815512f802640b0d5ce940161f1
_cds_commit=fe9630974d47f51bf54826e72fb8b654e620aa93
_browser_commit=d4db73e7e5d5b51d853177c8cddc796715a8ac84
_websocket_commit=e28f84975984340e84fc4879cfc05741cc0afde1
pkgdesc="Software for video recording and live streaming (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
