diff --git a/deps/detours-minhook/detours.h b/deps/detours-minhook/detours.h
new file mode 100644
index 0000000..b95bcfd
--- /dev/null
+++ b/deps/detours-minhook/detours.h
@@ -0,0 +1,51 @@
+/* The Detours calls OBS uses, implemented with MinHook for MinGW builds */
+#pragma once
+
+#include <windows.h>
+#include <MinHook.h>
+
+static PVOID detour_shim_targets[32];
+static int detour_shim_count;
+
+static inline LONG DetourTransactionBegin(void)
+{
+	MH_STATUS s = MH_Initialize();
+	detour_shim_count = 0;
+	return s == MH_OK || s == MH_ERROR_ALREADY_INITIALIZED ? NO_ERROR : ERROR_INVALID_OPERATION;
+}
+
+/* *ppPointer becomes the trampoline right away; it runs the original code */
+static inline LONG DetourAttach(PVOID *ppPointer, PVOID pDetour)
+{
+	PVOID target = *ppPointer, tramp;
+	if (detour_shim_count == 32 || MH_CreateHook(target, pDetour, &tramp) != MH_OK)
+		return ERROR_INVALID_PARAMETER;
+	if (MH_QueueEnableHook(target) != MH_OK) {
+		MH_RemoveHook(target);
+		return ERROR_INVALID_PARAMETER;
+	}
+	detour_shim_targets[detour_shim_count++] = target;
+	*ppPointer = tramp;
+	return NO_ERROR;
+}
+
+#ifdef __cplusplus
+/* MSVC converts function pointers to PVOID implicitly; GCC needs the cast */
+template<typename T> static inline LONG DetourAttach(PVOID *ppPointer, T *pDetour)
+{
+	return DetourAttach(ppPointer, reinterpret_cast<PVOID>(pDetour));
+}
+#endif
+
+static inline LONG DetourTransactionCommit(void)
+{
+	return MH_ApplyQueued() == MH_OK ? NO_ERROR : ERROR_INVALID_OPERATION;
+}
+
+static inline LONG DetourTransactionAbort(void)
+{
+	for (int i = 0; i < detour_shim_count; i++)
+		MH_RemoveHook(detour_shim_targets[i]);
+	detour_shim_count = 0;
+	return NO_ERROR;
+}
