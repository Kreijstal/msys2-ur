_realname=dotnet-security-accesscontrol6
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=6.0.1
pkgrel=1
_sourcever=189fbbd88d97dd6d65515ba2da05b62eab4e5039
pkgdesc='Full source-built System.Security.AccessControl 6.0.1 Windows port for .NET 8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("runtime-${_sourcever}.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/${_sourcever}"
        prepare.py libraries.json Microsoft.pubkey.hex Fixture.cs Runner.cs check.sh check-api.cs check-api.sh README.md)
noextract=("runtime-${_sourcever}.tar.gz")
sha256sums=('edc08a6ea7adb9d231fb4e9f8279d99f3cec37a4bf5f254f038cdf9d5669525e'
            '2b5707ed6385001a8a5cb8d11a3695870163c7c028ad8048b4ee35d48c09b88a'
            '67f1bed39a4c0fce540473dcfc4cd62672fd0a53033f3f4829b865c298068433'
            'f590f89e2667ca399aa6e436a8c8d3855bbcec19228980320920bad70e5bfd3f'
            'acff1c19e98c71b65e74ae8c6b6049fb90633f47bae3a6ebe36341f7f473bb32'
            'b978c4392b4c2eb64016949907432e32b49795cd5f9664d7da449b0275d71a68'
            '4cd02d2a86946366e8d03f58ddcd00ea2f8a0fcb99481a207dfd5a5d9d6b4b02'
            'f2f865f6b1a6e567c7f2b87fba1fa2d4b52e4e3d9d54877e09f40c9857b26b52'
            '2d5694a524bf4499bafdfb6a7a5057221fda34cfe7e7b7e609c3b90b189e9266'
