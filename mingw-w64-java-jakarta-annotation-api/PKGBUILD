# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=jakarta-annotation-api
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=3.0.0
pkgrel=1
pkgdesc="Jakarta Annotations API (jakarta.annotation), OSGi bundle (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/jakartaee/common-annotations-api'
license=('spdx:EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("common-annotations-api-${pkgver}.tar.gz::https://github.com/jakartaee/common-annotations-api/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('d076d0b1990fc63fc7ad09cdad7cde8cd0c3b0c217c029f322b9af7527c2e06b')

_src=common-annotations-api-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}/api"
  cat > "${srcdir}/annotation.bnd" <<EOF
Bundle-SymbolicName: jakarta.annotation-api
Bundle-Version: ${pkgver}
Bundle-Name: Jakarta Annotations API
Bundle-Description: Jakarta Annotations API
Bundle-Vendor: Eclipse Foundation
Bundle-DocURL: https://www.eclipse.org
Bundle-License: https://www.eclipse.org/legal/epl-2.0, https://www.gnu.org/software/classpath/license.html
Extension-Name: jakarta.annotation
Implementation-Vendor: Eclipse Foundation
Implementation-Vendor-Id: org.glassfish
Implementation-Version: ${pkgver}
Specification-Vendor: Eclipse Foundation
Specification-Version: 3.0
Export-Package: jakarta.annotation.*;version=${pkgver}
EOF
  rm -rf "${srcdir}/res" && mkdir -p "${srcdir}/res/META-INF"
  cp ../LICENSE.md ../NOTICE.md "${srcdir}/res/META-INF/"
  # Java 11 with module-info, as upstream
  local JB_RELEASE=11 JB_MODULE_INFO=1
  jb_module jakarta.annotation:jakarta.annotation-api:${pkgver} src/main/java -r "${srcdir}/res" -u pom.xml \
    -b "${srcdir}/annotation.bnd"
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck jakarta.annotation:jakarta.annotation-api
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install --plugin jakarta.annotation:jakarta.annotation-api
  install -Dm644 "${_src}/LICENSE.md" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-${_realname}/LICENSE.md"
}
