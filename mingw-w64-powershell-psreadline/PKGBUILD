prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/PSReadLine-$pkgver" "$srcdir/prepared"; }
build() {
  bash "$srcdir/build.sh" "$srcdir/prepared"
  /usr/bin/python3 "$srcdir/pack.py" "$srcdir/prepared" "$srcdir/feed"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/PSReadLine-$pkgver" "$srcdir/feed"; }
package() {
  install -Dm644 "$srcdir/feed/psreadline.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/psreadline.$pkgver.nupkg"
  local module="$pkgdir$MINGW_PREFIX/lib/powershell/Modules/PSReadLine/$pkgver"
  mkdir -p "$module"
  cp -R "$srcdir/prepared/module/." "$module/"
  install -Dm644 "$srcdir/prepared/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/License.txt"
  install -Dm644 /clang64/share/licenses/dotnet-powershell-pager/LICENSE "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Pager-LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -m644 "$srcdir/prepared/source-build.json" "$srcdir/published-provenance.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
}
