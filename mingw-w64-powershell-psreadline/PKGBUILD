# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=powershell-psreadline
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.3.6
pkgrel=1
pkgdesc='Complete source PSReadLine Core module and NuGet PSModule package for .NET8'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/PowerShell/PSReadLine'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-powershell-pager>=1.0.0")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131-2"
             "${MINGW_PACKAGE_PREFIX}-powershell-module-test-host>=7.4.20-2" 'python')
options=('!strip' '!lto')
source=("psreadline-$pkgver.tar.gz::https://codeload.github.com/PowerShell/PSReadLine/tar.gz/refs/tags/v$pkgver"
        prepare.py
        build.sh
        pack.py
        check.sh
        inspect.sh
        InspectApi.cs
        InspectIdentity.cs
        verify-restored.py
        check-editing.sh
        EditingCheck.cs
        RunEditing.ps1
        Smoke.ps1
        published-provenance.json
        README.md
)
