_realname=dotnet-winrt-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.1.1
pkgrel=1
pkgdesc='Source-built WinRT metadata, C#/WinRT tools and .NET 8 bindings for Greenshot'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/microsoft/CsWinRT'
license=('spdx:MIT' 'spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-libc++")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-clang" "${MINGW_PACKAGE_PREFIX}-rust" 'python' 'patch')
options=('!strip' '!lto')
_rs=c809589311cd6470e882db9ab98f3547a1274da1
_cs=d4649f92300aa3cb2dfd23a66074199488d85973
_wm=cf26c01298ff7ef704ca2824aa24a2b32f30a2ed
source=("windows-rs-$_rs.tar.gz::https://codeload.github.com/microsoft/windows-rs/tar.gz/$_rs"
        "cswinrt-$_cs.tar.gz::https://codeload.github.com/microsoft/CsWinRT/tar.gz/$_cs"
        "winmd-$_wm.tar.gz::https://codeload.github.com/microsoft/winmd/tar.gz/$_wm"
        'https://static.crates.io/crates/proc-macro2/proc-macro2-1.0.107.crate'
        'https://static.crates.io/crates/quote/quote-1.0.47.crate'
        'https://static.crates.io/crates/syn/syn-2.0.119.crate'
        'https://static.crates.io/crates/unicode-ident/unicode-ident-1.0.27.crate'
        0001-winrt-metadata.patch 0002-mingw-generator.patch prepare.py additions.py metadata-main.rs Cargo.lock check.cs README.md)
noextract=('proc-macro2-1.0.107.crate' 'quote-1.0.47.crate' 'syn-2.0.119.crate' 'unicode-ident-1.0.27.crate')
sha256sums=('fd0bfa531c719de5121eb7b174bc7830acef905115cbe23561362ee5cabdce06'
            'a6585ccbcc8dea8b8759a9dee1edacc8720203b99962f910949fad6a7ae00215'
            '9786fbe176f855f976ac25da3cd97d6f525cf2cd108a45ca274371c34f7f9197'
