_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet") DOTNET_ROOT_X64=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  patch -d "$srcdir/windows-rs-$_rs" -Np1 -i "$srcdir/0001-winrt-metadata.patch"
  patch -d "$srcdir/CsWinRT-$_cs" -Np1 -i "$srcdir/0002-mingw-generator.patch"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir"
}
build() {
  _env
  cd "$srcdir/build/metadata"
  cargo run --release --frozen
  cd "$srcdir/build/cswinrt"
  clang++ -std=c++17 -O2 -DNOMINMAX -DVERSION_STRING='"2.3.2-msys2.20261015"' -Igenerator -Iwinmd \
    generator/main.cpp -o cswinrt.exe -lshlwapi -ladvapi32 -lxmllite -lole32 -luuid
  ./cswinrt.exe -input ../metadata/Windows.winmd -output projection @../metadata/projection-types.rsp -verbose
  /usr/bin/python3 "$srcdir/additions.py" .
  cat > projection/projection.csproj <<'PROJECT'
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net8.0</TargetFramework><AssemblyName>Microsoft.Windows.SDK.NET</AssemblyName><PackageId>Msys2.Windows.WinRT</PackageId><Version>0.1.1</Version><PackageLicenseExpression>MIT</PackageLicenseExpression><AllowUnsafeBlocks>true</AllowUnsafeBlocks><LangVersion>12</LangVersion><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit><DisableRuntimeMarshalling>true</DisableRuntimeMarshalling></PropertyGroup><ItemGroup><ProjectReference Include="../runtime/runtime.csproj"/><Compile Remove="ComInteropHelpers.cs"/></ItemGroup></Project>
PROJECT
  for project in runtime/runtime.csproj projection/projection.csproj; do
    "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$project" -c Release -o "$(cygpath -m "$srcdir/feed")" \
      --configfile "$(cygpath -m "$srcdir/build/NuGet.config")" -p:UseSharedCompilation=false -v:minimal
  done
}
check() {
  _env
  mkdir -p "$srcdir/check"
  cp "$srcdir/check.cs" "$srcdir/check/Program.cs"
  cat > "$srcdir/check/check.csproj" <<'PROJECT'
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="Msys2.Windows.WinRT" Version="[0.1.1]"/></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" run --project "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    -p:RestoreSources="$(cygpath -m "$srcdir/feed")" -p:UseSharedCompilation=false
}
package() {
  install -Dm755 "$srcdir/build/cswinrt/cswinrt.exe" "$pkgdir$MINGW_PREFIX/bin/cswinrt.exe"
  install -Dm644 "$srcdir/build/metadata/Windows.winmd" "$pkgdir$MINGW_PREFIX/share/dotnet-winrt/Windows.winmd"
  install -Dm644 "$srcdir/build/metadata/projection-types.rsp" "$pkgdir$MINGW_PREFIX/share/dotnet-winrt/projection-types.rsp"
  for p in "$srcdir"/feed/*.nupkg; do
    install -Dm644 "$p" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/$(basename "$p" | tr '[:upper:]' '[:lower:]')"
  done
  install -Dm644 "$srcdir/CsWinRT-$_cs/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/CsWinRT-LICENSE"
  install -Dm644 "$srcdir/winmd-$_wm/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/WinMD-LICENSE"
  for license in license-mit license-apache-2.0; do
    install -Dm644 "$srcdir/windows-rs-$_rs/$license" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/$license"
  done
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
  install -Dm644 "$srcdir/build/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
}
