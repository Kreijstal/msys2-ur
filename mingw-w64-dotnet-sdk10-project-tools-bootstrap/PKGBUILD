# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-sdk10-project-tools-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.201
pkgrel=1
pkgdesc='Original NET10 SDK10 SDK resolver template locator and file-based project tools'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/sdk'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-msbuild18-bootstrap>=18.3.0.26113.113-2"
         "${MINGW_PACKAGE_PREFIX}-dotnet-sdk10-cli-foundation-bootstrap=10.0.201"
         "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn53=5.3.0.2.26113.113"
         "${MINGW_PACKAGE_PREFIX}-dotnet-deployment-releases-bootstrap=2.0.0.preview1.25612.105"
         "${MINGW_PACKAGE_PREFIX}-dotnet-host10-bootstrap=10.0.5")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler53-bootstrap>=5.3.0.2.26113.113-3"
             "${MINGW_PACKAGE_PREFIX}-dotnet-reference10=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
source=('sdk-v10.0.201.tar.gz::https://codeload.github.com/dotnet/sdk/tar.gz/refs/tags/v10.0.201'
        'arcade-runtime10-4bf37ce6.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/4bf37ce670528cf2aef4d9b1cd892554b1b02d9d'
        'sdk10-project-tools-source-2.tar.gz')
noextract=('sdk-v10.0.201.tar.gz' 'arcade-runtime10-4bf37ce6.tar.gz')
sha256sums=('3c9173ca31f070e662f705ebf6bc58c5a809fba78a407c3fb1f14274582ec85d'
            '82f5f6dd63c0dcf3c0fc49b282207db5d889d9cc0939589d43b16c7fcfdf7d66'
            'a2c8b69e0a500f77dba22d60886176906f72589e6e18f068efa2d75cbb9e245a')
prepare() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/prepare.py")" "$(cygpath -am "$srcdir/sdk-v10.0.201.tar.gz")" "$(cygpath -am "$srcdir/plan")" > "$srcdir/prepare.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/evaluate.py")" "$(cygpath -am "$srcdir/plan")" > "$srcdir/evaluate.log" 2>&1
}
build() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/build.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/arcade-runtime10-4bf37ce6.tar.gz")" "$(cygpath -am "$srcdir/build")" > "$srcdir/build.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/localize.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/localized")" > "$srcdir/localize.log" 2>&1
}
check() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/audit.py")" "$(cygpath -am "$srcdir/sdk-v10.0.201.tar.gz")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/localized")" "$(cygpath -am "$srcdir/source-audit.json")" > "$srcdir/audit.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/check-resources.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/localized")" "$(cygpath -am "$srcdir/resource-check")" > "$srcdir/resource-check.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/check.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/runtime-check")" > "$srcdir/runtime-check.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/sdk10-project-tools-workflow/stage.py")" "$(cygpath -am "$srcdir")" "$(cygpath -am "$srcdir/package-prefix")" > "$srcdir/stage.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/package-prefix/share/doc/$_realname/checks/check-installed.py")" "$(cygpath -am "$srcdir/package-prefix")" "$(cygpath -am "$srcdir/staged-check")" > "$srcdir/staged-check.log" 2>&1
}
package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -R "$srcdir/package-prefix/." "$pkgdir$MINGW_PREFIX/"
}
