# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-csharp-compiler
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.9.2
pkgrel=1
_commit=9934fb9e3527e1c0c51314e57d4aab30f97e8f9e
pkgdesc='Source-built Roslyn 4.9 CSharp command-line compiler for the .NET 8 toolchain'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/roslyn'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-common=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp=$pkgver")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("roslyn-$pkgver.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/$_commit"
        prepare.py build.sh csc49.cmd Probe.cs check.sh README.md)
sha256sums=('e01ea67aaec6408de51a0a4c18a7e15b2a527ca7a853c9a0a7742cb5680aeb30'
            '85db5ca140b6fbbc041787b15e5247a5329e2eda3606fdae95e454faf7e914c1'
            '48171b1afceda586eb29ad676644ff7d47a9886dc953de7075b9e05a38f7bd16'
            'e1c8f4c29ea7834b5b01c510a8ea2958e658dfbba20181a51f10e487f7964b67'
            'b4482a7a3bca021d0855646bf9a1739ee592a5b22a3afb316df2f457701da57e'
            '5964a9154d98a7647e8124fab9911f3cac9d9f40b05405a24b34d9ff4890ab8b'
            '8365d2327ad0a6f3e9d4bc65f8ff01b036b48937c6f700faa00920d2b74fe021')
prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/roslyn-$_commit" "$srcdir/prepared"; }
build() {
 bash "$srcdir/build.sh" "$srcdir/prepared"
 cp "$srcdir/csc49.cmd" "$srcdir/prepared/csc/bin/Release/net8.0/"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/prepared/csc/bin/Release/net8.0"; }
package() {
 local target="$pkgdir$MINGW_PREFIX/lib/dotnet/compiler-packs/roslyn-$pkgver"
 mkdir -p "$target"
 cp -R "$srcdir/prepared/csc/bin/Release/net8.0/"* "$target/"
 rm -f "$target/"*.pdb
 install -Dm644 "$srcdir/roslyn-$_commit/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
 install -Dm644 "$srcdir/roslyn-$_commit/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
 install -m644 "$srcdir/prepared/source-items.json" "$srcdir/prepared/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
}
