+
+void *
+hnj_malloc (int size)
+{
+  void *p;
+
+  p = malloc (size);
+  if (p == NULL)
+    {
+      fprintf (stderr, "can't allocate %d bytes\n", size);
+      exit (1);
+    }
+  return p;
+}
+
+void *
+hnj_realloc (void *p, int size)
+{
