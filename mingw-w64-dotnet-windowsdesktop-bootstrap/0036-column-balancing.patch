diff --git a/bootstrap/m612/wpf-tests/check-balancing-sdk.sh b/bootstrap/m612/wpf-tests/check-balancing-sdk.sh
new file mode 100644
index 0000000..1307310
--- /dev/null
+++ b/bootstrap/m612/wpf-tests/check-balancing-sdk.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+set -euo pipefail
+sdk=$1
+work=$2
+here=$(cd "$(dirname "$0")" && pwd)
+mkdir -p "$work"
+cp "$here/Balancing.cs" "$work/Program.cs"
+cat > "$work/BalancingSdkCheck.csproj" <<'PROJECT'
+<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net8.0-windows</TargetFramework><OutputType>Exe</OutputType><UseWPF>true</UseWPF><UseAppHost>false</UseAppHost><AllowUnsafeBlocks>true</AllowUnsafeBlocks><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup></Project>
+PROJECT
+printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$work/NuGet.config"
+export DOTNET_ROOT=$(cygpath -m "$sdk")
+export DOTNET_ROOT_X64=$DOTNET_ROOT
+export DOTNET_CLI_HOME=$(cygpath -m "$work/cli-home")
+export NUGET_PACKAGES=$(cygpath -m "$work/empty-packages")
+"$sdk/dotnet.exe" build "$(cygpath -m "$work/BalancingSdkCheck.csproj")" -c Release \
+  --configfile "$(cygpath -m "$work/NuGet.config")" -v:q -p:UseSharedCompilation=false
+# Shared-framework execution must load the installed/overlaid desktop pack.
+test ! -e "$work/bin/Release/net8.0-windows/PresentationCore.dll"
+timeout 60 "$sdk/dotnet.exe" "$(cygpath -m "$work/bin/Release/net8.0-windows/BalancingSdkCheck.dll")"
+"$sdk/dotnet.exe" publish "$(cygpath -m "$work/BalancingSdkCheck.csproj")" -r win-x64 --self-contained true \
+  --configfile "$(cygpath -m "$work/NuGet.config")" -p:UseAppHost=true -v:q -p:UseSharedCompilation=false
+# Verify the published implementation/resource bytes came from this SDK's pack.
+cmp "$work/bin/Release/net8.0-windows/win-x64/publish/PresentationCore.dll" \
+  "$sdk/shared/Microsoft.WindowsDesktop.App/8.0.0-bootstrap.wpf.8.0.0/PresentationCore.dll"
+env -u DOTNET_ROOT -u DOTNET_ROOT_X64 PATH=/usr/bin:/c/Windows/System32 \
+  timeout 60 "$work/bin/Release/net8.0-windows/win-x64/publish/BalancingSdkCheck.exe"
+printf 'PASS normal offline WPF SDK original column balancing check and self-contained publish with SDK roots removed\n'
