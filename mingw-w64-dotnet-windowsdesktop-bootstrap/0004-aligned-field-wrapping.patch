+    }
+    if(context.incremental_tab<=0) return LS_InvalidFormatterResult;
+    int64_t after=context.tabs.empty()?x:std::max<int64_t>(x,context.tabs.back().ur);
+    target=(after/context.incremental_tab+1)*context.incremental_tab;
+    return LS_None;
+}
