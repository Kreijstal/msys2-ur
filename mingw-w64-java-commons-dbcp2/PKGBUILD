# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-commons-dbcp2
pkgname=("${MINGW_PACKAGE_PREFIX}-java-commons-dbcp2")
pkgver=2.12.0
pkgrel=1
pkgdesc="commons-dbcp2 Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://commons.apache.org/proper/commons-dbcp/'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-commons-logging"
             "${MINGW_PACKAGE_PREFIX}-java-commons-pool2"
             "${MINGW_PACKAGE_PREFIX}-java-javax-transaction-api")
source=('https://repo.maven.apache.org/maven2/org/apache/commons/commons-dbcp2/2.12.0/commons-dbcp2-2.12.0-sources.jar'
         'https://repo.maven.apache.org/maven2/org/apache/commons/commons-dbcp2/2.12.0/commons-dbcp2-2.12.0.pom')
noextract=('commons-dbcp2-2.12.0-sources.jar'
         'commons-dbcp2-2.12.0.pom')
sha256sums=('a9b017e073ac855fe0059246bda83366d6df0a560d0c3f43173f72a8b880107e'
         '7b0c4e889cc3c65667b97ac68553bf9be8aa3dc30347c7782c80133e4d65e10f')
_artifacts=('org.apache.commons:commons-dbcp2:2.12.0')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.apache.commons:commons-dbcp2:2.12.0 upstream/commons-dbcp2 \
    -r resources/commons-dbcp2 -u commons-dbcp2-2.12.0.pom -- \
    org.apache.commons:commons-pool2 commons-logging:commons-logging javax.transaction:javax.transaction-api
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.apache.commons:commons-pool2 --with commons-logging:commons-logging --with javax.transaction:javax.transaction-api org.apache.commons:commons-dbcp2
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-commons-dbcp2() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-commons-pool2"
           "${MINGW_PACKAGE_PREFIX}-java-commons-logging"
           "${MINGW_PACKAGE_PREFIX}-java-javax-transaction-api")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.commons:commons-dbcp2
  _license commons-dbcp2 2.12.0
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
