         "${MINGW_PACKAGE_PREFIX}-java-lucene-sandbox"
         "${MINGW_PACKAGE_PREFIX}-java-lucene-queryparser")
pkgver=9.7.0
pkgrel=1
pkgdesc="lucene Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://lucene.apache.org/'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
