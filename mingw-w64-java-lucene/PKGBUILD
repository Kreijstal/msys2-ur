_artifacts=('org.apache.lucene:lucene-core:9.7.0'
         'org.apache.lucene:lucene-analysis-common:9.7.0'
         'org.apache.lucene:lucene-queries:9.7.0'
         'org.apache.lucene:lucene-sandbox:9.7.0'
         'org.apache.lucene:lucene-queryparser:9.7.0')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module org.apache.lucene:lucene-core:9.7.0 upstream/lucene-core \
    -r resources/lucene-core -u lucene-core-9.7.0.pom
  jb_module org.apache.lucene:lucene-analysis-common:9.7.0 upstream/lucene-analysis-common \
    -r resources/lucene-analysis-common -u lucene-analysis-common-9.7.0.pom -- \
    org.apache.lucene:lucene-core
  jb_module org.apache.lucene:lucene-queries:9.7.0 upstream/lucene-queries \
    -r resources/lucene-queries -u lucene-queries-9.7.0.pom -- \
    org.apache.lucene:lucene-core
  jb_module org.apache.lucene:lucene-sandbox:9.7.0 upstream/lucene-sandbox \
    -r resources/lucene-sandbox -u lucene-sandbox-9.7.0.pom -- \
    org.apache.lucene:lucene-core org.apache.lucene:lucene-queries
  jb_module org.apache.lucene:lucene-queryparser:9.7.0 upstream/lucene-queryparser \
    -r resources/lucene-queryparser -u lucene-queryparser-9.7.0.pom -- \
    org.apache.lucene:lucene-core org.apache.lucene:lucene-queries org.apache.lucene:lucene-sandbox
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck org.apache.lucene:lucene-core
  jb_loadcheck --with org.apache.lucene:lucene-core org.apache.lucene:lucene-analysis-common
  jb_loadcheck --with org.apache.lucene:lucene-core org.apache.lucene:lucene-queries
  jb_loadcheck --with org.apache.lucene:lucene-core --with org.apache.lucene:lucene-queries org.apache.lucene:lucene-sandbox
  jb_loadcheck --with org.apache.lucene:lucene-core --with org.apache.lucene:lucene-queries --with org.apache.lucene:lucene-sandbox org.apache.lucene:lucene-queryparser
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-lucene-core() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.lucene:lucene-core
  _license lucene-core 9.7.0
}

package_java-lucene-analysis-common() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-lucene-core")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.lucene:lucene-analysis-common
