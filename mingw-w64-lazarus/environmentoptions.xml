<?xml version="1.0"?>
<CONFIG>
  <EnvironmentOptions>
    <Version Value="110" Lazarus="4.8"/>
    <LazarusDirectory Value="@LAZARUSDIR@">
    </LazarusDirectory>
    <CompilerFilename Value="$(LazarusDir)\..\..\bin\fpc.exe">
    </CompilerFilename>
    <FPCSourceDirectory Value="$(LazarusDir)\..\fpc\src">
    </FPCSourceDirectory>
    <MakeFilename Value="$(LazarusDir)\..\..\bin\mingw32-make.exe">
    </MakeFilename>
    <Debugger>
      <Configs>
        <Config ConfigName="FpDebug" ConfigClass="TFpDebugDebugger" Active="True"/>
        <Config ConfigName="Gdb" ConfigClass="TGDBMIDebugger" DebuggerFilename="$(LazarusDir)\..\..\bin\gdb.exe"/>
      </Configs>
    </Debugger>
  </EnvironmentOptions>
</CONFIG>
