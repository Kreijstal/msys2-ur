# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-visualbasic-compiler
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.9.2
pkgrel=1
_commit=9934fb9e3527e1c0c51314e57d4aab30f97e8f9e
pkgdesc='Source-built Roslyn 4.9 VisualBasic command-line compiler for the .NET 8 toolchain'
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://github.com/dotnet/roslyn'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-common=$pkgver" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-visualbasic=$pkgver")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("roslyn-$pkgver.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/$_commit"
        prepare.py build.sh vbc49.cmd Probe.cs check.sh README.md)
sha256sums=('e01ea67aaec6408de51a0a4c18a7e15b2a527ca7a853c9a0a7742cb5680aeb30'
            'fb012e844308862813bad4cf36e01b9d98ee93b23e2230b26a574c43bb6a3123'
            'd96b6cd5944cbf93270a17ede99736a0ba39a2b9fad518b32324e8ca284bf2ab'
            'c4ed2eaa0f7ff226aa70b4a5f2d72e3ca49807f20b5d0594280f0802be0256a7'
            '286bfcac9335725871a2e5361815f1c95376f481a64527525454b122d2098fa9'
            'c1a5fe6bb5c55cf906a2e8958c82b4a2b2f315de7491446c050d87d507211302'
            '0ceb73f26f3add7bdee9fe56918b3a0763e22b354dd27c063045ee21d2bbe4f7')
prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/roslyn-$_commit" "$srcdir/prepared"; }
build() {
 bash "$srcdir/build.sh" "$srcdir/prepared"
 cp "$srcdir/vbc49.cmd" "$srcdir/prepared/vbc/bin/Release/net8.0/"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/prepared/vbc/bin/Release/net8.0"; }
package() {
 local target="$pkgdir$MINGW_PREFIX/lib/dotnet/compiler-packs/roslyn-vb-$pkgver"
 mkdir -p "$target"
 cp -R "$srcdir/prepared/vbc/bin/Release/net8.0/"* "$target/"
 rm -f "$target/"*.pdb
 install -Dm644 "$srcdir/roslyn-$_commit/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
 install -Dm644 "$srcdir/roslyn-$_commit/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
 install -m644 "$srcdir/prepared/source-items.json" "$srcdir/prepared/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/"
}
