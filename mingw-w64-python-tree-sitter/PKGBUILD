_realname=tree-sitter
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.26.0
pkgrel=1
pkgdesc="Python bindings to the tree-sitter parsing library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/tree-sitter/py-tree-sitter'
msys2_repository_url='https://github.com/tree-sitter/py-tree-sitter'
msys2_references=(
  'purl: pkg:pypi/tree-sitter'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-cc")
source=("https://pypi.org/packages/source/t/tree-sitter/tree_sitter-${pkgver}.tar.gz")
sha256sums=('b40c219edccc4564530c96f8f1556f6202b37cda964d1cbd7bd2b7e68b40a245')

build() {
  cp -r "tree_sitter-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  # no grammar yet; the grammar packages parse real code
  ${MINGW_PREFIX}/bin/python - <<'PY'
import tree_sitter
from tree_sitter import Parser, Query, LANGUAGE_VERSION, MIN_COMPATIBLE_LANGUAGE_VERSION
p = Parser()
assert p.language is None
print("tree-sitter ok", LANGUAGE_VERSION, MIN_COMPATIBLE_LANGUAGE_VERSION)
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
