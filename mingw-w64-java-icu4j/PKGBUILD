# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-icu4j
pkgname=("${MINGW_PACKAGE_PREFIX}-java-icu4j")
pkgver=72.1
pkgrel=1
pkgdesc="icu4j Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://icu.unicode.org/'
license=('spdx:Unicode-DFS-2016')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=('https://repo.maven.apache.org/maven2/com/ibm/icu/icu4j/72.1/icu4j-72.1-sources.jar'
         'https://repo.maven.apache.org/maven2/com/ibm/icu/icu4j/72.1/icu4j-72.1.pom'
         'icu4j-72.1-icudata.jar::https://media.githubusercontent.com/media/unicode-org/icu/release-72-1/icu4j/main/shared/data/icudata.jar'
         'icu4j-72.1-icutzdata.jar::https://media.githubusercontent.com/media/unicode-org/icu/release-72-1/icu4j/main/shared/data/icutzdata.jar')
noextract=('icu4j-72.1-sources.jar'
         'icu4j-72.1.pom'
         'icu4j-72.1-icudata.jar'
         'icu4j-72.1-icutzdata.jar')
sha256sums=('e90b4f8dd0e0ed1f8d5bf42c91c93d8aea13882eedd7aa3808123e7cb621f5d9'
         '3def2b29af4a19ad805cb153056925a89a903f92fbee1adee12ed2fc14c44ee8'
         '06dfeeb5d37e1335a30a60f86cedffc88a3bfac1fa88a3a01cde60b1c2cb7e03'
         'bf689de16f6b31cd55e8985db3761c3906c1d6c132c417d3a3fef9f2e467fd70')
_artifacts=('com.ibm.icu:icu4j:72.1')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
  # Canonical upstream Unicode/time-zone data: resource archives contain no
  # JVM bytecode. The matching Java implementations are compiled below.
  local data
  for data in icu4j-72.1-icudata.jar icu4j-72.1-icutzdata.jar; do
    if bsdtar -tf "$data" | grep -Eq '\.class$'; then
      printf '%s\n' "Unexpected JVM bytecode in ICU data: $data" >&2
      return 1
    fi
    bsdtar -xf "$data" -C resources/icu4j
    rm -f resources/icu4j/META-INF/{MANIFEST.MF,*.SF,*.RSA,*.DSA}
  done

}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module com.ibm.icu:icu4j:72.1 upstream/icu4j \
    -r resources/icu4j -u icu4j-72.1.pom
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck com.ibm.icu:icu4j
  mkdir -p smoke
  cat > smoke/IcuData.java <<'JAVA'
import com.ibm.icu.lang.UCharacter;
import com.ibm.icu.text.BreakIterator;
import com.ibm.icu.util.ULocale;
public class IcuData {
  public static void main(String[] args) {
    if (UCharacter.getUnicodeVersion().getMajor() != 15) throw new AssertionError("Unicode version");
    if (!UCharacter.isLetter('A')) throw new AssertionError("Unicode properties");
    BreakIterator iterator = BreakIterator.getWordInstance(ULocale.ENGLISH);
    iterator.setText("hello world");
    if (iterator.first() != 0 || iterator.next() != 5) throw new AssertionError("word boundaries");
    System.out.println("ICU Unicode data and word boundaries passed");
  }
}
JAVA
  local cp=$(jb_cp com.ibm.icu:icu4j)
  javac --release 21 -d "$(jb_w smoke)" -cp "$cp" "$(jb_w smoke/IcuData.java)"
  java -cp "$(jb_w smoke);$cp" IcuData

}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-icu4j() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.ibm.icu:icu4j
  _license icu4j 72.1
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
