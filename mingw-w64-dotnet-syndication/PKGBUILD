# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-syndication
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.3
pkgrel=1
pkgdesc='Source-built System.ServiceModel.Syndication for the .NET 8 offline feed'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
_commit=dc5fd7a8dce8309e4add8fd4bd5d8718f221b15a
_tree=syndication-source
_project=Syndication.csproj
_id=System.ServiceModel.Syndication
_framework=net8.0
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" 'python')
options=('!strip' '!lto')
source=("runtime-dc5fd7a8dce8309e4add8fd4bd5d8718f221b15a.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/dc5fd7a8dce8309e4add8fd4bd5d8718f221b15a" prepare.py check.cs Microsoft.pubkey.hex)
noextract=("runtime-dc5fd7a8dce8309e4add8fd4bd5d8718f221b15a.tar.gz")
sha256sums=('32de05f9721080a10f701da03cc3ed76cc5f081584e8ec6aa5250a76b0cdbfdf' 'e3398455a8af1433cff59ac46b0eb58dc5e6c2ae8470d71477daa722d2e6a3aa' '46d72904b7929dfd1dcd46d85e71e76eb1720e0a09e09e21047e158fcce44a00' 'f590f89e2667ca399aa6e436a8c8d3855bbcec19228980320920bad70e5bfd3f')

_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/runtime-dc5fd7a8dce8309e4add8fd4bd5d8718f221b15a.tar.gz" "$srcdir/$_tree"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  cd "$srcdir/$_tree"
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$_project" -c Release -o "$(cygpath -m "$srcdir/feed")" \
    --configfile "$(cygpath -m "$srcdir/NuGet.config")" -p:PackageId="$_id" -p:PackageVersion="$pkgver" \
    -p:Version="$pkgver" -p:PackageLicenseExpression=MIT -p:GeneratePackageOnBuild=false \
    -p:RestoreSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" -p:EnableNETAnalyzers=false -p:NuGetAudit=false -p:UseSharedCompilation=false -v:minimal
}
check() {
  _env
  mkdir -p "$srcdir/check"
  cp "$srcdir/check.cs" "$srcdir/check/Program.cs"
  cat > "$srcdir/check/check.csproj" <<PROJECT
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>$_framework</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="$_id" Version="[$pkgver]" /></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" run --project "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    -p:RestoreSources="$(cygpath -m "$srcdir/feed")" -p:UseSharedCompilation=false
}
package() {
  install -Dm644 "$srcdir/feed/$_id.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${_id,,}.$pkgver.nupkg"
  install -Dm644 "$srcdir/$_tree/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/$_tree/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
}
