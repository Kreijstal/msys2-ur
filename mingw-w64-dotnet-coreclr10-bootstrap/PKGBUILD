# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-coreclr10-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.0.5
pkgrel=1
pkgdesc='Original source CoreCLR10 native bootstrap with real generated cDAC contracts'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=(
             "${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-cc" "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja" "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-uasm" "${MINGW_PACKAGE_PREFIX}-python" 'python' 'patch')
options=('!strip' '!lto' '!buildflags' '!debug')
source=('runtime-v10.0.5.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.5'
        'coreclr10-bootstrap-source-1.tar.gz'
        'arcade-runtime10-4bf37ce6.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/4bf37ce670528cf2aef4d9b1cd892554b1b02d9d'
        'command-line-api-source.tar.gz::https://codeload.github.com/dotnet/command-line-api/tar.gz/c7b5e07cfed85e88c162dc1c916efaff03742e6e')
noextract=('runtime-v10.0.5.tar.gz' 'arcade-runtime10-4bf37ce6.tar.gz' 'command-line-api-source.tar.gz')
sha256sums=('1692acae5e3adfd625452fbc9db4fd4e982c10e38189358ae245c74dd5514d7a'
            '0a3afc2faa95a48f85ca349b529c760a99c88b9830935cc690f0d879d86b584c'
            '82f5f6dd63c0dcf3c0fc49b282207db5d889d9cc0939589d43b16c7fcfdf7d66'
            'a88afc443b5241c7d25866b961d9e364a3b6a309c35eb0de07e3338b0d72f65b')
prepare() {
  /usr/bin/python3 "$srcdir/coreclr10-workflow/prepare.py" "$srcdir" >"$srcdir/prepare.log" 2>&1
}
build() {
  bash "$srcdir/coreclr10-workflow/build.sh" "$srcdir" "${CORECLR10_JOBS:-2}" >"$srcdir/build.log" 2>&1
}
check() {
  bash "$srcdir/coreclr10-workflow/check.sh" "$srcdir" >"$srcdir/check.log" 2>&1
}
package() {
  local target="$pkgdir$MINGW_PREFIX/lib/dotnet-bootstrap10/coreclr/10.0.5"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$target" "$doc"
  install -m755 "$srcdir/coreclr-build/dlls/mscoree/coreclr/coreclr.dll" "$srcdir/coreclr-build/jit/clrjit.dll" "$srcdir/coreclr-build/dlls/mscorrc/mscorrc.dll" "$srcdir/coreclr-build/dlls/clretwrc/clretwrc.dll" "$target/"
  install -m644 "$srcdir/coreclr10-workflow/README.md" "$doc/"
  install -m644 "$srcdir/"{source-inputs,coreclr-port-inputs,version-build-inputs,native-version-inputs,native-audit,source-audit}.json "$doc/"
  install -m644 "$srcdir/cdac-bootstrap/source-inputs.json" "$doc/cdac-source-inputs.json"
  install -m644 "$srcdir/native-check/results.json" "$doc/native-check-results.json"
  install -m644 "$srcdir/eha-check/results.json" "$doc/eha-check-results.json"
  install -Dm644 "$srcdir/r/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE.TXT"
  install -Dm644 "$srcdir/r/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.TXT"
  install -Dm644 "$srcdir/Arcade-LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/Arcade-LICENSE.TXT"
  install -Dm644 "$srcdir/cdac-bootstrap/command-line-source/LICENSE.md" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/command-line-LICENSE.md"
}
