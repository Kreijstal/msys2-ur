From: Kreijstal <rainb@tfwno.gf>
Subject: [PATCH] tests: Run the shader runner in a native Windows build.

A MinGW (non-cross) build of the tests compiles with vkd3d-shader and
executes on the native d3d9/d3d11 runtimes, but did not build:
d3d12_crosstest.h used the cross-test d3dcompiler loaders for any _WIN32
build, shader_runner.c referenced SONAME_LIBDXCOMPILER unconditionally and
shader_runner_d3d9.c needs libvkd3d-common for vkd3d_unreachable().

Also let the d3d9/d3d11 runners work without an interactive desktop
(e.g. over ssh), where d3d9 has no adapter and DXGI cannot create a
swapchain; the swapchain is never presented.
---
--- a/Makefile.am
+++ b/Makefile.am
@@ -567,7 +567,7 @@
 tests_hlsl_d3d12_LDADD = $(TEST_LDADD) @DL_LIBS@
 tests_shader_runner_CPPFLAGS = $(TEST_CPPFLAGS)
 tests_shader_runner_CFLAGS = $(TEST_CFLAGS) @OPENGL_CFLAGS@
-tests_shader_runner_LDADD = $(TEST_LDADD) @OPENGL_LIBS@ @DL_LIBS@
+tests_shader_runner_LDADD = $(TEST_LDADD) libvkd3d-common.la @OPENGL_LIBS@ @DL_LIBS@
 tests_shader_runner_SOURCES = \
 	tests/shader_runner.c \
 	tests/shader_runner_d3d9.c \
--- a/Makefile.in
+++ b/Makefile.in
@@ -316,7 +316,7 @@
 @BUILD_TESTS_TRUE@	$(am__objects_3)
 tests_shader_runner_OBJECTS = $(am_tests_shader_runner_OBJECTS)
 @BUILD_TESTS_TRUE@tests_shader_runner_DEPENDENCIES =  \
-@BUILD_TESTS_TRUE@	$(am__DEPENDENCIES_2)
+@BUILD_TESTS_TRUE@	$(am__DEPENDENCIES_2) libvkd3d-common.la
 tests_vkd3d_api_SOURCES = tests/vkd3d_api.c
 tests_vkd3d_api_OBJECTS = tests/vkd3d_api-vkd3d_api.$(OBJEXT)
 @BUILD_TESTS_TRUE@tests_vkd3d_api_DEPENDENCIES =  \
@@ -1429,7 +1429,7 @@
 @BUILD_TESTS_TRUE@tests_hlsl_d3d12_LDADD = $(TEST_LDADD) @DL_LIBS@
 @BUILD_TESTS_TRUE@tests_shader_runner_CPPFLAGS = $(TEST_CPPFLAGS)
 @BUILD_TESTS_TRUE@tests_shader_runner_CFLAGS = $(TEST_CFLAGS) @OPENGL_CFLAGS@
-@BUILD_TESTS_TRUE@tests_shader_runner_LDADD = $(TEST_LDADD) @OPENGL_LIBS@ @DL_LIBS@
+@BUILD_TESTS_TRUE@tests_shader_runner_LDADD = $(TEST_LDADD) libvkd3d-common.la @OPENGL_LIBS@ @DL_LIBS@
 @BUILD_TESTS_TRUE@tests_shader_runner_SOURCES = tests/shader_runner.c \
 @BUILD_TESTS_TRUE@	tests/shader_runner_d3d9.c \
 @BUILD_TESTS_TRUE@	tests/shader_runner_d3d11.c \
--- a/tests/d3d12_crosstest.h
+++ b/tests/d3d12_crosstest.h
@@ -76,7 +76,7 @@
 
 #include "d3d12_test_utils.h"
 
-#ifdef _WIN32
+#ifdef VKD3D_CROSSTEST
 static inline HANDLE create_event(void)
 {
     return CreateEventA(NULL, FALSE, FALSE, NULL);
@@ -221,9 +221,11 @@
 }
 
 #else
+#ifndef _WIN32
 #define INFINITE VKD3D_INFINITE
 #define WAIT_OBJECT_0 VKD3D_WAIT_OBJECT_0
 #define WAIT_TIMEOUT VKD3D_WAIT_TIMEOUT
+#endif
 
 static inline HANDLE create_event(void)
 {
--- a/tests/shader_runner.c
+++ b/tests/shader_runner.c
@@ -3795,8 +3795,10 @@
     run_shader_tests_d3d11();
     run_shader_tests_d3d12(dxc);
 
+#ifdef SONAME_LIBDXCOMPILER
     if (dxc)
         print_dll_version(SONAME_LIBDXCOMPILER);
+#endif
     print_dll_version("d3d9.dll");
     print_dll_version("d3d11.dll");
 
--- a/tests/shader_runner_d3d11.c
+++ b/tests/shader_runner_d3d11.c
@@ -236,7 +236,13 @@
     dxgi_desc.Flags = 0;
 
     hr = IDXGIFactory_CreateSwapChain(factory, (IUnknown *)device, &dxgi_desc, &swapchain);
-    ok(hr == S_OK, "Failed to create swapchain, hr %#lx.\n", hr);
+    /* Not available without an interactive desktop (e.g. over ssh); the
+     * swapchain is never presented, so run the tests without it. */
+    if (FAILED(hr))
+    {
+        trace("Failed to create swapchain, hr %#lx.\n", hr);
+        swapchain = NULL;
+    }
     IDXGIFactory_Release(factory);
 
     return swapchain;
@@ -421,7 +427,8 @@
 
     ID3D11RasterizerState_Release(runner->rasterizer_state);
     ID3D11DeviceContext_Release(runner->immediate_context);
-    IDXGISwapChain_Release(runner->swapchain);
+    if (runner->swapchain)
+        IDXGISwapChain_Release(runner->swapchain);
     DestroyWindow(runner->window);
 
     ref = ID3D11Device_Release(runner->device);
--- a/tests/shader_runner_d3d9.c
+++ b/tests/shader_runner_d3d9.c
@@ -104,7 +104,14 @@
     ok(!!d3d, "Failed to create a D3D object.\n");
 
     hr = IDirect3D9_GetAdapterIdentifier(d3d, test_options.adapter_idx, 0, &identifier);
-    ok(hr == S_OK, "Failed to get adapter identifier, hr %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        /* No d3d9 adapter without an interactive desktop (e.g. over ssh). */
+        skip("Failed to get adapter identifier, hr %#lx.\n", hr);
+        IDirect3D9_Release(d3d);
+        DestroyWindow(runner->window);
+        return false;
+    }
 
     trace("Driver string: %s.\n", identifier.Driver);
     trace("Device: %s, %04lx:%04lx.\n", identifier.Description, identifier.VendorId, identifier.DeviceId);
