_realname=vkd3d
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-${_realname}-d3dcompiler")
pkgver=2.1
pkgrel=2
pkgdesc='Direct3D 12 to Vulkan translation library and vkd3d-shader (HLSL/DXBC/D3DBC compiler) (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://gitlab.winehq.org/wine/vkd3d'
msys2_repository_url='https://gitlab.winehq.org/wine/vkd3d'
msys2_changelog_url='https://gitlab.winehq.org/wine/vkd3d/-/blob/master/ANNOUNCE'
license=('spdx:LGPL-2.1-or-later')
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-autotools"
             "${MINGW_PACKAGE_PREFIX}-spirv-headers"
             "${MINGW_PACKAGE_PREFIX}-spirv-tools"
             "${MINGW_PACKAGE_PREFIX}-vulkan-headers"
             "${MINGW_PACKAGE_PREFIX}-tools"
             "bison"
             "flex"
             "perl"
             "perl-json")
source=("https://dl.winehq.org/vkd3d/source/${_realname}-${pkgver}.tar.xz"
        "0001-tests-run-the-shader-runner-in-a-native-Windows-build.patch"
        "0002-vkd3d-shader-hlsl-apply-register-reservations-by-shader-type.patch"
        "0003-vkd3d-shader-hlsl-reject-SampleCmp-before-shader-model-4.patch"
        "0004-vkd3d-shader-hlsl-write-the-target-profile-in-the-CTAB.patch"
        "0005-vkd3d-shader-d3dbc-legalize-texld-and-texkill-operands.patch"
        "0006-vkd3d-shader-tpf-mark-comparison-samplers-in-the-RDEF.patch"
        "d3dcompiler_47-extra.c"
        "d3dcompiler_47.def"
        "README.d3dcompiler"
        "d3dctest.c"
        "test-ps.hlsl"
        "test-effect.fx"
        "test-reservations.hlsl"
        "check-jobs.txt")
sha256sums=('7510146aff2adfb4ae07ab890701a607e5ff7c66e57100cfc9f630ec92eeda6a'
