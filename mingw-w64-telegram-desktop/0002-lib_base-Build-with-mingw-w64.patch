@@ -86,11 +86,14 @@ BOOL (__stdcall *SetDefaultDllDirectories)(_In_ DWORD DirectoryFlags);
 namespace details {
 
 void *LoadMethodRaw(HINSTANCE library, LPCSTR name, WORD id) {
-	const auto result = GetProcAddress(library, name);
+	// FARPROC is a function pointer, MSVC converts it to void* implicitly.
+	const auto result = reinterpret_cast<void*>(
+		GetProcAddress(library, name));
 	return result
 		? result
 		: id
-		? GetProcAddress(library, MAKEINTRESOURCEA(id))
+		? reinterpret_cast<void*>(
+			GetProcAddress(library, MAKEINTRESOURCEA(id)))
 		: nullptr;
 }
 
@@ -130,7 +133,16 @@ void InitDynamicLibraries() {
 	static const auto Inited = [] {
 		const auto kernel = LoadLibrary(L"kernel32.dll");
 		if (LOAD_SYMBOL(kernel, SetDefaultDllDirectories)) {
+#ifdef __MINGW32__
+			// A MinGW build links the shared libraries of its environment,
+			// installed next to the executable. Qt plugins, loaded later
+			// from their own directory, pull more of them in by name, so
+			// keep the application directory searchable as well.
+			SetDefaultDllDirectories(LOAD_LIBRARY_SEARCH_APPLICATION_DIR
+				| LOAD_LIBRARY_SEARCH_SYSTEM32);
+#else // __MINGW32__
 			SetDefaultDllDirectories(LOAD_LIBRARY_SEARCH_SYSTEM32);
