diff --git a/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/event.h b/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/event.h
new file mode 100644
index 0000000..0a8a4e9
--- /dev/null
+++ b/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/event.h
@@ -0,0 +1,62 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+// Microsoft::WRL::Callback for mingw-w64, which has no <wrl/event.h>:
+// wraps a callable into a COM delegate object implementing interface I,
+// whose single Invoke() method forwards to the callable.
+#pragma once
+
+#include <wrl/implements.h>
+
+namespace Microsoft::WRL {
+namespace Details {
+
+template <typename Interface, typename Function, typename Method>
+class CallbackImpl;
+
+template <
+	typename Interface,
+	typename Function,
+	typename Result,
+	typename Class,
+	typename ...Args>
+class CallbackImpl<Interface, Function, Result(STDMETHODCALLTYPE Class::*)(Args...)> final
+: public RuntimeClass<RuntimeClassFlags<Delegate>, Interface> {
+public:
+	explicit CallbackImpl(Function function)
+	: _function(std::move(function)) {
+	}
+
+	Result STDMETHODCALLTYPE Invoke(Args ...args) override {
+		return _function(args...);
+	}
+
+private:
+	Function _function;
+
+};
+
+} // namespace Details
+
+template <typename Interface, typename Function>
+ComPtr<Interface> Callback(Function &&function) {
+	using Impl = Details::CallbackImpl<
+		Interface,
+		std::decay_t<Function>,
+		decltype(&Interface::Invoke)>;
+	auto result = ComPtr<Interface>();
+	result.Attach(new (std::nothrow) Impl(std::forward<Function>(function)));
+	return result;
+}
+
+template <typename Interface, typename Object, typename Method>
+ComPtr<Interface> Callback(Object *object, Method method) {
+	return Callback<Interface>([=](auto ...args) {
+		return (object->*method)(args...);
+	});
+}
+
+} // namespace Microsoft::WRL
diff --git a/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/implements.h b/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/implements.h
new file mode 100644
index 0000000..a13b0d6
--- /dev/null
+++ b/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/implements.h
@@ -0,0 +1,160 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+// mingw-w64 ships <wrl/client.h> (ComPtr) but not the implementation side of
+// the Windows Runtime C++ Template Library. This is the small classic-COM
+// subset the code here and the WebView2 SDK helper header use:
+// RuntimeClass, Implements, RuntimeClassFlags, FtmBase and Make.
+#pragma once
+
+#include <unknwn.h>
+#include <objidl.h>
+#include <wrl/client.h>
+
+#include <atomic>
+#include <new>
+#include <type_traits>
+#include <utility>
+
+namespace Microsoft::WRL {
+
+enum RuntimeClassType {
+	WinRt = 0x0001,
+	ClassicCom = 0x0002,
+	WinRtClassicComMix = WinRt | ClassicCom,
+	InhibitWeakReference = 0x0004,
+	Delegate = ClassicCom,
+	InhibitFtmBase = 0x0008,
+	InhibitRoOriginateError = 0x0010,
+};
+
+template <unsigned int flags>
+struct RuntimeClassFlags {
+	static constexpr unsigned int value = flags;
+};
+
+// The SDK's FtmBase aggregates the free-threaded marshaler. Here it only
+// marks the class as agile: QueryInterface answers IAgileObject, which is
+// what lets COM hand the object to other apartments of the process as is.
+class FtmBase {
+};
+
+namespace Details {
+
+template <typename T, typename = void>
+struct IsImplements : std::false_type {
+};
+
+template <typename T>
+struct IsImplements<T, std::void_t<typename T::WrlImplementsTag>>
+: std::true_type {
+};
+
+// Answers riid for one entry of a RuntimeClass/Implements base list. With
+// `any` set it returns the first interface found, which serves as the
+// object's IUnknown identity.
+template <typename Self, typename Base>
+bool QueryBase(Self *self, REFIID riid, void **object, bool any) {
+	if constexpr (std::is_same_v<Base, FtmBase>) {
+		return false;
+	} else if constexpr (IsImplements<Base>::value) {
+		return Base::QueryImplements(static_cast<Base*>(self), riid, object, any);
+	} else {
+		static_assert(std::is_base_of_v<IUnknown, Base>, "Expected COM interface");
+		if (any || riid == __uuidof(Base)) {
+			*object = static_cast<Base*>(self);
+			return true;
+		}
+		return false;
+	}
+}
+
+template <typename Self, typename ...Bases>
+bool QueryBases(Self *self, REFIID riid, void **object, bool any) {
+	return (QueryBase<Self, Bases>(self, riid, object, any) || ...);
+}
+
+} // namespace Details
+
+// A mixin listing more interfaces for an enclosing RuntimeClass.
+template <typename Flags, typename ...Interfaces>
+class Implements : public Interfaces... {
+public:
+	using WrlImplementsTag = void;
+
+	static bool QueryImplements(
+			Implements *self,
+			REFIID riid,
+			void **object,
+			bool any) {
+		return Details::QueryBases<Implements, Interfaces...>(
+			self,
+			riid,
+			object,
+			any);
+	}
+
+protected:
+	virtual ~Implements() = default;
+};
+
+template <typename Flags, typename ...Bases>
+class RuntimeClass : public Bases... {
+	static constexpr bool kAgile = (std::is_same_v<Bases, FtmBase> || ...);
+
+public:
+	RuntimeClass() = default;
+	RuntimeClass(const RuntimeClass &) = delete;
+	RuntimeClass &operator=(const RuntimeClass &) = delete;
+
+	HRESULT STDMETHODCALLTYPE QueryInterface(
+			REFIID riid,
+			void **object) override {
+		if (!object) {
+			return E_POINTER;
+		}
+		*object = nullptr;
+		const auto any = (riid == __uuidof(IUnknown))
+			|| (kAgile && riid == __uuidof(IAgileObject));
+		if (!Details::QueryBases<RuntimeClass, Bases...>(
+				this,
+				riid,
+				object,
+				any)) {
+			return E_NOINTERFACE;
+		}
+		AddRef();
+		return S_OK;
+	}
+
+	ULONG STDMETHODCALLTYPE AddRef() override {
+		return ++_refCount;
+	}
+
+	ULONG STDMETHODCALLTYPE Release() override {
+		const auto result = --_refCount;
+		if (!result) {
+			delete this;
+		}
+		return result;
+	}
+
+protected:
+	virtual ~RuntimeClass() = default;
+
+private:
+	std::atomic<ULONG> _refCount = 1;
+
+};
+
+template <typename T, typename ...Args>
+ComPtr<T> Make(Args &&...args) {
+	auto result = ComPtr<T>();
+	result.Attach(new (std::nothrow) T(std::forward<Args>(args)...));
+	return result;
+}
+
+} // namespace Microsoft::WRL
diff --git a/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/module.h b/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/module.h
new file mode 100644
index 0000000..ec6d884
--- /dev/null
+++ b/Telegram/lib_base/base/platform/win/mingw_sdk/wrl/module.h
@@ -0,0 +1,155 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+// mingw-w64's <wrl/module.h> only pulls in the client side of WRL. Add the
+// out-of-process server part used for COM activation of toast notification
+// clicks: CoCreatableClass() records a class, and
+// Module<OutOfProc>::GetModule().RegisterObjects() publishes class factories
+// for all recorded classes with CoRegisterClassObject().
+#pragma once
+
+#include_next <wrl/module.h>
+#include <wrl/implements.h>
+
+#include <vector>
+
+namespace Microsoft::WRL {
+
+enum ModuleType {
+	InProc = 0x01,
+	OutOfProc = 0x02,
+	DisableCaching = 0x04,
+	InProcDisableCaching = InProc | DisableCaching,
+	OutOfProcDisableCaching = OutOfProc | DisableCaching,
+};
+
+namespace Details {
+
+struct CreatableClassEntry {
+	const CLSID *clsid = nullptr;
+	HRESULT (*create)(REFIID riid, void **object) = nullptr;
+	CreatableClassEntry *next = nullptr;
+};
+
+inline CreatableClassEntry *&CreatableClasses() {
+	static CreatableClassEntry *head = nullptr;
+	return head;
+}
+
+struct CreatableClassRegistrar {
+	explicit CreatableClassRegistrar(CreatableClassEntry *entry) {
+		entry->next = CreatableClasses();
+		CreatableClasses() = entry;
+	}
+};
+
+template <typename T>
+HRESULT CreateInstance(REFIID riid, void **object) {
+	const auto instance = new (std::nothrow) T();
+	if (!instance) {
+		return E_OUTOFMEMORY;
+	}
+	const auto result = instance->QueryInterface(riid, object);
+	instance->Release();
+	return result;
+}
+
+class ClassFactory final
+: public RuntimeClass<RuntimeClassFlags<ClassicCom>, IClassFactory> {
+public:
+	explicit ClassFactory(const CreatableClassEntry *entry)
+	: _entry(entry) {
+	}
+
+	HRESULT STDMETHODCALLTYPE CreateInstance(
+			IUnknown *outer,
+			REFIID riid,
+			void **object) override {
+		if (!object) {
+			return E_POINTER;
+		}
+		*object = nullptr;
+		return outer
+			? CLASS_E_NOAGGREGATION
+			: _entry->create(riid, object);
+	}
+
+	HRESULT STDMETHODCALLTYPE LockServer(BOOL) override {
+		return S_OK;
+	}
+
+private:
+	const CreatableClassEntry *_entry = nullptr;
+
+};
+
+} // namespace Details
+
+template <int Type>
+class Module final {
+public:
+	static Module &GetModule() {
+		static auto instance = Module();
+		return instance;
+	}
+
+	HRESULT RegisterObjects(PCWSTR serverName = nullptr) {
+		(void)serverName;
+		auto result = S_OK;
+		for (auto entry = Details::CreatableClasses()
+			; entry
+			; entry = entry->next) {
+			const auto factory = Make<Details::ClassFactory>(entry);
+			if (!factory) {
+				return E_OUTOFMEMORY;
+			}
+			auto cookie = DWORD();
+			const auto hr = CoRegisterClassObject(
+				*entry->clsid,
+				factory.Get(),
+				CLSCTX_LOCAL_SERVER,
+				REGCLS_MULTIPLEUSE,
+				&cookie);
+			if (SUCCEEDED(hr)) {
+				_cookies.push_back(cookie);
+			} else {
+				result = hr;
+			}
+		}
+		return result;
+	}
+
+	HRESULT UnregisterObjects(PCWSTR serverName = nullptr) {
+		(void)serverName;
+		auto result = S_OK;
+		for (const auto cookie : _cookies) {
+			const auto hr = CoRevokeClassObject(cookie);
+			if (FAILED(hr)) {
+				result = hr;
+			}
+		}
+		_cookies.clear();
+		return result;
+	}
+
+private:
+	Module() = default;
+
+	std::vector<DWORD> _cookies;
+
+};
+
+} // namespace Microsoft::WRL
+
+#define CoCreatableClass(className) \
+	static ::Microsoft::WRL::Details::CreatableClassEntry \
+		WrlCreatableClassEntry##className = { \
+			&__uuidof(className), \
+			&::Microsoft::WRL::Details::CreateInstance<className>, \
+		}; \
+	static const ::Microsoft::WRL::Details::CreatableClassRegistrar \
+		WrlCreatableClassRegistrar##className( \
+			&WrlCreatableClassEntry##className);
-- 
