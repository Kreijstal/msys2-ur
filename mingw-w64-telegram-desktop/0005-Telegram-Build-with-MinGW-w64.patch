diff --git a/Telegram/cmake/generate_midl.cmake b/Telegram/cmake/generate_midl.cmake
index d3ec53c..6d7d924 100644
--- a/Telegram/cmake/generate_midl.cmake
+++ b/Telegram/cmake/generate_midl.cmake
@@ -27,15 +27,39 @@ function(generate_midl target_name src_loc)
             ${gen_dst}/${file_name}_i.c
             ${gen_dst}/${file_name}_h.h
         )
-        list(APPEND gen_commands
-        COMMAND
-            midl
-            /out ${gen_dst}
-            /h ${file_name}_h.h
-            /env ${env}
-            /notlb
-            ${src_loc}/${file}
-        )
+        if (MINGW)
+            # mingw-w64 comes with Wine's MIDL compiler instead. It writes
+            # one kind of output per run: the header, then the IID file.
+            if (CMAKE_SIZEOF_VOID_P EQUAL 8)
+                set(widl_arch -m64)
+            else()
+                set(widl_arch -m32)
+            endif()
+            list(APPEND gen_commands
+            COMMAND
+                widl
+                ${widl_arch}
+                -h
+                -o ${gen_dst}/${file_name}_h.h
+                ${src_loc}/${file}
+            COMMAND
+                widl
+                ${widl_arch}
+                -u
+                -o ${gen_dst}/${file_name}_i.c
+                ${src_loc}/${file}
+            )
+        else()
+            list(APPEND gen_commands
+            COMMAND
+                midl
+                /out ${gen_dst}
+                /h ${file_name}_h.h
+                /env ${env}
+                /notlb
+                ${src_loc}/${file}
+            )
+        endif()
     endforeach()
 
