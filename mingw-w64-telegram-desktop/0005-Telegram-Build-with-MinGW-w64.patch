 Telegram/Resources/winrc/Telegram.rc          | 12 ++++++
 .../SourceFiles/platform/win/specific_win.cpp | 10 +++++
 .../platform/win/wallet_protection_win.cpp    |  8 ++++
 .../win/windows_app_user_model_id.cpp         |  9 +++-
 .../platform/win/windows_toast_activator.h    |  5 +++
 .../settings/sections/settings_advanced.cpp   |  6 +--
 Telegram/cmake/generate_midl.cmake            | 42 +++++++++++++++----
 8 files changed, 82 insertions(+), 14 deletions(-)

diff --git a/Telegram/CMakeLists.txt b/Telegram/CMakeLists.txt
index 11d2fc6..406d982 100644
--- a/Telegram/CMakeLists.txt
+++ b/Telegram/CMakeLists.txt
@@ -2564,7 +2564,9 @@ if (WIN32)
         )
     endif()
 
-    target_link_options(Telegram PRIVATE /PDBPAGESIZE:8192)
+    if (MSVC)
+        target_link_options(Telegram PRIVATE /PDBPAGESIZE:8192)
+    endif()
 
     if (DESKTOP_APP_WIN7_BASELINE)
         # The loader reads the subsystem version as the minimal Windows.
diff --git a/Telegram/Resources/winrc/Telegram.rc b/Telegram/Resources/winrc/Telegram.rc
index 3cfe2df..da91f70 100644
--- a/Telegram/Resources/winrc/Telegram.rc
+++ b/Telegram/Resources/winrc/Telegram.rc
@@ -38,6 +38,18 @@ LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
 // remains consistent on all systems.
 IDI_ICON1               ICON                    "..\\art\\icon256.ico"
 
+#if defined(__MINGW64__) || defined(__MINGW32__)
+/////////////////////////////////////////////////////////////////////////////
+//
+// Manifest
+//
+// MSVC embeds Telegram.manifest at link time, the GNU toolchain has to get
+// it from here (it replaces the generic default manifest MinGW links in).
+//
+
+1 RT_MANIFEST "Telegram.manifest"
+#endif
+
 /////////////////////////////////////////////////////////////////////////////
 //
 // Version
diff --git a/Telegram/SourceFiles/platform/win/specific_win.cpp b/Telegram/SourceFiles/platform/win/specific_win.cpp
index ba7f267..e1fc7c2 100644
--- a/Telegram/SourceFiles/platform/win/specific_win.cpp
+++ b/Telegram/SourceFiles/platform/win/specific_win.cpp
@@ -277,6 +277,7 @@ void psDoCleanup() {
 }
 
 int psCleanup() {
+#ifdef _MSC_VER
 	__try
 	{
 		psDoCleanup();
@@ -285,6 +286,10 @@ int psCleanup() {
 	{
 		return 0;
 	}
+#else // _MSC_VER
+	// GCC has no SEH __try/__except, rely on the C++ handler inside.
+	psDoCleanup();
+#endif // _MSC_VER
 	return 0;
 }
 
@@ -343,6 +348,7 @@ void psDoFixPrevious() {
 }
 
 int psFixPrevious() {
+#ifdef _MSC_VER
 	__try
 	{
 		psDoFixPrevious();
@@ -351,6 +357,10 @@ int psFixPrevious() {
 	{
 		return 0;
 	}
+#else // _MSC_VER
+	// GCC has no SEH __try/__except, rely on the C++ handler inside.
+	psDoFixPrevious();
+#endif // _MSC_VER
 	return 0;
 }
 
diff --git a/Telegram/SourceFiles/platform/win/wallet_protection_win.cpp b/Telegram/SourceFiles/platform/win/wallet_protection_win.cpp
index ce7ab60..29f54bb 100644
--- a/Telegram/SourceFiles/platform/win/wallet_protection_win.cpp
+++ b/Telegram/SourceFiles/platform/win/wallet_protection_win.cpp
@@ -200,10 +200,15 @@ void FocusUnownedPrompt(int attemptsLeft = kPromptFocusAttempts) {
 // The owned overloads exist from Windows 11 24H2: on an older system the
 // factory or the credential lacks the interface, and the unowned ask runs
 // with the prompt brought forward by its class name instead.
+//
+// The C++/WinRT projection of mingw-w64 is generated from Windows metadata
+// that predates those overloads, so MinGW builds always take the unowned
+// path.
 [[nodiscard]] IAsyncOperation<KeyCredentialRetrievalResult> RequestCreate(
 		const winrt::hstring &name,
 		const std::optional<WindowId> &owner) {
 	const auto option = KeyCredentialCreationOption::ReplaceExisting;
+#ifndef __MINGW32__
 	if (owner) {
 		auto owned = base::WinRT::Try([&] {
 			return KeyCredentialManager::RequestCreateForWindowAsync(
@@ -215,6 +220,7 @@ void FocusUnownedPrompt(int attemptsLeft = kPromptFocusAttempts) {
 			return std::move(*owned);
 		}
 	}
+#endif // !__MINGW32__
 	auto result = KeyCredentialManager::RequestCreateAsync(name, option);
 	FocusUnownedPrompt();
 	return result;
@@ -224,6 +230,7 @@ void FocusUnownedPrompt(int attemptsLeft = kPromptFocusAttempts) {
 		const KeyCredential &credential,
 		const IBuffer &data,
 		const std::optional<WindowId> &owner) {
+#ifndef __MINGW32__
 	if (owner) {
 		if (const auto owned = credential.try_as<IKeyCredentialWithWindow>()) {
 			auto request = base::WinRT::Try([&] {
@@ -234,6 +241,7 @@ void FocusUnownedPrompt(int attemptsLeft = kPromptFocusAttempts) {
 			}
 		}
 	}
+#endif // !__MINGW32__
 	auto result = credential.RequestSignAsync(data);
 	FocusUnownedPrompt();
 	return result;
diff --git a/Telegram/SourceFiles/platform/win/windows_app_user_model_id.cpp b/Telegram/SourceFiles/platform/win/windows_app_user_model_id.cpp
index 3d051f4..2fa8619 100644
--- a/Telegram/SourceFiles/platform/win/windows_app_user_model_id.cpp
+++ b/Telegram/SourceFiles/platform/win/windows_app_user_model_id.cpp
@@ -15,6 +15,11 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include <propvarutil.h>
 #include <propkey.h>
 
+#ifndef APPUSERMODEL_STARTPINOPTION_NOPINONINSTALL
+// System.AppUserModel.StartPinOption value, missing from mingw-w64 <propkey.h>.
+#define APPUSERMODEL_STARTPINOPTION_NOPINONINSTALL 1
+#endif // APPUSERMODEL_STARTPINOPTION_NOPINONINSTALL
+
 namespace Platform {
 namespace AppUserModelId {
 namespace {
@@ -296,7 +301,9 @@ bool validateShortcutAt(const QString &path) {
 	PropVariantClear(&appIdPropVar);
 
 	auto clsid = CLSID();
-	hr = PropVariantToCLSID(toastActivatorPropVar, &clsid);
+	// PropVariantToCLSID() is only an inline wrapper around this one in the
+	// Windows SDK, mingw-w64 does not have it.
+	hr = PropVariantToGUID(toastActivatorPropVar, &clsid);
 	const auto good2 = SUCCEEDED(hr) && (clsid == __uuidof(ToastActivator));
 	const auto bad2 = !good2 && (toastActivatorPropVar.vt != VT_EMPTY);
 	PropVariantClear(&toastActivatorPropVar);
diff --git a/Telegram/SourceFiles/platform/win/windows_toast_activator.h b/Telegram/SourceFiles/platform/win/windows_toast_activator.h
index 0c85942..4682e22 100644
--- a/Telegram/SourceFiles/platform/win/windows_toast_activator.h
+++ b/Telegram/SourceFiles/platform/win/windows_toast_activator.h
@@ -39,6 +39,11 @@ private:
 
 };
 
+#ifdef __MINGW32__
+// GCC ignores DECLSPEC_UUID, __uuidof() needs the IID declared explicitly.
+__CRT_UUID_DECL(ToastActivator, 0xf11932d3, 0x6110, 0x4bbc, 0x9b, 0x02, 0xb2, 0xec, 0x07, 0xa1, 0xbd, 0x19)
+#endif // __MINGW32__
+
 struct ToastActivation {
 	struct UserInput {
 		QString key;
