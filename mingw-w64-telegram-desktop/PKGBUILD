# The full tarball carries relative symlinks, some pointing at paths that are
# extracted later, which MSYS cannot create. All but one sit in the Linux-only
# input-method plugins (fcitx5-qt, hime, nimf); the last is hunspell/README.
# Unpack it by hand without them.
noextract=("tdesktop-${pkgver}-full.tar.gz")

prepare() {
  cd "${srcdir}"
  local _tp="tdesktop-${pkgver}-full/Telegram/ThirdParty"
  bsdtar -xf "tdesktop-${pkgver}-full.tar.gz" \
    --exclude "${_tp}/fcitx5-qt" \
    --exclude "${_tp}/hime" \
    --exclude "${_tp}/nimf" \
    --exclude "${_tp}/hunspell/README"

  mv "td-${_td_commit}" td
  mv "tlottie-${_tlottie_commit}" tlottie
  mv "wallet-engine-${_wallet_engine_commit}" wallet-engine

  # tdesktop's wallet integration needs the extra TON Connect cell decoding
  # API it adds on top of the pinned wallet-engine.
  patch -d wallet-engine -Np1 -i "${srcdir}/wallet-engine-${_patches_commit:0:7}.patch"

  # TDLib's TL parser defines __attribute__ away on every Windows compiler,
  # breaking the fortified mingw-w64 CRT headers.
  patch -d td -Np1 -i "${srcdir}/td-0001-tl-parser-Only-define-away-__attribute__-for-MSVC.patch"

  _prepare_tdesktop_rust

  cd "${srcdir}/tdesktop-${pkgver}-full"
  # Bundled range-v3: member function projections fail with MinGW GCC.
  patch -Np1 -i "${srcdir}/0001-range-v3-Do-not-let-member-function-pointers-match-t.patch"
  # Stand-ins for the parts of the Windows SDK mingw-w64 lacks (classic COM
  # WRL, interop headers), C++/WinRT linkage, DLL search path.
  patch -Np1 -i "${srcdir}/0002-lib_base-Build-with-mingw-w64.patch"
  # WebView2 from MSYS2's webview2-loader instead of NuGet, plus the
  # __uuidof() declarations GCC needs for its MIDL-generated header.
  patch -Np1 -i "${srcdir}/0003-lib_webview-Use-the-WebView2-SDK-of-the-MinGW-enviro.patch"
  patch -Np1 -i "${srcdir}/0004-lib_ui-lib_webrtc-tgcalls-Fix-building-with-MinGW-GC.patch"
  # widl instead of midl, manifest through the resource script, no SEH,
  # declarations mingw-w64 is missing.
  patch -Np1 -i "${srcdir}/0005-Telegram-Build-with-MinGW-w64.patch"
}

_build_tde2e() {
  # The TL parser's bundled getopt is K&R C with empty-parameter-list
  # prototypes, which mean "no parameters" in C23, GCC's default since 15.
  CFLAGS="${CFLAGS} -std=gnu17" \
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="$(cygpath -m "${srcdir}/deps")" \
      -DCMAKE_BUILD_TYPE=Release \
      -DTD_E2E_ONLY=ON \
      -DBUILD_TESTING=OFF \
      -S "${srcdir}/td" \
      -B "${srcdir}/build-td-${MSYSTEM}"
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/build-td-${MSYSTEM}"
  "${MINGW_PREFIX}/bin/cmake.exe" --install "${srcdir}/build-td-${MSYSTEM}"
}

_prepare_tdesktop_rust() {
  # Upstream builds tlottie and wallet-engine as a single Rust staticlib:
  # each staticlib carries its own copy of std, and two of them in one binary
  # define the same runtime symbols twice. The umbrella crate is generated
  # the same way prepare.py does; its lock file is shipped with the package
  # so the dependency graph is fixed.
  local _crate="${srcdir}/tdesktop_rust"
  mkdir -p "${_crate}/src"
  cat > "${_crate}/Cargo.toml" <<'END'
[package]
name = "tdesktop_rust"
version = "0.1.0"
edition = "2024"

[dependencies]
tlottie = { version = "1.0.6", path = "../tlottie", features = ["c-api"] }
wallet-engine = { version = "0.0.7", path = "../wallet-engine" }
END
  printf 'pub use ::tlottie;\npub use ::wallet_engine;\n' > "${_crate}/src/lib.rs"
  cp "${srcdir}/tdesktop_rust-Cargo.lock" "${_crate}/Cargo.lock"

  local _target
  _target="$(rustc -vV | sed -n 's/^host: //p')"
  cargo fetch --locked --target "${_target}" --manifest-path "${_crate}/Cargo.toml"
  cargo fetch --locked --target "${_target}" \
    --manifest-path "${srcdir}/wallet-engine/bindgen/cpp/bindgen/Cargo.toml"
}

_build_tdesktop_rust() {
  local _crate="${srcdir}/tdesktop_rust"
  cd "${_crate}"
  # Thin LTO, one codegen unit and unwinding panics as in prepare.py;
  # opt-level 3 for everything like the snap build (prepare.py only uses it
  # for tlottie, to keep the Windows wallet-engine small).
  cargo rustc --lib --release --frozen \
    --crate-type staticlib --crate-type cdylib \
    --config "profile.release.opt-level=3" \
    --config "profile.release.lto='thin'" \
    --config "profile.release.codegen-units=1" \
    --config "profile.release.panic='unwind'"

  local _out="${srcdir}/deps"
  install -Dm644 target/release/libtdesktop_rust.a "${_out}/lib/libtdesktop_rust.a"
  install -Dm644 "${srcdir}/tlottie/include/tlottie.h" "${_out}/include/tlottie/tlottie.h"
  # The C++ bindings are generated from the metadata uniffi embeds in the
  # cdylib; tdesktop compiles the generated wallet_engine.cpp itself.
  cargo run --frozen --manifest-path "${srcdir}/wallet-engine/bindgen/cpp/bindgen/Cargo.toml" -- \
    --library --out-dir "${_out}/include/wallet_engine" \
    target/release/tdesktop_rust.dll
}

build() {
  _build_tde2e
  _build_tdesktop_rust

  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  local _deps
  _deps="$(cygpath -m "${srcdir}/deps")"

  # range-v3 is taken from the copy bundled in the tarball, which carries a
  # fix for MinGW GCC (see 0001); the 0.12.0 release MSYS2 packages cannot
  # be patched from here.
  #
  # TDESKTOP_API_ID/HASH are the public credentials Telegram allows
  # distributions to use (the same ones its snap build and Arch use).
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=;-Dtde2e_DIR=;-DDESKTOP_APP_" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${_extra_config[@]}" \
      -DTDESKTOP_API_ID=611335 \
      -DTDESKTOP_API_HASH=d524b414d21f4d37f08684c1df41ac9c \
      -DDESKTOP_APP_USE_PACKAGED=ON \
      -DCMAKE_DISABLE_FIND_PACKAGE_range-v3=ON \
      -Dtde2e_DIR="${_deps}/lib/cmake/tde2e" \
      -DDESKTOP_APP_TDESKTOP_RUST_LIBRARY="${_deps}/lib/libtdesktop_rust.a" \
      -DDESKTOP_APP_TLOTTIE_INCLUDE_DIR="${_deps}/include/tlottie" \
      -DDESKTOP_APP_WALLET_ENGINE_INCLUDE_DIR="${_deps}/include/wallet_engine" \
      -S "${srcdir}/tdesktop-${pkgver}-full" \
      -B "${srcdir}/build-${MSYSTEM}"

  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/build-${MSYSTEM}"
}

check() {
  # Upstream's tests are developer-only test apps. Run the real executable
  # instead: -quit goes through Qt and platform start-up, the working
  # directory and single-instance setup, then exits as no other instance
  # is running.
  local _workdir="${srcdir}/check-workdir"
  rm -rf "${_workdir:?}"
  mkdir -p "${_workdir}"
  "${srcdir}/build-${MSYSTEM}/Telegram.exe" -quit -workdir "$(cygpath -w "${_workdir}")"
  grep -q "This is the only instance of Telegram" "${_workdir}"/log_start*.txt
}

package() {
  install -Dm755 "${srcdir}/build-${MSYSTEM}/Telegram.exe" \
    "${pkgdir}${MINGW_PREFIX}/bin/Telegram.exe"

  install -Dm644 "${srcdir}/tdesktop-${pkgver}-full/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
