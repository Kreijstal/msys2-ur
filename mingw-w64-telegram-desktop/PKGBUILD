# Revisions tdesktop v7.3.3 pins for the pieces it builds from source on
# every platform (Telegram/build/prepare/prepare.py and snap/snapcraft.yaml).
# tde2e is TDLib's end-to-end encryption core, built on its own
# (TD_E2E_ONLY); MSYS2's tdlib package ships libtde2e.a but not its headers
# or CMake package, and is a different revision.
_td_commit=51743dfd01dff6179e2d8f7095729caa4e2222e9
# Lottie renderer and TON wallet engine, both Rust, linked as one staticlib.
_tlottie_commit=92df98dc209bc39b1e567ec74a8c86a0af5239de
_wallet_engine_commit=e59e0d89d7ee90c388bf36e3334c5b276f396697
# desktop-app/patches revision holding the wallet-engine.patch tdesktop uses.
_patches_commit=a895fef40eaa7d66481cff542c623b039b7ce494
pkgdesc="Official Telegram Desktop messaging app (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://desktop.telegram.org/'
msys2_repository_url='https://github.com/telegramdesktop/tdesktop'
