From afec60cdea970f3b2171498fe1faa32ab22f2cb2 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Mon, 26 Oct 2026 02:11:48 +0100
Subject: [PATCH 3/5] lib_webview: Use the WebView2 SDK of the MinGW
 environment

The WebView2 loader is fetched from NuGet as a static MSVC library.
MSYS2 ships the SDK headers and WebView2Loader.dll (webview2-loader), so
with MinGW link that DLL directly instead.

That WebView2.h is MIDL output: interface IIDs are given only through
MIDL_INTERFACE(), i.e. __declspec(uuid()), which GCC ignores, while
C++/WinRT's com_ptr::try_as, winrt::implements and WRL need __uuidof()
for every interface. Generate a wrapper header at configure time that
includes the real one and adds a __CRT_UUID_DECL() per interface, and
put it first on lib_webview's include path.

Also capture the 'fail' lambda used inside 'done': GCC requires the
capture for a local constexpr lambda that is called, MSVC does not.
---
 Telegram/lib_webview/CMakeLists.txt           | 22 +++++++++
 .../platform/win/mingw_webview2_uuids.py      | 45 +++++++++++++++++++
 .../win/webview_windows_edge_chromium.cpp     |  2 +-
 cmake/nuget.cmake                             | 14 ++++++
 4 files changed, 82 insertions(+), 1 deletion(-)
 create mode 100644 Telegram/lib_webview/webview/platform/win/mingw_webview2_uuids.py

diff --git a/Telegram/lib_webview/CMakeLists.txt b/Telegram/lib_webview/CMakeLists.txt
index 1ce6de8..2e71e9f 100644
--- a/Telegram/lib_webview/CMakeLists.txt
+++ b/Telegram/lib_webview/CMakeLists.txt
@@ -60,6 +60,28 @@ PUBLIC
 
 if (WIN32)
     nuget_add_webview(lib_webview)
+    if (MINGW)
+        find_file(DESKTOP_APP_WEBVIEW2_HEADER WebView2.h REQUIRED)
+        find_package(Python3 REQUIRED COMPONENTS Interpreter)
+        set(webview2_gen_loc ${CMAKE_CURRENT_BINARY_DIR}/gen/mingw_sdk)
+        file(MAKE_DIRECTORY ${webview2_gen_loc})
+        execute_process(
+        COMMAND
+            ${Python3_EXECUTABLE}
+            ${src_loc}/webview/platform/win/mingw_webview2_uuids.py
+            ${DESKTOP_APP_WEBVIEW2_HEADER}
+            ${webview2_gen_loc}/WebView2.h
+        COMMAND_ERROR_IS_FATAL ANY
+        )
+        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+            ${DESKTOP_APP_WEBVIEW2_HEADER}
+            ${src_loc}/webview/platform/win/mingw_webview2_uuids.py
+        )
+        target_include_directories(lib_webview BEFORE
+        PRIVATE
+            ${webview2_gen_loc}
+        )
+    endif()
 elseif (LINUX)
     include(${cmake_helpers_loc}/external/glib/generate_dbus.cmake)
     generate_dbus(lib_webview org.desktop_app.GtkIntegration.Webview. Webview ${src_loc}/webview/platform/linux/webview_linux_interface.xml)
diff --git a/Telegram/lib_webview/webview/platform/win/mingw_webview2_uuids.py b/Telegram/lib_webview/webview/platform/win/mingw_webview2_uuids.py
new file mode 100644
index 0000000..2013a52
--- /dev/null
+++ b/Telegram/lib_webview/webview/platform/win/mingw_webview2_uuids.py
@@ -0,0 +1,45 @@
+# This file is part of Desktop App Toolkit,
+# a set of libraries for developing nice desktop applications.
+#
+# For license and copyright information please follow this link:
+# https://github.com/desktop-app/legal/blob/master/LEGAL
+#
+# The WebView2 SDK header is MIDL output: interfaces carry their IID only in
+# MIDL_INTERFACE("..."), i.e. __declspec(uuid()), which GCC ignores. With
+# mingw-w64, __uuidof() (used by C++/WinRT's com_ptr::as/try_as and
+# winrt::implements, and by WRL) needs a __CRT_UUID_DECL for each interface.
+# Generate a wrapper header that includes the real one and adds them.
+import re
+import sys
+
+source, output = sys.argv[1], sys.argv[2]
+text = open(source, encoding='utf-8', errors='replace').read()
+pattern = re.compile(
+    r'MIDL_INTERFACE\("([0-9A-Fa-f]{8})-([0-9A-Fa-f]{4})-([0-9A-Fa-f]{4})-'
+    r'([0-9A-Fa-f]{4})-([0-9A-Fa-f]{12})"\)\s+(\w+)\s*:')
+lines = [
+    '// Generated by mingw_webview2_uuids.py, do not edit.',
+    '#pragma once',
+    '',
+    '#include_next <WebView2.h>',
+    '',
+]
+seen = set()
+for m in pattern.finditer(text):
+    name = m.group(6)
+    if name in seen:
+        continue
+    seen.add(name)
+    tail = m.group(4) + m.group(5)
+    octets = ', '.join('0x' + tail[i:i + 2] for i in range(0, 16, 2))
+    lines.append('__CRT_UUID_DECL(%s, 0x%s, 0x%s, 0x%s, %s)' % (
+        name, m.group(1), m.group(2), m.group(3), octets))
+if not seen:
+    sys.exit('no MIDL_INTERFACE declarations found in ' + source)
+content = '\n'.join(lines) + '\n'
+try:
+    if open(output, encoding='utf-8').read() == content:
+        sys.exit(0)
+except OSError:
+    pass
+open(output, 'w', encoding='utf-8').write(content)
diff --git a/Telegram/lib_webview/webview/platform/win/webview_windows_edge_chromium.cpp b/Telegram/lib_webview/webview/platform/win/webview_windows_edge_chromium.cpp
index af58761..dddc79c 100644
--- a/Telegram/lib_webview/webview/platform/win/webview_windows_edge_chromium.cpp
+++ b/Telegram/lib_webview/webview/platform/win/webview_windows_edge_chromium.cpp
@@ -787,7 +787,7 @@ HRESULT STDMETHODCALLTYPE Handler::Invoke(
 		}
 		return S_OK;
 	};
-	constexpr auto done = [](
+	constexpr auto done = [fail](
 			ICoreWebView2Environment *environment,
 			ICoreWebView2WebResourceRequestedEventArgs *args,
 			DataResponse resolved) {
diff --git a/cmake/nuget.cmake b/cmake/nuget.cmake
index e89d796..8422238 100644
--- a/cmake/nuget.cmake
+++ b/cmake/nuget.cmake
@@ -45,6 +45,20 @@ function(nuget_add_package package_name package package_version)
 endfunction()
 
 function(nuget_add_webview target_name)
+    if (MINGW)
+        # MSYS2 ships the WebView2 SDK headers and the loader DLL in its
+        # webview2-loader package, there is no static loader library to fetch
+        # from NuGet. GNU ld links against the DLL's exports directly.
+        find_file(DESKTOP_APP_WEBVIEW2_LOADER WebView2Loader.dll
+            PATH_SUFFIXES bin
+            REQUIRED)
+        target_link_libraries(${target_name}
+        PRIVATE
+            ${DESKTOP_APP_WEBVIEW2_LOADER}
+        )
+        return()
+    endif()
+
     nuget_add_package(webview2 "Microsoft.Web.WebView2" 1.0.1901.177)
 
     set(webview2_loc_native ${webview2_loc}/build/native)
