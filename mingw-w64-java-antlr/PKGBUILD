# Maintainer: Kreijstal <rainb@tfwno.gf>

pkgbase=mingw-w64-java-antlr
pkgname="${MINGW_PACKAGE_PREFIX}-java-antlr"
pkgver=2.7.7
pkgrel=1
pkgdesc="ANTLR 2 parser generator and runtime, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://www.antlr2.org/'
license=('spdx:LicenseRef-ANTLR-PD')
depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21")
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=('https://www.antlr2.org/download/antlr-2.7.7.tar.gz')
sha256sums=('853aeb021aef7586bda29e74a6b03006bcb565a755c86b66032d8ec31b67dbb9')

prepare() {
  find antlr-2.7.7 -type f \( -name '*.jar' -o -name '*.class' \) -delete
  # Sources predate Java 5: rename the later-reserved identifier.
  find antlr-2.7.7/antlr -name '*.java' -exec sed -i 's/\<enum\>/enumeration/g' {} +
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  JB_RELEASE=8 jb_module antlr:antlr:${pkgver} antlr-2.7.7/antlr
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck antlr:antlr
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install antlr:antlr
  install -Dm644 antlr-2.7.7/LICENSE.txt "${pkgdir}${MINGW_PREFIX}/share/licenses/java-antlr/LICENSE"
}
