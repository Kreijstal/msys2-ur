From 7311c7966ef4d7c6981eacdaf6207d695e782933 Mon Sep 17 00:00:00 2001
From: Kreijstal <rainb@tfwno.gf>
Date: Sun, 8 Nov 2026 09:51:26 +0100
Subject: [PATCH] Install the library with a CMake package config

---
 CMakeLists.txt | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 944025a..ebbaf0a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -120,3 +120,21 @@ endif ()
 if(WIN32)
     set_target_properties(cura-formulae-engine PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
 endif()
+
+install(TARGETS cura-formulae-engine EXPORT cura-formulae-engine-targets
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(DIRECTORY include/cura-formulae-engine DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+install(EXPORT cura-formulae-engine-targets NAMESPACE cura-formulae-engine::
+        DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/cura-formulae-engine)
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/cura-formulae-engineConfig.cmake [=[
+include(CMakeFindDependencyMacro)
+find_dependency(spdlog)
+find_dependency(lexy)
+find_dependency(zeus_expected)
+find_dependency(range-v3)
+include(${CMAKE_CURRENT_LIST_DIR}/cura-formulae-engine-targets.cmake)
+]=])
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/cura-formulae-engineConfig.cmake
+        DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/cura-formulae-engine)
-- 
