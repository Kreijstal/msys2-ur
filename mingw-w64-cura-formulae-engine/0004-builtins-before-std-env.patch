diff --git a/include/cura-formulae-engine/config.h b/include/cura-formulae-engine/config.h
index 8651a25..f69289e 100644
--- a/include/cura-formulae-engine/config.h
+++ b/include/cura-formulae-engine/config.h
@@ -9,3 +9,11 @@
 #else
 #    define CURA_FORMULAE_ENGINE_API
 #endif
+
+// std_env copies the builtin functions while it is initialized; PE targets run
+// GCC's constructors in reverse link order, so they have to be built first
+#if defined(__GNUC__)
+#    define CURA_FORMULAE_ENGINE_EARLY_INIT __attribute__((init_priority(1000)))
+#else
+#    define CURA_FORMULAE_ENGINE_EARLY_INIT
+#endif
