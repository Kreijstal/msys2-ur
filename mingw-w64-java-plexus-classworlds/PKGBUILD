# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=plexus-classworlds
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=2.11.0
pkgrel=1
pkgdesc="Plexus class loader framework (Maven's launcher), built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://codehaus-plexus.github.io/plexus-classworlds/'
msys2_repository_url='https://github.com/codehaus-plexus/plexus-classworlds'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/codehaus-plexus/plexus-classworlds/archive/refs/tags/${_realname}-${pkgver}.tar.gz")
sha256sums=('446b1eee36d4a79ebf803d8a19368eacba13c13687369362da636294b83040e9')

_src=${_realname}-${_realname}-${pkgver}

prepare() {
  cd "${_src}"
  # prebuilt test fixtures (src/test/test-data/*.jar)
  find . -name '*.jar' -print -delete
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  jb_module org.codehaus.plexus:plexus-classworlds:${pkgver} src/main/java -u pom.xml \
    -m "Automatic-Module-Name: org.codehaus.plexus.classworlds" \
    -m "Main-Class: org.codehaus.plexus.classworlds.launcher.Launcher"
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests need JUnit 5 and the prebuilt fixture jars removed above
  jb_loadcheck org.codehaus.plexus:plexus-classworlds
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.codehaus.plexus:plexus-classworlds
  install -Dm644 "${_src}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-${_realname}/LICENSE.txt"
}
