# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=libx11
urlpkgname=libX11
pkgver=1.8.8
pkgrel=1
pkgdesc="X Window System client-side library"
arch=('i686' 'x86_64')
url="https://www.x.org/"
license=('MIT')
depends=()
makedepends=('xtrans' 'autoconf' 'automake' 'libtool' 'gcc' 'ccache')

XORG_SRC_COMPRESSION=${XORG_SRC_COMPRESSION:-xz}
source=(https://www.x.org/archive/individual/lib/${urlpkgname}-${pkgver}.tar.${XORG_SRC_COMPRESSION})
sha256sums=('SKIP')  # Replace SKIP with the actual checksum

prepare() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # The release tarball ships a working ./configure. Do NOT autoreconf
  # unconditionally: on the trimmed guest the default autoreconf resolves to
  # 2.71 while only autoconf-2.72's perl modules are installed, which aborts
  # with "Can't locate Autom4te/ChannelDefs.pm". Only regenerate if configure is
  # genuinely missing (e.g. after patching configure.ac).
  if [ ! -x ./configure ]; then
    autoreconf -vif
  fi
}

build() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Force the Cygwin host triple. libtool has no msys case
  # (build_libtool_libs=no for host_os=msys), so canonicalising the host to
  # *-msys silently produces a static-only libX11.a with no msys-X11-6.dll and
  # no libX11.dll.a. That package is useless to Wine, whose winex11.drv dlopens
  # the shared library at runtime - and the failure is silent, surfacing only as
  # a missing X driver much later. x86_64-pc-cygwin gives host_os=cygwin, where
  # libtool has full shared support; --build matches so this is not treated as a
  # cross build and CC stays the msys gcc (the DLL still links msys-2.0.dll).
  # NOTE: this only works if libxcb/libXau/libXdmcp underneath are themselves
  # SHARED - libtool degrades to static if any -no-undefined dep lacks a .dll.a.
  ./configure --prefix=/usr \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --datadir=/usr/share \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info \
    --build=x86_64-pc-cygwin \
    --host=x86_64-pc-cygwin \
    --enable-shared \
    --enable-static

  # Name the DLL msys-X11-6.dll to match the rest of the msys2 stack (the cygwin
  # host path names it cygX11-6.dll by default).
  sed -i 's#s/\^lib/cyg/#s/^lib/msys-/#g' libtool

  # Override the autotools-regeneration recipes so a stale Makefile.in mtime
  # cannot trigger a doomed automake re-run on the guest's broken autoconf split.
  make AUTOMAKE=: AUTOCONF=: AUTOHEADER=: ACLOCAL=: MAKEINFO=:
}

check() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Run any check commands here, such as "make check"
  make check
}

package() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Install the package to the system
  make DESTDIR=${pkgdir} install AUTOMAKE=: AUTOCONF=: AUTOHEADER=: ACLOCAL=: MAKEINFO=:

  # A static-only libX11 satisfies configure checks but leaves winex11.drv with
  # nothing to dlopen. Fail loudly here rather than shipping a package that
  # breaks Wine at runtime.
  if [ ! -f "${pkgdir}/usr/lib/libX11.dll.a" ]; then
    echo "ERROR: libX11 built static-only (no libX11.dll.a) - refusing to package" >&2
    echo "       check that libxcb/libXau/libXdmcp are SHARED (.dll.a present)" >&2
    return 1
  fi
}
