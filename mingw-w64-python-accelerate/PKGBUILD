_realname=accelerate
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.15.0
pkgrel=1
pkgdesc="Run PyTorch training on any device and distributed configuration (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/huggingface/accelerate'
msys2_repository_url='https://github.com/huggingface/accelerate'
msys2_references=(
  'purl: pkg:pypi/accelerate'
)
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-huggingface-hub"
         "${MINGW_PACKAGE_PREFIX}-python-numpy"
         "${MINGW_PACKAGE_PREFIX}-python-packaging"
         "${MINGW_PACKAGE_PREFIX}-python-psutil"
         "${MINGW_PACKAGE_PREFIX}-python-pytorch"
         "${MINGW_PACKAGE_PREFIX}-python-safetensors"
         "${MINGW_PACKAGE_PREFIX}-python-yaml")
optdepends=("${MINGW_PACKAGE_PREFIX}-python-rich: rich tracebacks")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools")
options=('!strip')
source=("https://pypi.org/packages/source/a/accelerate/accelerate-${pkgver}.tar.gz"
        '0001-model-has-dtensor-without-distributed.patch')
sha256sums=('5654f8c5eaa0d4fa68b33e287a97765da6849bf6d51dcac874e73fbbddfb6134'
            'bed17b60dccd72dc4c2db3557300d5c1508875c5a060e04bec1c1217a3564f94')

prepare() {
  cd "accelerate-${pkgver}"
  # MSYS2's pytorch is built without torch.distributed; prepare() must not
  # import torch.distributed.tensor then
  patch -Np1 -i "${srcdir}/0001-model-has-dtensor-without-distributed.patch"
}

build() {
  cp -r "accelerate-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import torch
from torch.utils.data import DataLoader, TensorDataset
from accelerate import Accelerator
acc = Accelerator(cpu=True)
torch.manual_seed(0)
x = torch.randn(64, 4); y = x @ torch.tensor([1., -2., 3., 0.5]) + 0.1
model = torch.nn.Linear(4, 1)
opt = torch.optim.SGD(model.parameters(), lr=0.1)
dl = DataLoader(TensorDataset(x, y), batch_size=16)
model, opt, dl = acc.prepare(model, opt, dl)
losses = []
for _ in range(3):
    for xb, yb in dl:
        loss = torch.nn.functional.mse_loss(model(xb).squeeze(-1), yb)
        acc.backward(loss); opt.step(); opt.zero_grad()
        losses.append(loss.item())
assert losses[-1] < losses[0], losses
print(acc.device, losses[0], losses[-1])
PY
  ${MINGW_PREFIX}/bin/python -c "from accelerate.commands.accelerate_cli import main; main()" env
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
