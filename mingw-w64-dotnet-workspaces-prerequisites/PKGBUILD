pkgver=8.0.31
pkgrel=1
pkgdesc='Source-built MEF2 and Pipelines prerequisites for Roslyn Workspaces'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-targeting-pack>=8.0.131-2" 'python')
options=('!strip' '!lto')
source=("runtime-v$pkgver.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v$pkgver"
        prepare.py make-meta.py libraries.json Microsoft.pubkey.hex Open.pubkey.hex build.sh check.cs CheckResources.cs check.sh InspectApi.cs ExpectedApi.json published-metadata-provenance.json check-api.sh README.md)
noextract=("runtime-v$pkgver.tar.gz")
