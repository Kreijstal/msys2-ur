prepare() {
  local inputs=("runtime-$pkgver/LICENSE.TXT" "runtime-$pkgver/THIRD-PARTY-NOTICES.TXT"
                "runtime-$pkgver/src/libraries/Common/src" "runtime-$pkgver/src/libraries/System.Private.CoreLib/src"
                "runtime-$pkgver/src/libraries/System.Composition")
  while read -r id;do inputs+=("runtime-$pkgver/src/libraries/$id");done < <(/usr/bin/python3 -c 'import json,sys;[print(e["id"]) for e in json.load(open(sys.argv[1]))]' "$srcdir/libraries.json")
  tar -xzf "$srcdir/runtime-v$pkgver.tar.gz" -C "$srcdir" "${inputs[@]}"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/runtime-$pkgver" "$srcdir/prepared"
  /usr/bin/python3 "$srcdir/make-meta.py" "$srcdir/prepared"
}
build() { bash "$srcdir/build.sh" "$srcdir/prepared"; }
check() {
  bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/prepared/localization.json" "$srcdir/feed"
  bash "$srcdir/check-api.sh" "$srcdir/check" "$srcdir/check-api"
}
_install() {
  local suffix=$1 id=$2
  install -Dm644 "$srcdir/feed/$id.8.0.0.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${id,,}.8.0.0.nupkg"
  install -Dm644 "$srcdir/runtime-$pkgver/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/LICENSE"
  install -Dm644 "$srcdir/runtime-$pkgver/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-$suffix/THIRD-PARTY-NOTICES"
  for file in README.md ExpectedApi.json libraries.json published-metadata-provenance.json;do
    install -Dm644 "$srcdir/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/$file"
  done
  for file in removed-binaries.json localization.json;do
    install -m644 "$srcdir/prepared/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-$suffix/$file"
  done
}

package_mingw-w64-clang-x86_64-dotnet-composition2-attributedmodel() {
  pkgdesc='Source-built System.Composition.AttributedModel 8.0.0 from .NET 8.0.31 sources'
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
  _install composition2-attributedmodel System.Composition.AttributedModel
}

