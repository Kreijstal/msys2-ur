# Maintainer: Kreijstal <rainb@tfwno.gf>

# 3.2.0: the version Maven 3.9.16 binds to the clean lifecycle by default.

_realname=maven-clean-plugin
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.2.0
pkgrel=1
pkgdesc="Apache Maven Clean Plugin, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://maven.apache.org/plugins/maven-clean-plugin/'
msys2_repository_url='https://github.com/apache/maven-clean-plugin'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-maven-shared-utils")
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-maven-core"
             "${MINGW_PACKAGE_PREFIX}-maven-plugin-annotations")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/apache/maven-clean-plugin/archive/refs/tags/${_realname}-${pkgver}.tar.gz")
sha256sums=('40988075eb618ad18cae72eaf79bb3d5101feda7d49f487d5de7ff267f5762f9')

_src=${_realname}-${_realname}-${pkgver}

prepare() {
  # test fixtures
  find "${_src}" -name '*.jar' -print -delete
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  jb_plugin org.apache.maven.plugins:maven-clean-plugin:${pkgver} clean \
    "Apache Maven Clean Plugin" 1.8 3.2.5 src/main/java -u pom.xml \
    -- org.apache.maven:maven-plugin-api/provided org.apache.maven.shared:maven-shared-utils \
       org.apache.maven.plugin-tools:maven-plugin-annotations/provided \
       org.apache.maven:maven-core/provided
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests need maven-plugin-testing-harness
  jb_loadcheck --with org.apache.maven:maven-core org.apache.maven.plugins:maven-clean-plugin
  unzip -p "$(jb_jarpath org.apache.maven.plugins:maven-clean-plugin)" META-INF/maven/plugin.xml \
    | grep -q '<goal>clean</goal>'
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.maven.plugins:maven-clean-plugin
}
