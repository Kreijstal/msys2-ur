pkgdesc='Steinberg VST 3 SDK: interfaces, hosting and plug-in sources, CMake modules and VSTGUI (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://github.com/steinbergmedia/vst3sdk'
msys2_repository_url='https://github.com/steinbergmedia/vst3sdk'
msys2_changelog_url='https://steinbergmedia.github.io/vst3_dev_portal/pages/Versions/Index.html'
