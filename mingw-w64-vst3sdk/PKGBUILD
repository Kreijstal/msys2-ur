pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=3.8.1.84
_tag=v3.8.1_build_84
# submodule commits of the ${_tag} superproject tag
_base=fcf9da0bd27a16f7f03773a3a39822f28f5c8477
