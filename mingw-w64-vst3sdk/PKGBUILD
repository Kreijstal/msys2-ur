prepare() {
  local _sdk="${srcdir}/vst3sdk-${_tag#v}"
  local _m
  for _m in base:vst3_base-${_base} pluginterfaces:vst3_pluginterfaces-${_pluginterfaces} \
            public.sdk:vst3_public_sdk-${_public_sdk} cmake:vst3_cmake-${_cmake} \
            vstgui4:vstgui-${_vstgui}; do
    rm -rf "${_sdk:?}/${_m%%:*}"
    cp -a "${srcdir}/${_m#*:}" "${_sdk}/${_m%%:*}"
  done
  cd "${_sdk}"
  patch -Np1 -i "${srcdir}/0001-alignedalloc-use-_aligned_malloc-on-all-Windows-comp.patch"
  patch -Np1 -i "${srcdir}/0002-MinGW-link-the-wmain-tools-with-municode.patch"
}

build() {
  # Not installed: a MinGW build of the SDK's validator and "adelay" sample,
  # used by check() to prove the sources build and host a plug-in here.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -S "${srcdir}/vst3sdk-${_tag#v}" \
      -B "${srcdir}/build-${MSYSTEM}" \
      -DCMAKE_BUILD_TYPE=Release \
      -DSMTG_ENABLE_VSTGUI_SUPPORT=OFF \
      -DSMTG_ENABLE_VST3_PLUGIN_EXAMPLES=ON \
      -DSMTG_ENABLE_VST3_HOSTING_EXAMPLES=ON \
      -DSMTG_CREATE_PLUGIN_LINK=OFF \
      -DSMTG_RUN_VST_VALIDATOR=OFF
  "${MINGW_PREFIX}/bin/cmake.exe" --build "${srcdir}/build-${MSYSTEM}" --target validator adelay
}

check() {
  local _b="${srcdir}/build-${MSYSTEM}"
  local _v _p
  _v=$(find "${_b}" -name 'validator.exe' -print -quit)
  _p=$(find "${_b}" -type d -name 'adelay.vst3' -print -quit)
  [[ -n "${_v}" && -n "${_p}" ]] || { echo "validator or adelay.vst3 not built"; return 1; }
  "${_v}" "${_p}"
}

package() {
  local _sdk="${srcdir}/vst3sdk-${_tag#v}"
  local _dst="${pkgdir}${MINGW_PREFIX}/share/vst3sdk"
  mkdir -p "${_dst}"
  # The SDK is consumed as source (hosts compile public.sdk themselves);
  # this is the layout Audacity and others look for in $VST3SDK.
  cp -a "${_sdk}"/{base,pluginterfaces,public.sdk,cmake,vstgui4,CMakeLists.txt,LICENSE.txt,README.md} "${_dst}/"
  find "${_dst}" \( -name '.git*' -o -name '.github' \) -prune -exec rm -rf {} +
  install -Dm644 "${_sdk}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.txt"
  install -Dm644 "${_sdk}/vstgui4/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.vstgui"
}
