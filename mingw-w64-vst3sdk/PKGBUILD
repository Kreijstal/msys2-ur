        "vst3_pluginterfaces-${_pluginterfaces}.tar.gz::https://github.com/steinbergmedia/vst3_pluginterfaces/archive/${_pluginterfaces}.tar.gz"
        "vst3_public_sdk-${_public_sdk}.tar.gz::https://github.com/steinbergmedia/vst3_public_sdk/archive/${_public_sdk}.tar.gz"
        "vst3_cmake-${_cmake}.tar.gz::https://github.com/steinbergmedia/vst3_cmake/archive/${_cmake}.tar.gz"
        "vstgui-${_vstgui}.tar.gz::https://github.com/steinbergmedia/vstgui/archive/${_vstgui}.tar.gz"
        "0001-alignedalloc-use-_aligned_malloc-on-all-Windows-comp.patch"
        "0002-MinGW-link-the-wmain-tools-with-municode.patch")
