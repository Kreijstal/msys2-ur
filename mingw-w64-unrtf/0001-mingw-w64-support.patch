diff --git a/src/win32.c b/src/win32.c
new file mode 100644
index 0000000..0370776
--- /dev/null
+++ b/src/win32.c
@@ -0,0 +1,55 @@
+/* MinGW support: functions missing from the Windows C runtime, and
+   lookup of the data files relative to the executable. */
+#ifdef _WIN32
+#include <ctype.h>
+#include <string.h>
+#include <stdlib.h>
+#include <windows.h>
+
+#include "defs.h"
+
+char *strcasestr(const char *s, const char *find)
+{
+	size_t len = strlen(find);
+	for (; *s; s++)
+	{
+		if (strncasecmp(s, find, len) == 0)
+		{
+			return (char *)s;
+		}
+	}
+	return len == 0 ? (char *)s : NULL;
+}
+
+unsigned int unrtf_ntohl(unsigned int in)
+{
+	const unsigned char *f = (const unsigned char *)&in;
+	return ((unsigned int)f[3]) | ((unsigned int)f[2] << 8) |
+	       ((unsigned int)f[1] << 16) | ((unsigned int)f[0] << 24);
+}
+
+/* <exedir>/../share/unrtf/ , falling back to the configured directory. */
+char *unrtf_default_search_path(void)
+{
+	static char buf[MAX_PATH + 32];
+	char *p;
+	DWORD n = GetModuleFileNameA(NULL, buf, MAX_PATH);
+	if (n == 0 || n >= MAX_PATH)
+	{
+		return strdup(PKGDATADIR "/");
+	}
+	for (p = buf; *p; p++)
+	{
+		if (*p == '\\')
+		{
+			*p = '/';
+		}
+	}
+	if ((p = strrchr(buf, '/')) != NULL)
+	{
+		*p = '\0';
+	}
+	strcat(buf, "/../share/unrtf/");
+	return buf;
+}
+#endif
