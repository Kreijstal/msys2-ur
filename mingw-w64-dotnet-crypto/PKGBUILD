  pkgdesc='Source-built System.Security.Cryptography.Xml 8.0.4 from .NET 8.0.31 sources'
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-cryptography-pkcs=${pkgver}")
