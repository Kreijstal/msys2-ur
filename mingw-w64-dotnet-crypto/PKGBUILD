  pkgdesc='Source-built System.Security.Cryptography.Pkcs 8.0.1 from .NET 8.0.31 sources'
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-formats-asn1=${pkgver}")
  _install cryptography-pkcs System.Security.Cryptography.Pkcs 8.0.1
}

