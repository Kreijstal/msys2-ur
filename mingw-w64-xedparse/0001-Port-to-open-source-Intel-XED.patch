+// The x87 / two-operand code below sizes operands 0 and 1 only. Open-source
+// XED, unlike the XED2 kit, does not widen an immediate that does not match
+// any form (IMUL EAX, EAX, 0x1FF failed; 0xFF picked imm8 = -1), so a third
+// immediate operand gets the smallest form width that holds its value: a
+// narrower immediate must sign-extend to the same value at the operand size.
+static bool ImmFits(ULONGLONG Value, int Bits, int OperandBits, bool Widest)
+{
+    if(OperandBits <= 0 || OperandBits > 64)
+        OperandBits = 64;
+    ULONGLONG mask = OperandBits == 64 ? ~0ULL : ((1ULL << OperandBits) - 1);
+    // The value itself has to fit the operand size (either signedness)
+    if((Value & ~mask) != 0 && (Value | mask) != ~0ULL)
+        return false;
+    if(Bits >= OperandBits)
+        return true;
+    if(Widest && Bits < 64 && (Value >> Bits) == 0)
+        return true;
+    LONGLONG extended = (LONGLONG)(Value << (64 - Bits)) >> (64 - Bits);
+    return ((ULONGLONG)extended & mask) == (Value & mask);
+}
+
+static bool ResizeThirdImmediate(XEDPARSE* Parse, Inst* Instruction)
+{
+    InstOperand* dest = &Instruction->Operands[0];
+    InstOperand* imm = &Instruction->Operands[2];
+    IClassType* type = &XedInstLookupTable[Instruction->Class];
+    int eosz = OpsizeToEosz(dest->Size);
+    int operandBits = OpsizeToBits(dest->Size);
+
+    int widths[8];
+    int widthCount = 0;
+    for(int i = 0; i < type->InstructionCount; i++)
+    {
+        const xed_inst_t* inst = type->Instructions[i];
+        if(xed_inst_noperands(inst) < 3)
+            continue;
+        const xed_operand_t* op = xed_inst_operand(inst, 2);
+        if(!xed_operand_type_is_immediate(xed_operand_type(op)))
+            continue;
+        int size = (int)xed_operand_width_bits(op, eosz ? eosz : EOSZ_64_32(Parse->x64));
+        bool known = false;
+        for(int j = 0; j < widthCount; j++)
+            known |= widths[j] == size;
+        if(!known && size > 0 && widthCount < 8)
+            widths[widthCount++] = size;
+    }
+    if(widthCount == 0)
+        return true; // nothing to choose from; leave it to the encoder
+
+    int widest = 0;
+    for(int j = 0; j < widthCount; j++)
+        widest = max(widest, widths[j]);
+    int best = INT_MAX;
+    for(int j = 0; j < widthCount; j++)
+    {
+        if(widths[j] < best && ImmFits(imm->Imm.imm, widths[j], widthCount > 1 ? operandBits : widths[j], widths[j] == widest))
+            best = widths[j];
+    }
+    if(best == INT_MAX)
+    {
+        strcpy(Parse->error, "Immediate size is too large");
+        return false;
+    }
+    imm->Size = OpsizeFromBits(best);
+    imm->BitSize = best;
+    return true;
+}
