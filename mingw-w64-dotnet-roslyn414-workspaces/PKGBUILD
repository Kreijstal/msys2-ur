# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-roslyn414-workspaces
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.14.0
pkgrel=1
pkgdesc='Original source Roslyn4.14 Common and CSharp Workspaces Standard2.0 libraries'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/roslyn'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-roslyn414=4.14.0"
         "${MINGW_PACKAGE_PREFIX}-dotnet-runtime9-libraries>=9.0.0-2"
         "${MINGW_PACKAGE_PREFIX}-dotnet-humanizer>=2.14.1-2"
         "${MINGW_PACKAGE_PREFIX}-dotnet-maintenance-netstandard>=20261028-2"
         "${MINGW_PACKAGE_PREFIX}-dotnet-netstandard-reference>=2.0.3-3")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
_commit=8edf7bcd4f1594c3d68a6a567469f41dbd33dd1b
source=("roslyn-4.14.0-${_commit:0:8}.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/$_commit"
        'workspaces414-source-1.tar.gz')
noextract=("roslyn-4.14.0-${_commit:0:8}.tar.gz")
sha256sums=('8cf2d365d1fad52b480f7c68b5c477cb586a935ada0eb309b0c40dacfec5fe9c'
            '942b4d588c6cc90e0515aca8dd5b6db3022400a3c136841c05d2aa7e2204ea92')
prepare() {
  /usr/bin/python3 "$srcdir/workspaces414-workflow/prepare.py" "$srcdir" "$srcdir/prepared" > "$srcdir/prepare.log" 2>&1
}
build() {
  bash "$srcdir/workspaces414-workflow/build.sh" "$srcdir/prepared" > "$srcdir/build.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/workspaces414-workflow/check.py" "$srcdir" "$srcdir/prepared" "$srcdir/consumer" > "$srcdir/check.log" 2>&1
  /usr/bin/python3 "$srcdir/workspaces414-workflow/audit.py" "$srcdir" "$srcdir/prepared" "$srcdir/consumer" > "$srcdir/audit.log" 2>&1
}
package() {
  local feed="$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$feed" "$doc"
  local file
  for file in "$srcdir/prepared/feed/"*.nupkg;do
    install -m644 "$file" "$feed/$(basename "$file" | tr '[:upper:]' '[:lower:]')"
  done
  install -m644 "$srcdir/workspaces414-workflow/README.md" "$doc/"
  install -m644 "$srcdir/prepared/"{source-inputs,tool-inputs,localization,source-package-audit}.json "$doc/"
  install -m644 "$srcdir/consumer/results.json" "$doc/build-consumer-results.json"
  install -Dm644 "$srcdir/prepared/roslyn-source/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/License.txt"
  install -Dm644 "$srcdir/prepared/roslyn-source/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.txt"
}
