# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-roslyn431-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.3.1
pkgrel=1
pkgdesc='Original source Roslyn4.3.1 Standard2.0 Common/CSharp libraries for PolySharp bootstrap'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/roslyn'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime9-libraries>=9.0.0-2"
         "${MINGW_PACKAGE_PREFIX}-dotnet-maintenance-netstandard>=20261028-2"
         "${MINGW_PACKAGE_PREFIX}-dotnet-netstandard-reference>=2.0.3-3")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netcore-platforms110=1.1.0"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
_commit=4bdc8414790101a4da120a92cc4bc0154ac787ca
source=("roslyn-4.3.1-${_commit:0:8}.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/$_commit"
        'roslyn431-source-1.tar.gz')
noextract=("roslyn-4.3.1-${_commit:0:8}.tar.gz")
sha256sums=('0e254cc88ce10ea4293431c4df687e0c405062a7512f811e270a2b88c5b728a1'
            'bd0bd7971f4c10904a546e777381ecac3a3701dc61daaeb7f534bb1567961fb0')
prepare() {
  /usr/bin/python3 "$srcdir/roslyn431-workflow/prepare.py" "$srcdir" "$srcdir/prepared" > "$srcdir/prepare.log" 2>&1
}
build() {
  bash "$srcdir/roslyn431-workflow/build.sh" "$srcdir/prepared" > "$srcdir/build.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/roslyn431-workflow/check.py" "$srcdir" "$srcdir/prepared" "$srcdir/consumer" > "$srcdir/check.log" 2>&1
  /usr/bin/python3 "$srcdir/roslyn431-workflow/audit.py" "$srcdir" "$srcdir/prepared" "$srcdir/consumer" > "$srcdir/audit.log" 2>&1
}
package() {
  local feed="$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$feed" "$doc"
  local file
  for file in "$srcdir/prepared/feed/"*.nupkg;do
    install -m644 "$file" "$feed/$(basename "$file" | tr '[:upper:]' '[:lower:]')"
  done
  install -m644 "$srcdir/roslyn431-workflow/README.md" "$doc/"
  install -m644 "$srcdir/prepared/"{source-inputs,tool-inputs,localization,generated-sources,operation-generated-sources,source-package-audit}.json "$doc/"
  install -m644 "$srcdir/consumer/results.json" "$doc/build-consumer-results.json"
  install -Dm644 "$srcdir/prepared/roslyn-source/License.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/License.txt"
  install -Dm644 "$srcdir/prepared/roslyn-source/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.txt"
}
