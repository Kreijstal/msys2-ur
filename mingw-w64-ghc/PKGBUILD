source=("https://downloads.haskell.org/~ghc/${pkgver}/ghc-${pkgver}-src.tar.xz"
        "https://downloads.haskell.org/~ghc/${_bootver}/ghc-${_bootver}-${_hsarch}-unknown-mingw32.tar.xz"
        'launcher.c'
        '0001-utime-mingw-utimbuf.patch'
        '0002-rts-pe-import-name-types.patch')
sha256sums=('2a83779c9af86554a3289f2787a38d6aa83d00d136aa9f920361dd693c101e77'
            'eccd82af0c7d1d5316f30e0a6dd2d6ff608a4a2a99fbdf5ccb0786c49da59b1d'
            'SKIP'
            'SKIP'
            'SKIP')
noextract=()
for _dep in "${_hadrian_deps[@]}"; do
  read -r _n _v _r _ssha _csha <<< "${_dep}"
  source+=("${_n}-${_v}.tar.gz::https://hackage.haskell.org/package/${_n}-${_v}/${_n}-${_v}.tar.gz"
           "${_n}-${_v}-r${_r}.cabal::https://hackage.haskell.org/package/${_n}-${_v}/revision/${_r}.cabal")
  sha256sums+=("${_ssha}" "${_csha}")
  noextract+=("${_n}-${_v}.tar.gz")
done
unset _dep _n _v _r _ssha _csha

_bootghc() {
  echo "${srcdir}/ghc-${_bootver}-${_hsarch}-unknown-mingw32/bin/ghc.exe"
}

prepare() {
  cd "${srcdir}/ghc-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-utime-mingw-utimbuf.patch"
  patch -Np1 -i "${srcdir}/0002-rts-pe-import-name-types.patch"

  cd "${srcdir}/ghc-${pkgver}/hadrian/bootstrap"
  rm -rf _build
  mkdir -p _build/tarballs
  local _dep _n _v _r _rest
  for _dep in "${_hadrian_deps[@]}"; do
    read -r _n _v _r _rest <<< "${_dep}"
    cp "${srcdir}/${_n}-${_v}.tar.gz" _build/tarballs/
    cp "${srcdir}/${_n}-${_v}-r${_r}.cabal" "_build/tarballs/${_n}.cabal"
  done

  # The shipped plans were generated on Linux and list unix as a GHC builtin;
  # a Windows GHC ships Win32 instead, which Setup.hs picks up on its own.
  python - <<PY
import json
plan = json.load(open("plan-bootstrap-${_bootver//./_}.json"))
plan["builtin"] = [b for b in plan["builtin"] if b["package"] != "unix"]
json.dump(plan, open("plan-bootstrap-windows.json", "w"), indent=2)
PY
}

build() {
  cd "${srcdir}/ghc-${pkgver}/hadrian/bootstrap"
  msg2 "Bootstrapping Hadrian with GHC ${_bootver}"
  python bootstrap.py --no-archive \
    -w "$(cygpath -m "$(_bootghc)")" \
    -d plan-bootstrap-windows.json

  cd "${srcdir}/ghc-${pkgver}"
  msg2 "Configuring GHC ${pkgver}"
  # Same tool choices as upstream's bundled toolchain (m4/fp_setup_windows_toolchain.m4),
  # which the distro-toolchain path does not apply. LLD's COFF driver has no -r,
  # so object merging is disabled the same way. hadrian.exe is a native program
  # and cannot spawn MSYS paths such as /usr/bin/sh, so pass those as Windows paths.
  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}" \
    --enable-distro-toolchain \
    GHC="$(_bootghc)" \
    CC=clang CXX=clang++ LD=ld.lld \
    AR=llvm-ar NM=llvm-nm RANLIB=llvm-ranlib OBJDUMP=llvm-objdump \
    DLLTOOL=llvm-dlltool WindresCmd=llvm-windres \
    CONF_GCC_LINKER_OPTS_STAGE1="-fuse-ld=lld" \
    CONF_GCC_LINKER_OPTS_STAGE2="-fuse-ld=lld" \
    MergeObjsCmd="" MergeObjsArgs="" \
    SH="$(cygpath -m /usr/bin/sh)" \
    AutoreconfCmd="$(cygpath -m /usr/bin/autoreconf)" \
    MAKEINFO="$(cygpath -m /usr/bin/makeinfo)" \
    GIT="$(cygpath -m /usr/bin/git)"

  msg2 "Building GHC ${pkgver}"
  # binary-dist-dir unconditionally copies the bundled toolchain from _build/mingw
  # on Windows and then deletes its .stamp; with a distro toolchain there is none.
  mkdir -p _build/mingw
  touch _build/mingw/.stamp
  # ACLOCAL_PATH gets converted to a Windows path list on the way into the
  # native hadrian.exe and comes back mangled for the MSYS aclocal it spawns
  # (for distrib/configure.ac, which only needs MSYS's own macros).
  # makepkg's CXX leaks into the in-tree GMP configure, whose libtool then sets
  # up an MSVC-style C++ tag (GMP never checks for GNU C++ without --enable-cxx)
  # and names the static library gmp.lib instead of libgmp.a.
  env -u ACLOCAL_PATH -u CXX -u CXXFLAGS \
  hadrian/bootstrap/_build/bin/hadrian.exe \
    -j"$(nproc)" \
    --flavour=release \
    --docs=none \
    binary-dist-dir
}

package() {
  local _bindist="${srcdir}/ghc-${pkgver}/_build/bindist/ghc-${pkgver}-${MINGW_CHOST}"
  local _dest="${pkgdir}${MINGW_PREFIX}/lib/ghc-${pkgver}"

  mkdir -p "${_dest}"
  cp -a "${_bindist}"/{bin,lib} "${_dest}/"
  [[ -d "${_bindist}/doc" ]] && cp -a "${_bindist}/doc" "${_dest}/"
  # ghcii.sh wrappers call the MinGW-bundled toolchain layout; not needed here.
  rm -f "${_dest}"/bin/ghcii*.sh

  # Launchers in ${MINGW_PREFIX}/bin forwarding to lib/ghc-${pkgver}/bin/<name>.
  mkdir -p "${pkgdir}${MINGW_PREFIX}/bin"
  ${CC:-cc} -O2 -municode -DGHC_SUBDIR="L\"ghc-${pkgver}\"" \
    -o "${srcdir}/ghc-launcher.exe" "${srcdir}/launcher.c"
  local _exe
  for _exe in "${_dest}"/bin/*.exe; do
    install -m755 "${srcdir}/ghc-launcher.exe" \
      "${pkgdir}${MINGW_PREFIX}/bin/$(basename "${_exe}")"
  done

  install -Dm644 "${srcdir}/ghc-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
