_realname=ghc
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=9.14.1
pkgrel=1
pkgdesc="The Glorious Glasgow Haskell Compilation System (mingw-w64)"
arch=('any')
mingw_arch=('clang64' 'ucrt64')
url='https://www.haskell.org/ghc/'
msys2_repository_url='https://gitlab.haskell.org/ghc/ghc'
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-clang"
         "${MINGW_PACKAGE_PREFIX}-lld"
         "${MINGW_PACKAGE_PREFIX}-llvm")
makedepends=("${MINGW_PACKAGE_PREFIX}-autotools"
             "${MINGW_PACKAGE_PREFIX}-python")
options=('!strip' 'staticlibs')

# Stage0: the only binary input. Hadrian's bootstrap plans cover 9.10/9.12
# boot compilers, so use 9.12.2 and build Hadrian plus all of its Hackage
# dependencies from source with hadrian/bootstrap/bootstrap.py (no cabal-install,
# no network during build()).
_bootver=9.12.2
_hsarch=x86_64
# name version revision src_sha256 cabal_sha256 (from plan-bootstrap-9_12_2.json)
_hadrian_deps=(
  'base16-bytestring 1.0.2.0 1 1d5a91143ef0e22157536093ec8e59d226a68220ec89378d5dcaeea86472c784 a694e88f9ec9fc79f0b03f233d3fea592b68f70a34aac2ddb5bcaecb6562e2fd'
  'clock 0.8.4 0 6ae9898afe788a5e334cd5fad5d18a3c2e8e59fa09aaf7b957dbb38a4767df2e b938655b00cf204ce69abfff946021bed111d2609a9f7a9c22e28a1a202e9115'
