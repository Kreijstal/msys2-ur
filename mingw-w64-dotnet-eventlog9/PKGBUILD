# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-eventlog9
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=9.0.11
pkgrel=1
pkgdesc='Source original NET9 EventLog servicing profile for MSBuild18'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime10-bootstrap>=10.0.5-1")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-reference9-servicing=9.0.11"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler53-bootstrap>=5.3.0.2.26113.113-3"
             "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces=4.9.2"
             "${MINGW_PACKAGE_PREFIX}-clang"
             "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn414=4.14.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netstandard-reference=2.0.3"
             "binutils"
             "${MINGW_PACKAGE_PREFIX}-python")
options=('!strip' '!lto' '!buildflags')
source=('runtime-msbuild9-fa7cdded.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/fa7cdded37981a97cec9a3e233c4a6af58a91c57'
        'intellisense9-20241010.1.nupkg::https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet9-transport/nuget/v3/flat2/microsoft.private.intellisense/9.0.0-preview-20241010.1/microsoft.private.intellisense.9.0.0-preview-20241010.1.nupkg'
        'eventlog9-source-1.tar.gz'
        'arcade-runtime9-6666973b.tar.gz::https://codeload.github.com/dotnet/arcade/tar.gz/6666973b629b24e259162dba03486c23af464bab')
noextract=('runtime-msbuild9-fa7cdded.tar.gz' 'intellisense9-20241010.1.nupkg' 'arcade-runtime9-6666973b.tar.gz')
sha256sums=('63ab12fafdec8559d59d25e21ddaf0edbde90d6c538b44d4cbb6f693a61e90df'
            '227bc364165d241eeb122e410216e9cbdb955400402475477c506e7ce8c4117c'
            '66317a10c221fe09370a7b49db15adb69962ab38e66ed7a6a42454ac8abbc386'
            '6305eac8a59c6cc9675f82afaac365f8519d8cb8e55bec6a98c9eeb6951b4a2c')
prepare() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/eventlog9-workflow/prepare.py")" "$(cygpath -am "$srcdir/runtime-msbuild9-fa7cdded.tar.gz")" "$(cygpath -am "$srcdir/prepared")" "$(cygpath -am "$srcdir/intellisense9-20241010.1.nupkg")" "$(cygpath -am "$srcdir/arcade-runtime9-6666973b.tar.gz")" > "$srcdir/prepare.log" 2>&1
}
build() {
  bash "$srcdir/eventlog9-workflow/build.sh" "$srcdir/prepared" > "$srcdir/build.log" 2>&1
}
check() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/eventlog9-workflow/check.py")" "$(cygpath -am "$srcdir/prepared")" "$(cygpath -am "$srcdir/prepared/check")" > "$srcdir/check.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/eventlog9-workflow/audit.py")" "$(cygpath -am "$srcdir/runtime-msbuild9-fa7cdded.tar.gz")" "$(cygpath -am "$srcdir/prepared")" > "$srcdir/audit.log" 2>&1
}
package() {
  local feed="$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  mkdir -p "$feed" "$doc"
  install -m644 "$srcdir/prepared/feed/system.diagnostics.eventlog.9.0.11.nupkg" "$feed/"
  install -m644 "$srcdir/prepared/"{documentation-inputs,extraction,source-audit,version-build-inputs,assembly-version-policy}.json "$doc/"
  install -m644 "$srcdir/prepared/interop/audit-results.json" "$doc/interop-generator-inputs.json"
  install -m644 "$srcdir/prepared/unsupported-build/results.json" "$doc/unsupported-build-inputs.json"
  install -m644 "$srcdir/prepared/messages/results.json" "$doc/native-message-inputs.json"
  install -m644 "$srcdir/prepared/build/results.json" "$doc/build-inputs.json"
  install -m644 "$srcdir/prepared/check/results.json" "$doc/build-consumer-results.json"
  install -m644 "$srcdir/eventlog9-workflow/README.md" "$doc/"
  install -Dm644 "$srcdir/prepared/r/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE.TXT"
  install -Dm644 "$srcdir/prepared/r/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.TXT"
}
