# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=xcb-util-errors
pkgver=1.0.1
pkgrel=1
pkgdesc="XCB errors utility library"
arch=('i686' 'x86_64')
url="http://xcb.sourceforge.net/"
license=('MIT')
depends=('libxcb')
makedepends=('libxcb' 'xorg-util-macros' 'xcb-proto' 'gcc' 'make' 'sh'
             'autoconf' 'automake' 'libtool')
source=(https://xorg.freedesktop.org/archive/individual/lib/${pkgname}-${pkgver}.tar.xz)
sha256sums=('SKIP')  # Replace SKIP with the actual checksum

prepare() {
  cd ${srcdir}/${pkgname}-${pkgver}

  # Regenerate configure so the build below uses the guest's MSYS2-patched
  # libtool.m4, whose cygwin branch renames lib -> msys- rather than cyg.
  autoreconf -vif
}

build() {
  cd ${srcdir}/${pkgname}-${pkgver}

  export PKG_CONFIG_SYSROOT_DIR=''

  # libtool has no 'msys' case: its Windows branch matches only
  # cygwin*|mingw*|windows*|pw32*|cegcc*, so an *-msys host falls through to the
  # default branch, which sets build_libtool_libs=no and an empty
  # library_names_spec - a STATIC ARCHIVE ONLY, produced silently with configure
  # still exiting 0. The host triple is what decides; x86_64-pc-cygwin selects
  # the branch with full shared-library support. --build is passed identically
  # so autoconf does not treat this as a cross build - CC stays the msys gcc,
  # only libtool's behaviour changes.
  local _host="x86_64-pc-cygwin"

  ./configure --prefix=/usr \
    --build=${_host} \
    --host=${_host} \
    --enable-shared \
    --enable-static
  make
}

check() {
  cd ${srcdir}/${pkgname}-${pkgver}

  # Add any check commands here
}

package() {
  cd ${srcdir}/${pkgname}-${pkgver}

  # Install the library and headers to the package directory
  make DESTDIR=${pkgdir} install

  # A libtool static-only degradation is silent: configure and make both still
  # exit 0, so nothing above this line can fail on it. Assert on the artifacts
  # instead. This matters beyond this package -- libtool also degrades a
  # dependent library to static when one of its dependencies has no import
  # library, so one static result quietly propagates down the whole chain.
  ls "${pkgdir}"/usr/bin/msys-*.dll >/dev/null 2>&1 || {
    echo "ERROR: ${pkgname} built static-only (no DLL installed)" >&2; return 1; }
  local _a _base
  for _a in "${pkgdir}"/usr/lib/lib*.a; do
    [ -e "${_a}" ] || continue
    case "${_a}" in *.dll.a) continue;; esac
    _base=$(basename "${_a}" .a)
    [ -f "${pkgdir}/usr/lib/${_base}.dll.a" ] || {
      echo "ERROR: ${_base} built static-only (no import library)" >&2; return 1; }
  done
}
