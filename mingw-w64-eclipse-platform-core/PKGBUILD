_pn() { local b=${1#org.eclipse.}; echo "eclipse-${b//./-}"; }

pkgname=("${MINGW_PACKAGE_PREFIX}-eclipse-equinox-executable")
for _e in "${_bundles[@]}"; do pkgname+=("${MINGW_PACKAGE_PREFIX}-$(_pn "${_e%%|*}")"); done
pkgdesc="Eclipse Platform core bundles: Equinox and the platform runtime (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://eclipse.dev/eclipse/'
msys2_repository_url='https://github.com/eclipse-platform/eclipse.platform'
license=('spdx:EPL-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-java-osgi-annotation"
             "${MINGW_PACKAGE_PREFIX}-java-osgi-service-component-annotations"
