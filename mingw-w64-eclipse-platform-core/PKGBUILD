# Maintainer: Kreijstal <rainb@tfwno.gf>

# Eclipse Platform 4.41 (2026-09), core layer: the Equinox OSGi framework and
# its services (github.com/eclipse-equinox/equinox) with the non-UI bundles of
# github.com/eclipse-platform/eclipse.platform (runtime, jobs, content types,
# expressions, e4 DI, resources, debug/team/compare core, net, help,
# update.configurator), plus the native launcher (eclipse.exe and the
# launcher library) built from the equinox executable feature's C sources.
#
# Both repositories are one pkgbase because their bundles depend on each
# other (org.eclipse.equinox.registry/.security need org.eclipse.core.jobs and
# .runtime, which need Equinox).  The UI bundles of eclipse.platform are built
# by mingw-w64-eclipse-platform-ui, after SWT, p2 and EMF.
#
# Bundles are compiled with javac from their MANIFEST.MF and build.properties
# (javabuild.sh's jb_bundle); ".qualifier" becomes the release's build id.

_realname=eclipse-platform-core
pkgbase=mingw-w64-${_realname}
pkgver=4.41
pkgrel=1
_tag=R${pkgver/./_}
_qualifier=v20260828-1142
_eq=equinox-${_tag}
_pl=eclipse.platform-${_tag}

# bundle symbolic name | directory | split packages it depends on
