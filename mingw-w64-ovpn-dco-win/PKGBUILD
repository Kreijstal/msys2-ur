# Maintainer: Kreijstal <rainb@tfwno.gf>

# ovpn-dco-win (OpenVPN data channel offload) built from source with GCC
# against the clean-room ReactOS NetAdapterCx client headers.
#
# The result is an unsigned kernel driver: it loads on ReactOS, or on
# Windows only in test-signing mode. Normal Windows installs need
# OpenVPN's signed build.
#
# Build inputs from ReactOS:
#   - the NetAdapterCx client headers and the netadaptercxstub_2_0/2_1
#     libraries (ReactOS branch netadaptercx-headers), to be packaged as
#     ${MINGW_PACKAGE_PREFIX}-reactos-netcx-headers
#   - the DDK and KMDF 1.17 headers, the generated xdk/psdk headers and the
#     ntoskrnl, wdfldr, netio and cng import libraries of a configured
#     ReactOS amd64 build tree
# Until those are packaged, point REACTOS_SOURCE_DIR at the ReactOS source
# tree and REACTOS_BUILD_DIR at a build tree where "ninja xdk psdk bugcodes
# libcntpr libntoskrnl_implib_target libwdfldr_implib_target
# libnetio_implib_target libcng_implib_target netadaptercxstub_2_0
# netadaptercxstub_2_1" has run. The ntoskrnl import library must have the
# EX_SPIN_LOCK, ExAllocatePool2, processor group and ETW exports (ReactOS
# branch ovpn-dco-prereqs); NTOSKRNL_IMPLIB can name one built elsewhere.

_realname=ovpn-dco-win
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.8.13
pkgrel=1
pkgdesc="OpenVPN data channel offload kernel driver, unsigned GCC build (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'mingw64')
url='https://github.com/OpenVPN/ovpn-dco-win'
license=('spdx:GPL-2.0-only AND MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-reactos-netcx-headers"
             'git')
install=${_realname}.install
source=("git+https://github.com/OpenVPN/ovpn-dco-win.git#tag=${pkgver}"
        0001-Use-portable-include-paths.patch
        0002-trace-Build-the-logging-macros-with-GCC.patch
        0003-Do-not-jump-over-initialized-declarations.patch
        CMakeLists.txt
        TraceLoggingProvider.h
        ovpn-gcc-prelude.h
        ovpn-gcc-shims.c
        kmdfentry.c
        mkoverlay.py
        stampinf.py)
sha256sums=('SKIP'
            '84694647f57a0ce3b9d294cb5fd7cbe16ae0d76c7c2eef78c12bea210568fb62'
            'd57c17ee6cb8b671ed769fe25e899c35381cd1b96e2637f44f408915700e6db4'
            '85d831d7a5616860133c5f3f2fdbc2d859efc5bf936d44f7be5aaf0106e1322d'
            '934da3d51747486e07fa60227ae6da71131a367150387ceb7ce1268ceb2dbf41'
            'ffe2455187f1ec4f5f322f6502ec7a6edce0a1dd7b74983b145375cd8bc07aab'
            '5900d1299e323b2de1e4fc5d775a68a367c0ad65dbd9943294624c46a2d4e351'
            '101a9c6401daffca099c011a064bdd0f4a35166feba7f57c19ebb41d2199e1a1'
            '240d74ab7fb466d353f09c2c8bce8098cc9bcaebc6b4dad10de370e8b7f8f0c6'
            '6728881f41479cd6903ee672885d5636fb0cf6bbf7bc5f1d757392577706f871'
            '931c4f3d04eafa22cece41085da92d1e40032c226e63b415e0d8944fec18845b')

# NetAdapterCx 2.0 is OpenVPN's "win10" build, 2.1 its "win11" build
_flavors=('win10:0' 'win11:1')

prepare() {
  cd "${srcdir}/${_realname}"

  git apply --whitespace=nowarn \
    "${srcdir}/0001-Use-portable-include-paths.patch" \
    "${srcdir}/0002-trace-Build-the-logging-macros-with-GCC.patch" \
    "${srcdir}/0003-Do-not-jump-over-initialized-declarations.patch"

  cp "${srcdir}/CMakeLists.txt" .
  mkdir -p gcc
  cp "${srcdir}"/{TraceLoggingProvider.h,ovpn-gcc-prelude.h,ovpn-gcc-shims.c,kmdfentry.c,mkoverlay.py,stampinf.py} gcc/
}

build() {
  : "${REACTOS_SOURCE_DIR:=${MINGW_PREFIX}/share/reactos/source}"
  : "${REACTOS_BUILD_DIR:=${MINGW_PREFIX}/share/reactos/build-amd64}"

  # DriverVer follows the upstream release date unless overridden
  local _date="${OVPN_DCO_DRIVER_DATE:-10/03/2026}"
  local _flavor _name _minor
  for _flavor in "${_flavors[@]}"; do
    _name=${_flavor%%:*}
    _minor=${_flavor##*:}
    cmake -S "${srcdir}/${_realname}" -B "${srcdir}/build-${_name}" -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DREACTOS_SOURCE_DIR="${REACTOS_SOURCE_DIR}" \
      -DREACTOS_BUILD_DIR="${REACTOS_BUILD_DIR}" \
      ${NTOSKRNL_IMPLIB:+-DNTOSKRNL_IMPLIB="${NTOSKRNL_IMPLIB}"} \
      -DNETADAPTER_VERSION_MINOR=${_minor} \
      -DOVPN_DCO_VERSION=${pkgver} \
      -DDRIVER_DATE="${_date}"
    cmake --build "${srcdir}/build-${_name}"
  done
}

check() {
  # A native kernel driver bound to KMDF 1.15 and NetAdapterCx 2.x
  local _flavor _name _minor _sys
  for _flavor in "${_flavors[@]}"; do
    _name=${_flavor%%:*}
    _minor=${_flavor##*:}
    _sys="${srcdir}/build-${_name}/ovpn-dco.sys"
    objdump -p "${_sys}" 2>/dev/null | grep -q 'Subsystem.*(NT native)'
    objdump -p "${_sys}" 2>/dev/null | grep -qi 'DLL Name: wdfldr.sys'
    # The NetAdapterCx class bind record: Size 0x50, version 2.${_minor}.0
    objdump -s -j .kmdfcla "${_sys}" 2>/dev/null | grep -q ' 50000000 00000000 '
    objdump -s -j .kmdfcla "${_sys}" 2>/dev/null | grep -q " 02000000 0${_minor}000000 00000000 "
  done
}

package() {
  local _flavor _name
  for _flavor in "${_flavors[@]}"; do
    _name=${_flavor%%:*}
    install -Dm644 "${srcdir}/build-${_name}/ovpn-dco.sys" \
      "${pkgdir}${MINGW_PREFIX}/lib/${_realname}/${_name}/ovpn-dco.sys"
    install -Dm644 "${srcdir}/build-${_name}/ovpn-dco.inf" \
      "${pkgdir}${MINGW_PREFIX}/lib/${_realname}/${_name}/ovpn-dco.inf"
  done
  install -Dm644 "${srcdir}/${_realname}/COPYRIGHT.MIT" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYRIGHT.MIT"
}
