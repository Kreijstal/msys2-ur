_realname=httpx2
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.13.1
pkgrel=1
pkgdesc="The next generation HTTP client (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://github.com/pydantic/httpx2'
msys2_references=(
  'purl: pkg:pypi/httpx2'
)
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-anyio"
         "${MINGW_PACKAGE_PREFIX}-python-httpcore2"
         "${MINGW_PACKAGE_PREFIX}-python-idna"
         "${MINGW_PACKAGE_PREFIX}-python-truststore")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-hatchling"
             "${MINGW_PACKAGE_PREFIX}-python-hatch-fancy-pypi-readme"
             "${MINGW_PACKAGE_PREFIX}-python-uv-dynamic-versioning")
options=('!strip')
source=("https://pypi.org/packages/source/h/httpx2/httpx2-${pkgver}.tar.gz")
sha256sums=('e48744a19e3af5ee48313d0ce5fe941d5422fae5705ea922a4aabf94d7800dfa')

build() {
  cp -r "httpx2-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  # the version comes from git tags, which an sdist does not have
  export UV_DYNAMIC_VERSIONING_BYPASS="${pkgver}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages && ${MINGW_PREFIX}/bin/python -c "import httpx2, importlib.metadata as m; assert m.version('httpx2') == '${pkgver}'"
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.md "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE.md"
}
