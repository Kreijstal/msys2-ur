From d1584570ca01d23d5e4098f9da44738e3a12aaa4 Mon Sep 17 00:00:00 2001
From: Kreijstal <rainb@tfwno.gf>
Date: Tue, 20 Oct 2026 22:39:21 +0200
Subject: [PATCH 1/6] cmake: support building with MinGW

The CMake build is the Windows build of httpd, but it assumes MSVC:

* /base:@BaseAddr.ref is an MSVC link.exe option; only pass it for MSVC.
* mod_http2 and mod_proxy_http2 define ssize_t=long because MSVC has no
  ssize_t; MinGW does, and long is 32 bits on LLP64, so only do this
  for MSVC.
* MinGW import libraries come from TARGET_LINKER_FILE; there are no .exp
  files to install.
* Keep the MSVC-style names (libhttpd.dll, mod_foo.so) instead of
  CMake's MinGW default "lib" prefix.
* The perl/xcopy install steps write straight into CMAKE_INSTALL_PREFIX
  and ignore DESTDIR, so skip them for MinGW.
* Make the module directory and the paths substituted into the .conf
  templates cache variables, and also define exp_logfiledir,
  exp_runtimedir and exp_sysconfdir which the extra/*.conf templates use
  but the CMake build never set.
* ap_config.h includes ap_config_auto.h whenever __MINGW32__ is defined
  (it assumes the autoconf build); generate and install an empty one.
* MSYS2's apr-util uses OpenLDAP, so link mod_ldap/mod_authnz_ldap with
  -lldap -llber instead of wldap32.
* Quote the template text passed to STRING(REPLACE), which otherwise
  treats it as a list and drops every ';' from the .conf files.
---
 CMakeLists.txt | 94 ++++++++++++++++++++++++++++++++++++--------------
 1 file changed, 69 insertions(+), 25 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1d57889..b480020 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -113,6 +113,10 @@ SET(JANSSON_LIBRARIES     "${default_jansson_libraries}" CACHE STRING "Jansson l
 OPTION(INSTALL_PDB        "Install .pdb files (if generated)"  ON)
 OPTION(INSTALL_MANUAL     "Install manual"                     ON)
 
+# Directory holding the DSO modules, relative to the install prefix and to
+# ServerRoot (used for both the install location and the LoadModule lines)
+SET(MODULES_DIR           "modules"                      CACHE STRING "Module directory, relative to the install prefix and ServerRoot")
+
 SET(ENABLE_MODULES        "O"                            CACHE STRING "Minimum module enablement (e.g., \"i\" to build all but those without prerequisites)")
 SET(WITH_MODULES          ""                             CACHE STRING "comma-separated paths to single-file modules to statically link into the server")
 SET(EXTRA_INCLUDES        ""                             CACHE STRING "Extra include directories")
@@ -516,7 +520,9 @@ ENDIF()
 SET(mod_firehose_requires            SOMEONE_TO_MAKE_IT_COMPILE_ON_WINDOWS)
 SET(mod_heartbeat_extra_libs         mod_watchdog)
 SET(mod_http2_requires               NGHTTP2_FOUND)
-SET(mod_http2_extra_defines          ssize_t=long)
+IF(MSVC)
+  SET(mod_http2_extra_defines        ssize_t=long)
+ENDIF()
 SET(mod_http2_extra_includes         ${NGHTTP2_INCLUDE_DIR})
 SET(mod_http2_extra_libs             ${NGHTTP2_LIBRARIES})
 SET(mod_http2_extra_sources
@@ -532,7 +538,13 @@ SET(mod_http2_extra_sources
   modules/http2/h2_ws.c
 )
 SET(mod_ldap_extra_defines           LDAP_DECLARE_EXPORT)
-SET(mod_ldap_extra_libs              wldap32)
+IF(MINGW)
+  # MSYS2's apr-util uses the OpenLDAP SDK, not wldap32
+  SET(mod_ldap_extra_libs            ldap lber)
+  SET(mod_authnz_ldap_extra_libs     mod_ldap ldap lber)
+ELSE()
+  SET(mod_ldap_extra_libs            wldap32)
+ENDIF()
 SET(mod_ldap_extra_sources
   modules/ldap/util_ldap_cache.c     modules/ldap/util_ldap_cache_mgr.c
 )
@@ -590,7 +602,9 @@ ENDIF()
 SET(mod_proxy_scgi_extra_libs        mod_proxy)
 SET(mod_proxy_wstunnel_extra_libs    mod_proxy)
 SET(mod_proxy_http2_requires               NGHTTP2_FOUND)
-SET(mod_proxy_http2_extra_defines          ssize_t=long)
+IF(MSVC)
+  SET(mod_proxy_http2_extra_defines  ssize_t=long)
+ENDIF()
 SET(mod_proxy_http2_extra_includes         ${NGHTTP2_INCLUDE_DIR})
 SET(mod_proxy_http2_extra_libs             ${NGHTTP2_LIBRARIES} mod_proxy)
 SET(mod_proxy_http2_extra_sources
@@ -813,6 +827,14 @@ SET(other_installed_h
 )
 # When mod_serf is buildable, don't forget to copy modules/proxy/mod_serf.h
 
+# ap_config.h includes ap_config_auto.h for MinGW, assuming the autoconf
+# build; this build has no autoconf results, so provide an empty one.
+IF(MINGW)
+  FILE(WRITE ${PROJECT_BINARY_DIR}/ap_config_auto.h
+       "/* CMake build for MinGW: nothing detected by autoconf. */\n")
+  LIST(APPEND other_installed_h ${PROJECT_BINARY_DIR}/ap_config_auto.h)
+ENDIF()
+
 INCLUDE_DIRECTORIES(${HTTPD_INCLUDE_DIRECTORIES})
 
 SET(HTTPD_SYSTEM_LIBS
@@ -868,10 +890,10 @@ FOREACH (mod ${MODULE_PATHS})
   ELSE()
     # Handle whether or not the LoadModule is commented out.
     IF(${enable_mod_val} STREQUAL "A")
-      SET(LoadModules "${LoadModules}LoadModule ${mod_module_name} modules/${mod_name}.so\n")
+      SET(LoadModules "${LoadModules}LoadModule ${mod_module_name} ${MODULES_DIR}/${mod_name}.so\n")
       SET(mods_built_and_loaded ${mods_built_and_loaded} ${mod_name})
     ELSEIF(${enable_mod_val} STREQUAL "I")
-      SET(LoadModules "${LoadModules}# LoadModule ${mod_module_name} modules/${mod_name}.so\n")
+      SET(LoadModules "${LoadModules}# LoadModule ${mod_module_name} ${MODULES_DIR}/${mod_name}.so\n")
       SET(mods_built_but_not_loaded ${mods_built_but_not_loaded} ${mod_name})
     ELSE()
       MESSAGE(FATAL_ERROR "${enable_mod} must be set to \"A\", \"I\", or \"O\" instead of \"${enable_mod_val}\"")
@@ -894,14 +916,21 @@ FOREACH (mod ${MODULE_PATHS})
       SET(installed_mod_libs_exps
           ${installed_mod_libs_exps}
           "$<TARGET_LINKER_FILE:${mod_name}>"
-          "$<TARGET_LINKER_FILE_DIR:${mod_name}>/${mod_name}.exp"
       )
+      IF(MSVC)
+        SET(installed_mod_libs_exps
+            ${installed_mod_libs_exps}
+            "$<TARGET_LINKER_FILE_DIR:${mod_name}>/${mod_name}.exp"
+        )
+      ENDIF()
     ENDIF()
     SET(mod_extra_libs "${mod_name}_extra_libs")
-    SET_TARGET_PROPERTIES(${mod_name} PROPERTIES
-      SUFFIX .so
-      LINK_FLAGS /base:@${PROJECT_BINARY_DIR}/BaseAddr.ref,${mod_name}.so
-    )
+    SET_TARGET_PROPERTIES(${mod_name} PROPERTIES PREFIX "" SUFFIX .so)
+    IF(MSVC)
+      SET_TARGET_PROPERTIES(${mod_name} PROPERTIES
+        LINK_FLAGS /base:@${PROJECT_BINARY_DIR}/BaseAddr.ref,${mod_name}.so
+      )
+    ENDIF()
     TARGET_LINK_LIBRARIES(${mod_name} ${${mod_extra_libs}} libhttpd ${EXTRA_LIBS} ${APR_LIBRARIES} ${HTTPD_SYSTEM_LIBS})
     DEFINE_WITH_BLANKS(define_long_name "LONG_NAME" "${mod_name} for Apache HTTP Server")
     SET_TARGET_PROPERTIES(${mod_name} PROPERTIES COMPILE_FLAGS "${define_long_name} -DBIN_NAME=${mod_name}.so ${EXTRA_COMPILE_FLAGS}")
@@ -925,9 +954,14 @@ ENDFOREACH()
 
 ###########   HTTPD LIBRARIES   ############
 ADD_LIBRARY(libhttpd SHARED ${LIBHTTPD_SOURCES} build/win32/httpd.rc)
-SET_TARGET_PROPERTIES(libhttpd PROPERTIES
-  LINK_FLAGS /base:@${PROJECT_BINARY_DIR}/BaseAddr.ref,libhttpd.dll
-)
+IF(MSVC)
+  SET_TARGET_PROPERTIES(libhttpd PROPERTIES
+    LINK_FLAGS /base:@${PROJECT_BINARY_DIR}/BaseAddr.ref,libhttpd.dll
+  )
+ELSE()
+  # keep the MSVC-style DLL name; the import library becomes libhttpd.dll.a
+  SET_TARGET_PROPERTIES(libhttpd PROPERTIES PREFIX "" IMPORT_PREFIX "")
+ENDIF()
 SET(install_targets ${install_targets} libhttpd)
 SET(install_bin_pdb ${install_bin_pdb} $<TARGET_PDB_FILE:libhttpd>)
 TARGET_LINK_LIBRARIES(libhttpd ${EXTRA_LIBS} ${APR_LIBRARIES} ${PCRE_LIBRARIES} ${HTTPD_SYSTEM_LIBS})
@@ -993,22 +1027,26 @@ GET_PROPERTY(tmp_includes TARGET ab PROPERTY INCLUDE_DIRECTORIES)
 SET(LoadModule          "${LoadModules}")
 SET(Port                "80" CACHE STRING "http port to listen on")
 SET(SSLPort             "443" CACHE STRING "https port to listen on")
-SET(ServerRoot          "${CMAKE_INSTALL_PREFIX}")
-SET(exp_cgidir          "${CMAKE_INSTALL_PREFIX}/cgi-bin")
-SET(exp_htdocsdir       "${CMAKE_INSTALL_PREFIX}/htdocs")
-SET(exp_iconsdir        "${CMAKE_INSTALL_PREFIX}/icons")
-SET(exp_errordir        "${CMAKE_INSTALL_PREFIX}/error")
-SET(exp_manualdir       "${CMAKE_INSTALL_PREFIX}/manual")
-SET(rel_logfiledir      "logs")
-SET(rel_runtimedir      "logs")
-SET(rel_sysconfdir      "conf")
+SET(ServerRoot          "${CMAKE_INSTALL_PREFIX}"         CACHE STRING "ServerRoot written to httpd.conf")
+SET(exp_cgidir          "${CMAKE_INSTALL_PREFIX}/cgi-bin" CACHE STRING "cgi-bin directory written to the .conf files")
+SET(exp_htdocsdir       "${CMAKE_INSTALL_PREFIX}/htdocs"  CACHE STRING "DocumentRoot written to the .conf files")
+SET(exp_iconsdir        "${CMAKE_INSTALL_PREFIX}/icons"   CACHE STRING "icons directory written to the .conf files")
+SET(exp_errordir        "${CMAKE_INSTALL_PREFIX}/error"   CACHE STRING "error document directory written to the .conf files")
+SET(exp_manualdir       "${CMAKE_INSTALL_PREFIX}/manual"  CACHE STRING "manual directory written to the .conf files")
+SET(rel_logfiledir      "logs"                            CACHE STRING "log directory, relative to ServerRoot")
+SET(rel_runtimedir      "logs"                            CACHE STRING "runtime directory, relative to ServerRoot")
+SET(rel_sysconfdir      "conf"                            CACHE STRING "configuration directory, relative to ServerRoot")
+# used by the extra/*.conf templates
+SET(exp_logfiledir      "${CMAKE_INSTALL_PREFIX}/${rel_logfiledir}" CACHE STRING "log directory written to the extra .conf files")
+SET(exp_runtimedir      "${CMAKE_INSTALL_PREFIX}/${rel_runtimedir}" CACHE STRING "runtime directory written to the extra .conf files")
+SET(exp_sysconfdir      "${CMAKE_INSTALL_PREFIX}/${rel_sysconfdir}" CACHE STRING "configuration directory written to the extra .conf files")
 FILE(GLOB_RECURSE conffiles RELATIVE ${CMAKE_SOURCE_DIR}/docs/conf "docs/conf/*")
 FOREACH(template ${conffiles})
   STRING(REPLACE ".conf.in" ".conf" conf ${template})
   FILE(READ "docs/conf/${template}" template_text)
     IF(template MATCHES ".conf.in$")
       # substitute @var@/@@var@@ in .conf.in
-      STRING(REPLACE "@@" "@" template_text ${template_text})
+      STRING(REPLACE "@@" "@" template_text "${template_text}")
       STRING(CONFIGURE "${template_text}" template_text @ONLY)
     ENDIF()
   FILE(WRITE ${CMAKE_BINARY_DIR}/conf/original/${conf} "${template_text}")
@@ -1022,7 +1060,7 @@ INSTALL(TARGETS ${install_targets}
         ARCHIVE DESTINATION lib
        )
 INSTALL(TARGETS ${install_modules}
-        RUNTIME DESTINATION modules
+        RUNTIME DESTINATION ${MODULES_DIR}
        )
 
 IF(INSTALL_PDB)
@@ -1040,12 +1078,17 @@ INSTALL(DIRECTORY include/ DESTINATION include
 )
 INSTALL(FILES ${other_installed_h} DESTINATION include)
 INSTALL(FILES ${installed_mod_libs_exps} DESTINATION lib)
-INSTALL(FILES "$<TARGET_LINKER_FILE_DIR:libhttpd>/libhttpd.exp" DESTINATION LIB)
+IF(MSVC)
+  INSTALL(FILES "$<TARGET_LINKER_FILE_DIR:libhttpd>/libhttpd.exp" DESTINATION LIB)
+ENDIF()
 
 IF(INSTALL_MANUAL) # Silly?  This takes a while, and a dev doesn't need it.
   INSTALL(DIRECTORY docs/manual/ DESTINATION manual)
 ENDIF()
 
+# These steps use perl and xcopy and write directly into CMAKE_INSTALL_PREFIX,
+# ignoring DESTDIR; packagers on MinGW lay out these files themselves.
+IF(NOT MINGW)
 INSTALL(DIRECTORY DESTINATION logs)
 INSTALL(DIRECTORY DESTINATION cgi-bin)
 
@@ -1065,6 +1108,7 @@ INSTALL(CODE "EXECUTE_PROCESS(COMMAND perl \"${CMAKE_CURRENT_SOURCE_DIR}/build/c
 STRING(REPLACE "/" "\\\\" native_src ${CMAKE_BINARY_DIR}/conf/original)
 STRING(REPLACE "/" "\\\\" native_dest ${CMAKE_INSTALL_PREFIX}/conf/original)
 INSTALL(CODE "EXECUTE_PROCESS(COMMAND xcopy \"${native_src}\" \"${native_dest}\" /Q /S /Y)")
+ENDIF()
 
 STRING(TOUPPER "${CMAKE_BUILD_TYPE}" buildtype)
 MESSAGE(STATUS "")
