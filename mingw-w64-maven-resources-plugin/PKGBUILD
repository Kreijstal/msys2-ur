# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=maven-resources-plugin
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.4.0
pkgrel=1
pkgdesc="Apache Maven Resources Plugin, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://maven.apache.org/plugins/maven-resources-plugin/'
msys2_repository_url='https://github.com/apache/maven-resources-plugin'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-maven-filtering"
         "${MINGW_PACKAGE_PREFIX}-java-commons-lang3"
         "${MINGW_PACKAGE_PREFIX}-java-javax-inject")
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-maven-core"
             "${MINGW_PACKAGE_PREFIX}-maven-plugin-annotations")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/apache/maven-resources-plugin/archive/refs/tags/${_realname}-${pkgver}.tar.gz")
sha256sums=('fd6d4a40004813355deeedc66752168cad8d80a41f39c44fce9fea942d5cdc31')

_src=${_realname}-${_realname}-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}"
  jb_plugin org.apache.maven.plugins:maven-resources-plugin:${pkgver} resources \
    "Apache Maven Resources Plugin" 1.8 3.6.3 src/main/java -u pom.xml \
    -- org.apache.maven:maven-plugin-api/provided org.apache.maven:maven-core/provided \
       org.apache.maven:maven-model/provided \
       org.apache.maven.plugin-tools:maven-plugin-annotations/provided \
       org.eclipse.sisu:org.eclipse.sisu.plexus/provided \
       org.apache.maven.shared:maven-filtering org.apache.commons:commons-lang3 \
       javax.inject:javax.inject
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests need maven-plugin-testing-harness; the plugin is used
  # for real by the maven package's hello-world check
  jb_loadcheck --with org.apache.maven:maven-core org.apache.maven.plugins:maven-resources-plugin
  local p
  p=$(unzip -p "$(jb_jarpath org.apache.maven.plugins:maven-resources-plugin)" META-INF/maven/plugin.xml)
  grep -q '<goal>resources</goal>' <<< "${p}"
  grep -q '<goal>testResources</goal>' <<< "${p}"
  grep -q '<phase>process-resources</phase>' <<< "${p}"
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install org.apache.maven.plugins:maven-resources-plugin
}
