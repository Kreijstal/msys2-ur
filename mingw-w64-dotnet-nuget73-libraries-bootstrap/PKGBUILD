# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-nuget73-libraries-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=7.3.0.preview1.11413
pkgrel=1
pkgdesc='Original NET10 NuGet7.3 Configuration Packaging Protocol ProjectModel Commands library bootstrap'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/NuGet/NuGet.Client'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime10-bootstrap=10.0.5"
         "${MINGW_PACKAGE_PREFIX}-dotnet-nuget73-core-bootstrap=7.3.0.preview1.11413"
         "${MINGW_PACKAGE_PREFIX}-dotnet-newtonsoft-json1303-bootstrap=13.0.3"
         "${MINGW_PACKAGE_PREFIX}-dotnet-cryptography-pkcs=8.0.31"
         "${MINGW_PACKAGE_PREFIX}-dotnet-protecteddata=8.0.31"
         "${MINGW_PACKAGE_PREFIX}-dotnet-filesystem-globbing6=6.0.0"
         "${MINGW_PACKAGE_PREFIX}-dotnet-fileproviders-abstractions6=6.0.0"
         "${MINGW_PACKAGE_PREFIX}-dotnet-extensions-primitives6=6.0.0")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler53-bootstrap>=5.3.0.2.26113.113-3"
             "${MINGW_PACKAGE_PREFIX}-dotnet-runtime10-generators=10.0.5"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
source=('nuget-sdk10-bf048eb7.tar.gz::https://codeload.github.com/NuGet/NuGet.Client/tar.gz/bf048eb714eb6b1912ba868edca4c7cfec454841'
        'nuget73-libraries-source-2.tar.gz')
noextract=('nuget-sdk10-bf048eb7.tar.gz')
sha256sums=('9eb1139d9abecfab7d69fd7b02cb58d20792a0cd46ffb7b2ea6a12bbfda48f12'
            'fea1897ebf4fdffd5f9b7e35fb24ba4e03a54fa49c5ab052b17f8a22ac4c7855')
prepare() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/nuget73-libraries-workflow/prepare-all.py")" "$(cygpath -am "$srcdir")" > "$srcdir/prepare.log" 2>&1
}
build() {
  if [[ ${NUGET73_LIBRARIES_RESUME_COMPILED:-0} == 1 ]]; then
    /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/nuget73-libraries-workflow/resume-compiled.py")" "$(cygpath -am "$srcdir")" > "$srcdir/resume-compiled.log" 2>&1
    return
  fi
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/nuget73-libraries-workflow/build-closure.py")" "$(cygpath -am "$srcdir/plan")" "$(cygpath -am "$srcdir/build")" > "$srcdir/build.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/nuget73-libraries-workflow/localize-closure.py")" "$(cygpath -am "$srcdir")" > "$srcdir/localize.log" 2>&1
}
check() {
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/nuget73-libraries-workflow/audit-closure.py")" "$(cygpath -am "$srcdir")" "$(cygpath -am "$srcdir/build")" "$(cygpath -am "$srcdir/source-audit.json")" > "$srcdir/audit.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/nuget73-libraries-workflow/stage.py")" "$(cygpath -am "$srcdir")" "$(cygpath -am "$srcdir/package-prefix")" > "$srcdir/stage.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/package-prefix/share/doc/$_realname/checks/check-installed.py")" "$(cygpath -am "$srcdir/package-prefix")" "$(cygpath -am "$srcdir/staged-check")" > "$srcdir/staged-check.log" 2>&1
}
package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -R "$srcdir/package-prefix/." "$pkgdir$MINGW_PREFIX/"
}
