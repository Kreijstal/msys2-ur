# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-dapplo-ini
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}" "${MINGW_PACKAGE_PREFIX}-${_realname}-generator")
pkgver=1.1.11
pkgrel=1
pkgdesc='Source-built Dapplo.Ini configuration and source generator for .NET 8'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dapplo/Dapplo.Ini'
license=('spdx:MIT')
_commit=8f2c2228175a39a09f88a3d77643fc4e947803d8
_tree=Dapplo.Ini-${_commit}
_project=src/Dapplo.Ini/Dapplo.Ini.csproj
_id=Dapplo.Ini
_framework=net8.0
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" 'python')
options=('!strip' '!lto')
source=("dapplo-ini-8f2c2228175a39a09f88a3d77643fc4e947803d8.tar.gz::https://codeload.github.com/dapplo/Dapplo.Ini/tar.gz/8f2c2228175a39a09f88a3d77643fc4e947803d8" prepare.py check.cs)
sha256sums=('e17846b10683a82b0d4436bbd0ddc13ad818896f8137be0ccfd49f00f6d0152b' 'eb65010dc09b9f1cc9e19a4fe75ea8b21be3b5f6c911d558d7556eef4fd3f528' '9be7ecaa43b41303034919457da6ed2a0dbf3d8733a49f0f6477479aa9fadbc8')

_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" dapplo-ini "$srcdir/$_tree"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  cd "$srcdir/$_tree"
  for project in Dapplo.Ini Dapplo.Ini.Generator; do
    "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "src/$project/$project.csproj" -c Release -o "$(cygpath -m "$srcdir/feed")" \
      --configfile "$(cygpath -m "$srcdir/NuGet.config")" -p:PackageVersion="$pkgver" -p:Version="$pkgver" \
      -p:GeneratePackageOnBuild=false -p:TargetFrameworks=net8.0 -p:TargetFramework=net8.0 -p:IsTrimmable=false \
      -p:RestoreSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" \
      -p:EnableNETAnalyzers=false -p:NuGetAudit=false -p:UseSharedCompilation=false -v:minimal
  done
}
check() {
  _env
  mkdir -p "$srcdir/check"
  cp "$srcdir/check.cs" "$srcdir/check/Program.cs"
  cat > "$srcdir/check/check.csproj" <<PROJECT
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>$_framework</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="$_id" Version="[$pkgver]" /><PackageReference Include="Dapplo.Ini.Generator" Version="[$pkgver]" /></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" run --project "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    -p:RestoreSources="$(cygpath -m "$srcdir/feed")" -p:UseSharedCompilation=false
}
_package_feed() {
  local id=$1
  install -Dm644 "$srcdir/feed/$id.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${id,,}.$pkgver.nupkg"
  install -Dm644 "$srcdir/$_tree/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$_tree/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$pkgname/removed-binaries.json"
}
package_mingw-w64-clang-x86_64-dotnet-dapplo-ini() {
  _package_feed Dapplo.Ini
}
package_mingw-w64-clang-x86_64-dotnet-dapplo-ini-generator() {
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-dapplo-ini=$pkgver")
  _package_feed Dapplo.Ini.Generator
}
