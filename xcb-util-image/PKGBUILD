# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=xcb-util-image
pkgver=0.4.1
pkgrel=1
pkgdesc="Port of Xlib's XImage and XShmImage functions to XCB"
arch=('x86_64')
url="https://xcb.freedesktop.org/"
license=('spdx:MIT')
depends=('libxcb'
         'xcb-util')
makedepends=('gcc'
             'pkgconf')
source=("https://xorg.freedesktop.org/releases/individual/xcb/${pkgname}-${pkgver}.tar.xz")
sha256sums=('ccad8ee5dadb1271fd4727ad14d9bd77a64e505608766c4e98267d9aede40d3d')

build() {
  cd "${pkgname}-${pkgver}"

  # Force the Cygwin host triple, same reason as libxdmcp: the guest's libtool
  # has no msys case, so canonicalising the host to *-msys yields a static-only
  # build and no DLL for downstream -no-undefined libs to link against. The
  # compiler stays the msys gcc, so the DLL still links msys-2.0.dll.
  ./configure \
    --prefix=/usr \
    --build=x86_64-pc-cygwin \
    --host=x86_64-pc-cygwin \
    --disable-static

  # Name the DLL msys-* to match the rest of the stack (the cygwin host path
  # would name it cyg*).
  sed -i 's#s/\^lib/cyg#s/^lib/msys-#' libtool

  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
