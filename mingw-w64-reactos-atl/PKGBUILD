prepare() {
  rm -rf "${srcdir}/${_realname}"
  mkdir -p "${srcdir}/${_realname}"
  local _h
  for _h in "${_atl_headers[@]}"; do
    cp "${srcdir}/reactos-atl-${_commit}-${_h}" "${srcdir}/${_realname}/${_h}"
  done

  cd "${srcdir}/${_realname}"
  patch -Np1 -i "${srcdir}/0001-atl-do-not-require-PSEH-outside-of-ReactOS.patch"
  patch -Np1 -i "${srcdir}/0002-atl-add-MSVC-ATL-pieces-needed-by-mingw-w64-users.patch"
  patch -Np1 -i "${srcdir}/0003-atl-only-declare-CTimeSpan-Format-LPCSTR-in-UNICODE-.patch"
}

build() {
  sed -e "s|@PREFIX@|${MINGW_PREFIX}|" -e "s|@VERSION@|${pkgver}|" \
    "${srcdir}/reactos-atl.pc.in" > "${srcdir}/reactos-atl.pc"
}

check() {
  cd "${srcdir}"
  # every header must be self-contained after atlbase.h, in ANSI and UNICODE
  local _h _d
  for _d in "" "-DUNICODE -D_UNICODE"; do
    for _h in "${_atl_headers[@]}"; do
      printf '#include <atlbase.h>\n#include <%s>\nint main() { return 0; }\n' "${_h}" > hdrtest.cpp
      ${CXX:-c++} ${_d} -std=c++17 -I"${_realname}" -fsyntax-only hdrtest.cpp
    done
  done
  # CComPtr / CComQIPtr / CComObject / CComCoClass / CComGITPtr, and
  # OBJECT_ENTRY_AUTO from a header shared by two translation units
  ${CXX:-c++} -O2 -Wall -I"${_realname}" atltest.cpp atltest2.cpp -o atltest.exe -lole32 -loleaut32 -luuid
  ./atltest.exe
}

package() {
  install -d "${pkgdir}${MINGW_PREFIX}/include/${_realname}"
  install -m644 "${srcdir}/${_realname}"/*.h "${pkgdir}${MINGW_PREFIX}/include/${_realname}/"
  install -Dm644 "${srcdir}/reactos-atl.pc" "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/reactos-atl.pc"
  install -Dm644 "${srcdir}/reactos-COPYING-${_commit}" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
  install -Dm644 "${srcdir}/reactos-COPYING.LIB-${_commit}" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING.LIB"
}
