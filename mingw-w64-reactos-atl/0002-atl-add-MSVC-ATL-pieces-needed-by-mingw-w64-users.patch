     HRESULT UnregisterServer(BOOL bUnRegTypeLib, const CLSID *pCLSID = NULL);
@@ -687,6 +742,16 @@ public:
         _AtlComModule.ExecuteObjectMain(true);
     }
 
+    BOOL WINAPI DllMain(DWORD dwReason, LPVOID /*lpReserved*/)
