     {
         _AtlComModule.ExecuteObjectMain(false);
@@ -716,7 +781,9 @@ public:
         HRESULT hResult;
 
         pThis = static_cast<T *>(this);
-        hResult = pThis->RegisterServer(bRegTypeLib);
+        hResult = pThis->RegisterAppId();
+        if (SUCCEEDED(hResult))
+            hResult = pThis->RegisterServer(bRegTypeLib);
         return hResult;
     }
 
@@ -727,6 +794,8 @@ public:
 
         pThis = static_cast<T *>(this);
         hResult = pThis->UnregisterServer(bUnRegTypeLib);
+        if (SUCCEEDED(hResult))
