+// Pointer stored in the process-wide Global Interface Table.
+template <class T>
+class CComGITPtr
+{
+public:
+    DWORD m_dwCookie;
+
+    CComGITPtr() :
+        m_dwCookie(0)
+    {
+    }
+    CComGITPtr(_In_opt_ T* p) :
+        m_dwCookie(0)
+    {
+        Attach(p);
+    }
+    CComGITPtr(_In_ const CComPtr<T>& sp) :
+        m_dwCookie(0)
+    {
+        Attach(sp.p);
+    }
+    explicit CComGITPtr(_In_ DWORD dwCookie) :
+        m_dwCookie(dwCookie)
+    {
+    }
+    CComGITPtr(_In_ const CComGITPtr& git) :
+        m_dwCookie(0)
+    {
+        CComPtr<T> sp;
+        if (SUCCEEDED(git.CopyTo(&sp)))
+            Attach(sp.p);
+    }
+    ~CComGITPtr()
+    {
+        Revoke();
+    }
+
+    CComGITPtr<T>& operator=(_In_ const CComGITPtr<T>& git)
+    {
+        if (this != &git)
+        {
+            CComPtr<T> sp;
+            if (SUCCEEDED(git.CopyTo(&sp)))
+                Attach(sp.p);
+            else
+                Revoke();
+        }
+        return *this;
+    }
+    CComGITPtr<T>& operator=(_In_opt_ T* p)
+    {
+        Attach(p);
+        return *this;
+    }
+    CComGITPtr<T>& operator=(_In_ DWORD dwCookie)
+    {
+        Attach(dwCookie);
+        return *this;
+    }
+
+    operator DWORD() const
+    {
+        return m_dwCookie;
+    }
+    DWORD GetCookie() const
+    {
+        return m_dwCookie;
+    }
+
+    static HRESULT GetGIT(_Outptr_ IGlobalInterfaceTable **ppGIT)
+    {
+        return ::CoCreateInstance(CLSID_StdGlobalInterfaceTable, NULL, CLSCTX_INPROC_SERVER,
+                                  IID_IGlobalInterfaceTable, (void **)ppGIT);
+    }
+
+    HRESULT Attach(_In_opt_ T* p)
+    {
+        HRESULT hr = Revoke();
+        if (FAILED(hr) || p == NULL)
+            return hr;
+        CComPtr<IGlobalInterfaceTable> git;
+        hr = GetGIT(&git);
+        if (FAILED(hr))
+            return hr;
+#ifndef _ATL_NO_UUIDOF
+        return git->RegisterInterfaceInGlobal(p, __uuidof(T), &m_dwCookie);
+#else
+        return git->RegisterInterfaceInGlobal(p, IID_IUnknown, &m_dwCookie);
+#endif
+    }
+    HRESULT Attach(_In_ DWORD dwCookie)
+    {
+        HRESULT hr = Revoke();
+        if (SUCCEEDED(hr))
+            m_dwCookie = dwCookie;
+        return hr;
+    }
+    DWORD Detach()
+    {
+        DWORD dwCookie = m_dwCookie;
+        m_dwCookie = 0;
+        return dwCookie;
+    }
+    HRESULT Revoke()
+    {
+        HRESULT hr = S_OK;
+        if (m_dwCookie != 0)
+        {
+            CComPtr<IGlobalInterfaceTable> git;
+            hr = GetGIT(&git);
+            if (SUCCEEDED(hr))
+                hr = git->RevokeInterfaceFromGlobal(m_dwCookie);
+            if (SUCCEEDED(hr))
+                m_dwCookie = 0;
+        }
+        return hr;
+    }
+    HRESULT CopyTo(_Outptr_ T** pp) const
+    {
+        if (pp == NULL)
+            return E_POINTER;
+        *pp = NULL;
+        CComPtr<IGlobalInterfaceTable> git;
+        HRESULT hr = GetGIT(&git);
+        if (FAILED(hr))
+            return hr;
+#ifndef _ATL_NO_UUIDOF
+        return git->GetInterfaceFromGlobal(m_dwCookie, __uuidof(T), (void **)pp);
+#else
+        return git->GetInterfaceFromGlobal(m_dwCookie, IID_IUnknown, (void **)pp);
+#endif
+    }
+};
