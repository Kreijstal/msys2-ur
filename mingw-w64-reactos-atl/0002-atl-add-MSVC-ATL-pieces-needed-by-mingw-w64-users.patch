From e25c9bb5f4398b73474b5ab2f194ce9a260aad7a Mon Sep 17 00:00:00 2001
From: Kreijstal <rainb@tfwno.gf>
Date: Thu, 8 Oct 2026 07:15:18 +0200
Subject: [PATCH 2/3] atl: add MSVC ATL pieces needed by mingw-w64 users

- CComQIPtr<T[, piid]> (piid defaults to nullptr, meaning __uuidof(T)
  at run time, since mingw-w64 GCC's __uuidof is not a constant)
- CComGITPtr<T> on top of the standard Global Interface Table
- CComPtr<T>::CoCreateInstance(clsid[, outer[, ctx]]) with the MSVC
  signature (interface taken from T)
- _ATL_IIDOF(x) = __uuidof(x) so COM_INTERFACE_ENTRY(x) works
- GetUnknown() in BEGIN_COM_MAP
- CComCoClass: DECLARE_AGGREGATABLE and CreateInstance<Q>()
- CAtlDllModuleT::DllMain()
- DECLARE_LIBID, DECLARE_REGISTRY_APPID_RESOURCEID and the matching
  InitLibId/UpdateRegistryAppId hooks in CAtlModuleT/CAtlDllModuleT
- ATL_NO_VTABLE expands to nothing outside MSVC (GCC/clang ignore
  __declspec(novtable) with a warning)
- OBJECT_ENTRY_AUTO usable from headers included by several translation
  units, with both GNU ld and lld: the entries get COMDAT linkage (C++17
  inline variables), a writable per-class ATL$__m_<class> section (ld
  deduplicates COMDAT sections by name; lld does not merge sections that
  differ in flags) and 'used'.
---
 atlbase.h   |  75 +++++++++++++++-
 atlcom.h    |  49 ++++++++++-
 atlcomcli.h | 243 +++++++++++++++++++++++++++++++++++++++++++++++++++-
 atldef.h    |   2 +-
 4 files changed, 361 insertions(+), 8 deletions(-)

diff --git a/atlbase.h b/atlbase.h
index 54effd7..3db2e7d 100644
--- a/atlbase.h
+++ b/atlbase.h
@@ -39,7 +39,7 @@
 #define ATLTRY(x) x;
 #endif
 
-#ifdef _ATL_DISABLE_NO_VTABLE
+#if defined(_ATL_DISABLE_NO_VTABLE) || !defined(_MSC_VER)
 #define ATL_NO_VTABLE
 #else
 #define ATL_NO_VTABLE __declspec(novtable)
@@ -185,6 +185,33 @@ typedef _ATL_WIN_MODULE70 _ATL_WIN_MODULE;
 
 // Auto object map
 
+// OBJECT_ENTRY_AUTO may sit in a header that several translation units
+// include, so its variables need COMDAT ("pick any") linkage; use C++17
+// inline variables for that where available.
+#if !defined(_MSC_VER) && defined(__cplusplus) && __cplusplus >= 201703L
+#define _ATL_OBJMAP_SELECTANY inline
+#else
+#define _ATL_OBJMAP_SELECTANY __declspec(selectany)
+#endif
+
+#if defined(_MSC_VER)
+#define _ATLALLOC_OBJMAP(class) _ATLALLOC("ATL$__m")
+#else
+// GNU ld deduplicates COMDAT ("link once") sections by section name, so
+// every entry needs its own section; ATL$__m_<class> still sorts between
+// ATL$__a and ATL$__z.
+#define _ATLALLOC_OBJMAP(class) _ATLALLOC("ATL$__m_" #class)
+#endif
+
+#if defined(_MSC_VER)
+#define _ATL_OBJMAP_CONST const
+#else
+// The section markers __pobjMapEntryFirst/Last are writable; a const entry
+// would land in a read-only section of the same name that the linker does
+// not merge (lld), so the auto object map would appear empty.
+#define _ATL_OBJMAP_CONST
+#endif
+
 #if defined(_MSC_VER)
 #pragma section("ATL$__a", read, write)
 #pragma section("ATL$__z", read, write)
@@ -199,6 +226,11 @@ typedef _ATL_WIN_MODULE70 _ATL_WIN_MODULE;
 #error  Your platform is not supported.
 #endif
 
+#elif defined(__clang__)
+
+#define _ATLALLOC(x) __attribute__((section(x), used))
+#define OBJECT_ENTRY_PRAGMA(class)
+
 #elif defined(__GNUC__)
 
 // GCC completely ignores __attribute__((unused)) on the __pobjMap_ pointer, so we pass it to a function that is not allowed to be optimized....
@@ -207,7 +239,7 @@ static int __attribute__((optimize("O0"), unused)) hack_for_gcc(const _ATL_OBJMA
     return 1;
 }
 
-#define _ATLALLOC(x) __attribute__((section(x)))
+#define _ATLALLOC(x) __attribute__((section(x), used))
 #define OBJECT_ENTRY_PRAGMA(class) static int __pobjMap_hack_##class = hack_for_gcc(&__pobjMap_##class);
 
 #else
