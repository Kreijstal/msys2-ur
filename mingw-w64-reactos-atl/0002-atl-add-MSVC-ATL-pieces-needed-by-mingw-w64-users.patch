+#ifndef _ATL_NO_UUIDOF
+// CComQIPtr<Itype> / CComQIPtr<Itype, &IID_Itype>.
+// MSVC defaults piid to &__uuidof(T), which is not a constant expression
+// with GCC (mingw-w64 implements __uuidof as an inline function), so a NULL
+// default selects __uuidof(T) at run time instead.
+template <class T, const IID* piid = nullptr>
+class CComQIPtr :
+    public CComPtr<T>
+{
+public:
+    using CComPtr<T>::p;
+
+    static const IID& _GetIID()
+    {
+        return (piid != nullptr) ? *piid : __uuidof(T);
+    }
+
+    CComQIPtr()
+    {
+    }
+    CComQIPtr(_Inout_opt_ T* lp) :
+        CComPtr<T>(lp)
+    {
+    }
+    CComQIPtr(_Inout_ const CComQIPtr<T,piid>& lp) :
+        CComPtr<T>(lp.p)
+    {
+    }
+    CComQIPtr(_Inout_opt_ IUnknown* lp)
+    {
+        if (lp != NULL)
+        {
+            if (FAILED(lp->QueryInterface(_GetIID(), (void**)(IUnknown**)&p)))
+                p = NULL;
+        }
+    }
+    T *operator = (T *lp)
+    {
+        T* pOld = p;
+
+        p = lp;
+        if (p != NULL)
+            p->AddRef();
+
+        if (pOld != NULL)
+            pOld->Release();
+
+        return *this;
+    }
+
+    T *operator = (const CComQIPtr<T,piid> &lp)
+    {
+        return *this = lp.p;
+    }
+
+    T * operator=(IUnknown* lp)
+    {
+        T* pOld = p;
+
+        if (!lp || FAILED(lp->QueryInterface(_GetIID(), (void**)(IUnknown**)&p)))
+            p = NULL;
+
+        if (pOld != NULL)
+            pOld->Release();
+
+        return *this;
+    }
+};
+
+// IUnknown specialization: no QueryInterface needed, every interface is an IUnknown
+template <>
+class CComQIPtr<IUnknown, nullptr> :
+    public CComPtr<IUnknown>
+{
+public:
+    CComQIPtr()
+    {
+    }
+    CComQIPtr(_Inout_opt_ IUnknown* lp) :
+        CComPtr<IUnknown>(lp)
+    {
+    }
+    CComQIPtr(_Inout_ const CComQIPtr<IUnknown, nullptr>& lp) :
+        CComPtr<IUnknown>(lp.p)
+    {
+    }
+};
+#endif // _ATL_NO_UUIDOF
