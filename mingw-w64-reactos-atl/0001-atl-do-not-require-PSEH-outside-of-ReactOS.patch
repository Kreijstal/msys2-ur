From 401528d90ac342158e7f5964e9cd3212074eddf3 Mon Sep 17 00:00:00 2001
From: Kreijstal <rainb@tfwno.gf>
Date: Thu, 8 Oct 2026 07:12:35 +0200
Subject: [PATCH 1/3] atl: do not require PSEH outside of ReactOS

pseh2 is ReactOS' portable SEH library and is not available with
mingw-w64. The only user is CComClassFactorySingleton::CreateInstance,
which merely needs to Unlock() on scope exit, so use a RAII guard
when __REACTOS__ is not defined.
---
 atlcom.h | 24 ++++++++++++++++++++++++
 atldef.h |  1 -
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/atlcom.h b/atlcom.h
index 024d85a..89911ce 100644
--- a/atlcom.h
+++ b/atlcom.h
@@ -22,7 +22,9 @@
 #pragma once
 
 #include <cguid.h>          // for GUID_NULL
+#ifdef __REACTOS__
 #include <pseh/pseh2.h>
+#endif
 
 namespace ATL
 {
@@ -795,6 +797,7 @@ public:
             hResult = CLASS_E_NOAGGREGATION;
         else if (m_hrCreate == S_OK && m_spObj == NULL)
         {
+#ifdef __REACTOS__
             _SEH2_TRY
             {
                 Lock();
@@ -815,6 +818,27 @@ public:
                 Unlock();
             }
             _SEH2_END;
+#else
+            struct UnlockGuard
+            {
+                CComClassFactorySingleton *m_p;
+                ~UnlockGuard() { m_p->Unlock(); }
+            } guard = { this };
+            {
+                Lock();
+                if (m_hrCreate == S_OK && m_spObj == NULL)
+                {
+                    CComObjectCached<T> *pObj;
+                    m_hrCreate = CComObjectCached<T>::CreateInstance(&pObj);
+                    if (SUCCEEDED(m_hrCreate))
+                    {
+                        m_hrCreate = pObj->QueryInterface(IID_IUnknown, reinterpret_cast<PVOID *>(&m_spObj));
+                        if (FAILED(m_hrCreate))
+                            delete pObj;
+                    }
+                }
+            }
+#endif
         }
         if (m_hrCreate == S_OK)
             hResult = m_spObj->QueryInterface(riid, ppvObj);
diff --git a/atldef.h b/atldef.h
index a789870..f7b76fd 100644
--- a/atldef.h
+++ b/atldef.h
@@ -9,7 +9,6 @@
 
 #ifndef __REACTOS__
     #include <cstddef>
-    #include <pseh/pseh2.h>
 #endif
 
 #define _ATL_PACKING 8
