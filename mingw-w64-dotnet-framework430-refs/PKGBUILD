# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-framework430-refs
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.3.0
pkgrel=1
pkgdesc='Eight original legacy .NET 4.3.0 source reference NuGet packages'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/source-build-reference-packages'
license=('spdx:MIT' 'custom:Microsoft.NET.Library')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-legacy-ns13-contracts-bootstrap>=20261031-4"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn44=4.4.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-cecil011-bootstrap=0.11.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-runtime430=4.3.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-reflection430=4.3.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netstandard-library161=1.6.1"
             "${MINGW_PACKAGE_PREFIX}-llvm-tools"
             "${MINGW_PACKAGE_PREFIX}-python" 'python')
options=('!strip' '!lto' '!buildflags')
source=('sbrp-5aeee273.tar.gz::https://codeload.github.com/dotnet/source-build-reference-packages/tar.gz/5aeee2738338530a92d7f6caa2c7d5f569fed3c4'
        'corefx10-codepages-9688ddbb.tar.gz::https://codeload.github.com/dotnet/corefx/tar.gz/9688ddbb62c04189cac4c4a06e31e93377dccd41'
        'roslyn-4.4.0-1ce8866c.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/1ce8866c9de4c2d67351ef6863699dee03b0804a'
        'framework430-refs-source-1.tar.gz')
noextract=('sbrp-5aeee273.tar.gz' 'corefx10-codepages-9688ddbb.tar.gz' 'roslyn-4.4.0-1ce8866c.tar.gz')
sha256sums=('2b3136fab488246d0289e622797094e7c2eb29b35f67a9a5cd1312ef3ddfca79'
            '986a512c70d55ed7a1ed8cbb9d8323017c9cc83e77e95e833c7b91f42e4ef601'
            '9edb8c430576c5f5b27032afe8f79c74508b0150e03406a7a4ca6f218e03fd11'
            '3bea6aa717ec022e5cf68486b17ee5e44e2a19ce12a48a00665987c2f5c15841')
_env() {
  export DOTNET_CLI_HOME=$(cygpath -am "$srcdir/cli-home")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
build() {
  _env
  local workflow="$srcdir/framework430-refs-workflow"
  /usr/bin/python3 "$workflow/compiler44.py" "$srcdir/roslyn-4.4.0-1ce8866c.tar.gz" "$srcdir/compiler44" > "$srcdir/compiler44.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$workflow/build.py")" "$(cygpath -am "$srcdir/sbrp-5aeee273.tar.gz")" "$(cygpath -am "$srcdir/corefx10-codepages-9688ddbb.tar.gz")" "$(cygpath -am "$srcdir/references")" "$(cygpath -am "$MINGW_PREFIX")" "$(cygpath -am "$srcdir/compiler44/bin/Release/net8.0")" > "$srcdir/references.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$workflow/finish.py")" "$(cygpath -am "$srcdir/references")" "$(cygpath -am "$srcdir/finished")" "$(cygpath -am "$MINGW_PREFIX")" > "$srcdir/finish.log" 2>&1
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$workflow/pack.py")" "$(cygpath -am "$srcdir/finished")" "$(cygpath -am "$srcdir/archives")" "$(cygpath -am "$MINGW_PREFIX")" > "$srcdir/pack.log" 2>&1
}
check() {
  _env
  /clang64/bin/python.exe -X utf8 "$(cygpath -am "$srcdir/framework430-refs-workflow/check.py")" "$(cygpath -am "$srcdir/archives/feed")" "$(cygpath -am "$srcdir/check")" "$(cygpath -am "$MINGW_PREFIX")" "$(cygpath -am "$srcdir/compiler44/bin/Release/net8.0")" > "$srcdir/check.log" 2>&1
}
package() {
  local workflow="$srcdir/framework430-refs-workflow"
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  local licenses="$pkgdir$MINGW_PREFIX/share/licenses/$_realname"
  local name file
  mkdir -p "$doc" "$licenses"
  for name in System.Collections System.Diagnostics.Debug System.Diagnostics.Tools System.Globalization System.Net.Primitives System.Resources.ResourceManager System.Runtime.Handles System.Threading.Timer;do
    install -Dm644 "$srcdir/archives/feed/$name.4.3.0.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${name,,}.4.3.0.nupkg"
    for file in dotnet_library_license.txt ThirdPartyNotices.txt;do
      install -m644 "$workflow/inputs/$name/data/$file" "$licenses/$name-$file"
    done
  done
  for file in check.py build-inspector.py build-forwarder-inspector.py README.md;do install -m644 "$workflow/$file" "$doc/";done
  cp -r "$workflow/inputs" "$workflow/metadata-inputs" "$doc/"
  install -m644 "$srcdir/references/source/sbrp/LICENSE.txt" "$licenses/SBRP-LICENSE.txt"
  install -m644 "$srcdir/references/source/corefx/LICENSE" "$licenses/CoreFX-LICENSE.txt"
  install -m644 "$srcdir/references/source/corefx/THIRD-PARTY-NOTICES" "$licenses/CoreFX-THIRD-PARTY-NOTICES.txt"
  install -m644 "$srcdir/references/results.json" "$doc/source-reference-build.json"
  install -m644 "$srcdir/finished/results.json" "$doc/source-metadata-restoration.json"
  install -m644 "$srcdir/archives/results.json" "$doc/source-package-build.json"
  install -m644 "$srcdir/check/results.json" "$doc/producer-check-results.json"
  install -m644 "$srcdir/compiler44/source-inputs.json" "$doc/compiler44-source-inputs.json"
}
