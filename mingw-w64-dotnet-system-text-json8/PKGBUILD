_realname=dotnet-system-text-json8
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=8.0.5
pkgrel=1
_commit=81cabf2857a01351e5ab578947c7403a5b128ad1
pkgdesc='Complete source System.Text.Json .NET8 library and original generator variants'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2" 'python')
options=('!strip' '!lto')
source=("runtime-$_commit.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/$_commit"
  extract.py
  prepare.py
  verify-build.py
  pack.py
  prepare-check.py
  verify-consumer.py
  verify-sdk.py
  check.sh
  Check.cs
  SdkSample.cs
  InspectApi.cs
  InspectAssemblyMetadata.cs
  compare.py
  Open.pubkey.hex
  published-metadata.json
  published-api.json
  README.md
)
noextract=("runtime-$_commit.tar.gz")
