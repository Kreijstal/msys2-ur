prepare() {
 /usr/bin/python3 "$srcdir/extract.py" "$srcdir/runtime-$_commit.tar.gz" "$srcdir/source"
 /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/source" "$srcdir/prepared"
}
build() {
 export DOTNET_ROOT=$(cygpath -am /clang64/lib/dotnet) DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
 export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_HOME=$(cygpath -am "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -am "$srcdir/cache")
 /clang64/lib/dotnet/dotnet.exe build "$(cygpath -am "$srcdir/prepared/Lib/Library.csproj")" -c Release \
  --configfile "$(cygpath -am "$srcdir/prepared/NuGet.config")" -p:UseSharedCompilation=false \
  -p:CscToolPath=E:/msys64/clang64/lib/dotnet/compiler-packs/roslyn-4.9.2 -p:CscToolExe=csc49.cmd -v:minimal
 /usr/bin/python3 "$srcdir/verify-build.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/cache"
 /usr/bin/python3 "$srcdir/pack.py" "$srcdir/source" "$srcdir/prepared" "$srcdir/feed"
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"; }
package() {
 install -Dm644 "$srcdir/feed/System.Text.Json.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/System.Text.Json.$pkgver.nupkg"
 install -Dm644 "$srcdir/source/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
 install -m644 "$srcdir/source/THIRD-PARTY-NOTICES.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/THIRD-PARTY-NOTICES.TXT"
 install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/README.md"
 install -m644 "$srcdir/prepared/verified-build.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/source-inventory.json"
}
