# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=xkbcomp
pkgver=1.5.0
pkgrel=1
pkgdesc="X Keyboard description compiler"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('spdx:MIT')
depends=('libx11'
         'libxkbfile')
makedepends=('gcc'
             'pkgconf'
             'xorgproto')
source=("https://xorg.freedesktop.org/releases/individual/app/${pkgname}-${pkgver}.tar.xz")
sha256sums=('2ac31f26600776db6d9cd79b3fcd272263faebac7eb85fb2f33c7141b8486060')

build() {
  cd "${pkgname}-${pkgver}"

  # This X stack is built as static archives only.  pkgconf demotes a package
  # named as an explicit root (x11) to the end of the link line, so
  # PKG_CHECK_MODULES(XKBCOMP, [x11 xkbfile xproto]) yields
  #     -lxcb -lXau -lXdmcp -lxkbfile -lX11
  # and ld, being single-pass, discards libxcb before libX11 ever references
  # it -> undefined xcb_connect/xcb_take_socket/...  Harmless with shared
  # libs, fatal here.  Wrap the libs in a link group so symbol resolution no
  # longer depends on pkgconf's emission order.
  ./configure \
    --prefix=/usr \
    --build=${CHOST} \
    --host=${CHOST} \
    XKBCOMP_LIBS="-Wl,--start-group $(pkg-config --libs x11 xkbfile xproto) -Wl,--end-group"

  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
