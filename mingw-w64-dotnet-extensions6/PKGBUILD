_realname=dotnet-extensions6
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-dotnet-extensions-primitives6"
         "${MINGW_PACKAGE_PREFIX}-dotnet-fileproviders-abstractions6"
         "${MINGW_PACKAGE_PREFIX}-dotnet-filesystem-globbing6")
pkgver=6.0.0
pkgrel=1
_commit=4822e3c3aa77eb82b2fb33c9321f923cf11ddde6
pkgdesc='Complete original Microsoft.Extensions 6.0 libraries for source NuGet/PSResourceGet'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/runtime'
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" 'python')
checkdepends=("${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp=4.9.2")
options=('!strip' '!lto')
source=("runtime-$_commit.tar.gz::https://codeload.github.com/dotnet/runtime/tar.gz/$_commit"
        extract.py prepare.py verify-build.py check.sh Check.cs InspectApi.cs compare-api.py
        AspNetCore.pubkey.hex published-provenance.json published-metadata.json published-api.json README.md)
noextract=("runtime-$_commit.tar.gz")
sha256sums=('0eb8640ce1964d0f1422060b31ab0fc25be194239998f72d2f9316aa3a31241c'
