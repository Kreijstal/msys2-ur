prepare() {
  /usr/bin/python3 "$srcdir/extract.py" "$srcdir/runtime-$_commit.tar.gz" "$srcdir/runtime"
  /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/runtime" "$srcdir/prepared"
}
build() {
  export DOTNET_ROOT=$(cygpath -am /clang64/lib/dotnet) DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBuildEnableWorkloadResolver=false
  export DOTNET_ROOT_X64=$DOTNET_ROOT DOTNET_CLI_HOME=$(cygpath -am "$srcdir/cli-home") NUGET_PACKAGES=$(cygpath -am "$srcdir/empty-packages")
  local name
  for name in Microsoft.Extensions.Primitives Microsoft.Extensions.FileProviders.Abstractions Microsoft.Extensions.FileSystemGlobbing;do
    /clang64/lib/dotnet/dotnet.exe build "$(cygpath -am "$srcdir/prepared/$name/Library.csproj")" -c Release \
      --configfile "$(cygpath -am "$srcdir/prepared/NuGet.config")" -p:UseSharedCompilation=false -v:minimal
  done
  /usr/bin/python3 "$srcdir/verify-build.py" "$srcdir/runtime" "$srcdir/prepared"
  for name in Microsoft.Extensions.Primitives Microsoft.Extensions.FileProviders.Abstractions Microsoft.Extensions.FileSystemGlobbing;do
    /clang64/lib/dotnet/dotnet.exe pack "$(cygpath -am "$srcdir/prepared/$name/Library.csproj")" -c Release \
      --no-build --no-restore -o "$(cygpath -am "$srcdir/feed")" -v:minimal
  done
}
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed"; }
_package() {
  local name=$1 suffix=$2
  depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
  if [[ $name == Microsoft.Extensions.FileProviders.Abstractions ]];then depends+=("${MINGW_PACKAGE_PREFIX}-dotnet-extensions-primitives6=$pkgver");fi
  install -Dm644 "$srcdir/feed/$name.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/$name.$pkgver.nupkg"
  install -Dm644 "$srcdir/runtime/LICENSE.TXT" "$pkgdir$MINGW_PREFIX/share/licenses/$suffix/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir$MINGW_PREFIX/share/doc/$suffix/README.md"
  install -m644 "$srcdir/prepared/$name/source-inventory.json" "$pkgdir$MINGW_PREFIX/share/doc/$suffix/"
}
package_mingw-w64-clang-x86_64-dotnet-extensions-primitives6() { _package Microsoft.Extensions.Primitives dotnet-extensions-primitives6; }
package_mingw-w64-clang-x86_64-dotnet-fileproviders-abstractions6() { _package Microsoft.Extensions.FileProviders.Abstractions dotnet-fileproviders-abstractions6; }
package_mingw-w64-clang-x86_64-dotnet-filesystem-globbing6() { _package Microsoft.Extensions.FileSystemGlobbing dotnet-filesystem-globbing6; }
