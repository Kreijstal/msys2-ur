# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-excel-streaming-reader
pkgname=("${MINGW_PACKAGE_PREFIX}-java-excel-streaming-reader")
pkgver=5.0.2
pkgrel=1
pkgdesc="excel-streaming-reader Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/pjfanning/excel-streaming-reader'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-commons-compress"
             "${MINGW_PACKAGE_PREFIX}-java-commons-io"
             "${MINGW_PACKAGE_PREFIX}-java-poi"
             "${MINGW_PACKAGE_PREFIX}-java-poi-ooxml"
             "${MINGW_PACKAGE_PREFIX}-java-poi-shared-strings"
             "${MINGW_PACKAGE_PREFIX}-java-slf4j-api")
source=('https://repo.maven.apache.org/maven2/com/github/pjfanning/excel-streaming-reader/5.0.2/excel-streaming-reader-5.0.2-sources.jar'
         'https://repo.maven.apache.org/maven2/com/github/pjfanning/excel-streaming-reader/5.0.2/excel-streaming-reader-5.0.2.pom')
noextract=('excel-streaming-reader-5.0.2-sources.jar'
         'excel-streaming-reader-5.0.2.pom')
sha256sums=('4571574a743862dfaed267b804616599ad8beddf417c9c4c178b92fff65f9a34'
         '638d148a97a315e26a6030c3771edbd494f074826503749a5d7bfa797fad0c3e')
_artifacts=('com.github.pjfanning:excel-streaming-reader:5.0.2')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  jb_module com.github.pjfanning:excel-streaming-reader:5.0.2 upstream/excel-streaming-reader \
    -r resources/excel-streaming-reader -u excel-streaming-reader-5.0.2.pom -- \
    org.apache.poi:poi org.apache.poi:poi-ooxml org.slf4j:slf4j-api/runtime commons-io:commons-io/runtime org.apache.commons:commons-compress/runtime com.github.pjfanning:poi-shared-strings/runtime?
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.apache.poi:poi --with org.apache.poi:poi-ooxml --with org.slf4j:slf4j-api --with commons-io:commons-io --with org.apache.commons:commons-compress --with com.github.pjfanning:poi-shared-strings com.github.pjfanning:excel-streaming-reader
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-excel-streaming-reader() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-poi"
           "${MINGW_PACKAGE_PREFIX}-java-poi-ooxml"
           "${MINGW_PACKAGE_PREFIX}-java-slf4j-api"
           "${MINGW_PACKAGE_PREFIX}-java-commons-io"
           "${MINGW_PACKAGE_PREFIX}-java-commons-compress")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.github.pjfanning:excel-streaming-reader
  _license excel-streaming-reader 5.0.2
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
