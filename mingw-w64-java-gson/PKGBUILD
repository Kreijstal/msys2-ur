# Maintainer: Kreijstal <rainb@tfwno.gf>

_realname=gson
pkgbase=mingw-w64-java-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-java-${_realname}"
pkgver=2.13.2
pkgrel=2
pkgdesc="Gson JSON serialization library for Java, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/google/gson'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-java-error-prone-annotations")
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/google/gson/archive/refs/tags/gson-parent-${pkgver}.tar.gz")
sha256sums=('cd766ae605d73e1a2f057fd4469f0b8bc0aa112140d11a817f599f68beefb168')

_src=gson-gson-parent-${pkgver}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  cd "${_src}/gson"
  # templating-maven-plugin upstream
  rm -rf "${srcdir}/generated"
  mkdir -p "${srcdir}/generated"
  cp -r src/main/java-templates/. "${srcdir}/generated/"
  sed -i "s/\${project.version}/${pkgver}/" "${srcdir}/generated/com/google/gson/internal/GsonBuildConfig.java"
  jb_module com.google.code.gson:gson:${pkgver} src/main/java -s "${srcdir}/generated" \
    -r src/main/resources -u pom.xml -- com.google.errorprone:error_prone_annotations
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  # upstream tests need Truth and guava-testlib; smoke test a round trip
  jb_loadcheck com.google.code.gson:gson
  local t="${srcdir}/smoke" cp
  mkdir -p "${t}"
  cat > "${t}/Smoke.java" <<'JAVA'
import com.google.gson.Gson;
import java.util.Map;
public class Smoke {
  static class P { String name = "gson"; int[] v = {2, 13}; }
  public static void main(String[] a) {
    String json = new Gson().toJson(new P());
    if (!json.equals("{\"name\":\"gson\",\"v\":[2,13]}")) throw new AssertionError(json);
    Map<?, ?> m = new Gson().fromJson(json, Map.class);
    if (!"gson".equals(m.get("name"))) throw new AssertionError(m);
    System.out.println("gson smoke test ok: " + json);
  }
}
JAVA
  cp=$(jb_cp com.google.code.gson:gson)
  javac -nowarn -d "$(jb_w "${t}")" -cp "${cp}" "$(jb_w "${t}/Smoke.java")"
  java -cp "$(jb_w "${t}");${cp}" Smoke
}

package() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install com.google.code.gson:gson
  install -Dm644 "${_src}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-${_realname}/LICENSE"
}
