# Maintainer: Kreijstal <rainb@tfwno.gf>

# Build the upstream published Java sources with the source-bootstrapped JDK.
# Source archives may include generated Java and schema data; all JVM bytecode
# is compiled here. No dependency binary JARs are downloaded.

pkgbase=mingw-w64-java-saxon-he
pkgname=("${MINGW_PACKAGE_PREFIX}-java-saxon-he")
pkgver=12.5
pkgrel=1
pkgdesc="saxon-he Java libraries, built from source"
arch=('any')
mingw_arch=('ucrt64')
url='http://www.saxonica.com/'
license=('spdx:MPL-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-java-build-helper"
             "${MINGW_PACKAGE_PREFIX}-java-icu4j"
             "${MINGW_PACKAGE_PREFIX}-java-xmlresolver")
source=('https://repo.maven.apache.org/maven2/net/sf/saxon/Saxon-HE/12.5/Saxon-HE-12.5-sources.jar'
         'https://repo.maven.apache.org/maven2/net/sf/saxon/Saxon-HE/12.5/Saxon-HE-12.5.pom')
noextract=('Saxon-HE-12.5-sources.jar'
         'Saxon-HE-12.5.pom')
sha256sums=('f1500b3f8be4a3c0257d77e43752fe0cce0913a215924256b2a29877b05b6323'
         'e0f3a8551db88b657e7856635b714eb630456405eeb2b161790eb28f18769ad7')
_artifacts=('net.sf.saxon:Saxon-HE:12.5')

prepare() {
  local gav g a v
  for gav in "${_artifacts[@]}"; do
    IFS=: read -r g a v <<< "$gav"
    mkdir -p "upstream/$a" "resources/$a"
    bsdtar -xf "$a-$v-sources.jar" -C "upstream/$a"
    find "upstream/$a" -type f \( -name '*.class' -o -name '*.jar' -o -name '*.dll' -o -name '*.so' \) -delete
    rm -rf "upstream/$a/META-INF/versions"
    cp -r "upstream/$a/." "resources/$a/"
    find "resources/$a" -type f \( -name '*.java' -o -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' \) -delete
    rm -f "resources/$a/META-INF/MANIFEST.MF"
  done
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  local JB_RELEASE=21
  # DBeaver/XMLBeans use Saxon's native tree and W3C DOM models. These other
  # XML models and the interactive shell are optional integrations upstream.
  rm -rf upstream/Saxon-HE/net/sf/saxon/option/{axiom,dom4j,jdom2,xom} \
         upstream/Saxon-HE/net/sf/saxon/gizmo
  rm -f upstream/Saxon-HE/net/sf/saxon/Gizmo.java
  jb_module net.sf.saxon:Saxon-HE:12.5 upstream/Saxon-HE \
    -r resources/Saxon-HE -u Saxon-HE-12.5.pom -- \
    org.xmlresolver:xmlresolver com.ibm.icu:icu4j?
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_loadcheck --with org.xmlresolver:xmlresolver --with com.ibm.icu:icu4j net.sf.saxon:Saxon-HE
}

_license() {
  local a=$1 v=$2 f
  local copyrights="${srcdir}/$a-SOURCE-COPYRIGHTS.txt"
  find "upstream/$a" -name '*.java' -exec awk '
    FNR == 1 { header=""; collecting=1 }
    /^package[[:space:]]/ {
      if (header != "" && !seen[header]++) print header
      collecting=0
    }
    collecting { header=header $0 "\n" }
  ' {} + > "$copyrights"
  install -Dm644 "$copyrights" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/SOURCE-COPYRIGHTS.txt"
  install -Dm644 "$a-$v.pom" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/UPSTREAM.pom"
  while IFS= read -r f; do
    install -Dm644 "$f" "${pkgdir}${MINGW_PREFIX}/share/licenses/java-$a/${f#upstream/$a/}"
  done < <(find "upstream/$a" -type f \( -iname '*license*' -o -iname '*notice*' -o -iname '*copying*' \) ! -name '*.java')
}

package_java-saxon-he() {
  depends=("${MINGW_PACKAGE_PREFIX}-openjdk>=21"
           "${MINGW_PACKAGE_PREFIX}-java-xmlresolver")
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  jb_install net.sf.saxon:Saxon-HE
  _license Saxon-HE 12.5
}

for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
