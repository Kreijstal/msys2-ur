# Maintainer: Kreijstal <rainb@tfwno.gf>
# Contributor: Kreijstal <elektrischrainbow@gmail.com>

# DBeaver Community Edition built from source without Maven/Tycho: every
# plug-in of the CE product (org.jkiss.dbeaver.ce.feature) is compiled with
# the source-bootstrapped OpenJDK by java-build-helper, against the Eclipse
# 4.41 platform and the DBeaver dependency bundles of the msys2-ur packages.
# The product runs from ${MINGW_PREFIX}/lib/dbeaver on the shared Eclipse
# platform bundles in ${MINGW_PREFIX}/lib/eclipse/plugins, started by the
# native Eclipse launcher of eclipse-equinox-executable.
#
# Not built: org.jkiss.dbeaver.ext.wmi (Windows Management Instrumentation
# driver). Its JNI library is an MSVC project that needs Microsoft ATL, which
# MinGW-w64 does not provide; upstream ships it as a prebuilt DLL.
#
# JDBC drivers: DBeaver downloads driver JARs from Maven Central on first use.
# The SQLite (Xerial) and H2 2.x drivers come from MSYS2 packages instead:
# org.msys2ur.dbeaver.drivers declares DBeaver's product bundles
# drivers.sqlite.xerial and drivers.h2_v2, so DBeaver uses the copies in
# lib/dbeaver/drivers rather than downloading them.

_realname=dbeaver
_datadam=afb5477ab9ab6f90ba8aad27fb0231c6e1727ca3
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=26.2.2
pkgrel=1
pkgdesc="DBeaver Community Edition universal database tool, built from source (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://dbeaver.io/'
license=('spdx:Apache-2.0')
