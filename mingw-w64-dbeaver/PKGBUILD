_excluded=(org.jkiss.dbeaver.ext.wmi)
# ANTLR grammars: plug-in, Java package, grammars (lexer before parser)
_grammars=('org.jkiss.dbeaver.model.lsm org.jkiss.dbeaver.model.lsm.sql.impl.syntax SQLStandardLexer.g4 SQLStandardParser.g4'
           'org.jkiss.dbeaver.ext.clickhouse org.jkiss.dbeaver.ext.clickhouse ClickhouseDataTypes.g4'
           'org.jkiss.dbeaver.ext.databricks org.jkiss.dbeaver.ext.databricks DatabricksDataTypes.g4')

prepare() {
  cd "${srcdir}/${_src}"
  patch -Np1 -i "${srcdir}/0001-product-restrict-org.apache.ant-to-the-packaged-1.10.15-bundle.patch"
  patch -Np1 -i "${srcdir}/0002-net.ssh-use-JSch-s-JDK-Unix-domain-socket-factory-for-ssh-agent.patch"
  # prebuilt binaries: the awt.injector helper JAR (rebuilt from its source
  # below) and the WMI JNI library (plug-in not built)
  rm -f plugins/org.jkiss.dbeaver.core/lib/awt.injector-1.0.0.jar
  rm -rf plugins/org.jkiss.dbeaver.ext.wmi/native
  if [[ -n $(find . "../datadam-api-${_datadam}" -type f \( -name '*.jar' -o -name '*.class' \
      -o -name '*.dll' -o -name '*.so' -o -name '*.dylib' -o -name '*.exe' -o -name '*.zip' \) -print -quit) ]]; then
    echo 'prebuilt binaries left in the sources' >&2
    return 1
  fi

  # bundle projects of this recipe
  rm -rf "${srcdir}/bundles"
  mkdir -p "${srcdir}/bundles/org.msys2ur.dbeaver.drivers/META-INF" \
    "${srcdir}/bundles/org.msys2ur.dbeaver.e2e/META-INF" \
    "${srcdir}/bundles/org.msys2ur.dbeaver.e2e/src/org/msys2ur/dbeaver/e2e"
  cd "${srcdir}/bundles"
  cp "${srcdir}/drivers.MF" org.msys2ur.dbeaver.drivers/META-INF/MANIFEST.MF
  cp "${srcdir}/drivers-plugin.xml" org.msys2ur.dbeaver.drivers/plugin.xml
  printf 'bin.includes = META-INF/,plugin.xml\n' > org.msys2ur.dbeaver.drivers/build.properties
  cp "${srcdir}/e2e.MF" org.msys2ur.dbeaver.e2e/META-INF/MANIFEST.MF
  cp "${srcdir}/e2e-plugin.xml" org.msys2ur.dbeaver.e2e/plugin.xml
  cp "${srcdir}/E2EApplication.java" org.msys2ur.dbeaver.e2e/src/org/msys2ur/dbeaver/e2e/
  printf 'source.. = src/\nbin.includes = .,META-INF/,plugin.xml\n' > org.msys2ur.dbeaver.e2e/build.properties
}

# DBeaver plug-ins of the CE product, one BSN per line
_ce_plugins() {
  local p
  while read -r p; do
    [[ $p == feature:* ]] && continue
    [[ -d ${srcdir}/${_src}/plugins/$p ]] || continue
    [[ " ${_excluded[*]} " == *" $p "* ]] && continue
    printf '%s\n' "$p"
  done < "${srcdir}/ce-plugins.txt"
}

build() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  export JB_QUALIFIER=${_qualifier}
  cd "${srcdir}/${_src}"

  # plug-ins of the CE feature tree on win32/x86_64; the included Eclipse
  # features are listed in eclipse-features.txt
  java "$(jb_w "${srcdir}/FeaturePlugins.java")" "$(jb_w features)" org.jkiss.dbeaver.ce.feature \
    win32 win32 x86_64 | tr -d '\r' > "${srcdir}/ce-plugins.txt"
  local f
  for f in $(sed -n 's/^feature://p' "${srcdir}/ce-plugins.txt"); do
    grep -q "^$f " "${srcdir}/eclipse-features.txt" || { echo "unknown feature $f" >&2; return 1; }
  done

  # ANTLR parsers, generated as antlr4-maven-plugin does
  local row p pkg out antlr
  local -a gs
  antlr=$(jb_cp org.antlr:antlr4)
  for row in "${_grammars[@]}"; do
    read -r p pkg _ <<< "$row"
    read -r -a gs <<< "${row#* * }"
    out=plugins/$p/target/generated-sources/antlr4/${pkg//.//}
    rm -rf "$out" && mkdir -p "$out"
    java -cp "$antlr" org.antlr.v4.Tool -no-visitor -no-listener -Xexact-output-dir \
      -o "$(jb_w "$out")" -lib "$(jb_w "$out")" \
      $(for f in "${gs[@]}"; do jb_w "plugins/$p/grammar/$f"; done)
  done

  # awt.injector: the helper JAR of org.jkiss.dbeaver.core, from its source
  local awt="${srcdir}/awt.injector"
  rm -rf "$awt" && mkdir -p "$awt/classes"
  javac -source 21 -target 21 -nowarn -proc:none --add-exports java.desktop/java.awt.peer=ALL-UNNAMED \
    -d "$(jb_w "$awt/classes")" \
    $(find plugins/org.jkiss.dbeaver.core/awt.injector.lib/src/main/java -name '*.java')
  mkdir -p plugins/org.jkiss.dbeaver.core/lib
  jar --create --file "$(jb_w plugins/org.jkiss.dbeaver.core/lib/awt.injector-1.0.0.jar)" \
    -C "$(jb_w "$awt/classes")" .
  JB_BUNDLE_OPTS_org_jkiss_dbeaver_core=(-C "${srcdir}/${_src}/plugins/org.jkiss.dbeaver.core/lib/awt.injector-1.0.0.jar")

  local -a dirs=("${srcdir}/datadam-api-${_datadam}/apis/com.dbeaver.datadam.lm.api"
                 "${srcdir}/bundles/org.msys2ur.dbeaver.drivers")
  while read -r p; do dirs+=("plugins/$p"); done < <(_ce_plugins)
  jb_bundles -- "${dirs[@]}"

  # root bundles of the product for the launcher
  {
    printf '# DBeaver CE %s product roots (generated)\n' "${pkgver}"
    _ce_plugins
    grep -v '^feature:' "${srcdir}/ce-plugins.txt" | while read -r p; do
      [[ -d plugins/$p ]] || printf '%s\n' "$p"
    done
    grep -v '^#' "${srcdir}/eclipse-features.txt" | awk '{print $2}'
    # start-level bundles of DBeaver.product and the Gogo shell that
    # org.eclipse.equinox.console (org.eclipse.e4.rcp) needs by capability
    printf '%s\n' com.dbeaver.datadam.lm.api org.msys2ur.dbeaver.drivers org.apache.felix.scr \
      org.eclipse.equinox.event org.eclipse.equinox.simpleconfigurator \
      org.apache.felix.gogo.shell org.apache.felix.gogo.command
  } | awk '!seen[$0]++' > "${srcdir}/dbeaver.roots"
}

# the product bundles built here
_product_bundles() {
  printf '%s\n' com.dbeaver.datadam.lm.api org.msys2ur.dbeaver.drivers
  _ce_plugins
}

# lay out the product in $1 (lib/dbeaver)
_assemble() {
  local dest=$1
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  install -d "$dest/plugins" "$dest/drivers/sqlite/xerial" "$dest/drivers/h2_v2"
  ( pkgdir= JB_PLUGINS=$dest/plugins; jb_plugins_install $(_product_bundles) )
  install -m644 "${srcdir}/dbeaver.roots" "${srcdir}/dbeaver.vmargs" "$dest/"
  install -m644 "${srcdir}/${_src}/product/community/icons/dbeaver.ico" "$dest/"
  install -m644 "$(jb_jarpath org.xerial:sqlite-jdbc)" "$dest/drivers/sqlite/xerial/sqlite-jdbc.jar"
  install -m644 "$(jb_jarpath com.h2database:h2)" "$dest/drivers/h2_v2/h2.jar"
}

check() {
  source "${MINGW_PREFIX}/share/java-build-helper/javabuild.sh"
  export JB_QUALIFIER=${_qualifier}
  cd "${srcdir}/${_src}"
  jb_bundle_loadcheck $(_product_bundles)
  # all staged and installed bundle paths exceed the Windows command line
  # limit: pass the resolver check's arguments to java in an @argfile
  java() {
    printf '"%s"\n' "$@" > "${srcdir}/java.args"
    command java "@$(jb_w "${srcdir}/java.args")"
  }
  jb_osgi_resolvecheck
  unset -f java

  # end-to-end: the assembled product, run by the launcher with DBeaver's
  # headless application plug-in (a test plug-in, not packaged) and a check
  # application that resolves every bundle and connects through DBeaver's
  # data source registry with the packaged SQLite and H2 drivers
  jb_bundle plugins/org.jkiss.dbeaver.headless
  jb_bundle "${srcdir}/bundles/org.msys2ur.dbeaver.e2e"
  local product="${srcdir}/check-product" state="${srcdir}/check-state" work="${srcdir}/check-work"
  rm -rf "$product" "$state" "$work"
  _assemble "$product"
  mkdir -p "$state/msys2-ur/dbeaver/plugins" "$work"
  cp "$(jb_bundle_jar org.jkiss.dbeaver.headless)" "$(jb_bundle_jar org.msys2ur.dbeaver.e2e)" \
    "$state/msys2-ur/dbeaver/plugins/"
  sed -e "s|^prefix=.*|prefix=${MINGW_PREFIX}|" -e "s|^home=.*|home=${product}|" \
    "${srcdir}/dbeaver" > "${srcdir}/dbeaver-check"
  XDG_STATE_HOME="$state" timeout 1800 bash "${srcdir}/dbeaver-check" --console -nosplash -consoleLog \
    -application org.msys2ur.dbeaver.e2e.app -data "$(cygpath -am "$work/workspace")" \
    -vmargs -De2e.dir="$(cygpath -am "$work")" -Djava.io.tmpdir="$(cygpath -am "$work")" \
    | tr -d '\r' | tee "${srcdir}/e2e.log"
  grep -qx 'E2E PASS' "$work/result.txt"
}

package() {
  depends=("${_runtime_deps[@]}")
  _assemble "${pkgdir}${MINGW_PREFIX}/lib/${_realname}"
  install -Dm755 "${srcdir}/dbeaver" "${pkgdir}${MINGW_PREFIX}/bin/dbeaver"
  local lic="${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 "${srcdir}/${_src}/LICENSE.md" "$lic/LICENSE.md"
  install -Dm644 "${srcdir}/datadam-api-${_datadam}/LICENSE.md" "$lic/datadam-api/LICENSE.md"
}
