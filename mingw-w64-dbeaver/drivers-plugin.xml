<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Product bundles: DBeaver uses the driver files under drivers/ in the
     installation directory instead of downloading them from Maven. -->
<plugin>
    <extension point="org.jkiss.dbeaver.product.bundles">
        <bundle id="drivers.sqlite.xerial" label="SQLite JDBC driver (mingw-w64-java-sqlite-jdbc)"/>
        <bundle id="drivers.h2_v2" label="H2 2.x JDBC driver (mingw-w64-java-h2)"/>
    </extension>
</plugin>
