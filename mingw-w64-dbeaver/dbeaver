#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# DBeaver CE launcher for MSYS2: runs the product in ${MINGW_PREFIX}/lib/dbeaver
# on the shared Eclipse platform bundles with the packaged OpenJDK.
set -euo pipefail

prefix=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export PATH="$prefix/bin:$PATH"
home=$prefix/lib/dbeaver
eclipse=$prefix/lib/eclipse
java=$prefix/bin/java.exe
launcher=$eclipse/eclipse.exe
splash=(-showsplash)
app_args=()
jvm_args=()
while (($#)); do
  case $1 in
    -h|--help)
      printf '%s\n' 'Usage: dbeaver [--console] [DBeaver/Eclipse options] [-vmargs JVM options]' \
        '  --console  use the console launcher (eclipsec.exe): output and launcher errors go to' \
        '             the terminal instead of message boxes'
      exit 0 ;;
    --console) launcher=$eclipse/eclipsec.exe; splash=(--launcher.suppressErrors); shift ;;
    -vmargs) shift; jvm_args=("$@"); break ;;
    *) app_args+=("$1"); shift ;;
  esac
done

if [[ -n ${XDG_STATE_HOME:-} ]]; then
  state=$XDG_STATE_HOME
elif [[ -n ${LOCALAPPDATA:-} ]]; then
  state=$(cygpath -u "$LOCALAPPDATA")
else
  state=$HOME/.local/state
fi
state=$state/msys2-ur/dbeaver
config=$state/configuration
user_plugins=$state/plugins
mkdir -p "$config/org.eclipse.equinox.simpleconfigurator" "$user_plugins"

plugin() {
  local files=("$home/plugins/$1"_* "$eclipse/plugins/$1"_*) f
  for f in "${files[@]}"; do [[ -e $f ]] && printf '%s\n' "$f"; done | sort -V | tail -1 | grep . ||
    { printf 'Missing Eclipse bundle: %s\n' "$1" >&2; exit 1; }
}

# ASCII file URIs also work with spaces and non-ASCII Windows user names.
property_uri() {
  local LC_ALL=C path encoded= char hex i
  path=$(cygpath -am "$1")
  for ((i=0; i<${#path}; i++)); do
    char=${path:i:1}
    case $char in
      [a-zA-Z0-9/_.:~-]) encoded+=$char ;;
      *) printf -v hex '%02X' "'$char"; encoded+="%$hex" ;;
    esac
  done
  printf 'file\\:/%s' "${encoded//:/\\:}"
}

osgi() {
  "$java" -cp "$(cygpath -am "$prefix/share/java-build-helper/javabuild.jar")" jb.Osgi "$@" | tr -d '\r'
}

# The product's root bundles (DBeaver CE features), plus every bundle in the
# per-user plugins directory; jb.Osgi adds everything they require.
mapfile -t roots < <(grep -v '^#' "$home/dbeaver.roots" | tr -d '\r' | grep .)
for f in "$user_plugins"/*; do
  [[ -e $f ]] || continue
  bv=$(osgi bsnver "$(cygpath -am "$f")") || continue
  [[ $bv == null* ]] || roots+=("${bv%% *}")
done

bundles=$config/org.eclipse.equinox.simpleconfigurator/bundles.info
temporary=$(mktemp "$config/bundles.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
osgi bundlesinfo \
  --dirs "$(cygpath -am "$user_plugins");$(cygpath -am "$home/plugins");$(cygpath -am "$eclipse/plugins")" \
  --start org.eclipse.equinox.simpleconfigurator@1:true \
  --start org.apache.felix.scr@2:true --start org.eclipse.equinox.common@2:true \
  --start org.eclipse.equinox.event@2:true \
  --start org.apache.aries.spifly.dynamic.bundle@2:true \
  --start org.eclipse.core.runtime@4:true --start org.eclipse.osgi@-1:true \
  "$(cygpath -am "$temporary")" "${roots[@]}"
if ! cmp -s "$temporary" "$bundles"; then mv -f -- "$temporary" "$bundles"; fi
rm -f -- "$temporary"
trap - EXIT

simple=$(plugin org.eclipse.equinox.simpleconfigurator)
cat > "$config/config.ini" <<EOF
osgi.framework=$(property_uri "$(plugin org.eclipse.osgi)")
osgi.bundles=reference\:$(property_uri "$simple")@1\:start
org.eclipse.equinox.simpleconfigurator.configUrl=file\:org.eclipse.equinox.simpleconfigurator/bundles.info
osgi.bundles.defaultStartLevel=4
eclipse.product=org.jkiss.dbeaver.ui.app.standalone.product
eclipse.application=org.jkiss.dbeaver.ui.app.standalone.standalone
osgi.splashPath=platform\:/base/plugins/org.jkiss.dbeaver.ui.app.standalone
EOF

java_home=$("$java" -XshowSettings:properties -version 2>&1 |
  sed -n 's/^ *java.home = //p' | tr -d '\r')
[[ -n $java_home ]] || { printf '%s\n' 'Cannot locate the packaged Java runtime' >&2; exit 1; }
mapfile -t product_vmargs < <(grep -v '^#' "$home/dbeaver.vmargs" | tr -d '\r' | grep .)
exec "$launcher" "${splash[@]}" \
  -install "$(cygpath -am "$home")" \
  -startup "$(cygpath -am "$(plugin org.eclipse.equinox.launcher)")" \
  --launcher.library "$(cygpath -am "$(plugin org.eclipse.equinox.launcher.win32.win32.x86_64)")" \
  -configuration "$(cygpath -am "$config")" \
  -vm "$(cygpath -am "$java_home/bin/server/jvm.dll")" "${app_args[@]}" \
  -vmargs "${product_vmargs[@]}" "${jvm_args[@]}"
