_realname=tree-sitter-typescript
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.23.2
pkgrel=1
pkgdesc="TypeScript and TSX grammar for tree-sitter (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/tree-sitter/tree-sitter-typescript'
msys2_repository_url='https://github.com/tree-sitter/tree-sitter-typescript'
msys2_references=(
  'purl: pkg:pypi/tree-sitter-typescript'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-python")
optdepends=("${MINGW_PACKAGE_PREFIX}-python-tree-sitter: parsing through the tree_sitter API")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-python-wheel"
             "${MINGW_PACKAGE_PREFIX}-cc")
checkdepends=("${MINGW_PACKAGE_PREFIX}-python-tree-sitter")
# the PyPI sdist lacks common/scanner.h and the tree_sitter/ headers
source=("${_realname}-${pkgver}.tar.gz::https://github.com/tree-sitter/tree-sitter-typescript/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('2c4ce711ae8d1218a3b2f899189298159d672870b5b34dff5d937bed2f3e8983')

prepare() {
  cd "tree-sitter-typescript-${pkgver}"
  # platform.system() is "Windows" under MinGW too, which selects MSVC's
  # /std:c11 /utf-8; GCC needs the POSIX branch
  sed -i 's/system() != "Windows"/True/' setup.py
}

build() {
  cp -r "tree-sitter-typescript-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import tree_sitter_typescript as tst
from tree_sitter import Language, Parser
p = Parser(Language(tst.language_typescript()))
t = p.parse(b"function f(x: number): string { return `${x}`; }\n")
assert t.root_node.type == "program" and not t.root_node.has_error, t.root_node
p = Parser(Language(tst.language_tsx()))
t = p.parse(b"const a = <div className=\"x\">{1}</div>;\n")
assert not t.root_node.has_error, t.root_node
print("tree-sitter-typescript ok")
PY
}

package() {
  cd "python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
