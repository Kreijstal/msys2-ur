# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-toolkit-highperformance
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=7.0.2
pkgrel=1
pkgdesc='Source-built Microsoft.Toolkit.HighPerformance (Windows Community Toolkit) for the .NET 8 offline feed'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/CommunityToolkit/WindowsCommunityToolkit'
license=('spdx:MIT')
_commit=28e7dd4f92c0a2c8a60e8410941ff0577fb78d3d
_tree=WindowsCommunityToolkit-${_commit}
_project=Microsoft.Toolkit.HighPerformance/Microsoft.Toolkit.HighPerformance.csproj
_id=Microsoft.Toolkit.HighPerformance
_framework=net8.0
depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime=8.0.131")
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk=8.0.131" 'python')
options=('!strip' '!lto')
source=("windowscommunitytoolkit-28e7dd4f92c0a2c8a60e8410941ff0577fb78d3d.tar.gz::https://codeload.github.com/CommunityToolkit/WindowsCommunityToolkit/tar.gz/28e7dd4f92c0a2c8a60e8410941ff0577fb78d3d" prepare.py check.cs)
sha256sums=('be12950bc5c397d8ddbf2e0b0e120002652823d00e27a2c31719ec2d7258ddbd'
            '41bf4565e0123f66c795ba66c733f80de91dbfb7b64ad8b64b3d4dbec0d935ab'
            '9ed686ccb2f4db78a39e2cd0f6f064be46889bc64a7b2a9610b79e85876542bf')

_env() {
  export PATH="$MINGW_PREFIX/bin:/usr/bin:$PATH"
  export DOTNET_ROOT=$(cygpath -m "$MINGW_PREFIX/lib/dotnet")
  export DOTNET_ROOT_X64=$DOTNET_ROOT
  export DOTNET_CLI_HOME=$(cygpath -m "$srcdir/cli-home")
  export NUGET_PACKAGES=$(cygpath -m "$srcdir/empty-packages")
  export MSBuildEnableWorkloadResolver=false DOTNET_CLI_TELEMETRY_OPTOUT=1
}
prepare() {
  /usr/bin/python3 "$srcdir/prepare.py" toolkit-highperformance "$srcdir/$_tree"
  printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$srcdir/NuGet.config"
}
build() {
  _env
  cd "$srcdir/$_tree"
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" pack "$_project" -c Release -o "$(cygpath -m "$srcdir/feed")" \
    --configfile "$(cygpath -m "$srcdir/NuGet.config")" -p:PackageId="$_id" -p:PackageVersion="$pkgver" \
    -p:Version="$pkgver" -p:GeneratePackageOnBuild=false -p:TargetFrameworks=net8.0 \
    -p:AssemblyVersion=7.0.0.0 -p:FileVersion=7.0.2.1 -p:InformationalVersion="$pkgver+${_commit::10}" -p:SourceRevisionId="$_commit" -p:IncludeSourceRevisionInInformationalVersion=false \
    -p:RepositoryUrl=https://github.com/windows-toolkit/WindowsCommunityToolkit -p:RepositoryType=git -p:PublishRepositoryUrl=true -p:RepositoryCommit="$_commit" -p:IncludeSymbols=false -p:RestoreSources="$(cygpath -m "$MINGW_PREFIX/lib/dotnet/library-packs")" \
    -p:EnablePackageValidation=false -p:TreatWarningsAsErrors=false -p:WarningsAsErrors= -p:EnableNETAnalyzers=false -p:NuGetAudit=false -p:UseSharedCompilation=false -v:minimal
}
check() {
  _env
  mkdir -p "$srcdir/check"
  cp "$srcdir/check.cs" "$srcdir/check/Program.cs"
  cat > "$srcdir/check/check.csproj" <<PROJECT
<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>$_framework</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost><EnableNETAnalyzers>false</EnableNETAnalyzers><NuGetAudit>false</NuGetAudit></PropertyGroup><ItemGroup><PackageReference Include="$_id" Version="[$pkgver]" /></ItemGroup></Project>
PROJECT
  "$MINGW_PREFIX/lib/dotnet/dotnet.exe" run --project "$(cygpath -m "$srcdir/check/check.csproj")" -c Release \
    -p:RestoreSources="$(cygpath -m "$srcdir/feed")" -p:UseSharedCompilation=false
}
package() {
  install -Dm644 "$srcdir/feed/$_id.$pkgver.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${_id,,}.$pkgver.nupkg"
  install -Dm644 "$srcdir/$_tree/license.md" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/LICENSE"
  install -Dm644 "$srcdir/$_tree/removed-binaries.json" "$pkgdir$MINGW_PREFIX/share/doc/$_realname/removed-binaries.json"
}
