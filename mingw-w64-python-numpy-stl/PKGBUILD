_realname=numpy-stl
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=4.1.3
pkgrel=1
pkgdesc="Library to make reading, writing and modifying both binary and ascii STL files easy (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://pypi.org/project/numpy-stl/'
msys2_references=(
  'purl: pkg:pypi/numpy-stl'
)
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-numpy"
         "${MINGW_PACKAGE_PREFIX}-python-python-utils"
         "${MINGW_PACKAGE_PREFIX}-python-typing_extensions")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-uv-build")
source=("https://files.pythonhosted.org/packages/source/n/${_realname}/numpy_stl-${pkgver}.tar.gz")
sha256sums=('2820f64ba63283bfe56081f36eb9089196141d08eb5e00ecd1ba50ce78eee107')

build() {
  cp -r numpy_stl-${pkgver} python-build-${MSYSTEM} && cd python-build-${MSYSTEM}
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd python-build-${MSYSTEM}
  rm -rf chk && MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} --destdir=chk dist/*.whl
  cd chk${MINGW_PREFIX}/lib/python3*/site-packages
  ${MINGW_PREFIX}/bin/python - <<'PY'
import os, tempfile, numpy
from stl import mesh, Mode
# one triangle, written and read back in both formats as Uranium's STL reader does
m = mesh.Mesh(numpy.zeros(1, dtype=mesh.Mesh.dtype))
m.vectors[0] = [[0, 0, 0], [10, 0, 0], [0, 10, 0]]
d = tempfile.mkdtemp()
for mode in (Mode.ASCII, Mode.BINARY):
    p = os.path.join(d, "t.stl")
    m.save(p, mode=mode)
    r = mesh.Mesh.from_file(p)
    assert numpy.allclose(r.vectors, m.vectors), (mode, r.vectors)
print("numpy-stl ok")
PY
}

package() {
  cd python-build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
