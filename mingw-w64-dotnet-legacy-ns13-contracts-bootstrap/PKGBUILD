# Maintainer: Kreijstal <rainb@tfwno.gf>
_realname=dotnet-legacy-ns13-contracts-bootstrap
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=20261031
pkgrel=4
pkgdesc='Selected original Standard1.x source reference contracts for legacy dependency builds'
arch=('any')
mingw_arch=('clang64')
url='https://github.com/dotnet/source-build-reference-packages'
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-dotnet-sdk8-servicing>=8.0.131-5"
             "${MINGW_PACKAGE_PREFIX}-dotnet-compiler5-bootstrap=5.0.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-roslyn44=4.4.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-cecil011-bootstrap=0.11.0"
             "${MINGW_PACKAGE_PREFIX}-dotnet-netcore-platforms110=1.1.0" 'python')
options=('!strip' '!lto' '!buildflags')
source=('sbrp-5aeee273.tar.gz::https://codeload.github.com/dotnet/source-build-reference-packages/tar.gz/5aeee2738338530a92d7f6caa2c7d5f569fed3c4'
        'corefx10-codepages-9688ddbb.tar.gz::https://codeload.github.com/dotnet/corefx/tar.gz/9688ddbb62c04189cac4c4a06e31e93377dccd41'
        'roslyn-4.4.0-1ce8866c.tar.gz::https://codeload.github.com/dotnet/roslyn/tar.gz/1ce8866c9de4c2d67351ef6863699dee03b0804a'
        'legacy-ns13-contracts-source-4.tar.gz')
noextract=('sbrp-5aeee273.tar.gz' 'corefx10-codepages-9688ddbb.tar.gz' 'roslyn-4.4.0-1ce8866c.tar.gz')
sha256sums=('2b3136fab488246d0289e622797094e7c2eb29b35f67a9a5cd1312ef3ddfca79'
            '986a512c70d55ed7a1ed8cbb9d8323017c9cc83e77e95e833c7b91f42e4ef601'
            '9edb8c430576c5f5b27032afe8f79c74508b0150e03406a7a4ca6f218e03fd11'
            '0df02866e940569b4cbbbdc230ca15f3ade1c62008078e7b5a97f0c6cc724dee')
prepare() {
  /usr/bin/python3 "$srcdir/legacy-ns13-contracts-workflow/prepare.py" "$srcdir/sbrp-5aeee273.tar.gz" "$srcdir/corefx10-codepages-9688ddbb.tar.gz" "$srcdir/prepared" > "$srcdir/prepare.log" 2>&1
}
build() {
  /usr/bin/python3 "$srcdir/legacy-ns13-contracts-workflow/compiler44.py" "$srcdir/roslyn-4.4.0-1ce8866c.tar.gz" "$srcdir/compiler44" > "$srcdir/compiler44.log" 2>&1
  /usr/bin/python3 "$srcdir/legacy-ns13-contracts-workflow/build.py" "$srcdir/prepared" "$srcdir/compiler44/bin/Release/net8.0" > "$srcdir/build.log" 2>&1
}
check() {
  /usr/bin/python3 "$srcdir/legacy-ns13-contracts-workflow/audit.py" "$srcdir/prepared" > "$srcdir/audit.log" 2>&1
  /usr/bin/python3 "$srcdir/legacy-ns13-contracts-workflow/check.py" "$srcdir/prepared" "$srcdir/check" "$srcdir/compiler44/bin/Release/net8.0" > "$srcdir/check.log" 2>&1
}
package() {
  local doc="$pkgdir$MINGW_PREFIX/share/doc/$_realname"
  local pack="$pkgdir$MINGW_PREFIX/lib/dotnet/reference-packs/legacy-ns13-contracts-bootstrap"
  local file
  mkdir -p "$pack" "$doc/inputs"
  cp -r "$srcdir/prepared/ref" "$srcdir/prepared/contracts" "$pack/"
  for file in README.md check.py;do install -m644 "$srcdir/legacy-ns13-contracts-workflow/$file" "$doc/$file";done
  for file in Api.cs Check.cs Probe.cs ProbeDataflow.cs published-metadata.json published-build-matrix.json published-provenance.json build-matrix-provenance.json interop-layouts.json conditional-attributes.json;do install -m644 "$srcdir/legacy-ns13-contracts-workflow/inputs/$file" "$doc/inputs/$file";done
  install -m644 "$srcdir/prepared/source-inputs.json" "$srcdir/prepared/build-results.json" "$srcdir/prepared/producer-audit.json" "$doc/"
  install -m644 "$srcdir/compiler44/source-inputs.json" "$doc/compiler44-source-inputs.json"
  install -m644 "$srcdir/check/results.json" "$doc/producer-check-results.json"
  install -Dm644 "$srcdir/prepared/source/LICENSE.txt" "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/SBRP-LICENSE.txt"
  for file in LICENSE THIRD-PARTY-NOTICES;do
    tar -xOf "$srcdir/corefx10-codepages-9688ddbb.tar.gz" "corefx-9688ddbb62c04189cac4c4a06e31e93377dccd41/$file" > "$pkgdir$MINGW_PREFIX/share/licenses/$_realname/CoreFX-$file"
  done
}
