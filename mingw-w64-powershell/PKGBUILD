prepare() {
  mkdir "$srcdir/build"
  cp "$srcdir/powershell-7.4.20.tar.gz" "$srcdir/build/"
  tar -xf "$srcdir/powershell-7.4.20.tar.gz" -C "$srcdir/build"
  /usr/bin/python3 "$srcdir/workflow/tests/powershell-full-sdk/prepare.py" "$srcdir/build/PowerShell-7.4.20"
}

build() {
  bash "$srcdir/workflow/tests/powershell-full-sdk/build-package.sh" "$srcdir/build"
}

check() {
  bash "$srcdir/workflow/tests/powershell-full-sdk/check-localaccounts-api.sh" "$srcdir/build" "$srcdir/build/localaccounts-api-check"
  local checks="$srcdir/build/distribution/share/doc/powershell/checks"
  bash "$checks/check-package.sh" "$srcdir/build/distribution" "$srcdir/build/package-check" "$checks"
}

package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -a "$srcdir/build/distribution/." "$pkgdir$MINGW_PREFIX/"
}
