if [[ ${MINGW_PACKAGE_PREFIX} == *-clang-* ]]; then
  depends+=("${MINGW_PACKAGE_PREFIX}-dotnet-windowsdesktop-bootstrap>=8.0.0")
  makedepends+=("${MINGW_PACKAGE_PREFIX}-dotnet-windowsdesktop-bootstrap>=8.0.0")
fi
_wf() { printf '%s/dotnet-mingw-bootstrap-%s/workflows/powershell-full-sdk' "${srcdir}" "${_workflow_commit}"; }
_desktop() { [[ ${MINGW_PACKAGE_PREFIX} == *-clang-* ]] && echo 1 || echo 0; }

prepare() {
  mkdir "$srcdir/build"
  cp "$srcdir/powershell-7.4.20.tar.gz" "$srcdir/build/"
  tar -xf "$srcdir/powershell-7.4.20.tar.gz" -C "$srcdir/build"
  /usr/bin/python3 "$(_wf)/prepare.py" "$srcdir/build/PowerShell-7.4.20"
}

build() {
  POWERSHELL_DESKTOP=$(_desktop) bash "$(_wf)/build-package.sh" "$srcdir/build" "$srcdir"
}

check() {
  bash "$(_wf)/check-localaccounts-api.sh" "$srcdir/build" "$srcdir/build/localaccounts-api-check"
  local checks="$srcdir/build/distribution/share/doc/powershell/checks"
  bash "$checks/check-package.sh" "$srcdir/build/distribution" "$srcdir/build/package-check" "$checks"
}

package() {
  mkdir -p "$pkgdir$MINGW_PREFIX"
  cp -a "$srcdir/build/distribution/." "$pkgdir$MINGW_PREFIX/"
}
