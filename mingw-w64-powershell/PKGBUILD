# The full-SDK workflow of Kreijstal/dotnet-mingw-bootstrap, for both
# environments. UCRT64 has no WindowsDesktop runtime: it builds the console
# without GraphicalHost and the WindowsDesktop framework reference.
_workflow_commit=5ab58f8ba94346c59bc68ab052d8f96f124be323
source=('powershell-7.4.20.tar.gz::https://codeload.github.com/PowerShell/PowerShell/tar.gz/refs/tags/v7.4.20'
        "dotnet-mingw-bootstrap-${_workflow_commit}.tar.gz::https://codeload.github.com/Kreijstal/dotnet-mingw-bootstrap/tar.gz/${_workflow_commit}"
        'launcher.c'
        'LICENSE.launcher'
        'README.md'
        'check-package.sh'
        'check-launcher.py'
        'module-host-audit-source.py')
noextract=('powershell-7.4.20.tar.gz')
