            'a36298df0c668a6e1ad423826006937b006f139767fdef30e854a8d517e3ce08')
prepare() { /usr/bin/python3 "$srcdir/prepare.py" "$srcdir/DocumentationAnalyzers-$_commit" "$srcdir/prepared"; }
build() { bash "$srcdir/build.sh" "$srcdir/DocumentationAnalyzers-$_commit" "$srcdir/prepared"; }
check() { bash "$srcdir/check.sh" "$srcdir/check" "$srcdir/feed" "$srcdir/prepared"; }
_install() {
 local suffix=$1 id=$2 version=$3
 install -Dm644 "$srcdir/feed/$id.$version.nupkg" "$pkgdir$MINGW_PREFIX/lib/dotnet/library-packs/${id,,}.$version.nupkg"
 install -Dm644 "$srcdir/DocumentationAnalyzers-$_commit/LICENSE" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-documentation-analyzers$suffix/LICENSE"
 install -m644 "$srcdir/DocumentationAnalyzers-$_commit/THIRD-PARTY-NOTICES.txt" "$pkgdir$MINGW_PREFIX/share/licenses/dotnet-documentation-analyzers$suffix/THIRD-PARTY-NOTICES"
 for file in README.md ExpectedInventory.json UpstreamFixtures.json published-metadata-provenance.json;do
  install -Dm644 "$srcdir/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-documentation-analyzers$suffix/$file"
 done
 for file in source-items.json removed-binaries.json fixtures.json localization.json;do
  install -m644 "$srcdir/prepared/$file" "$pkgdir$MINGW_PREFIX/share/doc/dotnet-documentation-analyzers$suffix/$file"
 done
}
package_mingw-w64-clang-x86_64-dotnet-documentation-analyzers() {
 pkgdesc='Source-built DocumentationAnalyzers beta.59 dependency package'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-documentation-analyzers-unstable=$pkgver")
 _install '' DotNetAnalyzers.DocumentationAnalyzers 1.0.0-beta.59
}
package_mingw-w64-clang-x86_64-dotnet-documentation-analyzers-unstable() {
 pkgdesc='Source-built DocumentationAnalyzers 1.0.0.59 analyzer and code-fix implementation'
 depends=("${MINGW_PACKAGE_PREFIX}-dotnet-runtime>=8.0.131" "${MINGW_PACKAGE_PREFIX}-dotnet-commonmark>=0.15.1" "${MINGW_PACKAGE_PREFIX}-dotnet-codeanalysis-csharp-workspaces>=4.9.2" "${MINGW_PACKAGE_PREFIX}-dotnet-csharp-compiler>=4.9.2")
 _install '-unstable' DotNetAnalyzers.DocumentationAnalyzers.Unstable 1.0.0.59
}
