# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=libice
urlpkgname=libICE
pkgver=1.1.1
pkgrel=1
pkgdesc="X11 Inter-Client Exchange library"
arch=('i686' 'x86_64')
url="https://www.x.org/"
license=('MIT')
depends=('xorgproto' 'libx11')
makedepends=('xorg-util-macros' 'xtrans' 'autoconf' 'automake' 'libtool' 'gcc' 'ccache')

XORG_SRC_COMPRESSION=${XORG_SRC_COMPRESSION:-xz}
source=(https://www.x.org/archive/individual/lib/${urlpkgname}-${pkgver}.tar.${XORG_SRC_COMPRESSION})
sha256sums=('SKIP')  # Replace SKIP with the actual checksum

prepare() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  autoreconf -vif
}

build() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # libtool has no 'msys' case: its Windows branch matches only
  # cygwin*|mingw*|windows*|pw32*|cegcc*, so an *-msys host falls through to the
  # default branch, which sets build_libtool_libs=no and an empty
  # library_names_spec. The result is a STATIC ARCHIVE ONLY, produced silently
  # with configure still exiting 0; --enable-shared does not override it, the
  # host triple is what decides. x86_64-pc-cygwin selects the branch with full
  # shared-library support, and --build is passed identically so autoconf does
  # not treat this as a cross build - CC stays the msys gcc, only libtool's
  # behaviour changes.
  #
  # The DLL still comes out named msys-* rather than cyg*, because prepare()
  # regenerates configure with autoreconf and so picks up MSYS2's patched
  # libtool.m4, whose cygwin branch renames lib -> msys- instead of cyg.
  local _host="x86_64-pc-cygwin"

  ./configure --prefix=/usr \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --datadir=/usr/share \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info \
    --build=${_host} \
    --host=${_host} \
    --enable-shared \
    --enable-static

  make
}

check() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  make check
}

package() {
  cd ${srcdir}/${urlpkgname}-${pkgver}

  # Install the package to the system
  make DESTDIR=${pkgdir} install

  # A libtool static-only degradation is silent: configure and make both still
  # exit 0, so nothing above this line can fail on it. Assert on the artifacts
  # instead. This matters beyond this package -- libtool also degrades a
  # dependent library to static when one of its dependencies has no import
  # library, so one static result quietly propagates down the whole chain.
  ls "${pkgdir}"/usr/bin/msys-*.dll >/dev/null 2>&1 || {
    echo "ERROR: ${pkgname} built static-only (no DLL installed)" >&2; return 1; }
  local _a _base
  for _a in "${pkgdir}"/usr/lib/lib*.a; do
    [ -e "${_a}" ] || continue
    case "${_a}" in *.dll.a) continue;; esac
    _base=$(basename "${_a}" .a)
    [ -f "${pkgdir}/usr/lib/${_base}.dll.a" ] || {
      echo "ERROR: ${_base} built static-only (no import library)" >&2; return 1; }
  done
}
