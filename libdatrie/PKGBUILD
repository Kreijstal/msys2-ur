# Maintainer: kreijstal <kreijstal@hotmail.com>

pkgname=libdatrie
pkgver=0.2.13
pkgrel=1
pkgdesc="Double-array digital search tree library"
arch=('i686' 'x86_64')
url="https://linux.thai.net/"
license=('LGPL-2.1-or-later')
makedepends=('gcc' 'make' 'libiconv-devel' 'autoconf' 'automake' 'libtool')
source=(http://linux.thai.net/pub/thailinux/software/libthai/libdatrie-${pkgver}.tar.xz
        0001-fix-Import-AX_COMPARE_VERSION-macro-in-configure.ac.patch
        0002-fix-Add-missing-ax_compare_version.m4-file-and-updat.patch
trietool.patch
 https://raw.githubusercontent.com/autoconf-archive/autoconf-archive/master/m4/ax_compare_version.m4)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'  
'SKIP')
options=("strip")
depends=('gcc-libs' 'libiconv')

prepare() {
  cd ${srcdir}/${pkgname}-${pkgver}

  # Apply patches
  patch -p1 -i ${srcdir}/0001-fix-Import-AX_COMPARE_VERSION-macro-in-configure.ac.patch
  patch -p1 -i ${srcdir}/0002-fix-Add-missing-ax_compare_version.m4-file-and-updat.patch
  patch -p1 -i ${srcdir}/trietool.patch

  #patch -p1 -i ${srcdir}/0003-adding-things-to-m4-for-new-autotools.patch
  cp ${srcdir}/ax_compare_version.m4 m4/
  # Regenerate build system after patching
  autoreconf -fiv
  #fix cygwin bug
  find . -type f \( -name "*.c" -o -name "*.cpp" -o -name "*.h" -o -name "*.hpp" \) -exec sed -i 's/\bL"/U"/g' {} +
  
}

build() {
  # Create build directory
  mkdir -p ${srcdir}/build
  cd ${srcdir}/build

  # libtool has no 'msys' case: its Windows branch matches only
  # cygwin*|mingw*|windows*|pw32*|cegcc*, so an *-msys host (what config.guess
  # reports here, though it is not what CHOST says)
  # falls through to the default branch, which sets build_libtool_libs=no and an
  # empty library_names_spec. The result is a STATIC ARCHIVE ONLY, produced
  # silently with configure still exiting 0. Note that the --enable-shared that
  # used to be on this line did NOT prevent that -- the host triple is what
  # decides, and this package shipped only libdatrie.a because of it.
  # $CHOST selects the branch with full shared-library support, and
  # --build is passed identically so autoconf does not treat this as a cross
  # build - CC stays the msys gcc, only libtool's behaviour changes.
  #
  # The DLL still comes out named msys-* rather than cyg*, because prepare()
  # regenerates the build system with autoreconf and so picks up MSYS2's patched
  # libtool.m4, whose cygwin branch renames lib -> msys- instead of cyg.
  # The triple is $CHOST, MSYS2's own declaration for this environment: stock
  # /etc/makepkg.conf (straight from the pacman package) sets
  # CHOST=x86_64-pc-cygwin. Never hardcode one here - an earlier revision of this
  # file hardcoded x86_64-pc-msys, which is precisely what produced the
  # static-only build described above.
  local _host="${CHOST:?CHOST unset - /etc/makepkg.conf was not sourced}"

  # Configure and build from the build directory
  ${srcdir}/${pkgname}-${pkgver}/configure --prefix=/usr \
    --build=${_host} \
    --host=${_host} \
    --enable-shared \
    --enable-static
  make ${MAKEOPTS}
}

check() {
  cd ${srcdir}/build

  make check
}

package() {
  cd ${srcdir}/build
    # Create the man directory if it doesn't exist
  mkdir -p man
    # Copy the man page to the build directory
  cp ${srcdir}/${pkgname}-${pkgver}/man/trietool.1 man/trietool.1

  # Install the library and headers to the package directory
  make install DESTDIR=${pkgdir}

  # A libtool static-only degradation is silent: configure and make both still
  # exit 0, so nothing above this line can fail on it. Assert on the artifacts
  # instead, or a static-only regression ships unnoticed and every dependent
  # package (libthai, and pango above it) quietly goes static along with it.
  for _l in datrie; do
    [ -f "${pkgdir}/usr/lib/lib${_l}.dll.a" ] || {
      echo "ERROR: lib${_l} built static-only (no import library)" >&2; return 1; }
    ls "${pkgdir}"/usr/bin/msys-${_l}-*.dll >/dev/null 2>&1 || {
      echo "ERROR: lib${_l} built static-only (no DLL)" >&2; return 1; }
  done
}
